module data_pipeline;

// data-pipeline — a JSON/record-processing application, dogfooded on the v0
// runnable core.
//
// A real data processor decodes structured records (say, JSON objects with a
// `category` and an `amount` field), filters them, transforms them, and
// aggregates the result. Records here are *packed integers* — but the batch is
// a real fixed-capacity array, folded with a bounded `for` loop, and the
// pipeline itself is the genuine article: field decoding, a filter predicate, a
// per-record transform, and two aggregations (a conditional sum and a count),
// each pinned by an executable `spec`.
//
// Growable-collection oracle (ADR-0009). The original fixed-`[Int; 8]` fold
// answers the query in one pass. But a real filter+collect produces a subset
// whose *size is data-dependent* — the number of transport records is not known
// until the batch is scanned — which a fixed-capacity array cannot express.
// Since ADR-0009 landed the allocator core, the second half of this file does
// exactly that: it `push`es each matching amount into a growable `Array[Int]`
// (`std::array`), then folds the materialised subset. The specs prove the
// growable path yields the **identical** total as the streaming fold — the
// oracle the ADR names. This is the thing fixed arrays could not do; the two
// aggregations agreeing is the evidence it is correct.
//
// Higher-order oracle (ADR-0008 Tier 1). The materialised subset is no longer
// folded by a hand-written `while` loop: it is summed by the *generic* fold
// `fold(items, 0, add)`, passing this module's own top-level `add` as a
// **first-class function value** (ADR-0008). This is the ADR's named oracle —
// "data-pipeline's hand-written fold rewritten to call the generic fold with
// identical spec verdicts". The subset-sum still equals the streaming
// `total_for`, and the exit byte is unchanged (144). The generic `fold` here is
// the exact shape of the shipped `std::collections::fold` (same signature, same
// body); it lives in this file rather than being vendored from the catalog
// because `std::collections` also defines the generic `Pair[A, B]` struct,
// which the native backend cannot lower yet (monomorphization is deferred), so
// the whole catalog module cannot be compiled through `tuo run`. The catalog's
// `std::collections::fold` is proven by its own module spec in the shipped
// stdlib suite; here we dogfood the identical higher-order fold in a program
// that runs natively.
//
// Record-struct oracle (ADR-0012). Since ADR-0012 widened the array element
// set to structs (including structs with owned `String` fields), the packed
// integers can finally be decoded into what they always stood for: a
// `Record { category, amount, label }` struct, held in a growable
// `Array[Record]`. The last section of this file does exactly that — decode,
// filter+collect at the record level, and fold with the **struct
// instantiation** of the generic combinator (`fold_records` over an
// `in Record` function value) — and `main` now answers the query through it,
// so the native binary exercises the owned-element deep-copy `get` and
// recursive drop for real. The specs pin the record path equal to the
// streaming packed-`Int` fold and the packed-`Int` collect path — the oracle
// ADR-0012 names. The owned `label` also composes ADR-0010 for real: a
// `String` producer (`label_for`) is viewed zero-copy by `Str` consumers
// (`label_is`/`label_len`) natively.
//
// Keyed-aggregation oracle (ADR-0011). Since ADR-0011 landed the hash map,
// the pipeline finally has its dictionary shape: `totals_by_category` folds
// the whole batch into a `Map[Int, Int]` in ONE scan (where `total_for`
// re-scans per category), and `main` cross-checks the two paths at runtime —
// the exit byte survives only if the map's answer equals the record-struct
// path's, natively. The specs pin the map path equal to the streaming fold
// for every category and pin `keys`' first-seen order.
//
// Record encoding (a deliberately real serialization exercise):
//
//     record = category * 100000 + amount
//
//   * `category` in 1..=9   — a small enumerated tag (1 = groceries,
//                             2 = transport, 3 = utilities, ...)
//   * `amount`   in 0..=99999 — the value carried by the record
//
// Decoding a field is integer division / modulo — exactly what a hand-written
// JSON number scanner reduces to once the bytes are in hand. The program
// answers one query — "total amount across transport records (category 2)" —
// and returns it (mod 256) as the process exit status.

// --- The encoded batch -----------------------------------------------------

/// Eight packed records in one fixed-capacity array. In a real build these
/// would be decoded from a byte stream; here they are the fixed input. Written
/// in packed form on purpose, so the decoders below have something authentic
/// to take apart.
fn records() -> [Int; 8] {
    [100150, // category 1, amount 150
    200080, // category 2, amount  80
    300500, // category 3, amount 500
    200120, // category 2, amount 120
    100075, // category 1, amount  75
    200200, // category 2, amount 200
    400300, // category 4, amount 300
    300060 // category 3, amount  60
    ]
}

// --- Field decoders --------------------------------------------------------

/// The base used to pack `category` and `amount` into one integer.
fn field_base() -> Int {
    100000
}

/// Decode the `category` field of a packed record.
fn category(take record: Int) -> Int {
    record / field_base()
}

/// Decode the `amount` field of a packed record.
fn amount(take record: Int) -> Int {
    record - category(record) * field_base()
}

// --- Pipeline stages -------------------------------------------------------

/// The filter predicate: does this record belong to the queried category?
fn matches(take record: Int, take wanted: Int) -> Bool {
    category(record) == wanted
}

/// The per-record transform + fold: contribute a record's amount to the
/// running total only when it matches the wanted category. This is the fused
/// filter+map+reduce step a streaming processor would run per element.
fn fold_one(take acc: Int, take record: Int, take wanted: Int) -> Int {
    if matches(record, wanted) {
        acc + amount(record)
    } else {
        acc
    }
}

/// Total the amounts of every record in the wanted category, folding
/// `fold_one` over the batch.
fn total_for(take wanted: Int) -> Int {
    var total = 0;
    for record in records() {
        total = fold_one(total, record, wanted);
    }
    total
}

/// The per-record counting step: bump the count only on a match.
fn count_hit(take acc: Int, take record: Int, take wanted: Int) -> Int {
    if matches(record, wanted) {
        acc + 1
    } else {
        acc
    }
}

/// Count how many records fall in the wanted category, folding `count_hit`
/// over the batch.
fn count_for(take wanted: Int) -> Int {
    var count = 0;
    for record in records() {
        count = count_hit(count, record, wanted);
    }
    count
}

/// The average amount within a category (floored). Guards the empty category
/// so no record in the pipeline can divide by zero.
fn average_for(take wanted: Int) -> Int {
    let n = count_for(wanted);
    if n == 0 {
        0
    } else {
        total_for(wanted) / n
    }
}

// --- The growable-collection oracle (ADR-0009) -----------------------------

/// Collect the amounts of every record in the wanted category into a **new,
/// growable** `Array[Int]`. The result's length is data-dependent — it is the
/// number of matching records, discovered only by scanning the batch — so this
/// is the filter+collect a fixed-capacity `[Int; N]` cannot express. Each match
/// is `push`ed onto the heap-backed array (ADR-0009's allocator core).
fn collect_amounts(take wanted: Int) -> Array[Int] {
    var out = std::array::empty();
    for record in records() {
        if matches(record, wanted) {
            std::array::push(out, amount(record));
        }
    }
    out
}

/// The count of matching records, read from the materialised subset's length —
/// the growable-array analogue of `count_for`.
fn collected_count(take wanted: Int) -> Int {
    std::array::len(collect_amounts(wanted))
}

/// The fold step: add a record's amount to the running accumulator. Used as a
/// **first-class function value** (ADR-0008 Tier 1) — `sum_collected` passes it
/// by name to the generic `fold`.
fn add(take acc: Int, take x: Int) -> Int {
    acc + x
}

/// The generic left fold over a growable `Array[Int]` and a **function value**
/// step (ADR-0008 Tier 1) — the exact shape of `std::collections::fold`. One
/// generic fold replaces the family of hand-written folds this file used to
/// carry; `step` is a first-class `fn(take Int, take Int) -> Int` value.
fn fold(in xs: Array[Int], take init: Int, take step: fn(take Int, take Int) -> Int) -> Int {
    var acc = init;
    var i = 0;
    while i < std::array::len(xs) {
        acc = step(acc, std::array::get(xs, i));
        i = i + 1;
    }
    acc
}

/// Sum the wanted category's amounts by materialising the filtered subset into a
/// growable array and folding it with the **generic** `fold` (ADR-0008 Tier 1),
/// passing this module's `add` as a function value — no hand-written loop. This
/// must equal `total_for` (the streaming fold) for every category — the oracle
/// that pins the growable, higher-order path against the fixed one.
fn sum_collected(take wanted: Int) -> Int {
    let items = collect_amounts(wanted);
    fold(items, 0, add)
}

// --- The record-struct oracle (ADR-0012) -----------------------------------

/// A decoded record — the struct the packed integer has stood in for all
/// along, now expressible as an array element (ADR-0012's widened element
/// set), carrying the owned `label` a genuinely parsed record would: two
/// scalar fields plus a heap-backed `String`, so an `Array[Record]` exercises
/// the owned-element deep-copy `get` and recursive drop for real.
struct Record {
    category: Int,
    amount: Int,
    label: String,
}

/// The human-readable name of a category tag, as a fresh owned `String` — the
/// `String` *producer* half of the ADR-0010 composition (`label_is` below is
/// the `Str`-consumer half).
fn label_for(take c: Int) -> String {
    if c == 1 {
        std::string::from_str("groceries")
    } else if c == 2 {
        std::string::from_str("transport")
    } else if c == 3 {
        std::string::from_str("utilities")
    } else {
        std::string::from_str("other")
    }
}

/// Decode a packed integer into a full `Record` — the same field arithmetic as
/// `category`/`amount`, materialised as a struct with its owned label.
fn decode(take packed: Int) -> Record {
    Record { category: category(packed), amount: amount(packed), label: label_for(category(packed)) }
}

/// Decode the whole batch into a growable `Array[Record]` — parsed records
/// held as structs, the shape ADR-0012 names as this example's oracle.
fn decode_records() -> Array[Record] {
    var out = std::array::empty();
    for packed in records() {
        std::array::push(out, decode(packed));
    }
    out
}

/// Filter+collect at the record level: the records of the wanted category, as
/// a data-dependent-length `Array[Record]` — `collect_amounts` lifted from the
/// decoded field to the decoded struct.
fn collect_records(take wanted: Int) -> Array[Record] {
    var out = std::array::empty();
    for packed in records() {
        if category(packed) == wanted {
            std::array::push(out, decode(packed));
        }
    }
    out
}

/// The generic left fold over an `Array[Record]` and a function-value step —
/// the **struct instantiation** of the ADR-0008 combinator shape (the `String`
/// instantiations live in `std::collections`; this is the concrete-struct
/// sibling ADR-0012 names). Because `Record` owns heap, the step *borrows*
/// each element (`in Record`); each visited element is a fresh deep copy from
/// `std::array::get`, dropped at the end of its iteration through the
/// recursive per-element glue.
fn fold_records(in xs: Array[Record], take init: Int, take step: fn(take Int, in Record) -> Int) -> Int {
    var acc = init;
    var i = 0;
    while i < std::array::len(xs) {
        let r = std::array::get(xs, i);
        acc = step(acc, r);
        i = i + 1;
    }
    acc
}

/// Add a record's amount to the accumulator. Passed by name to `fold_records`
/// as a first-class function value.
fn add_amount(take acc: Int, in r: Record) -> Int {
    acc + r.amount
}

/// Sum the wanted category through the record path: collect the matching
/// records as structs, then fold their `amount` field with `add_amount` as a
/// function value. The specs pin this equal to `total_for` (the streaming
/// packed-`Int` fold) and `sum_collected` (the packed-`Int` collect path) for
/// every category — the ADR-0012 oracle.
fn sum_records(take wanted: Int) -> Int {
    let rs = collect_records(wanted);
    fold_records(rs, 0, add_amount)
}

/// Does the record's owned label read as `want`? The `Str`-consumer half of
/// the ADR-0010 composition: the owned `String` field is viewed zero-copy
/// through `as_str` and compared against a borrowed literal.
fn label_is(in r: Record, in want: Str) -> Bool {
    std::string::as_str(r.label) == want
}

/// The record label's length in bytes, read by composing the `String` producer
/// into a `Str` consumer (`std::str::len` over the `as_str` view).
fn label_len(in r: Record) -> Int {
    std::str::len(std::string::as_str(r.label))
}

// --- The keyed-aggregation oracle (ADR-0011) --------------------------------

/// Total **every** category's spend in ONE scan of the batch, keyed by
/// category in a real `Map[Int, Int]` — the dictionary shape this pipeline
/// always wanted and previously faked by re-scanning the whole batch per
/// category (`total_for` runs one pass per query; this runs one pass, full
/// stop). Each record folds into its category's running total via
/// `get`-then-`insert`.
fn totals_by_category() -> Map[Int, Int] {
    var totals = std::map::empty();
    for packed in records() {
        let c = category(packed);
        let so_far = match std::map::get(totals, c) {
            Some { value } => value,
            None => 0,
        };
        let _ = std::map::insert(totals, c, so_far + amount(packed));
    }
    totals
}

/// One category's total, read out of the single-scan map — the ADR-0011
/// oracle: the specs pin this equal to the streaming `total_for` and the
/// record-struct path for every category, so the O(1)-lookup shape is proven
/// against its linear-scan predecessors.
fn total_from_map(take wanted: Int) -> Int {
    let totals = totals_by_category();
    match std::map::get(totals, wanted) {
        Some { value } => value,
        None => 0,
    }
}

/// The query the program answers: total transport (category 2) spend. Computed
/// through the record-struct path (`sum_records`, ADR-0012's oracle) **and**
/// cross-checked at runtime against the keyed-aggregation map
/// (`total_from_map`, ADR-0011's oracle): the exit byte stays 144 (400 & 0xff)
/// only when the two independently-shaped paths agree natively — so `run`
/// exercises the owned-element array, the recursive drop glue, a native
/// indirect call, the ADR-0010 view composition, and the native hash table in
/// one binary.
fn main() -> Int {
    let record_total = sum_records(2);
    let map_total = total_from_map(2);
    if record_total == map_total {
        record_total
    } else {
        0
    }
}

// --- Executable specs ------------------------------------------------------

spec "field decoding splits category from amount" {
    then category(200120) == 2;
    then amount(200120) == 120;
    then category(100150) == 1;
    then amount(100150) == 150;
}

spec "the filter predicate selects a category" {
    then matches(records()[3], 2);
    then matches(records()[0], 1);
}

spec "the pipeline totals a category" {
    // transport (category 2): 80 + 120 + 200 = 400
    then total_for(2) == 400;
    // groceries (category 1): 150 + 75 = 225
    then total_for(1) == 225;
    // utilities (category 3): 500 + 60 = 560
    then total_for(3) == 560;
    // a category with no records totals zero
    then total_for(9) == 0;
}

spec "the pipeline counts a category" {
    then count_for(2) == 3;
    then count_for(1) == 2;
    then count_for(9) == 0;
}

spec "averages floor and guard the empty category" {
    then average_for(2) == 133;
    then average_for(9) == 0;
}

spec "the growable-collection path equals the streaming fold (ADR-0009 + ADR-0008 oracle)" {
    // The materialised-subset sum — now computed by the generic
    // `std::collections::fold` over the `add` function value (ADR-0008 Tier 1) —
    // agrees with the streaming fold for every category, so both the growable
    // Array[Int] path and the higher-order fold are correct.
    then sum_collected(2) == total_for(2);
    then sum_collected(1) == total_for(1);
    then sum_collected(3) == total_for(3);
    then sum_collected(9) == total_for(9);
    // Concrete totals, so the oracle is not merely self-consistent.
    then sum_collected(2) == 400;
    then sum_collected(1) == 225;
    then sum_collected(9) == 0;
}

spec "the generic higher-order fold sums through a function value (ADR-0008)" {
    // `fold` with `add` passed as a first-class function value reproduces the
    // hand-written sum exactly — the ADR-0008 oracle.
    then fold(collect_amounts(2), 0, add) == 400;
    then fold(collect_amounts(2), 0, add) == total_for(2);
    then fold(collect_amounts(1), 0, add) == total_for(1);
    then fold(collect_amounts(9), 0, add) == 0;
    then add(10, 5) == 15;
}

spec "the collected subset has the data-dependent size a fixed array cannot" {
    // The subset length is discovered by scanning, not fixed at compile time.
    then collected_count(2) == 3;
    then collected_count(1) == 2;
    then collected_count(9) == 0;
    then collected_count(2) == count_for(2);
}

spec "records decode into structs with owned labels (ADR-0012)" {
    let rs = decode_records();
    then std::array::len(rs) == 8;
    // Each `get` is a deep copy of the stored record; its scalar fields carry
    // the decoded values and its owned label reads back through the ADR-0010
    // view (the String producer composed into a Str consumer).
    let head = std::array::get(rs, 0);
    then head.category == 1;
    then head.amount == 150;
    then label_is(head, "groceries");
    let next = std::array::get(rs, 1);
    then next.category == 2;
    then label_is(next, "transport");
    then label_len(next) == 9;
    let last = std::array::get(rs, 7);
    then label_is(last, "utilities");
}

spec "the record-struct path equals the packed-Int pipeline (ADR-0012 oracle)" {
    // Parsed records held in an `Array[Record]`, filtered and folded through
    // the struct instantiation of the generic fold, agree with the streaming
    // packed-`Int` fold *and* the packed-`Int` collect path for every
    // category — the oracle ADR-0012 names for this example.
    then sum_records(2) == total_for(2);
    then sum_records(1) == total_for(1);
    then sum_records(3) == total_for(3);
    then sum_records(9) == total_for(9);
    then sum_records(2) == sum_collected(2);
    // Concrete totals, so the oracle is not merely self-consistent.
    then sum_records(2) == 400;
    then sum_records(1) == 225;
    then sum_records(9) == 0;
    // The record-level subset has the same data-dependent size.
    then std::array::len(collect_records(2)) == count_for(2);
    then std::array::len(collect_records(9)) == 0;
}

spec "the keyed-aggregation map equals the streaming fold (ADR-0011 oracle)" {
    // One scan into a Map[Int, Int] agrees with the per-category re-scans
    // and with the record-struct path, for every category — the map oracle.
    then total_from_map(2) == total_for(2);
    then total_from_map(1) == total_for(1);
    then total_from_map(3) == total_for(3);
    then total_from_map(4) == total_for(4);
    then total_from_map(2) == sum_records(2);
    then total_from_map(9) == 0;
    // Concrete totals, so the oracle is not merely self-consistent.
    then total_from_map(2) == 400;
    then total_from_map(3) == 560;
    // The map holds exactly the four categories present, keyed in
    // first-seen order (the deterministic `keys` contract).
    let totals = totals_by_category();
    then std::map::len(totals) == 4;
    let ks = std::map::keys(totals);
    then std::array::get(ks, 0) == 1;
    then std::array::get(ks, 1) == 2;
    then std::array::get(ks, 2) == 3;
    then std::array::get(ks, 3) == 4;
}

spec main {
    then main() == 400;
}
