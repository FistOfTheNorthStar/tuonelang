module http_service;

// http-service — an HTTP service, dogfooded against the limits of v0.
//
// Prompt 39 asks for "an HTTP service WHEN networking support exists."
// Networking support now exists: ADR-0006 landed the borrowed `Str` core and
// the descriptor seam, and ADR-0014 landed the socket effects
// (`listen`/`bound_port`/`accept`/`connect`), so the old `CONTRACT serve` is
// gone — this example now serves a request over a real TCP connection. Two
// tiers remain, exactly like `tuo-stdlib`'s:
//
//   * an EXECUTABLE TIER — the pure request-line parsing (`parse_request_line`,
//     over `std::str` byte scans and slice comparisons) and the routing/status
//     logic, the real decision core of any HTTP server. It checks with
//     `tuo check` and runs its specs with `tuo test`; and
//
//   * an EFFECT TIER — the socket shell: `read_request_line` (bytes off a
//     connection), `serve_once` (read → parse → route → respond → close, the
//     whole request lifecycle over one accepted connection), `live_status`
//     (the loopback self-request that proves the wire path), and
//     `write_response` (stdout). Effectful, so no specs (`R0007`); pinned by
//     the dogfood test (`crates/tuo-cli/tests/dogfood_examples.rs`).
//
// Since ADR-0017 every wait in the effect tier is **bounded**: the connect,
// the accept, and each byte read carry a timeout (`io_timeout_ms`), so a peer
// that goes away is a value the program branches on instead of a wait it
// never leaves. Before that this example was a potential CI hang — three
// blocking calls with no recourse — which is the gap that motivated the ADR.
// A timeout is deliberately NOT folded into "end of input": collapsing them
// would let a truncated request route as if the peer had sent it, which is
// exactly the confusion ADR-0017's distinct `-3` sentinel exists to prevent.
//
// `main` is the acceptance oracle: it routes "GET /health HTTP/1.1" through
// the pure core AND serves the identical request to itself over a live
// loopback socket (listen ephemeral → connect → accept → serve_once → the
// client reads the status line back), printing the response line and exiting
// with the status only when the wire agrees with the model. Documented exit
// byte: route(GET, /health) = 200, so the process exits 200.
//
// Encoding, so the routing core has concrete values to route on:
//
//   method: 1 = GET, 2 = POST, 3 = PUT, 4 = DELETE   (0 = unknown)
//   path:   1 = /            2 = /health
//           3 = /users       4 = /users/{id}          (0 = unmatched)
//
// A route decision is `(method, path) -> status`, the heart of a web service.

// --- Method and path tags --------------------------------------------------

fn method_get() -> Int {
    1
}
fn method_post() -> Int {
    2
}

fn path_root() -> Int {
    1
}
fn path_health() -> Int {
    2
}
fn path_users() -> Int {
    3
}
fn path_user_id() -> Int {
    4
}

// --- HTTP status codes (the executable routing core) -----------------------

fn status_ok() -> Int {
    200
}
fn status_created() -> Int {
    201
}
fn status_not_found() -> Int {
    404
}
fn status_method_not_allowed() -> Int {
    405
}

/// Does this path exist at all, regardless of method?
fn path_exists(take path: Int) -> Bool {
    path == path_root() || path == path_health() || path == path_users() || path == path_user_id()
}

/// Is `method` allowed on `path`? GET is allowed everywhere; POST only creates
/// under /users. This is the per-route method policy a real router encodes.
fn method_allowed(take method: Int, take path: Int) -> Bool {
    if method == method_get() {
        path_exists(path)
    } else {
        // POST is only allowed to create a user.
        method == method_post() && path == path_users()
    }
}

/// The core routing decision: map a (method, path) request to a status code.
/// Precedence matches a conforming server: unknown path -> 404 before any
/// method check; known path with a disallowed method -> 405; a POST that
/// creates -> 201; everything else allowed -> 200.
fn route(take method: Int, take path: Int) -> Int {
    if !path_exists(path) {
        status_not_found()
    } else {
        if !method_allowed(method, path) {
            status_method_not_allowed()
        } else {
            if method == method_post() {
                status_created()
            } else {
                status_ok()
            }
        }
    }
}

/// A tiny synthetic request log the pure core can "handle" end to end: four
/// requests, summed into a single figure. The value is `sum of statuses -
/// 1000` — proof the routing core executed.
fn handle_sample_traffic() -> Int {
    let a = route(method_get(), path_root()); // 200
    let b = route(method_get(), path_health()); // 200
    let c = route(method_post(), path_users()); // 201
    let d = route(method_delete_unknown(), path_users()); // 405
    (a + b + c + d) - 1000
}

/// An unmodelled method tag (DELETE), used to exercise the 405 path.
fn method_delete_unknown() -> Int {
    4
}

// --- Request-line parsing (pure, over the borrowed Str core) ---------------
//
// ADR-0006's acceptance oracle: "GET /health HTTP/1.1" decodes into the
// integer form `route` consumes, with byte scans and slice comparisons over
// the borrowed `Str` — no heap, no effect, fully spec-checked.

/// One parsed request line: the integer method/path tags the router consumes,
/// plus whether the version token is exactly "HTTP/1.1".
struct Request {
    method: Int,
    path: Int,
    version_ok: Bool,
}

/// The index of the first space (byte 32) at or after `from`, or -1 if none.
fn find_space(in line: Str, take from: Int) -> Int {
    if from >= std::str::len(line) {
        0 - 1
    } else if std::str::byte_at(line, from) == 32 {
        from
    } else {
        find_space(line, from + 1)
    }
}

/// Does `s` start with `prefix` (byte-wise)?
fn starts_with(in s: Str, in prefix: Str) -> Bool {
    let n = std::str::len(prefix);
    if std::str::len(s) < n {
        false
    } else {
        std::str::slice(s, 0, n) == prefix
    }
}

/// Decode a method token into the router's method tag (0 = unknown).
fn method_tag(in token: Str) -> Int {
    if token == "GET" {
        method_get()
    } else if token == "POST" {
        method_post()
    } else if token == "DELETE" {
        method_delete_unknown()
    } else {
        0
    }
}

/// Decode a path token into the router's path tag (0 = unmatched). A path
/// under `/users/` with at least one id byte is the `{id}` route.
fn path_tag(in token: Str) -> Int {
    if token == "/" {
        path_root()
    } else if token == "/health" {
        path_health()
    } else if token == "/users" {
        path_users()
    } else if starts_with(token, "/users/") && std::str::len(token) > 7 {
        path_user_id()
    } else {
        0
    }
}

/// Parse a raw request line ("GET /health HTTP/1.1") into a typed `Request`.
/// A malformed line (fewer than three space-separated tokens) parses to the
/// unknown request (`method` 0, `path` 0), which `route` answers with 404/405
/// — a real server's behavior for garbage.
fn parse_request_line(in line: Str) -> Request {
    let first = find_space(line, 0);
    if first < 0 {
        Request { method: 0, path: 0, version_ok: false }
    } else {
        let second = find_space(line, first + 1);
        if second < 0 {
            Request { method: method_tag(std::str::slice(line, 0, first)), path: 0, version_ok: false }
        } else {
            Request { method: method_tag(std::str::slice(line, 0, first)), path: path_tag(std::str::slice(line, first + 1, second)), version_ok: std::str::slice(line, second + 1, std::str::len(line)) == "HTTP/1.1" }
        }
    }
}

// --- The response shell (EFFECT tier) --------------------------------------

/// The status line for a routed status code — selected from static text,
/// because v0 has no owned String to format into (that is the allocator
/// ADR's ground). Pure, so it is spec-checked.
fn response_line(take status: Int) -> Str {
    if status == status_ok() {
        "HTTP/1.1 200 OK"
    } else if status == status_created() {
        "HTTP/1.1 201 Created"
    } else if status == status_not_found() {
        "HTTP/1.1 404 Not Found"
    } else {
        "HTTP/1.1 405 Method Not Allowed"
    }
}

/// EFFECT: write the response status line and a newline to stdout via the
/// `std::rt::write` effect primitive — the thin effectful shell over the pure
/// core. Returns the bytes written. Effectful, so no spec (`R0007`); pinned
/// natively by `crates/tuo-cli/tests/dogfood_examples.rs`, which asserts the
/// exact bytes `main` prints.
fn write_response(take status: Int) -> Int {
    let line = std::rt::write(1, response_line(status));
    let newline = std::rt::write(1, "\n");
    line + newline
}

// --- The socket shell (EFFECT tier, ADR-0014) -------------------------------

/// The bounded wait every socket operation in this example uses, in
/// milliseconds (ADR-0017). Generous enough that a healthy loopback
/// round-trip never reaches it, short enough that a peer which goes away
/// fails the run instead of wedging it forever.
fn io_timeout_ms() -> Int {
    5000
}

/// EFFECT: read one line (bytes up to CR, LF, or end of input, exclusive)
/// from a connection into an owned `String` — the request-line reader,
/// accumulating exactly as `std::io::read_line` does, but with each byte
/// **bounded** by `read_byte_timeout` (ADR-0017) rather than blocking
/// forever on a silent peer.
///
/// `read_ok` reports whether the line terminated for a legitimate reason (a
/// CR/LF delimiter or end of input) rather than a timeout or host error.
/// The distinction matters: a timeout that quietly returned the bytes read
/// so far would look exactly like a short-but-complete request line, so the
/// caller would route a truncated request as if the peer had sent it. That
/// is precisely the confusion ADR-0017's distinct `-3` sentinel exists to
/// prevent, so this reader propagates it instead of collapsing it.
///
/// Effectful, so no spec (`R0007`); pinned natively by the dogfood test
/// through `main`'s live round-trip.
fn read_line_from(take conn: Int, mut read_ok: Bool) -> String {
    var line = std::string::empty();
    var done = false;
    read_ok = true;
    while !done {
        let b = std::rt::read_byte_timeout(conn, io_timeout_ms());
        if b == 13 {
            // A CR: consume the LF of the CRLF pair too. Leaving it unread
            // matters — a peer that closes while bytes are still queued in
            // its receive buffer makes TCP send RST, which discards data the
            // peer had already written, so the *other* side's read fails with
            // a host error instead of seeing the response. Draining the
            // delimiter keeps the close orderly.
            let lf = std::rt::read_byte_timeout(conn, io_timeout_ms());
            if lf < 0 && lf != 0 - 1 {
                read_ok = false;
            }
            done = true;
        } else {
            if b == 10 || b == 0 - 1 {
                // A bare LF, or a clean end of input: the line is complete.
                done = true;
            } else {
                if b < 0 {
                    // -3 (timeout) or -2 (host error): the peer never finished.
                    read_ok = false;
                    done = true;
                } else {
                    std::string::push_byte(line, b);
                }
            }
        }
    }
    line
}

/// EFFECT: serve exactly one request on an accepted connection — the whole
/// lifecycle the old `CONTRACT serve` promised, now real: read the request
/// line off the socket (bounded, per ADR-0017), parse it with the pure core,
/// route it, write the response status line back over the wire, and close
/// the connection.
///
/// Returns the routed status, or `-1` when the request line never arrived
/// within the bound. A peer that opens a connection and then goes silent is
/// now a value this function returns rather than a wait it never leaves; the
/// connection is closed on that path too, so a timed-out peer leaks nothing.
///
/// Effectful, so no spec (`R0007`); pinned natively by the dogfood test
/// through `main`'s live round-trip.
fn serve_once(take conn: Int) -> Int {
    var read_ok = false;
    let line = read_line_from(conn, read_ok);
    if !read_ok {
        std::rt::close(conn);
        return 0 - 1;
    }
    let request = parse_request_line(std::string::as_str(line));
    let status = route(request.method, request.path);
    std::rt::write(conn, response_line(status));
    std::rt::write(conn, "\n");
    std::rt::close(conn);
    status
}

/// EFFECT: the live loopback round-trip — the ADR-0014 acceptance oracle,
/// bounded end to end by ADR-0017.
///
/// Listen on an ephemeral port, connect to it (TCP's backlog completes the
/// handshake before accept), accept, send the canonical request line from
/// the client, `serve_once` it on the server side, and read the status line
/// back off the client socket. Returns the served status (200) only when
/// the bytes on the wire equal the pure model's response line; any
/// divergence, timeout, or socket failure returns -1.
///
/// Every wait here is bounded: `connect_timeout` and `accept_timeout` cannot
/// hang on a handshake that never completes, and both reads go through
/// `read_line_from`'s bounded byte loop. Before ADR-0017 this function was a
/// potential CI hang with no recourse — three blocking calls, any of which
/// could wait forever if the peer or the kernel never answered. The
/// descriptors are closed on the failure paths too, so a bounded failure
/// does not leak a socket.
///
/// Effectful, so no spec (`R0007`).
fn live_status() -> Int {
    let listener = std::rt::listen(0);
    if listener < 0 {
        return 0 - 1;
    }
    let port = std::rt::bound_port(listener);
    if port <= 0 {
        std::rt::close(listener);
        return 0 - 1;
    }
    let client = std::rt::connect_timeout("127.0.0.1", port, io_timeout_ms());
    if client < 0 {
        std::rt::close(listener);
        return 0 - 1;
    }
    let conn = std::rt::accept_timeout(listener, io_timeout_ms());
    if conn < 0 {
        std::rt::close(client);
        std::rt::close(listener);
        return 0 - 1;
    }
    std::rt::write(client, "GET /health HTTP/1.1\r\n");
    let served = serve_once(conn);
    var reply_ok = false;
    let reply = read_line_from(client, reply_ok);
    std::rt::close(client);
    std::rt::close(listener);
    if served == 200 && reply_ok && std::string::as_str(reply) == "HTTP/1.1 200 OK" {
        200
    } else {
        0 - 1
    }
}

/// The demo and the oracle in one: parse the fixed request line through the
/// pure core, serve the identical request to itself over a live loopback
/// socket, and — only when the wire's answer agrees with the model's — print
/// the response status line and exit with the status. route(GET, /health) =
/// 200, so the documented exit byte is 200 and stdout is
/// "HTTP/1.1 200 OK\n"; a disagreement exits 0 with no output, which the
/// dogfood test reports loudly.
fn main() -> Int {
    let request = parse_request_line("GET /health HTTP/1.1");
    let status = route(request.method, request.path);
    if live_status() != status {
        return 0;
    }
    write_response(status);
    status
}

// --- Executable specs for the pure core ------------------------------------

spec "known paths exist and unknown ones do not" {
    then path_exists(path_root());
    then path_exists(path_user_id());
    then !path_exists(0);
    then !path_exists(99);
}

spec "method policy per route" {
    then method_allowed(method_get(), path_health());
    then method_allowed(method_post(), path_users());
    then !method_allowed(method_post(), path_health());
    then !method_allowed(method_get(), 0);
}

spec route {
    // happy paths
    then route(method_get(), path_root()) == 200;
    then route(method_get(), path_health()) == 200;
    then route(method_post(), path_users()) == 201;
    // unknown path is 404 even for a valid method
    then route(method_get(), 0) == 404;
    then route(method_get(), 99) == 404;
    // known path, disallowed method is 405
    then route(method_post(), path_health()) == 405;
    then route(method_delete_unknown(), path_users()) == 405;
}

spec "404 precedes 405: an unknown path never reports a method error" {
    // POST to an unknown path is 404 (path checked first), not 405.
    then route(method_post(), 0) == 404;
}

spec find_space {
    then find_space("GET /", 0) == 3;
    then find_space("GET /", 4) == 0 - 1;
    then find_space("a b c", 2) == 3;
    then find_space("nospace", 0) == 0 - 1;
}

spec starts_with {
    then starts_with("/users/42", "/users/");
    then !starts_with("/user", "/users/");
    then !starts_with("/health", "/users/");
    then starts_with("anything", "");
}

spec method_tag {
    then method_tag("GET") == 1;
    then method_tag("POST") == 2;
    then method_tag("DELETE") == 4;
    then method_tag("BREW") == 0;
}

spec path_tag {
    then path_tag("/") == 1;
    then path_tag("/health") == 2;
    then path_tag("/users") == 3;
    then path_tag("/users/42") == 4;
    then path_tag("/users/") == 0;
    then path_tag("/missing") == 0;
}

spec parse_request_line {
    then parse_request_line("GET /health HTTP/1.1").method == 1;
    then parse_request_line("GET /health HTTP/1.1").path == 2;
    then parse_request_line("GET /health HTTP/1.1").version_ok;
    then parse_request_line("POST /users HTTP/1.0").method == 2;
    then parse_request_line("POST /users HTTP/1.0").path == 3;
    then !parse_request_line("POST /users HTTP/1.0").version_ok;
    then parse_request_line("GET /users/42 HTTP/1.1").path == 4;
    then parse_request_line("garbage").method == 0;
    then parse_request_line("garbage").path == 0;
}

spec "a parsed request routes end to end" {
    // The full pure pipeline: raw line -> Request -> status.
    then route(parse_request_line("GET /health HTTP/1.1").method, parse_request_line("GET /health HTTP/1.1").path) == 200;
    then route(parse_request_line("POST /users HTTP/1.1").method, parse_request_line("POST /users HTTP/1.1").path) == 201;
    then route(parse_request_line("GET /missing HTTP/1.1").method, parse_request_line("GET /missing HTTP/1.1").path) == 404;
}

spec response_line {
    then response_line(200) == "HTTP/1.1 200 OK";
    then response_line(201) == "HTTP/1.1 201 Created";
    then response_line(404) == "HTTP/1.1 404 Not Found";
    then response_line(405) == "HTTP/1.1 405 Method Not Allowed";
}

spec handle_sample_traffic {
    // 200 + 200 + 201 + 405 = 1006; 1006 - 1000 = 6
    then handle_sample_traffic() == 6;
}
