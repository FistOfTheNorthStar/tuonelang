module concurrent_worker;

// concurrent-worker — a concurrent worker pool, dogfooded first against the
// limits of v0 and now against ADR-0007's structured concurrency.
//
//   * the EXECUTABLE TIER — the deterministic scheduling model: round-robin
//     assignment, per-worker load, the makespan (finish time of the slowest
//     worker), and speedup versus a single worker. Runnable scalar core,
//     spec-checked; and
//
//   * the LIVE POOL (since ADR-0007): `std::rt::par_map` runs the model's own
//     `worker_load` **as the task function, one OS thread per worker** —
//     round-robin is both what the model predicts and what the primitive
//     implements, so the model IS the pool's scheduling oracle. `main`
//     computes the makespan twice — once through the pure model, once by
//     folding the live pool's per-worker results — and exits with the model's
//     answer only when the live run agrees (the ADR's "the deterministic
//     scheduling model is the oracle" constraint, executed literally). The
//     spec sandbox stays pure (spawning is an effect, `R0007`), so the live
//     path is pinned by the native dogfood test, not a spec.
//
// What still cannot run — a *shared* work queue with dynamic stealing, or any
// shared mutable state across workers — remains a documented CONTRACT below,
// blocked on an ADR admitting shared state across threads.
//
// The task batch: eight tasks whose costs (in abstract time units) are the
// accessors `cost0`..`cost7`. Workers pull them round-robin: worker w handles
// task i whenever `i % worker_count == w`.

fn worker_count() -> Int {
    3
}
fn task_count() -> Int {
    8
}

// Per-task costs — a real scheduler's input. Uneven on purpose, so balance and
// makespan are non-trivial.
fn cost0() -> Int {
    5
}
fn cost1() -> Int {
    2
}
fn cost2() -> Int {
    8
}
fn cost3() -> Int {
    3
}
fn cost4() -> Int {
    6
}
fn cost5() -> Int {
    1
}
fn cost6() -> Int {
    4
}
fn cost7() -> Int {
    7
}

/// The cost of task `i` (0-based). A single point where the batch is defined.
fn cost_of(take i: Int) -> Int {
    if i == 0 {
        cost0()
    } else {
        if i == 1 {
            cost1()
        } else {
            if i == 2 {
                cost2()
            } else {
                if i == 3 {
                    cost3()
                } else {
                    if i == 4 {
                        cost4()
                    } else {
                        if i == 5 {
                            cost5()
                        } else {
                            if i == 6 {
                                cost6()
                            } else {
                                if i == 7 {
                                    cost7()
                                } else {
                                    0
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

/// Round-robin owner of task `i`: worker `i % worker_count`.
fn owner_of(take i: Int) -> Int {
    i - (i / worker_count()) * worker_count()
}

/// The total cost assigned to `worker`, by summing the costs of the tasks it
/// owns under round-robin. Recurses over task indices with an accumulator.
fn load_from(take worker: Int, take i: Int, take acc: Int) -> Int {
    if i >= task_count() {
        acc
    } else {
        let next = if owner_of(i) == worker {
            acc + cost_of(i)
        } else {
            acc
        };
        load_from(worker, i + 1, next)
    }
}

fn worker_load(take worker: Int) -> Int {
    load_from(worker, 0, 0)
}

/// The makespan: the finish time of the slowest worker, i.e. how long the whole
/// batch takes when the workers run in parallel. The headline latency figure.
fn makespan_from(take worker: Int, take best: Int) -> Int {
    if worker >= worker_count() {
        best
    } else {
        let load = worker_load(worker);
        let next = if load > best {
            load
        } else {
            best
        };
        makespan_from(worker + 1, next)
    }
}

fn makespan() -> Int {
    makespan_from(0, 0)
}

/// Total serial cost: the time a single worker would take (the sum of all task
/// costs). The baseline the pool is measured against.
fn serial_from(take i: Int, take acc: Int) -> Int {
    if i >= task_count() {
        acc
    } else {
        serial_from(i + 1, acc + cost_of(i))
    }
}

fn serial_cost() -> Int {
    serial_from(0, 0)
}

/// Integer speedup (floored): serial time divided by makespan. A perfectly
/// balanced pool of N workers approaches N; imbalance lowers it.
fn speedup() -> Int {
    let m = makespan();
    if m == 0 {
        0
    } else {
        serial_cost() / m
    }
}

/// The imbalance: slowest worker's load minus the ideal even share (floored).
/// Zero would be a perfectly balanced partition.
fn imbalance() -> Int {
    makespan() - serial_cost() / worker_count()
}

// --- The live pool (ADR-0007) -----------------------------------------------

/// Every worker id, `0..worker_count`, as the live pool's task list.
fn worker_ids() -> Array[Int] {
    var ids = std::array::empty();
    var w = 0;
    while w < worker_count() {
        std::array::push(ids, w);
        w = w + 1;
    }
    ids
}

/// The live pool's makespan: run `worker_load` for every worker id through
/// `std::rt::par_map` — one OS thread per worker, each computing its own
/// round-robin partition's total, joined before the fold — and take the max.
/// EFFECTFUL (spawning is a typed effect), so no spec reaches it; the native
/// dogfood test pins it against the model.
fn live_makespan() -> Int {
    let loads = std::rt::par_map(worker_load, worker_ids(), worker_count());
    var best = 0;
    var i = 0;
    while i < std::array::len(loads) {
        let load = std::array::get(loads, i);
        if load > best {
            best = load;
        }
        i = i + 1;
    }
    best
}

/// Exit with the model's makespan **only if the live parallel run agrees** —
/// the scheduling model acting as the pool's correctness oracle, at runtime.
fn main() -> Int {
    let predicted = makespan();
    let live = live_makespan();
    if predicted == live {
        predicted
    } else {
        0
    }
}

// --- CONTRACT TIER: what structured fork-join deliberately does not admit ---
//
// ADR-0007's primitive is structured: workers share nothing mutable and
// nothing outlives the call. A pool with a *shared, dynamically-drained* work
// queue needs shared mutable state across threads, which stays out of v0 by
// design. Given as contracts only, blocked on a future ADR admitting shared
// state (the Shared/atomics story):
//
// CONTRACT submit(pool: Pool, task: Task) -> Unit
//   Enqueue a task onto a shared queue workers drain dynamically. BLOCKED ON:
//   a synchronized channel/queue type — dynamic stealing changes *which*
//   worker runs a task (the round-robin model pins it statically).
//
// CONTRACT join_detached(pool: Pool) -> Results
//   Wait on workers that outlive the spawning call. BLOCKED ON: detached
//   spawn — deliberately absent; ADR-0007 chose structured fork-join so
//   nothing can dangle.

// --- Executable specs for the scheduling model -----------------------------

spec cost_of {
    then cost_of(0) == 5;
    then cost_of(7) == 7;
    then cost_of(8) == 0;
}

spec owner_of {
    // round-robin over 3 workers
    then owner_of(0) == 0;
    then owner_of(1) == 1;
    then owner_of(2) == 2;
    then owner_of(3) == 0;
    then owner_of(7) == 1;
}

spec "per-worker load partitions the batch" {
    // worker 0 owns tasks 0,3,6 -> 5+3+4 = 12
    then worker_load(0) == 12;
    // worker 1 owns tasks 1,4,7 -> 2+6+7 = 15
    then worker_load(1) == 15;
    // worker 2 owns tasks 2,5   -> 8+1   = 9
    then worker_load(2) == 9;
}

spec "loads sum to the serial cost (no task lost or double-counted)" {
    then worker_load(0) + worker_load(1) + worker_load(2) == serial_cost();
    then serial_cost() == 36;
}

spec makespan {
    // slowest worker is worker 1 at 15
    then makespan() == 15;
}

spec speedup {
    // 36 / 15 = 2 (floored) with 3 workers: imbalance costs us the 3rd.
    then speedup() == 2;
}

spec imbalance {
    // makespan 15 minus even share 36/3 = 12 -> 3 units of imbalance.
    then imbalance() == 3;
}

// `main` is effectful since the live pool landed (spawning is a typed
// effect), so no spec reaches it — exactly like http-service's printing
// `main`. Its exit byte (15, the model's makespan, surviving the live
// cross-check) is pinned by the native dogfood test instead.
