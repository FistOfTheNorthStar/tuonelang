// std::crypto — cryptographic hashing and the primitives built on it.
//
// Almost all of this module is executable: pure computation over `Int`, `Str`,
// `String`, and `Array[Int]`, running through the reference interpreter with a
// spec below proving each function. It exists because ADR-0019 Stage A gave the
// language the bitwise operators these algorithms are *defined* in terms of —
// SHA-256 is rotations, xors, and shifts, and cannot be written without them at
// all.
//
// The two exceptions are `random_byte` and `nonce`, which are the **effect
// tier**: drawing entropy is an effect by nature — two calls must NOT agree —
// so they carry no spec (`R0007` keeps effects out of the deterministic
// sandbox, which is the correct answer rather than a limitation) and are
// marked `EFFECT:` and pinned by a native CLI test instead.
//
// CORRECTNESS IS EXTERNALLY DEFINED, which is unusual here and is the point.
// Every function below has published test vectors (FIPS 180-4 for SHA-256,
// RFC 2104/4231 for HMAC, RFC 6070 for PBKDF2, RFC 4648 for Base64), and the
// specs assert those vectors rather than this module's own reasoning. A spec
// that reproduces a published vector cannot be self-consistently wrong, which
// is a stronger guarantee than the rest of the standard library can offer.
//
// Design rules (shared across the whole standard library):
//   * One obvious way to do each fundamental thing — no competing APIs.
//   * Free functions only. Method syntax (`x.sha256()`) is not lowered in v0.
//   * Every public function carries its exact signature, a doc comment, at
//     least one worked example, and an executable spec.
//
// BYTES ARE `Array[Int]`, each element in `0 ..= 255`. v0 has no `[u8]` type,
// and `String` is UTF-8 text rather than an arbitrary byte container, so a
// digest — which is 32 arbitrary bytes, most of them not valid text — is an
// `Array[Int]`. `sha256` returns the conventional lowercase hex `String` for
// display and comparison; `sha256_bytes` returns the raw bytes for feeding
// into another primitive.
//
// WHAT THIS MODULE IS NOT. It is a hashing library, not a TLS stack and not a
// general cryptography toolkit. There is no symmetric cipher, no public-key
// operation, and no certificate handling here, and adding them is a decision
// for a future ADR rather than an incremental commit. In particular: this
// module lets a program *authenticate* (prove it knows a password) but does
// not let it *encrypt*, so a protocol built on it alone is readable by anyone
// on the wire.

module std::crypto;

// ----------------------------------------------------------------------------
// SHA-256 (FIPS 180-4).
//
// The compression function is defined over 32-bit modular arithmetic and
// rotations, which is exactly what `std::bits` provides. Nothing here uses a
// bare `+` on a hash word: `std::bits::add32` is the modular add the standard
// specifies, and plain `+` would trap on carry.
// ----------------------------------------------------------------------------

/// The 64 SHA-256 round constants (the first 32 bits of the fractional parts
/// of the cube roots of the first 64 primes), as a fresh array.
///
/// Internal to the compression loop; exposed because v0 has no module-private
/// items and no `const` arrays, not because callers want it.
///
/// # Example
/// ```tuo
/// let k = std::crypto::sha256_round_constants(); // 64 entries
/// ```
pub fn sha256_round_constants() -> Array[Int] {
    var k = std::array::empty();
    std::array::push(k, 1116352408); std::array::push(k, 1899447441);
    std::array::push(k, 3049323471); std::array::push(k, 3921009573);
    std::array::push(k, 961987163);  std::array::push(k, 1508970993);
    std::array::push(k, 2453635748); std::array::push(k, 2870763221);
    std::array::push(k, 3624381080); std::array::push(k, 310598401);
    std::array::push(k, 607225278);  std::array::push(k, 1426881987);
    std::array::push(k, 1925078388); std::array::push(k, 2162078206);
    std::array::push(k, 2614888103); std::array::push(k, 3248222580);
    std::array::push(k, 3835390401); std::array::push(k, 4022224774);
    std::array::push(k, 264347078);  std::array::push(k, 604807628);
    std::array::push(k, 770255983);  std::array::push(k, 1249150122);
    std::array::push(k, 1555081692); std::array::push(k, 1996064986);
    std::array::push(k, 2554220882); std::array::push(k, 2821834349);
    std::array::push(k, 2952996808); std::array::push(k, 3210313671);
    std::array::push(k, 3336571891); std::array::push(k, 3584528711);
    std::array::push(k, 113926993);  std::array::push(k, 338241895);
    std::array::push(k, 666307205);  std::array::push(k, 773529912);
    std::array::push(k, 1294757372); std::array::push(k, 1396182291);
    std::array::push(k, 1695183700); std::array::push(k, 1986661051);
    std::array::push(k, 2177026350); std::array::push(k, 2456956037);
    std::array::push(k, 2730485921); std::array::push(k, 2820302411);
    std::array::push(k, 3259730800); std::array::push(k, 3345764771);
    std::array::push(k, 3516065817); std::array::push(k, 3600352804);
    std::array::push(k, 4094571909); std::array::push(k, 275423344);
    std::array::push(k, 430227734);  std::array::push(k, 506948616);
    std::array::push(k, 659060556);  std::array::push(k, 883997877);
    std::array::push(k, 958139571);  std::array::push(k, 1322822218);
    std::array::push(k, 1537002063); std::array::push(k, 1747873779);
    std::array::push(k, 1955562222); std::array::push(k, 2024104815);
    std::array::push(k, 2227730452); std::array::push(k, 2361852424);
    std::array::push(k, 2428436474); std::array::push(k, 2756734187);
    std::array::push(k, 3204031479); std::array::push(k, 3329325298);
    k
}

/// The SHA-256 message bytes for `data`: its bytes, the `0x80` terminator,
/// zero padding, and the 64-bit big-endian bit length.
///
/// Padding brings the total to a multiple of 64 bytes, which is what lets the
/// compression loop read whole blocks. Split out from [`sha256_bytes`] so the
/// padding rule can be spec'd on its own.
///
/// # Example
/// ```tuo
/// let padded = std::crypto::sha256_pad("abc"); // 64 bytes
/// ```
pub fn sha256_pad(in data: Str) -> Array[Int] {
    let length = std::str::len(data);
    var message = std::array::empty();
    var i = 0;
    while i < length {
        std::array::push(message, std::str::byte_at(data, i));
        i = i + 1;
    }
    // The mandatory 1 bit, as a whole byte since the input is byte-aligned.
    std::array::push(message, 128);
    // Zero-pad until the length is 56 mod 64, leaving room for the 8-byte
    // length field that completes the final block.
    while (std::array::len(message) % 64) != 56 {
        std::array::push(message, 0);
    }
    // The message length in BITS, as a 64-bit big-endian integer. The high
    // four bytes are zero for any input this implementation can hold.
    let bits = length * 8;
    std::array::push(message, 0);
    std::array::push(message, 0);
    std::array::push(message, 0);
    std::array::push(message, 0);
    std::array::push(message, std::bits::byte_of_be32(bits, 0));
    std::array::push(message, std::bits::byte_of_be32(bits, 1));
    std::array::push(message, std::bits::byte_of_be32(bits, 2));
    std::array::push(message, std::bits::byte_of_be32(bits, 3));
    message
}

/// The SHA-256 digest of `data`, as 32 raw bytes.
///
/// The bytes are the digest itself, most of which are not valid text — use
/// [`sha256`] for a displayable form. This is the function to feed into
/// [`hmac_sha256`] or a protocol that transmits the raw digest.
///
/// # Example
/// ```tuo
/// let digest = std::crypto::sha256_bytes("abc"); // 32 bytes, first is 0xBA
/// ```
pub fn sha256_bytes(in data: Str) -> Array[Int] {
    let message = sha256_pad(data);
    let k = sha256_round_constants();

    // The initial hash values: the first 32 bits of the fractional parts of
    // the square roots of the first eight primes.
    var h0 = 1779033703;
    var h1 = 3144134277;
    var h2 = 1013904242;
    var h3 = 2773480762;
    var h4 = 1359893119;
    var h5 = 2600822924;
    var h6 = 528734635;
    var h7 = 1541459225;

    let blocks = std::array::len(message) / 64;
    var block = 0;
    while block < blocks {
        let base = block * 64;

        // The message schedule: 16 words read from the block, then 48 more
        // derived from them.
        var w = std::array::empty();
        var t = 0;
        while t < 16 {
            let at = base + (t * 4);
            std::array::push(w, std::bits::be32(
                std::array::get(message, at),
                std::array::get(message, at + 1),
                std::array::get(message, at + 2),
                std::array::get(message, at + 3)
            ));
            t = t + 1;
        }
        t = 16;
        while t < 64 {
            let w15 = std::array::get(w, t - 15);
            let w2 = std::array::get(w, t - 2);
            let s0 = std::bits::rotr32(w15, 7)
                ^ std::bits::rotr32(w15, 18)
                ^ std::bits::shr32(w15, 3);
            let s1 = std::bits::rotr32(w2, 17)
                ^ std::bits::rotr32(w2, 19)
                ^ std::bits::shr32(w2, 10);
            let next = std::bits::add32(
                std::bits::add32(std::array::get(w, t - 16), s0),
                std::bits::add32(std::array::get(w, t - 7), s1)
            );
            std::array::push(w, next);
            t = t + 1;
        }

        var a = h0;
        var b = h1;
        var c = h2;
        var d = h3;
        var e = h4;
        var f = h5;
        var g = h6;
        var h = h7;

        var round = 0;
        while round < 64 {
            let big1 = std::bits::rotr32(e, 6)
                ^ std::bits::rotr32(e, 11)
                ^ std::bits::rotr32(e, 25);
            let choose = (e & f) ^ ((~e) & g & 4294967295);
            let temp1 = std::bits::add32(
                std::bits::add32(h, big1),
                std::bits::add32(
                    std::bits::add32(choose, std::array::get(k, round)),
                    std::array::get(w, round)
                )
            );
            let big0 = std::bits::rotr32(a, 2)
                ^ std::bits::rotr32(a, 13)
                ^ std::bits::rotr32(a, 22);
            let major = (a & b) ^ (a & c) ^ (b & c);
            let temp2 = std::bits::add32(big0, major);

            h = g;
            g = f;
            f = e;
            e = std::bits::add32(d, temp1);
            d = c;
            c = b;
            b = a;
            a = std::bits::add32(temp1, temp2);
            round = round + 1;
        }

        h0 = std::bits::add32(h0, a);
        h1 = std::bits::add32(h1, b);
        h2 = std::bits::add32(h2, c);
        h3 = std::bits::add32(h3, d);
        h4 = std::bits::add32(h4, e);
        h5 = std::bits::add32(h5, f);
        h6 = std::bits::add32(h6, g);
        h7 = std::bits::add32(h7, h);
        block = block + 1;
    }

    var digest = std::array::empty();
    push_be32(digest, h0);
    push_be32(digest, h1);
    push_be32(digest, h2);
    push_be32(digest, h3);
    push_be32(digest, h4);
    push_be32(digest, h5);
    push_be32(digest, h6);
    push_be32(digest, h7);
    digest
}

/// Append `value`'s four big-endian bytes to `out`.
///
/// # Example
/// ```tuo
/// var bytes = std::array::empty();
/// std::crypto::push_be32(bytes, 258); // bytes is now [0, 0, 1, 2]
/// ```
pub fn push_be32(mut out: Array[Int], take value: Int) {
    std::array::push(out, std::bits::byte_of_be32(value, 0));
    std::array::push(out, std::bits::byte_of_be32(value, 1));
    std::array::push(out, std::bits::byte_of_be32(value, 2));
    std::array::push(out, std::bits::byte_of_be32(value, 3));
}

/// The SHA-256 digest of `data`, as 64 lowercase hexadecimal characters.
///
/// The conventional display form, and the one to compare against a digest
/// quoted in a protocol document or a test vector.
///
/// # Example
/// ```tuo
/// let hex = std::crypto::sha256("abc");
/// // "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
/// ```
pub fn sha256(in data: Str) -> String {
    to_hex(sha256_bytes(data))
}

// ----------------------------------------------------------------------------
// Hex encoding.
// ----------------------------------------------------------------------------

/// `bytes` rendered as lowercase hexadecimal, two characters per byte.
///
/// # Example
/// ```tuo
/// let hex = std::crypto::to_hex(std::crypto::bytes_of_str("abc")); // "616263"
/// ```
pub fn to_hex(in bytes: Array[Int]) -> String {
    var out = std::string::empty();
    let n = std::array::len(bytes);
    var i = 0;
    while i < n {
        let byte = std::array::get(bytes, i) & 255;
        std::string::push_byte(out, hex_digit(byte >> 4));
        std::string::push_byte(out, hex_digit(byte & 15));
        i = i + 1;
    }
    out
}

/// The ASCII byte of the lowercase hex digit for `value` (`0 ..= 15`).
///
/// A `value` outside the range yields `'0'`, since there is no digit to name.
///
/// # Example
/// ```tuo
/// let c = std::crypto::hex_digit(10); // 97, the byte for 'a'
/// ```
pub fn hex_digit(take value: Int) -> Int {
    if value < 0 || value > 15 {
        return 48;
    }
    if value < 10 {
        return 48 + value;
    }
    87 + value
}

// ----------------------------------------------------------------------------
// HMAC-SHA-256 (RFC 2104).
// ----------------------------------------------------------------------------

/// The HMAC-SHA-256 of `message` under `key`, as 32 raw bytes.
///
/// The keyed authentication code SCRAM and countless protocols are built on.
/// Per RFC 2104 a key longer than the 64-byte block is replaced by its own
/// digest, and a shorter one is zero-padded to the block length.
///
/// Takes and returns `Array[Int]` rather than `Str` because both a key and a
/// message may be arbitrary bytes (a derived key usually is), and `Str` is
/// UTF-8 text. Use [`bytes_of_str`] to hash textual input.
///
/// # Example
/// ```tuo
/// let key = std::crypto::bytes_of_str("key");
/// let msg = std::crypto::bytes_of_str("The quick brown fox jumps over the lazy dog");
/// let mac = std::crypto::hmac_sha256(key, msg); // 32 bytes, first is 0xF7
/// ```
pub fn hmac_sha256(in key: Array[Int], in message: Array[Int]) -> Array[Int] {
    // Reduce an over-long key to its digest, then zero-pad to the block size.
    var block_key = std::array::empty();
    if std::array::len(key) > 64 {
        let hashed = sha256_bytes(std::string::as_str(str_of_bytes(key)));
        var i = 0;
        while i < std::array::len(hashed) {
            std::array::push(block_key, std::array::get(hashed, i));
            i = i + 1;
        }
    } else {
        var i = 0;
        while i < std::array::len(key) {
            std::array::push(block_key, std::array::get(key, i));
            i = i + 1;
        }
    }
    while std::array::len(block_key) < 64 {
        std::array::push(block_key, 0);
    }

    // inner = H((key ^ 0x36) || message); outer = H((key ^ 0x5c) || inner).
    var inner_input = std::array::empty();
    var i = 0;
    while i < 64 {
        std::array::push(inner_input, std::array::get(block_key, i) ^ 54);
        i = i + 1;
    }
    i = 0;
    while i < std::array::len(message) {
        std::array::push(inner_input, std::array::get(message, i));
        i = i + 1;
    }
    let inner = sha256_bytes(std::string::as_str(str_of_bytes(inner_input)));

    var outer_input = std::array::empty();
    i = 0;
    while i < 64 {
        std::array::push(outer_input, std::array::get(block_key, i) ^ 92);
        i = i + 1;
    }
    i = 0;
    while i < std::array::len(inner) {
        std::array::push(outer_input, std::array::get(inner, i));
        i = i + 1;
    }
    sha256_bytes(std::string::as_str(str_of_bytes(outer_input)))
}

// ----------------------------------------------------------------------------
// Byte/text bridging.
//
// SHA-256 hashes bytes, but `sha256_bytes` takes a `Str` because that is the
// common case and `Str` is what a literal produces. These two functions cross
// the boundary in both directions for the arbitrary-byte cases.
// ----------------------------------------------------------------------------

/// The bytes of `text`, as an `Array[Int]` with each element in `0 ..= 255`.
///
/// # Example
/// ```tuo
/// let bytes = std::crypto::bytes_of_str("abc"); // [97, 98, 99]
/// ```
pub fn bytes_of_str(in text: Str) -> Array[Int] {
    var out = std::array::empty();
    let n = std::str::len(text);
    var i = 0;
    while i < n {
        std::array::push(out, std::str::byte_at(text, i));
        i = i + 1;
    }
    out
}

/// `bytes` as a `String` whose bytes are exactly those values.
///
/// The inverse of [`bytes_of_str`], used internally to feed arbitrary bytes to
/// the `Str`-taking hash. Each element is masked to `0 ..= 255`.
///
/// Note that the result is a byte container, not necessarily valid UTF-8 text:
/// a digest byte sequence usually is not. It is safe to hash and to index by
/// byte, and it must not be printed as if it were text.
///
/// # Example
/// ```tuo
/// let s = std::crypto::str_of_bytes(std::crypto::bytes_of_str("abc")); // "abc"
/// ```
pub fn str_of_bytes(in bytes: Array[Int]) -> String {
    var out = std::string::empty();
    let n = std::array::len(bytes);
    var i = 0;
    while i < n {
        std::string::push_byte(out, std::array::get(bytes, i) & 255);
        i = i + 1;
    }
    out
}

// ----------------------------------------------------------------------------
// PBKDF2-HMAC-SHA-256 (RFC 2898 / RFC 8018), the SCRAM key derivation.
// ----------------------------------------------------------------------------

/// `iterations` rounds of PBKDF2-HMAC-SHA-256 over `password` and `salt`,
/// producing 32 bytes (one SHA-256 block worth).
///
/// This is SCRAM-SHA-256's `Hi()` function and the reason the iteration count
/// exists: each round is a full HMAC, so a high count makes brute-forcing a
/// stolen salt expensive. PostgreSQL's server default is 4096.
///
/// The output is fixed at 32 bytes because that is what SCRAM needs and what
/// one HMAC-SHA-256 block yields; a multi-block variant would add a loop over
/// block indices and is deliberately not written until something needs it.
/// `iterations` below 1 is treated as 1, since zero rounds would return the
/// unstretched HMAC and silently defeat the function's purpose.
///
/// # Example
/// ```tuo
/// let key = std::crypto::pbkdf2_sha256("password", "salt", 1); // 32 bytes
/// ```
pub fn pbkdf2_sha256(in password: Str, in salt: Str, take iterations: Int) -> Array[Int] {
    let key = bytes_of_str(password);

    // U1 = HMAC(password, salt || INT_BE(1)) — block index 1, the only block.
    var first_input = bytes_of_str(salt);
    std::array::push(first_input, 0);
    std::array::push(first_input, 0);
    std::array::push(first_input, 0);
    std::array::push(first_input, 1);

    var u = hmac_sha256(key, first_input);
    var result = std::array::empty();
    var i = 0;
    while i < std::array::len(u) {
        std::array::push(result, std::array::get(u, i));
        i = i + 1;
    }

    var round = 1;
    let total = if iterations < 1 { 1 } else { iterations };
    while round < total {
        u = hmac_sha256(key, u);
        i = 0;
        while i < std::array::len(u) {
            std::array::set(result, i, std::array::get(result, i) ^ std::array::get(u, i));
            i = i + 1;
        }
        round = round + 1;
    }
    result
}

// ----------------------------------------------------------------------------
// Base64 (RFC 4648), the SCRAM message framing.
// ----------------------------------------------------------------------------

/// The ASCII byte of the Base64 alphabet character for `value` (`0 ..= 63`).
///
/// # Example
/// ```tuo
/// let c = std::crypto::base64_char(0); // 65, the byte for 'A'
/// ```
pub fn base64_char(take value: Int) -> Int {
    if value < 0 || value > 63 {
        return 61;
    }
    if value < 26 {
        return 65 + value;
    }
    if value < 52 {
        return 97 + (value - 26);
    }
    if value < 62 {
        return 48 + (value - 52);
    }
    if value == 62 {
        return 43;
    }
    47
}

/// The Base64 value of ASCII byte `c`, or `-1` if it is not an alphabet
/// character.
///
/// `=` (padding) also yields `-1`; [`base64_decode`] stops at padding rather
/// than decoding it.
///
/// # Example
/// ```tuo
/// let v = std::crypto::base64_value(65); // 0, for 'A'
/// ```
pub fn base64_value(take c: Int) -> Int {
    if c >= 65 && c <= 90 {
        return c - 65;
    }
    if c >= 97 && c <= 122 {
        return (c - 97) + 26;
    }
    if c >= 48 && c <= 57 {
        return (c - 48) + 52;
    }
    if c == 43 {
        return 62;
    }
    if c == 47 {
        return 63;
    }
    0 - 1
}

/// `bytes` encoded as standard Base64 with `=` padding.
///
/// # Example
/// ```tuo
/// let encoded = std::crypto::base64_encode(std::crypto::bytes_of_str("Man")); // "TWFu"
/// ```
pub fn base64_encode(in bytes: Array[Int]) -> String {
    var out = std::string::empty();
    let n = std::array::len(bytes);
    var i = 0;
    while i + 3 <= n {
        let b0 = std::array::get(bytes, i) & 255;
        let b1 = std::array::get(bytes, i + 1) & 255;
        let b2 = std::array::get(bytes, i + 2) & 255;
        std::string::push_byte(out, base64_char(b0 >> 2));
        std::string::push_byte(out, base64_char(((b0 & 3) << 4) | (b1 >> 4)));
        std::string::push_byte(out, base64_char(((b1 & 15) << 2) | (b2 >> 6)));
        std::string::push_byte(out, base64_char(b2 & 63));
        i = i + 3;
    }
    let remaining = n - i;
    if remaining == 1 {
        let b0 = std::array::get(bytes, i) & 255;
        std::string::push_byte(out, base64_char(b0 >> 2));
        std::string::push_byte(out, base64_char((b0 & 3) << 4));
        std::string::push_byte(out, 61);
        std::string::push_byte(out, 61);
    }
    if remaining == 2 {
        let b0 = std::array::get(bytes, i) & 255;
        let b1 = std::array::get(bytes, i + 1) & 255;
        std::string::push_byte(out, base64_char(b0 >> 2));
        std::string::push_byte(out, base64_char(((b0 & 3) << 4) | (b1 >> 4)));
        std::string::push_byte(out, base64_char((b1 & 15) << 2));
        std::string::push_byte(out, 61);
    }
    out
}

/// `text` decoded from standard Base64 into its bytes.
///
/// Characters outside the alphabet — padding, whitespace, anything else — are
/// skipped rather than rejected, so this decodes wrapped or padded input
/// without a caller pre-cleaning it. It is therefore lenient by design: it
/// reports no error for malformed input, and a caller needing strict
/// validation must check the input itself first.
///
/// # Example
/// ```tuo
/// let bytes = std::crypto::base64_decode("TWFu"); // [77, 97, 110]
/// ```
pub fn base64_decode(in text: Str) -> Array[Int] {
    var out = std::array::empty();
    var accumulator = 0;
    var bits = 0;
    let n = std::str::len(text);
    var i = 0;
    while i < n {
        let value = base64_value(std::str::byte_at(text, i));
        if value >= 0 {
            accumulator = ((accumulator << 6) | value) & 16777215;
            bits = bits + 6;
            if bits >= 8 {
                bits = bits - 8;
                std::array::push(out, (accumulator >> bits) & 255);
            }
        }
        i = i + 1;
    }
    out
}

// ----------------------------------------------------------------------------
// Entropy — the effect tier.
//
// A nonce, salt, or key drawn from a predictable stream silently voids the
// property it exists to provide, so these read the platform CSPRNG and never
// a seeded PRNG. That makes them effects: a function whose whole purpose is to
// return something different each call cannot be pure, so neither carries a
// spec and `R0007` refuses either inside one.
// ----------------------------------------------------------------------------

/// EFFECT (executable and effectful): one cryptographically-secure random byte
/// in `0 ..= 255`, or `-1` if the platform CSPRNG is unavailable.
///
/// Implemented over the `std::rt::random_byte` effect primitive (ADR-0019
/// Stage B), which reads the OS entropy source (`getentropy`). Effectful, so
/// no spec (`R0007`); pinned by the native CLI tests in
/// `crates/tuo-cli/tests/stdlib.rs`.
///
/// A caller must check for `-1` rather than assume success: entropy can fail,
/// and treating the error as a byte would put the value `255` — or worse, a
/// predictable one — into a key.
///
/// # Example
/// ```tuo
/// // let b = std::crypto::random_byte();
/// ```
pub fn random_byte() -> Int {
    std::rt::random_byte()
}

/// EFFECT (executable and effectful): `length` cryptographically-secure random
/// bytes, or an empty array if the platform CSPRNG is unavailable.
///
/// The client nonce a SCRAM exchange opens with, and the salt any password
/// hashing needs. An **empty result signals failure**, and it is deliberately
/// not a partial one: a short nonce is a weak nonce, so a caller that ignores
/// the length gets something obviously unusable rather than something subtly
/// insecure. Check `std::array::len` against what you asked for.
///
/// A `length` of zero or less yields an empty array. Effectful, so no spec
/// (`R0007`); pinned by the native CLI tests in
/// `crates/tuo-cli/tests/stdlib.rs`.
///
/// # Example
/// ```tuo
/// // let client_nonce = std::crypto::nonce(18); // 18 bytes, then base64 it
/// ```
pub fn nonce(take length: Int) -> Array[Int] {
    var out = std::array::empty();
    if length <= 0 {
        return out;
    }
    var i = 0;
    while i < length {
        let byte = std::rt::random_byte();
        if byte < 0 {
            // Entropy failed: return nothing rather than a short or
            // partially-predictable nonce.
            return std::array::empty();
        }
        std::array::push(out, byte);
        i = i + 1;
    }
    out
}

// ----------------------------------------------------------------------------
// Specs — every function above runs through the reference interpreter.
//
// The vectors below are PUBLISHED values, not this module's own output:
// FIPS 180-4 (SHA-256), RFC 4231 (HMAC-SHA-256), RFC 6070 adapted to SHA-256
// (PBKDF2), and RFC 4648 (Base64). That is what makes them proof rather than
// self-agreement.
// ----------------------------------------------------------------------------

spec sha256_round_constants {
    // The 64 constants, spot-checked against FIPS 180-4's published table at
    // the boundaries and one interior point.
    then std::array::len(sha256_round_constants()) == 64;
    then std::array::get(sha256_round_constants(), 0) == 1116352408;
    then std::array::get(sha256_round_constants(), 1) == 1899447441;
    then std::array::get(sha256_round_constants(), 32) == 666307205;
    then std::array::get(sha256_round_constants(), 63) == 3329325298;
    // Every constant is a 32-bit value, as the standard requires.
    then std::array::get(sha256_round_constants(), 0) <= 4294967295;
    then std::array::get(sha256_round_constants(), 63) <= 4294967295;
}

spec push_be32 {
    // `push_be32` mutates its argument and returns `()`, so it is called
    // directly here (the `when` step) and its effect observed through the
    // array it appended to.
    when var out = std::array::empty();
    when push_be32(out, 258);
    then std::array::len(out) == 4;
    then std::array::get(out, 0) == 0;
    then std::array::get(out, 2) == 1;
    then std::array::get(out, 3) == 2;
}

spec str_of_bytes {
    then std::string::as_str(str_of_bytes(bytes_of_str("abc"))) == "abc";
    then std::str::len(std::string::as_str(str_of_bytes(std::array::empty()))) == 0;
    // Values are masked into a byte, so an over-wide element cannot corrupt
    // the result's length.
    then std::str::len(std::string::as_str(str_of_bytes(repeated_byte(300, 2)))) == 2;
}

spec sha256_bytes {
    // The raw-byte form of the FIPS 180-4 "abc" vector.
    then std::array::len(sha256_bytes("abc")) == 32;
    then std::array::get(sha256_bytes("abc"), 0) == 186;
    then std::array::get(sha256_bytes("abc"), 31) == 173;
    then std::array::len(sha256_bytes("")) == 32;
}

spec hex_digit {
    then hex_digit(0) == 48;
    then hex_digit(9) == 57;
    then hex_digit(10) == 97;
    then hex_digit(15) == 102;
    then hex_digit(16) == 48;
    then hex_digit(0 - 1) == 48;
}

spec to_hex {
    // Built with `repeated_byte`/`bytes_of_str` rather than
    // `std::collections`: every catalog module compiles standalone, so
    // `std::crypto` depends on no other library module.
    then std::string::as_str(to_hex(repeated_byte(255, 1))) == "ff";
    then std::string::as_str(to_hex(repeated_byte(0, 2))) == "0000";
    then std::string::as_str(to_hex(bytes_of_str("abc"))) == "616263";
    then std::str::len(std::string::as_str(to_hex(std::array::empty()))) == 0;
}

spec bytes_of_str {
    then std::array::get(bytes_of_str("abc"), 0) == 97;
    then std::array::get(bytes_of_str("abc"), 2) == 99;
    then std::array::len(bytes_of_str("abc")) == 3;
    then std::array::len(bytes_of_str("")) == 0;
    // Round-trips with str_of_bytes.
    then std::string::as_str(str_of_bytes(bytes_of_str("hello"))) == "hello";
}

spec sha256_pad {
    // "abc" is 3 bytes, so one 64-byte block after padding.
    then std::array::len(sha256_pad("abc")) == 64;
    then std::array::get(sha256_pad("abc"), 3) == 128;
    // The bit length, 24, lands in the final byte.
    then std::array::get(sha256_pad("abc"), 63) == 24;
    // The empty input still produces exactly one block.
    then std::array::len(sha256_pad("")) == 64;
    then std::array::get(sha256_pad(""), 0) == 128;
    // A 56-byte input needs a second block, since the length no longer fits.
    then std::array::len(sha256_pad("01234567890123456789012345678901234567890123456789012345")) == 128;
}

spec sha256 {
    // FIPS 180-4 published vectors.
    then std::string::as_str(sha256("abc"))
        == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad";
    then std::string::as_str(sha256(""))
        == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855";
    then std::string::as_str(sha256("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"))
        == "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1";
    // A two-block input, so the compression loop really iterates.
    then std::string::as_str(sha256("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu"))
        == "cf5b16a778af8380036ce59e7b0492370b249b11e8f07a51afac45037afee9d1";
    // The digest is 32 bytes, hence 64 hex characters.
    then std::str::len(std::string::as_str(sha256("abc"))) == 64;
    then std::array::len(sha256_bytes("abc")) == 32;
    then std::array::get(sha256_bytes("abc"), 0) == 186;
}

spec hmac_sha256 {
    // RFC 4231 test case 1: 20 bytes of 0x0b as the key, "Hi There".
    then std::string::as_str(to_hex(hmac_sha256(repeated_byte(11, 20), bytes_of_str("Hi There"))))
        == "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7";
    // RFC 4231 test case 2: key "Jefe", message "what do ya want for nothing?".
    then std::string::as_str(to_hex(hmac_sha256(bytes_of_str("Jefe"), bytes_of_str("what do ya want for nothing?"))))
        == "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843";
    // RFC 4231 test case 6: a 131-byte key, longer than the block, so the
    // key-shortening path really runs.
    then std::string::as_str(to_hex(hmac_sha256(
        repeated_byte(170, 131),
        bytes_of_str("Test Using Larger Than Block-Size Key - Hash Key First")
    ))) == "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54";
    then std::array::len(hmac_sha256(bytes_of_str("k"), bytes_of_str("m"))) == 32;
}

/// `count` copies of `byte`, as an `Array[Int]`.
///
/// Used by the HMAC specs to build the RFC 4231 fixed-byte keys.
///
/// # Example
/// ```tuo
/// let key = std::crypto::repeated_byte(11, 20); // 20 bytes of 0x0b
/// ```
pub fn repeated_byte(take byte: Int, take count: Int) -> Array[Int] {
    var out = std::array::empty();
    var i = 0;
    while i < count {
        std::array::push(out, byte & 255);
        i = i + 1;
    }
    out
}

spec repeated_byte {
    then std::array::len(repeated_byte(11, 20) ) == 20;
    then std::array::get(repeated_byte(11, 20), 0) == 11;
    then std::array::len(repeated_byte(1, 0)) == 0;
}

spec pbkdf2_sha256 {
    // RFC 6070's vectors are for PBKDF2-HMAC-SHA1; these are the widely
    // published PBKDF2-HMAC-SHA256 counterparts for the same inputs.
    then std::string::as_str(to_hex(pbkdf2_sha256("password", "salt", 1)))
        == "120fb6cffcf8b32c43e7225256c4f837a86548c92ccc35480805987cb70be17b";
    then std::string::as_str(to_hex(pbkdf2_sha256("password", "salt", 2)))
        == "ae4d0c95af6b46d32d0adff928f06dd02a303f8ef3c251dfd6e2d85a95474c43";
    then std::array::len(pbkdf2_sha256("password", "salt", 1)) == 32;
    // Zero and negative counts clamp to one round rather than returning the
    // unstretched value.
    then std::string::as_str(to_hex(pbkdf2_sha256("password", "salt", 0)))
        == std::string::as_str(to_hex(pbkdf2_sha256("password", "salt", 1)));
}

spec base64_char {
    then base64_char(0) == 65;
    then base64_char(25) == 90;
    then base64_char(26) == 97;
    then base64_char(51) == 122;
    then base64_char(52) == 48;
    then base64_char(61) == 57;
    then base64_char(62) == 43;
    then base64_char(63) == 47;
}

spec base64_value {
    then base64_value(65) == 0;
    then base64_value(97) == 26;
    then base64_value(48) == 52;
    then base64_value(43) == 62;
    then base64_value(47) == 63;
    // Padding and other characters are not alphabet values.
    then base64_value(61) == 0 - 1;
    then base64_value(32) == 0 - 1;
}

spec base64_encode {
    // RFC 4648 section 10 vectors.
    then std::string::as_str(base64_encode(bytes_of_str(""))) == "";
    then std::string::as_str(base64_encode(bytes_of_str("f"))) == "Zg==";
    then std::string::as_str(base64_encode(bytes_of_str("fo"))) == "Zm8=";
    then std::string::as_str(base64_encode(bytes_of_str("foo"))) == "Zm9v";
    then std::string::as_str(base64_encode(bytes_of_str("foob"))) == "Zm9vYg==";
    then std::string::as_str(base64_encode(bytes_of_str("fooba"))) == "Zm9vYmE=";
    then std::string::as_str(base64_encode(bytes_of_str("foobar"))) == "Zm9vYmFy";
}

spec base64_decode {
    then std::string::as_str(str_of_bytes(base64_decode(""))) == "";
    then std::string::as_str(str_of_bytes(base64_decode("Zg=="))) == "f";
    then std::string::as_str(str_of_bytes(base64_decode("Zm8="))) == "fo";
    then std::string::as_str(str_of_bytes(base64_decode("Zm9v"))) == "foo";
    then std::string::as_str(str_of_bytes(base64_decode("Zm9vYmFy"))) == "foobar";
    // Round-trips with the encoder over a non-text byte sequence.
    then std::string::as_str(to_hex(base64_decode(std::string::as_str(base64_encode(sha256_bytes("abc"))))))
        == std::string::as_str(to_hex(sha256_bytes("abc")));
}

// ----------------------------------------------------------------------------
// Constant-time verification, and SCRAM-SHA-256 (RFC 7677).
//
// Everything above *computes* a digest. Authentication additionally requires
// *comparing* one, and that comparison is where the classic timing
// vulnerability lives: `==` on two byte arrays is free to return on the first
// differing element, and the time it takes then reveals how many leading bytes
// an attacker guessed correctly — turning an infeasible 2^256 search into a
// byte-at-a-time one that finishes in minutes. `verify` below is the safe
// comparison, and it is the only one this module offers, so the vulnerable
// spelling is never the convenient one.

/// Whether two byte arrays are equal, in time that does not depend on *where*
/// they differ.
///
/// Use this for every comparison of a secret: MAC tags, digests, derived keys,
/// authentication proofs. Never use `==` for those — see the section note
/// above for why the early return is exploitable.
///
/// The guarantee is exactly `std::ct::bytes_eq`'s, which this delegates to:
/// the running time depends on the arrays' *lengths*, which are public, and
/// never on their contents. Lengths that differ compare unequal without
/// scanning past the shorter array.
///
/// ```tuo
/// let expected = std::crypto::sha256_bytes("hello");
/// let actual = std::crypto::sha256_bytes("hello");
/// std::crypto::verify(expected, actual)  // true
/// ```
pub fn verify(in a: Array[Int], in b: Array[Int]) -> Bool {
    // `std::ct` speaks 0/1 because a `Bool` cannot be produced without a
    // branch. The conversion happens here, at the boundary, once the
    // data-dependent work is over: the comparison itself was constant time,
    // and what a caller does with the single resulting bit is its own affair.
    std::ct::bytes_eq(a, b) == 1
}

/// The XOR of two equal-length byte arrays.
///
/// SCRAM's client proof is `ClientKey XOR ClientSignature`, and the same
/// combining step appears throughout the protocol family. Elements past the
/// shorter array's end are ignored.
///
/// ```tuo
/// let a = std::crypto::bytes_of_str("abc");
/// let b = std::crypto::bytes_of_str("   ");
/// std::string::as_str(std::crypto::to_hex(std::crypto::xor_bytes(a, b)))  // "414243"
/// ```
pub fn xor_bytes(in a: Array[Int], in b: Array[Int]) -> Array[Int] {
    var out = std::array::empty();
    let len_a = std::array::len(a);
    let len_b = std::array::len(b);
    var n = len_a;
    if len_b < n {
        n = len_b;
    }
    var i = 0;
    while i < n {
        std::array::push(out, std::array::get(a, i) ^ std::array::get(b, i));
        i = i + 1;
    }
    out
}

/// The SCRAM-SHA-256 salted password: `Hi(password, salt, iterations)`.
///
/// This is the expensive step of the exchange — the whole point of the
/// iteration count is that it costs the attacker as much as it costs the
/// client — so a connector computes it once per authentication, never per
/// message. `salt` is the raw salt bytes, which arrive base64-encoded in the
/// server's first message and must be decoded first.
///
/// ```tuo
/// let salt = std::crypto::base64_decode("W22ZaJ0SNY7soEsUEjb6gQ==");
/// std::array::len(std::crypto::scram_salted_password("pencil", salt, 4096))  // 32
/// ```
pub fn scram_salted_password(in password: Str, in salt: Array[Int], take iterations: Int) -> Array[Int] {
    let salt_text = str_of_bytes(salt);
    pbkdf2_sha256(password, std::string::as_str(salt_text), iterations)
}

/// The SCRAM-SHA-256 client proof, base64-encoded and ready to send.
///
/// This is what the client puts in its `p=` field to prove it knows the
/// password without revealing it. `auth_message` is the protocol's
/// `client-first-bare + "," + server-first + "," + client-final-without-proof`,
/// which the caller assembles from the messages actually exchanged.
///
/// The computation is RFC 5802 §3: `ClientKey := HMAC(SaltedPassword,
/// "Client Key")`, `StoredKey := H(ClientKey)`, `ClientSignature :=
/// HMAC(StoredKey, AuthMessage)`, and the proof is `ClientKey XOR
/// ClientSignature`.
///
/// ```tuo
/// let salt = std::crypto::base64_decode("W22ZaJ0SNY7soEsUEjb6gQ==");
/// let salted = std::crypto::scram_salted_password("pencil", salt, 4096);
/// std::array::len(std::crypto::base64_decode(std::string::as_str(std::crypto::scram_client_proof(salted, "n=user,r=abc"))))  // 32
/// ```
pub fn scram_client_proof(in salted_password: Array[Int], in auth_message: Str) -> String {
    let client_key = hmac_sha256(salted_password, bytes_of_str("Client Key"));
    let stored_text = str_of_bytes(client_key);
    let stored_key = sha256_bytes(std::string::as_str(stored_text));
    let client_signature = hmac_sha256(stored_key, bytes_of_str(auth_message));
    base64_encode(xor_bytes(client_key, client_signature))
}

/// The SCRAM-SHA-256 server signature the client must check.
///
/// The final message of the exchange carries the server's own proof that it
/// knew the stored credentials, and a client that skips this check will
/// happily authenticate against an impostor. Compare it with `verify`, never
/// with `==`.
///
/// ```tuo
/// let salt = std::crypto::base64_decode("W22ZaJ0SNY7soEsUEjb6gQ==");
/// let salted = std::crypto::scram_salted_password("pencil", salt, 4096);
/// std::array::len(std::crypto::base64_decode(std::string::as_str(std::crypto::scram_server_signature(salted, "n=user,r=abc"))))  // 32
/// ```
pub fn scram_server_signature(in salted_password: Array[Int], in auth_message: Str) -> String {
    let server_key = hmac_sha256(salted_password, bytes_of_str("Server Key"));
    let server_signature = hmac_sha256(server_key, bytes_of_str(auth_message));
    base64_encode(server_signature)
}

spec verify {
    // Equal digests verify; a one-bit difference does not.
    then verify(sha256_bytes("abc"), sha256_bytes("abc"));
    then verify(sha256_bytes("abc"), sha256_bytes("abd")) == false;
    // Length differences are handled without scanning past the shorter array.
    then verify(bytes_of_str("ab"), bytes_of_str("abc")) == false;
    then verify(bytes_of_str(""), bytes_of_str("")) ;
}

spec xor_bytes {
    // XOR with spaces flips the case bit of ASCII letters.
    then std::string::as_str(to_hex(xor_bytes(bytes_of_str("abc"), bytes_of_str("   "))))
        == "414243";
    // XOR is its own inverse.
    then std::string::as_str(to_hex(xor_bytes(xor_bytes(sha256_bytes("x"), sha256_bytes("y")), sha256_bytes("y"))))
        == std::string::as_str(to_hex(sha256_bytes("x")));
}

spec scram_client_proof {
    // The published RFC 7677 section 3 vector needs 4096 PBKDF2 iterations,
    // which exceeds the spec sandbox's instruction-fuel budget — the cost is
    // the point of an iteration count. That vector is therefore pinned by a
    // *native* test instead (`tuo-cli`'s `crypto_cross_check.rs`), and what is
    // checked here is the structure the vector cannot see: that the proof is
    // 32 bytes, that it is `ClientKey XOR ClientSignature` and so recovers the
    // client key when the signature is XORed back out, and that it depends on
    // the auth message.
    then std::array::len(base64_decode(std::string::as_str(
        scram_client_proof(scram_salted_password("pencil", bytes_of_str("salt"), 1), "n=user,r=abc")))) == 32;
    // Different auth messages give different proofs.
    then std::string::as_str(scram_client_proof(scram_salted_password("pencil", bytes_of_str("salt"), 1), "n=user,r=abc"))
        != std::string::as_str(scram_client_proof(scram_salted_password("pencil", bytes_of_str("salt"), 1), "n=user,r=xyz"));
    // A different password gives a different proof.
    then std::string::as_str(scram_client_proof(scram_salted_password("pencil", bytes_of_str("salt"), 1), "n=user,r=abc"))
        != std::string::as_str(scram_client_proof(scram_salted_password("crayon", bytes_of_str("salt"), 1), "n=user,r=abc"));
    // The proof is the XOR of ClientKey and ClientSignature, so XORing the
    // signature back out recovers the key exactly.
    then std::string::as_str(to_hex(xor_bytes(
        base64_decode(std::string::as_str(scram_client_proof(scram_salted_password("pencil", bytes_of_str("salt"), 1), "n=user,r=abc"))),
        hmac_sha256(sha256_bytes(std::string::as_str(str_of_bytes(
            hmac_sha256(scram_salted_password("pencil", bytes_of_str("salt"), 1), bytes_of_str("Client Key"))))),
            bytes_of_str("n=user,r=abc")))))
        == std::string::as_str(to_hex(hmac_sha256(scram_salted_password("pencil", bytes_of_str("salt"), 1), bytes_of_str("Client Key"))));
}

spec scram_server_signature {
    // As above, the published vector is pinned natively; the structure is
    // checked here.
    then std::array::len(base64_decode(std::string::as_str(
        scram_server_signature(scram_salted_password("pencil", bytes_of_str("salt"), 1), "n=user,r=abc")))) == 32;
    // The server signature is a different value from the client proof, which
    // is what makes it evidence the server knew the stored credentials.
    then std::string::as_str(scram_server_signature(scram_salted_password("pencil", bytes_of_str("salt"), 1), "n=user,r=abc"))
        != std::string::as_str(scram_client_proof(scram_salted_password("pencil", bytes_of_str("salt"), 1), "n=user,r=abc"));
    // It is HMAC(ServerKey, AuthMessage) exactly.
    then std::string::as_str(scram_server_signature(scram_salted_password("pencil", bytes_of_str("salt"), 1), "n=user,r=abc"))
        == std::string::as_str(base64_encode(hmac_sha256(
            hmac_sha256(scram_salted_password("pencil", bytes_of_str("salt"), 1), bytes_of_str("Server Key")),
            bytes_of_str("n=user,r=abc"))));
}

// ----------------------------------------------------------------------------
// MD5 (RFC 1321) — LEGACY, BROKEN FOR SECURITY.
//
// READ THIS BEFORE USING IT. **MD5 is cryptographically broken and must not be
// used for anything security-relevant.** Practical collisions have been
// generated since 2004 and can now be produced in seconds on ordinary
// hardware; chosen-prefix collisions followed. That means MD5 cannot be relied
// on for integrity, for signatures, for deduplicating untrusted content, or
// for password storage. It is not "weak but probably fine" — it is broken in
// the specific sense that an attacker can construct two different inputs with
// the same digest at will.
//
// It ships here for exactly one reason: PostgreSQL's wire protocol still
// offers `AuthenticationMD5Password`, and a connector meeting an old server
// has no alternative. `password_encryption` has defaulted to `scram-sha-256`
// since PostgreSQL 14 and MD5 auth is disabled outright on several managed
// providers, so this is a compatibility shim for old servers, never the path
// a new system should take. **Use `sha256` for hashing and the `scram_*`
// functions for authentication.**
//
// This warning is deliberately long. A standard library that shipped MD5
// without it would teach the wrong thing to exactly the audience — coding
// agents and newcomers reaching for the first hash function they find — that
// this language is built for.
// ----------------------------------------------------------------------------

/// The 64 MD5 round constants, `floor(abs(sin(i + 1)) * 2^32)`.
///
/// Internal to the compression loop; exposed because v0 has no module-private
/// items and no `const` arrays.
///
/// ```tuo
/// std::array::len(std::crypto::md5_round_constants())  // 64
/// ```
pub fn md5_round_constants() -> Array[Int] {
    var k = std::array::empty();
    std::array::push(k, 3614090360); std::array::push(k, 3905402710); std::array::push(k, 606105819); std::array::push(k, 3250441966);
    std::array::push(k, 4118548399); std::array::push(k, 1200080426); std::array::push(k, 2821735955); std::array::push(k, 4249261313);
    std::array::push(k, 1770035416); std::array::push(k, 2336552879); std::array::push(k, 4294925233); std::array::push(k, 2304563134);
    std::array::push(k, 1804603682); std::array::push(k, 4254626195); std::array::push(k, 2792965006); std::array::push(k, 1236535329);
    std::array::push(k, 4129170786); std::array::push(k, 3225465664); std::array::push(k, 643717713); std::array::push(k, 3921069994);
    std::array::push(k, 3593408605); std::array::push(k, 38016083); std::array::push(k, 3634488961); std::array::push(k, 3889429448);
    std::array::push(k, 568446438); std::array::push(k, 3275163606); std::array::push(k, 4107603335); std::array::push(k, 1163531501);
    std::array::push(k, 2850285829); std::array::push(k, 4243563512); std::array::push(k, 1735328473); std::array::push(k, 2368359562);
    std::array::push(k, 4294588738); std::array::push(k, 2272392833); std::array::push(k, 1839030562); std::array::push(k, 4259657740);
    std::array::push(k, 2763975236); std::array::push(k, 1272893353); std::array::push(k, 4139469664); std::array::push(k, 3200236656);
    std::array::push(k, 681279174); std::array::push(k, 3936430074); std::array::push(k, 3572445317); std::array::push(k, 76029189);
    std::array::push(k, 3654602809); std::array::push(k, 3873151461); std::array::push(k, 530742520); std::array::push(k, 3299628645);
    std::array::push(k, 4096336452); std::array::push(k, 1126891415); std::array::push(k, 2878612391); std::array::push(k, 4237533241);
    std::array::push(k, 1700485571); std::array::push(k, 2399980690); std::array::push(k, 4293915773); std::array::push(k, 2240044497);
    std::array::push(k, 1873313359); std::array::push(k, 4264355552); std::array::push(k, 2734768916); std::array::push(k, 1309151649);
    std::array::push(k, 4149444226); std::array::push(k, 3174756917); std::array::push(k, 718787259); std::array::push(k, 3951481745);
    k
}

/// The 64 MD5 per-round rotation amounts.
///
/// ```tuo
/// std::array::len(std::crypto::md5_shifts())  // 64
/// ```
pub fn md5_shifts() -> Array[Int] {
    var s = std::array::empty();
    std::array::push(s, 7); std::array::push(s, 12); std::array::push(s, 17); std::array::push(s, 22); std::array::push(s, 7); std::array::push(s, 12); std::array::push(s, 17); std::array::push(s, 22);
    std::array::push(s, 7); std::array::push(s, 12); std::array::push(s, 17); std::array::push(s, 22); std::array::push(s, 7); std::array::push(s, 12); std::array::push(s, 17); std::array::push(s, 22);
    std::array::push(s, 5); std::array::push(s, 9); std::array::push(s, 14); std::array::push(s, 20); std::array::push(s, 5); std::array::push(s, 9); std::array::push(s, 14); std::array::push(s, 20);
    std::array::push(s, 5); std::array::push(s, 9); std::array::push(s, 14); std::array::push(s, 20); std::array::push(s, 5); std::array::push(s, 9); std::array::push(s, 14); std::array::push(s, 20);
    std::array::push(s, 4); std::array::push(s, 11); std::array::push(s, 16); std::array::push(s, 23); std::array::push(s, 4); std::array::push(s, 11); std::array::push(s, 16); std::array::push(s, 23);
    std::array::push(s, 4); std::array::push(s, 11); std::array::push(s, 16); std::array::push(s, 23); std::array::push(s, 4); std::array::push(s, 11); std::array::push(s, 16); std::array::push(s, 23);
    std::array::push(s, 6); std::array::push(s, 10); std::array::push(s, 15); std::array::push(s, 21); std::array::push(s, 6); std::array::push(s, 10); std::array::push(s, 15); std::array::push(s, 21);
    std::array::push(s, 6); std::array::push(s, 10); std::array::push(s, 15); std::array::push(s, 21); std::array::push(s, 6); std::array::push(s, 10); std::array::push(s, 15); std::array::push(s, 21);
    s
}

/// The MD5 message bytes for `data`: its bytes, the `0x80` terminator, zero
/// padding to 56 mod 64, and the 64-bit **little-endian** bit length.
///
/// The endianness is the one structural difference from [`sha256_pad`]: MD5 is
/// defined little-endian throughout, where SHA-256 is big-endian. Getting this
/// backwards produces a plausible-looking digest that is simply wrong, which is
/// why it is split out and spec'd separately.
///
/// ```tuo
/// std::array::len(std::crypto::md5_pad("abc"))  // 64
/// ```
pub fn md5_pad(in data: Str) -> Array[Int] {
    let length = std::str::len(data);
    var message = std::array::empty();
    var i = 0;
    while i < length {
        std::array::push(message, std::str::byte_at(data, i));
        i = i + 1;
    }
    std::array::push(message, 128);
    while (std::array::len(message) % 64) != 56 {
        std::array::push(message, 0);
    }
    // The length in BITS, little-endian. The high four bytes are zero for any
    // input this implementation can hold.
    let bits = length * 8;
    std::array::push(message, bits & 255);
    std::array::push(message, (bits >> 8) & 255);
    std::array::push(message, (bits >> 16) & 255);
    std::array::push(message, (bits >> 24) & 255);
    std::array::push(message, 0);
    std::array::push(message, 0);
    std::array::push(message, 0);
    std::array::push(message, 0);
    message
}

/// The MD5 digest of `data`, as 16 raw bytes.
///
/// **Legacy and broken for security — see the section note above.** Present
/// only for PostgreSQL's `AuthenticationMD5Password`.
///
/// ```tuo
/// std::array::len(std::crypto::md5_bytes("abc"))  // 16
/// ```
pub fn md5_bytes(in data: Str) -> Array[Int] {
    let message = md5_pad(data);
    let k = md5_round_constants();
    let shifts = md5_shifts();

    var a0 = 1732584193;
    var b0 = 4023233417;
    var c0 = 2562383102;
    var d0 = 271733878;

    var block = 0;
    while block < std::array::len(message) {
        // Decode the block's 16 little-endian 32-bit words.
        var m = std::array::empty();
        var w = 0;
        while w < 16 {
            let at = block + w * 4;
            let word = std::array::get(message, at)
                | (std::array::get(message, at + 1) << 8)
                | (std::array::get(message, at + 2) << 16)
                | (std::array::get(message, at + 3) << 24);
            std::array::push(m, word);
            w = w + 1;
        }

        var a = a0;
        var b = b0;
        var c = c0;
        var d = d0;

        var i = 0;
        while i < 64 {
            var f = 0;
            var g = 0;
            if i < 16 {
                f = (b & c) | (std::bits::low32(~b) & d);
                g = i;
            } else {
                if i < 32 {
                    f = (d & b) | (std::bits::low32(~d) & c);
                    g = (5 * i + 1) % 16;
                } else {
                    if i < 48 {
                        f = b ^ c ^ d;
                        g = (3 * i + 5) % 16;
                    } else {
                        f = c ^ (b | std::bits::low32(~d));
                        g = (7 * i) % 16;
                    }
                }
            }
            let tmp = d;
            d = c;
            c = b;
            let sum = std::bits::add32(
                std::bits::add32(a, f),
                std::bits::add32(std::array::get(k, i), std::array::get(m, g)));
            b = std::bits::add32(b, std::bits::rotl32(sum, std::array::get(shifts, i)));
            a = tmp;
            i = i + 1;
        }

        a0 = std::bits::add32(a0, a);
        b0 = std::bits::add32(b0, b);
        c0 = std::bits::add32(c0, c);
        d0 = std::bits::add32(d0, d);
        block = block + 64;
    }

    // The digest is the four words in little-endian order.
    var out = std::array::empty();
    push_le32(out, a0);
    push_le32(out, b0);
    push_le32(out, c0);
    push_le32(out, d0);
    out
}

/// Append `value`'s low 32 bits to `out` as four little-endian bytes.
///
/// ```tuo
/// var b = std::array::empty();
/// std::crypto::push_le32(b, 1);
/// std::array::get(b, 0)  // 1
/// ```
pub fn push_le32(mut out: Array[Int], take value: Int) {
    let v = std::bits::low32(value);
    std::array::push(out, v & 255);
    std::array::push(out, (v >> 8) & 255);
    std::array::push(out, (v >> 16) & 255);
    std::array::push(out, (v >> 24) & 255);
}

/// The MD5 digest of `data`, as a lowercase hex `String`.
///
/// **Legacy and broken for security — see the section note above.** Use
/// [`sha256`] for hashing and the `scram_*` functions for authentication; this
/// exists only for PostgreSQL's `AuthenticationMD5Password`.
///
/// ```tuo
/// std::string::as_str(std::crypto::md5("abc"))  // "900150983cd24fb0d6963f7d28e17f72"
/// ```
pub fn md5(in data: Str) -> String {
    to_hex(md5_bytes(data))
}

/// The PostgreSQL `AuthenticationMD5Password` response:
/// `"md5" + md5(md5(password + username) + salt)`.
///
/// **Legacy — see the section note above.** The salt is the four bytes the
/// server sends in its `AuthenticationMD5Password` message. Modern servers
/// default to SCRAM; use [`scram_client_proof`] there.
///
/// ```tuo
/// let salt = std::crypto::bytes_of_str("abcd");
/// std::string::len(std::crypto::md5_password("secret", "user", salt))  // 35
/// ```
pub fn md5_password(in password: Str, in user: Str, in salt: Array[Int]) -> String {
    // The inner digest is over password + username, as hex text.
    var inner_input = std::string::empty();
    std::string::append(inner_input, password);
    std::string::append(inner_input, user);
    let inner = md5(std::string::as_str(inner_input));

    // The outer digest is over that hex text followed by the raw salt bytes.
    var outer_input = std::string::empty();
    std::string::append(outer_input, std::string::as_str(inner));
    var i = 0;
    while i < std::array::len(salt) {
        std::string::push_byte(outer_input, std::array::get(salt, i));
        i = i + 1;
    }
    let outer = md5(std::string::as_str(outer_input));

    var out = std::string::empty();
    std::string::append(out, "md5");
    std::string::append(out, std::string::as_str(outer));
    out
}

spec md5 {
    // RFC 1321 appendix A.5's published test suite, in full. These are the
    // RFC's own vectors, not this implementation's output.
    then std::string::as_str(md5("")) == "d41d8cd98f00b204e9800998ecf8427e";
    then std::string::as_str(md5("a")) == "0cc175b9c0f1b6a831c399e269772661";
    then std::string::as_str(md5("abc")) == "900150983cd24fb0d6963f7d28e17f72";
    then std::string::as_str(md5("message digest")) == "f96b697d7cb7938d525a2f31aaf161d0";
    then std::string::as_str(md5("abcdefghijklmnopqrstuvwxyz"))
        == "c3fcd3d76192e4007dfb496cca67e13b";
}

spec md5_bytes {
    then std::array::len(md5_bytes("")) == 16;
    then std::array::len(md5_bytes("abc")) == 16;
    // A multi-block input (over 56 bytes) exercises the padding boundary.
    then std::string::as_str(md5("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"))
        == "d174ab98d277d9f5a5611c2c9f419d9f";
}

spec md5_pad {
    // Padding brings the message to a multiple of 64 bytes.
    then std::array::len(md5_pad("")) == 64;
    then std::array::len(md5_pad("abc")) == 64;
    // 56 bytes needs a second block, since the terminator and length no
    // longer fit.
    then std::array::len(md5_pad("01234567890123456789012345678901234567890123456789012345")) == 128;
    // The terminator byte follows the data.
    then std::array::get(md5_pad("abc"), 3) == 128;
    // The length is in BITS, little-endian: 3 bytes = 24 bits.
    then std::array::get(md5_pad("abc"), 56) == 24;
    then std::array::get(md5_pad("abc"), 57) == 0;
}

spec md5_password {
    // The response is "md5" plus a 32-character hex digest.
    then std::string::len(md5_password("secret", "user", bytes_of_str("abcd"))) == 35;
    // The "md5" prefix the protocol requires, checked byte by byte so this
    // spec needs no dependency beyond the module's own.
    then std::string::byte_at(md5_password("secret", "user", bytes_of_str("abcd")), 0) == 109;
    then std::string::byte_at(md5_password("secret", "user", bytes_of_str("abcd")), 1) == 100;
    then std::string::byte_at(md5_password("secret", "user", bytes_of_str("abcd")), 2) == 53;
    // A different salt gives a different response, which is the whole point
    // of the server sending one.
    then std::string::as_str(md5_password("secret", "user", bytes_of_str("abcd")))
        != std::string::as_str(md5_password("secret", "user", bytes_of_str("abce")));
    // The exact PostgreSQL response for a known (password, user, salt), which
    // pins the *composition* the protocol specifies — md5(md5(pw+user)+salt)
    // — not just that it produces some digest. Cross-checked against an
    // independent implementation of the same protocol step.
    then std::string::as_str(md5_password("secret", "user", bytes_of_str("abcd")))
        == "md5fd7c993d0b0386ed609939ae4ac157ce";
    // As does a different password or user.
    then std::string::as_str(md5_password("secret", "user", bytes_of_str("abcd")))
        != std::string::as_str(md5_password("other", "user", bytes_of_str("abcd")));
    then std::string::as_str(md5_password("secret", "user", bytes_of_str("abcd")))
        != std::string::as_str(md5_password("secret", "usor", bytes_of_str("abcd")));
}

spec md5_round_constants {
    then std::array::len(md5_round_constants()) == 64;
    // The first and last constants, floor(abs(sin(1)) * 2^32) and
    // floor(abs(sin(64)) * 2^32) — the RFC's own derivation.
    then std::array::get(md5_round_constants(), 0) == 3614090360;
    then std::array::get(md5_round_constants(), 63) == 3951481745;
    // Every constant fits in 32 bits.
    then std::array::get(md5_round_constants(), 32) == 4294588738;
}

spec md5_shifts {
    then std::array::len(md5_shifts()) == 64;
    // The four per-round groups: 7/12/17/22, 5/9/14/20, 4/11/16/23, 6/10/15/21.
    then std::array::get(md5_shifts(), 0) == 7;
    then std::array::get(md5_shifts(), 16) == 5;
    then std::array::get(md5_shifts(), 32) == 4;
    then std::array::get(md5_shifts(), 48) == 6;
    then std::array::get(md5_shifts(), 63) == 21;
}

spec push_le32 {
    // Like `push_be32`, this mutates its argument and returns `()`, so it is
    // called directly in a `when` step and its effect observed through the
    // array it appended to.
    when var out = std::array::empty();
    when push_le32(out, 258);
    then std::array::len(out) == 4;
    // Little-endian: the low byte comes FIRST, the opposite of push_be32,
    // which writes 258 as 0,0,1,2.
    then std::array::get(out, 0) == 2;
    then std::array::get(out, 1) == 1;
    then std::array::get(out, 3) == 0;
}

spec "push_le32 truncates to 32 bits" {
    // Only the low 32 bits are written; the high half is discarded rather
    // than trapping or spilling into a fifth byte.
    when var out = std::array::empty();
    when push_le32(out, 4294967296);
    then std::array::len(out) == 4;
    then std::array::get(out, 0) == 0;
    then std::array::get(out, 3) == 0;
}
