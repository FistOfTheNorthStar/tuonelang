module geometry;

// geometry — the middle layer of the dogfooding workspace.
//
// Integer-lattice geometry built on `numeric`. This layer surfaces a real v0
// limitation (recorded in DOGFOODING.md and ADR-0004): with no product type in
// the runnable core, a "point" cannot be one value — every point is passed as a
// separate `x`/`y` pair. The functions are still genuine geometry, and each is
// pinned by a spec.

import numeric::abs;
import numeric::max;
import numeric::isqrt;

/// Manhattan (taxicab) distance between two lattice points. The natural metric
/// when only integer moves are allowed, and exact in integer arithmetic.
pub fn manhattan(take ax: Int, take ay: Int, take bx: Int, take by: Int) -> Int {
    abs(ax - bx) + abs(ay - by)
}

/// Chebyshev (chessboard) distance: the max of the per-axis gaps.
pub fn chebyshev(take ax: Int, take ay: Int, take bx: Int, take by: Int) -> Int {
    max(abs(ax - bx), abs(ay - by))
}

/// The squared Euclidean distance — exact in integers (no square root taken).
pub fn dist_squared(take ax: Int, take ay: Int, take bx: Int, take by: Int) -> Int {
    let dx = ax - bx;
    let dy = ay - by;
    dx * dx + dy * dy
}

/// The Euclidean distance, floored to an integer via `numeric::isqrt`.
pub fn dist_floor(take ax: Int, take ay: Int, take bx: Int, take by: Int) -> Int {
    isqrt(dist_squared(ax, ay, bx, by))
}

/// Twice the signed area of the triangle (a, b, c) — the 2D cross product. Its
/// sign tells orientation: > 0 counter-clockwise, < 0 clockwise, 0 collinear.
pub fn cross(
    take ax: Int,
    take ay: Int,
    take bx: Int,
    take by: Int,
    take cx: Int,
    take cy: Int,
) -> Int {
    (bx - ax) * (cy - ay) - (by - ay) * (cx - ax)
}

/// The area of an axis-aligned rectangle given two opposite corners.
pub fn rect_area(take ax: Int, take ay: Int, take bx: Int, take by: Int) -> Int {
    abs(bx - ax) * abs(by - ay)
}

spec manhattan {
    then manhattan(0, 0, 3, 4) == 7;
    then manhattan(1, 1, 1, 1) == 0;
    then manhattan(0 - 2, 0 - 3, 2, 3) == 10;
}

spec chebyshev {
    then chebyshev(0, 0, 3, 4) == 4;
    then chebyshev(0, 0, 5, 1) == 5;
}

spec dist_squared {
    then dist_squared(0, 0, 3, 4) == 25;
    then dist_squared(1, 2, 4, 6) == 25;
}

spec dist_floor {
    then dist_floor(0, 0, 3, 4) == 5;
    then dist_floor(0, 0, 2, 2) == 2;
}

spec cross {
    // (0,0)->(1,0)->(1,1) turns counter-clockwise: positive.
    then cross(0, 0, 1, 0, 1, 1) == 1;
    // collinear points give zero.
    then cross(0, 0, 2, 2, 4, 4) == 0;
}

spec rect_area {
    then rect_area(0, 0, 4, 3) == 12;
    then rect_area(2, 2, 0 - 1, 0 - 1) == 9;
}
