module app;

// app — the binary at the top of the dogfooding workspace's transitive graph
// (app -> geometry -> numeric, and app -> numeric directly).
//
// It computes the total Manhattan length of a fixed polyline through five
// lattice waypoints, plus the floored Euclidean length of its first leg, using
// the `geometry` and `numeric` libraries. `main` returns the total path length
// as the process exit status. Runnable with `tuo run`, spec-checked with
// `tuo test`.

import geometry::Point;
import geometry::point;
import geometry::manhattan;
import geometry::dist_floor;
import numeric::max;

// The polyline: five waypoints on the integer lattice, each a `Point`.
fn p0() -> Point {
    point(0, 0)
}
fn p1() -> Point {
    point(3, 4)
}
fn p2() -> Point {
    point(3, 10)
}
fn p3() -> Point {
    point(8, 10)
}
fn p4() -> Point {
    point(8, 2)
}

/// The total Manhattan length of the four-leg polyline.
fn path_length() -> Int {
    let leg0 = manhattan(p0(), p1());
    let leg1 = manhattan(p1(), p2());
    let leg2 = manhattan(p2(), p3());
    let leg3 = manhattan(p3(), p4());
    leg0 + leg1 + leg2 + leg3
}

/// The floored straight-line length of the first leg, for comparison.
fn first_leg_euclidean() -> Int {
    dist_floor(p0(), p1())
}

/// The longer of the two figures — exercising a direct `numeric` dependency
/// alongside the `geometry` one, so `app` depends on both libraries.
fn headline() -> Int {
    max(path_length(), first_leg_euclidean())
}

fn main() -> Int {
    headline()
}

spec path_length {
    // legs: (0,0)->(3,4)=7, (3,4)->(3,10)=6, (3,10)->(8,10)=5, (8,10)->(8,2)=8
    then path_length() == 26;
}

spec first_leg_euclidean {
    // (0,0)->(3,4): sqrt(25) = 5
    then first_leg_euclidean() == 5;
}

spec main {
    then main() == 26;
}
