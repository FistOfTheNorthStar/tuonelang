module cli_stats;

import std::io;

// cli-stats — a command-line statistics tool, dogfooded on the v0 core.
//
// A real CLI reads a list of numbers from argv or stdin and prints summary
// statistics. v0 still has no argument access (no argv effect primitive), so
// this program holds its dataset in a fixed `[Int; 7]` array — but since
// ADR-0006 (accepted) landed the effect boundary, it *prints its report* to
// stdout through `std::io::print`/`println` before returning `report()` as
// its exit status. The `std::io` module is the standard library consumed as
// input: `src/std_io.tuo` is a verbatim copy of `tdg-stdlib`'s `std/io.tuo`,
// pinned byte-for-byte against the catalog by
// `crates/tuo-cli/tests/dogfood_examples.rs` so it can never drift.
//
// Everything below is genuine, non-toy computation: a numeric reduction
// library (count, sum, min, max, mean, range, a scaled variance, and a bounded
// integer square root) written entirely in the runnable subset, with
// executable `spec` blocks pinning each pure function. The printing shell is
// the EFFECT tier: effectful functions can carry no spec (`R0007`), so the
// dogfood test asserts the exact bytes `main` prints instead. It compiles
// with `tuo check`, its specs run under `tuo test`, and it runs natively with
// `tuo run` — stdout is the four-line report below and the exit status is
// `report()`'s value truncated to a byte:
//
//   count 7
//   mean 12
//   sd 6
//   report 18

// --- The dataset -----------------------------------------------------------
//
// Seven sample observations. A real build would populate these from argv; here
// they are the program's fixed input. Chosen so the derived statistics land in
// distinct, easily-checked values.

fn data() -> [Int; 7] {
    [12, 7, 23, 4, 16, 9, 19]
}

/// The number of observations — the declared length of `data()`'s type.
fn count() -> Int {
    7
}

// --- Reductions ------------------------------------------------------------

/// The arithmetic sum of the whole dataset.
fn sum() -> Int {
    var total = 0;
    for x in data() {
        total = total + x;
    }
    total
}

/// The smaller of two values.
fn min2(take a: Int, take b: Int) -> Int {
    if a < b {
        a
    } else {
        b
    }
}

/// The larger of two values.
fn max2(take a: Int, take b: Int) -> Int {
    if a > b {
        a
    } else {
        b
    }
}

/// The smallest observation.
fn minimum() -> Int {
    let xs = data();
    var lowest = xs[0];
    for x in xs {
        lowest = min2(lowest, x);
    }
    lowest
}

/// The largest observation.
fn maximum() -> Int {
    let xs = data();
    var highest = xs[0];
    for x in xs {
        highest = max2(highest, x);
    }
    highest
}

/// The spread between the extremes.
fn range() -> Int {
    maximum() - minimum()
}

/// The integer mean (floored): total / count.
fn mean() -> Int {
    sum() / count()
}

/// The sum of squared deviations from the mean, a scaled dispersion measure
/// that avoids the fractional division a true variance would need.
fn sq_dev(take x: Int, take m: Int) -> Int {
    (x - m) * (x - m)
}

fn dispersion() -> Int {
    let m = mean();
    var total = 0;
    for x in data() {
        total = total + sq_dev(x, m);
    }
    total
}

/// A bounded integer square root by linear search: the largest `r` with
/// `r*r <= n`, capped so the recursion is provably finite on the scalar core.
fn isqrt_from(take n: Int, take r: Int) -> Int {
    if r * r > n {
        r - 1
    } else {
        if r > 1000 {
            r
        } else {
            isqrt_from(n, r + 1)
        }
    }
}

fn isqrt(take n: Int) -> Int {
    if n < 0 {
        0
    } else {
        isqrt_from(n, 0)
    }
}

/// The integer standard deviation (floored): the square root of the mean
/// squared deviation. For this dataset it floors to 6.
fn sd() -> Int {
    isqrt(dispersion() / count())
}

/// A single reported figure small enough to survive exit-status truncation:
/// the mean plus the integer standard deviation. For this dataset mean = 12
/// and the standard deviation floors to 6, so the program exits 18.
fn report() -> Int {
    mean() + sd()
}

// --- The printing shell (EFFECT tier) --------------------------------------
//
// Real output over the ADR-0006 effect boundary, through the `std::io` module
// consumed as input. v0 has no owned String to format into (allocator ADR),
// so decimal rendering prints digit-by-digit from a static digit table — a
// pure `digit_str` (spec-checked) under an effectful writer (no spec, R0007;
// pinned by the dogfood test's exact-stdout assertion).

/// The digit character for one decimal digit 0..=9 — the static text a digit
/// prints as. Pure, so it is spec-checked.
fn digit_str(take d: Int) -> Str {
    if d == 0 {
        "0"
    } else if d == 1 {
        "1"
    } else if d == 2 {
        "2"
    } else if d == 3 {
        "3"
    } else if d == 4 {
        "4"
    } else if d == 5 {
        "5"
    } else if d == 6 {
        "6"
    } else if d == 7 {
        "7"
    } else if d == 8 {
        "8"
    } else {
        "9"
    }
}

/// The bytes a write reported, or -1 on an I/O error. Pure over the
/// already-computed `Result`, so it is spec-checked.
fn ok_bytes(take outcome: Result[Int, std::io::IoError]) -> Int {
    match outcome {
        Ok { value } => value,
        Err { error } => 0 - 1,
    }
}

/// EFFECT: print one decimal digit via `std::io::print`; bytes written.
fn print_digit(take d: Int) -> Int {
    ok_bytes(std::io::print(digit_str(d)))
}

/// EFFECT: print a non-negative integer in decimal (most significant digit
/// first, by recursion); bytes written. The statistics here are all
/// non-negative, so no sign handling is needed.
fn print_uint(take n: Int) -> Int {
    if n < 10 {
        print_digit(n)
    } else {
        let high = print_uint(n / 10);
        high + print_digit(n % 10)
    }
}

/// EFFECT: print one `label value` report line; bytes written. The trailing
/// `println("")` supplies the newline.
fn print_stat(in label: Str, take value: Int) -> Int {
    let wrote_label = ok_bytes(std::io::print(label));
    let wrote_value = print_uint(value);
    let wrote_newline = ok_bytes(std::io::println(""));
    wrote_label + wrote_value + wrote_newline
}

/// EFFECT: print the whole four-line report; bytes written. The exact bytes
/// are asserted by `crates/tuo-cli/tests/dogfood_examples.rs`.
fn print_report() -> Int {
    let a = print_stat("count ", count());
    let b = print_stat("mean ", mean());
    let c = print_stat("sd ", sd());
    let d = print_stat("report ", report());
    a + b + c + d
}

fn main() -> Int {
    print_report();
    report()
}

// --- Executable specs ------------------------------------------------------

spec "sum totals the dataset" {
    then sum() == 90;
}

spec "extremes are found" {
    then minimum() == 4;
    then maximum() == 23;
    then range() == 19;
}

spec "mean floors the average" {
    then mean() == 12;
}

spec min2 {
    then min2(3, 7) == 3;
    then min2(7, 3) == 3;
    then min2(5, 5) == 5;
}

spec max2 {
    then max2(3, 7) == 7;
    then max2(7, 3) == 7;
    then max2(5, 5) == 5;
}

spec isqrt {
    then isqrt(0) == 0;
    then isqrt(1) == 1;
    then isqrt(15) == 3;
    then isqrt(16) == 4;
    then isqrt(24) == 4;
    then isqrt(25) == 5;
}

spec "the standard deviation floors to six" {
    then sd() == 6;
}

spec "report is the mean plus the integer standard deviation" {
    then report() == 18;
}

spec digit_str {
    then digit_str(0) == "0";
    then digit_str(4) == "4";
    then digit_str(9) == "9";
}

spec ok_bytes {
    then ok_bytes(Ok { value: 3 }) == 3;
    then ok_bytes(Err { error: std::io::IoError::Other }) == 0 - 1;
}
