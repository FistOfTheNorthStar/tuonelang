module short_circuit_heap_temporary;

// REGRESSION: a heap-allocating temporary in a short-circuit operand lowered
// to MIR that failed the verifier:
//
//     error: codegen: internal: lowered MIR failed verification
//
// The front end accepts this program (`tuo check` passes); only `build`/`run`
// fail, so the bug is in HIR->MIR lowering, not in any earlier stage.
//
// The cause is the conditional drop: `&&` and `||` evaluate their right
// operand only sometimes, so a temporary created there must be dropped on one
// path and not the other. Binding both sides to locals first makes the drops
// unconditional and lowers correctly, which is the workaround
// `std::ed25519::points_equal` documents.
//
// Found while writing Ed25519 verification, 2026-09-13.

fn allocates(take n: Int) -> Array[Int] {
    var out = std::array::empty();
    std::array::push(out, n);
    out
}

/// The failing shape: a heap temporary on the right of `&&`.
fn conjunction(take a: Int, take b: Int) -> Bool {
    std::array::len(allocates(a)) == 1 && std::array::len(allocates(b)) == 1
}

/// The same for `||`.
fn disjunction(take a: Int, take b: Int) -> Bool {
    std::array::len(allocates(a)) == 2 || std::array::len(allocates(b)) == 1
}

/// The workaround: bind first, so neither drop is conditional.
fn bound_first(take a: Int, take b: Int) -> Bool {
    let left = std::array::len(allocates(a)) == 1;
    let right = std::array::len(allocates(b)) == 1;
    left && right
}

fn main() -> Int {
    var bad = 0;
    if !conjunction(1, 2) {
        bad = bad + 1;
    }
    if !disjunction(1, 2) {
        bad = bad + 2;
    }
    if !bound_first(1, 2) {
        bad = bad + 4;
    }
    bad
}
