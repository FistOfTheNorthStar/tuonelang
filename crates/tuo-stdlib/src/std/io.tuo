// std::io — standard input and output.
//
//   Executable tier — the error vocabulary (`IoError`) and pure classification
//   helpers over it. Deciding what an error means is computation; it runs and
//   is spec-checked.
//
//   Effect tier — the real writes (`print`, `println`), implemented in
//   tuonelang over the `std::rt::write` effect primitive (ADR-0006). They
//   compile and run natively, but an effectful function can never appear in a
//   spec (`R0007` keeps the spec sandbox pure), so each is pinned by a native
//   CLI test instead of a spec and marked `EFFECT:`.
//
//   `read_line` joined the effect tier when ADR-0009 landed the allocator: it
//   builds an owned, growable `String` from the bytes `std::rt::read_byte`
//   yields, stopping at a newline or EOF. Effectful, so no spec (`R0007`);
//   pinned by a native CLI test.
//
// One I/O error type, one obvious way to test it — no parallel error hierarchies.

module std::io;

// ----------------------------------------------------------------------------
// IoError — the outcome vocabulary for I/O. Executable tier.
// ----------------------------------------------------------------------------

/// Why an I/O operation failed.
///
/// A closed, ordered enumeration; every I/O contract below reports failure as
/// one of these. `Ok` is not a member — success is carried by `Result`'s `Ok`.
pub enum IoError {
    /// The stream reached end-of-file before the request completed.
    Eof,
    /// The operation was refused for lack of permission.
    PermissionDenied,
    /// The stream was closed or broken.
    BrokenPipe,
    /// Any other failure not distinguished above.
    Other,
}

/// A stable numeric code for an `IoError`, for machine-readable reporting.
///
/// The mapping is fixed: `Eof`=0, `PermissionDenied`=1, `BrokenPipe`=2,
/// `Other`=3.
///
/// # Example
/// ```tuo
/// let c = std::io::error_code(IoError::Eof); // 0
/// ```
pub fn error_code(in e: IoError) -> Int {
    match e {
        IoError::Eof => 0,
        IoError::PermissionDenied => 1,
        IoError::BrokenPipe => 2,
        IoError::Other => 3,
    }
}

/// Is this failure end-of-file, as opposed to a real error?
///
/// A clean read that simply ran out of input is often not an error at the call
/// site; this is the one obvious way to ask.
///
/// # Example
/// ```tuo
/// let b = std::io::is_eof(IoError::Eof); // true
/// ```
pub fn is_eof(in e: IoError) -> Bool {
    match e {
        IoError::Eof => true,
        IoError::PermissionDenied => false,
        IoError::BrokenPipe => false,
        IoError::Other => false,
    }
}

// ----------------------------------------------------------------------------
// Writes — the EFFECT tier.
//
// Real tuonelang implementations over the `std::rt::write` effect primitive.
// Each returns `Result[Int, IoError]`: the bytes written, or a classified
// failure. Effectful, so specs are impossible here by rule (`R0007`); the
// native CLI tests named in each doc are the executable pin.
// ----------------------------------------------------------------------------

/// EFFECT (executable and effectful): write `text` to standard output.
///
/// Implemented over `std::rt::write` (fd 1). Returns the number of bytes
/// written on success; a negative host return maps to
/// `Err { error: IoError::Other }`. An effectful function cannot carry a spec
/// (`R0007` keeps the spec sandbox pure), so this is pinned by the native CLI
/// tests in `crates/tuo-cli/tests/stdlib.rs` instead.
///
/// # Example
/// ```tuo
/// let n = std::io::print("hello"); // Ok { value: 5 }, "hello" on stdout
/// ```
pub fn print(in text: Str) -> Result[Int, IoError] {
    let written = std::rt::write(1, text);
    if written < 0 {
        Err { error: IoError::Other }
    } else {
        Ok { value: written }
    }
}

/// EFFECT (executable and effectful): write `text` followed by a newline to
/// standard output.
///
/// Implemented as two `std::rt::write` calls to fd 1 — the text, then a
/// one-byte `"\n"`. Two writes is the documented behavior, not an atomicity
/// promise. On success the `Ok` value is the byte total (text bytes + 1);
/// either write returning a negative host value maps to
/// `Err { error: IoError::Other }`. Effectful, so no spec (`R0007`); pinned by
/// the native CLI tests in `crates/tuo-cli/tests/stdlib.rs`.
///
/// # Example
/// ```tuo
/// let n = std::io::println("hi"); // Ok { value: 3 }, "hi\n" on stdout
/// ```
pub fn println(in text: Str) -> Result[Int, IoError] {
    let written = std::rt::write(1, text);
    if written < 0 {
        Err { error: IoError::Other }
    } else {
        let newline = std::rt::write(1, "\n");
        if newline < 0 {
            Err { error: IoError::Other }
        } else {
            Ok { value: written + newline }
        }
    }
}

/// EFFECT (executable and effectful): read one line from standard input.
///
/// Reads bytes from fd 0 with `std::rt::read_byte`, accumulating them into an
/// owned `String` (ADR-0009's allocator core), and stops at the first newline
/// (byte 10, which is consumed but **not** included) or at end-of-input. On
/// success the `Ok` value is the line without its trailing newline — possibly
/// the empty string (a blank line, or a final line with no newline). When the
/// stream is already at EOF (the very first read returns a negative host value)
/// the result is `Err { error: IoError::Eof }`, so a caller can tell "blank
/// line" from "no more input" apart. A negative host value *after* some bytes
/// were read ends the line at what was read so far (EOF without a trailing
/// newline). Effectful, so no spec (`R0007`); pinned by the native CLI tests in
/// `crates/tuo-cli/tests/stdlib.rs`.
///
/// # Example
/// ```tuo
/// // match std::io::read_line() { Ok { value } => …, Err { error } => … }
/// ```
pub fn read_line() -> Result[String, IoError] {
    // Read the first byte up front: an immediate negative value is EOF with
    // nothing read, the one case that reports `Err`. Handling it before the
    // buffer is built keeps `line` moved on exactly one path (the `Ok`), which
    // the ownership checker requires — tuonelang inserts no hidden drop flags.
    let first = std::rt::read_byte(0);
    if first < 0 {
        return Err { error: IoError::Eof };
    }
    var line = std::string::empty();
    if first != 10 {
        std::string::push_byte(line, first);
        var done = false;
        while !done {
            let byte = std::rt::read_byte(0);
            if byte < 0 {
                done = true;
            } else if byte == 10 {
                done = true;
            } else {
                std::string::push_byte(line, byte);
            }
        }
    }
    Ok { value: line }
}

// ----------------------------------------------------------------------------
// Specs — pure executable tier only. The effect tier (`print`, `println`,
// `read_line`) is pinned by native CLI tests, since `R0007` forbids an
// effectful spec (never claim an effect that cannot run passed a test).
// ----------------------------------------------------------------------------

spec error_code {
    then error_code(IoError::Eof) == 0;
    then error_code(IoError::PermissionDenied) == 1;
    then error_code(IoError::BrokenPipe) == 2;
    then error_code(IoError::Other) == 3;
}

spec is_eof {
    then is_eof(IoError::Eof);
    then !is_eof(IoError::BrokenPipe);
    then !is_eof(IoError::Other);
}
