/// The sample ClientHello truncated to `n` bytes — hostile input.
fn truncated_hello(take n: Int) -> Array[Int] {
    var out = std::array::empty();
    var i = 0;
    while i < n {
        std::array::push(out, std::array::get(sample_hello(), i));
        i = i + 1;
    }
    out
}

spec byte_at {
    then byte_at(sample_hello(), 0) == handshake_client_hello();
    // Out of bounds answers -1, never a trap.
    then byte_at(sample_hello(), 0 - 1) == 0 - 1;
    then byte_at(sample_hello(), 99999) == 0 - 1;
    then byte_at(std::array::empty(), 0) == 0 - 1;
}

spec u16_at {
    // The legacy_version field is 0x0303.
    then u16_at(sample_hello(), 4) == 771;
    then u16_at(sample_hello(), 99999) == 0 - 1;
    then u16_at(std::array::empty(), 0) == 0 - 1;
}

spec u24_at {
    // The handshake length field equals the body length minus its header.
    then u24_at(sample_hello(), 1) == std::array::len(sample_hello()) - 4;
    then u24_at(std::array::empty(), 0) == 0 - 1;
}

spec push_u16 {
    then std::array::len(frame_record(content_handshake(), std::array::empty())) == 5;
}

spec push_u24 {
    then std::array::len(wrap_handshake(handshake_finished(), std::array::empty())) == 4;
}

spec push_bytes {
    then std::array::len(frame_record(content_handshake(), sample_hello()))
        == std::array::len(sample_hello()) + 5;
}

spec slice {
    then std::array::len(slice(sample_hello(), 0, 10)) == 10;
    // A range that runs past the end yields EMPTY rather than a short read —
    // a truncated field that silently becomes a shorter one is how a parser
    // authenticates something other than what arrived.
    then std::array::len(slice(sample_hello(), 0, 999999)) == 0;
    then std::array::len(slice(sample_hello(), 0 - 1, 4)) == 0;
    then std::array::len(slice(sample_hello(), 0, 0 - 1)) == 0;
}

spec bad_record {
    then !record_ok(bad_record());
}

spec record_ok {
    then !record_ok(bad_record());
}

spec read_record {
    // A handshake record framing the sample hello parses back.
    then record_ok(read_record(frame_record(content_handshake(), sample_hello()), 0));
    then read_record(frame_record(content_handshake(), sample_hello()), 0).content_type
        == content_handshake();
    then read_record(frame_record(content_handshake(), sample_hello()), 0).length
        == std::array::len(sample_hello());
    // Hostile input: empty, truncated, and a length past the data.
    then !record_ok(read_record(std::array::empty(), 0));
    then !record_ok(read_record(sample_hello(), 99999));
}

spec frame_record {
    // The wire version is always 0x0303, whatever version is negotiated.
    then std::array::get(frame_record(content_handshake(), std::array::empty()), 1) == 3;
    then std::array::get(frame_record(content_handshake(), std::array::empty()), 2) == 3;
    then std::array::get(frame_record(content_handshake(), std::array::empty()), 0)
        == content_handshake();
}

spec wrap_handshake {
    then std::array::get(wrap_handshake(handshake_finished(), std::array::empty()), 0)
        == handshake_finished();
    then std::array::len(wrap_handshake(handshake_finished(), sample_hello()))
        == std::array::len(sample_hello()) + 4;
}

spec hello_extensions_start {
    then hello_extensions_start(sample_hello()) == 83;
    // Hostile input answers rather than trapping.
    then hello_extensions_start(std::array::empty()) == 0 - 1;
    then hello_extensions_start(truncated_hello(40)) == 0 - 1;
}

spec hello_extensions_length {
    then hello_extensions_length(sample_hello()) > 0;
    then hello_extensions_length(std::array::empty()) == 0 - 1;
}

spec hello_extension {
    // The real hello carries key_share and supported_versions.
    then std::array::len(hello_extension(sample_hello(), extension_key_share())) > 0;
    then std::array::len(hello_extension(sample_hello(), extension_supported_versions())) > 0;
    // An extension it does not carry yields empty rather than garbage.
    then std::array::len(hello_extension(sample_hello(), 60000)) == 0;
    then std::array::len(hello_extension(std::array::empty(), extension_key_share())) == 0;
}

spec hello_offers_suite {
    then hello_offers_suite(sample_hello());
    then !hello_offers_suite(std::array::empty());
    then !hello_offers_suite(truncated_hello(60));
}

spec hello_offers_tls13 {
    // TLS 1.3 is negotiated ONLY through this extension — the version fields
    // both say "TLS 1.2", so a server trusting them never speaks 1.3.
    then hello_offers_tls13(sample_hello());
    then !hello_offers_tls13(std::array::empty());
}

spec hello_key_share {
    then std::array::len(hello_key_share(sample_hello())) == 32;
    then std::array::len(hello_key_share(std::array::empty())) == 0;
    then std::array::len(hello_key_share(truncated_hello(100))) == 0;
}

spec hello_random {
    then std::array::len(hello_random(sample_hello())) == 32;
    then std::array::len(hello_random(std::array::empty())) == 0;
}

spec hello_session_id {
    // OpenSSL sends a 32-byte legacy session id, which the server must echo.
    then std::array::len(hello_session_id(sample_hello())) == 32;
    then std::array::len(hello_session_id(std::array::empty())) == 0;
}

spec hello_acceptable {
    then hello_acceptable(sample_hello());
    // Every truncation is refused rather than trapping.
    then !hello_acceptable(std::array::empty());
    then !hello_acceptable(truncated_hello(1));
    then !hello_acceptable(truncated_hello(50));
    then !hello_acceptable(truncated_hello(200));
}

spec server_hello {
    // The reply echoes the client's session id — a middlebox-compatibility
    // requirement, not a choice.
    then std::array::get(server_hello(sample_hello(), zeros32(), zeros32()), 0)
        == handshake_server_hello();
    then std::array::len(server_hello(sample_hello(), zeros32(), zeros32())) > 40;
}

spec encrypted_extensions {
    // Empty, but present: a client that does not receive it aborts.
    then std::array::get(encrypted_extensions(), 0) == handshake_encrypted_extensions();
    then std::array::len(encrypted_extensions()) == 6;
}

spec certificate_message {
    then std::array::get(certificate_message(zeros32()), 0) == handshake_certificate();
    then std::array::len(certificate_message(zeros32())) > 32;
}

spec certificate_verify_content {
    // 64 spaces, a 33-byte context string, a zero byte, then the hash.
    then std::array::len(certificate_verify_content(zeros32())) == 64 + 33 + 1 + 32;
    then std::array::get(certificate_verify_content(zeros32()), 0) == 32;
    then std::array::get(certificate_verify_content(zeros32()), 63) == 32;
    // 'T' of "TLS 1.3, server CertificateVerify".
    then std::array::get(certificate_verify_content(zeros32()), 64) == 84;
    // The zero separator.
    then std::array::get(certificate_verify_content(zeros32()), 97) == 0;
}

spec certificate_verify_message {
    then std::array::get(certificate_verify_message(zeros32()), 0)
        == handshake_certificate_verify();
    // The signature algorithm is ed25519 (0x0807).
    then u16_at(certificate_verify_message(zeros32()), 4) == signature_ed25519();
}

spec finished_data {
    then std::array::len(finished_data(zeros32(), zeros32())) == 32;
}

spec finished_message {
    then std::array::get(finished_message(zeros32(), zeros32()), 0) == handshake_finished();
    then std::array::len(finished_message(zeros32(), zeros32())) == 36;
}

spec inner_content_type {
    // The real type is the last NON-ZERO byte: trailing zeros are padding.
    then inner_content_type(one_then(content_handshake())) == content_handshake();
    then inner_content_type(std::array::empty()) == 0 - 1;
}

spec inner_payload {
    then std::array::len(inner_payload(one_then(content_handshake()))) == 1;
    then std::array::len(inner_payload(std::array::empty())) == 0;
}

spec transcript_hash {
    then std::array::len(transcript_hash(sample_hello())) == 32;
    then std::array::len(transcript_hash(std::array::empty())) == 32;
}

spec content_handshake {
    then content_handshake() == 22;
}

spec content_application_data {
    // Every encrypted record's OUTER type is 23, whatever it contains.
    then content_application_data() == 23;
}

spec content_alert {
    then content_alert() == 21;
}

spec content_change_cipher_spec {
    then content_change_cipher_spec() == 20;
}

spec max_plaintext {
    then max_plaintext() == 16384;
}

spec max_ciphertext {
    then max_ciphertext() == 16640;
    then max_ciphertext() > max_plaintext();
}

spec cipher_suite {
    then cipher_suite() == 4867;
}

spec group_x25519 {
    then group_x25519() == 29;
}

spec signature_ed25519 {
    then signature_ed25519() == 2055;
}

spec version_tls13 {
    then version_tls13() == 772;
}

spec extension_supported_versions {
    then extension_supported_versions() == 43;
}

spec extension_key_share {
    then extension_key_share() == 51;
}

spec extension_server_name {
    then extension_server_name() == 0;
}

spec handshake_client_hello {
    then handshake_client_hello() == 1;
}

spec handshake_server_hello {
    then handshake_server_hello() == 2;
}

spec handshake_encrypted_extensions {
    then handshake_encrypted_extensions() == 8;
}

spec handshake_certificate {
    then handshake_certificate() == 11;
}

spec handshake_certificate_verify {
    then handshake_certificate_verify() == 15;
}

spec handshake_finished {
    then handshake_finished() == 20;
}

spec failed_handshake {
    then !failed_handshake().ok;
    then std::array::len(failed_handshake().flight) == 0;
}

/// 32 zero bytes, for the specs above.
fn zeros32() -> Array[Int] {
    var a = std::array::empty();
    var i = 0;
    while i < 32 {
        std::array::push(a, 0);
        i = i + 1;
    }
    a
}

/// A one-byte payload followed by `kind` — a decrypted record's inner shape.
fn one_then(take kind: Int) -> Array[Int] {
    var a = std::array::empty();
    std::array::push(a, 65);
    std::array::push(a, kind);
    a
}

/// Whether a sealed record opens back to its own plaintext — the round trip
/// `spec seal_record` and `spec open_record` both assert.
fn record_round_trips() -> Bool {
    let key = zeros32();
    var iv = std::array::empty();
    var i = 0;
    while i < 12 {
        std::array::push(iv, 0);
        i = i + 1;
    }
    var payload = std::array::empty();
    std::array::push(payload, 65);
    std::array::push(payload, 66);
    let record = seal_record(key, iv, 0, content_handshake(), payload);
    let header = slice(record, 0, 5);
    let body = slice(record, 5, std::array::len(record) - 5);
    match open_record(key, iv, 0, header, body) {
        Some { value } => inner_content_type(value) == content_handshake(),
        None => false,
    }
}

/// Whether a record sealed at sequence 0 fails to open at sequence 1 — the
/// property that makes per-record nonces meaningful.
fn record_rejects_wrong_sequence() -> Bool {
    let key = zeros32();
    var iv = std::array::empty();
    var i = 0;
    while i < 12 {
        std::array::push(iv, 0);
        i = i + 1;
    }
    var payload = std::array::empty();
    std::array::push(payload, 65);
    let record = seal_record(key, iv, 0, content_handshake(), payload);
    let header = slice(record, 0, 5);
    let body = slice(record, 5, std::array::len(record) - 5);
    match open_record(key, iv, 1, header, body) {
        Some { value } => false,
        None => true,
    }
}

spec seal_record {
    // The outer type is always application_data, hiding the real type.
    then std::array::get(seal_record(zeros32(), zeros12(), 0, content_handshake(), zeros32()), 0)
        == content_application_data();
    // Header (5) + plaintext (32) + inner type (1) + tag (16).
    then std::array::len(seal_record(zeros32(), zeros12(), 0, content_handshake(), zeros32()))
        == 5 + 32 + 1 + 16;
    then record_round_trips();
}

spec open_record {
    // A record opens back to what was sealed…
    then record_round_trips();
    // …and NOT under a different sequence number, which is what makes the
    // per-record nonce construction load-bearing rather than decorative.
    then record_rejects_wrong_sequence();
}

/// 12 zero bytes — an all-zero IV, for the specs above.
fn zeros12() -> Array[Int] {
    var a = std::array::empty();
    var i = 0;
    while i < 12 {
        std::array::push(a, 0);
        i = i + 1;
    }
    a
}

spec client_handshake_secret {
    // RFC 8448's published secrets are pinned natively
    // (`tls_key_schedule_matches_rfc_8448`) — the derivation chain is several
    // HMAC passes, past the spec sandbox's fuel for a full check. What the
    // sandbox pins is the shape and, crucially, that the client and server
    // secrets DIFFER: deriving the same secret for both directions would let
    // an attacker replay a server record back at the server.
    then std::array::len(client_handshake_secret(zeros32(), zeros32())) == 32;
    then secrets_differ();
}

spec server_handshake_secret {
    then std::array::len(server_handshake_secret(zeros32(), zeros32())) == 32;
    then secrets_differ();
}

spec client_application_secret {
    then std::array::len(client_application_secret(zeros32(), zeros32())) == 32;
    // Handshake and application secrets must differ, or a handshake key
    // would also decrypt application data.
    then application_differs_from_handshake();
}

spec server_application_secret {
    then std::array::len(server_application_secret(zeros32(), zeros32())) == 32;
    then application_differs_from_handshake();
}

/// Whether the client and server handshake secrets differ.
fn secrets_differ() -> Bool {
    let c = client_handshake_secret(zeros32(), zeros32());
    let s = server_handshake_secret(zeros32(), zeros32());
    var i = 0;
    var found = false;
    while i < 32 {
        if std::array::get(c, i) != std::array::get(s, i) {
            found = true;
        }
        i = i + 1;
    }
    found
}

/// Whether the application secret differs from the handshake secret.
fn application_differs_from_handshake() -> Bool {
    let h = client_handshake_secret(zeros32(), zeros32());
    let a = client_application_secret(zeros32(), zeros32());
    var i = 0;
    var found = false;
    while i < 32 {
        if std::array::get(h, i) != std::array::get(a, i) {
            found = true;
        }
        i = i + 1;
    }
    found
}

spec server_handshake {
    // A malformed or unacceptable ClientHello must be REFUSED, not answered
    // with a flight built from garbage.
    then !server_handshake(
        std::array::empty(),
        zeros32(),
        zeros32(),
        zeros32(),
        zeros32(),
    ).ok;
    then !server_handshake(
        truncated_hello(100),
        zeros32(),
        zeros32(),
        zeros32(),
        zeros32(),
    ).ok;
    // The full handshake against a live OpenSSL client is pinned by
    // `tls_server_completes_handshake_with_openssl`.
}

spec signing_content {
    // The signed content always carries the 64-space prefix and the context
    // string, whatever the transcript.
    then std::array::get(signing_content(sample_hello(), zeros32(), zeros32(), zeros32()), 0) == 32;
    then std::array::get(signing_content(sample_hello(), zeros32(), zeros32(), zeros32()), 64) == 84;
    then std::array::len(signing_content(sample_hello(), zeros32(), zeros32(), zeros32()))
        == 64 + 33 + 1 + 32;
}

// --- A TLS connection: byte-oriented I/O over record-oriented crypto --------
//
// The record layer above deals in whole records; every protocol built on TLS
// wants a byte stream. Bridging those is the job of the buffer below, and it
// is where a naive integration goes wrong: HTTP reads a byte at a time, but a
// TLS record only exists once *all* of it has arrived and its tag has
// verified. Reading a byte therefore means "decrypt the next record if the
// buffer is empty, then hand back one byte of it".
//
// `Connection` carries the sequence numbers because TLS 1.3 nonces are
// derived from them (RFC 8446 §5.3): every record must use the next number in
// order, and a repeat would reuse a nonce — catastrophic for both
// confidentiality and the authenticator. Keeping them inside the connection
// makes reuse something a caller cannot express by accident.

/// An established TLS connection: the descriptor, the four traffic values,
/// the sequence numbers, and the pending plaintext of a partially-read
/// record.
struct Connection {
    socket: Int,
    /// The key the NEXT client record will be opened with. It starts as the
    /// client's handshake key and becomes the application key once the
    /// client's Finished has been read.
    client_key: Array[Int],
    client_iv: Array[Int],
    server_key: Array[Int],
    server_iv: Array[Int],
    /// The client's application-epoch key, held until the switch.
    client_application_key: Array[Int],
    /// The client's application-epoch IV, held until the switch.
    client_application_iv: Array[Int],
    /// Whether reads are still in the handshake epoch.
    client_epoch_is_handshake: Bool,
    read_sequence: Int,
    write_sequence: Int,
    pending: Array[Int],
    pending_offset: Int,
    /// False once the peer has closed or a record failed to authenticate.
    /// A failed record is fatal in TLS 1.3 — there is no resynchronizing.
    live: Bool,
}

/// Build a connection from a completed handshake.
///
/// # Example
///
/// ```tuo
/// let connection = std::tls::connect(socket, handshake);
/// ```
pub fn connect(take socket: Int, in handshake: Handshake) -> Connection {
    Connection {
        socket: socket,
        // Reading STARTS in the handshake epoch: the client's Finished
        // arrives under its handshake key, and only afterwards does it
        // switch to application keys. `fill` performs that switch when it
        // sees the Finished, which is why both key pairs are carried.
        client_key: copy_bytes(handshake.client_handshake_key),
        client_iv: copy_bytes(handshake.client_handshake_iv),
        server_key: copy_bytes(handshake.server_key),
        server_iv: copy_bytes(handshake.server_iv),
        client_application_key: copy_bytes(handshake.client_key),
        client_application_iv: copy_bytes(handshake.client_iv),
        client_epoch_is_handshake: true,
        read_sequence: 0,
        write_sequence: 0,
        pending: std::array::empty(),
        pending_offset: 0,
        live: handshake.ok,
    }
}

/// An owned copy of a borrowed byte array.
///
/// # Example
///
/// ```tuo
/// let owned = std::tls::copy_bytes(borrowed);
/// ```
pub fn copy_bytes(in bytes: Array[Int]) -> Array[Int] {
    var out = std::array::empty();
    var i = 0;
    while i < std::array::len(bytes) {
        std::array::push(out, std::array::get(bytes, i) & 255);
        i = i + 1;
    }
    out
}

/// The plaintext of a record, or an empty array when it failed to
/// authenticate.
///
/// A successfully opened record is never empty — it always carries at least
/// its inner content type byte — so empty unambiguously means failure. This
/// exists because `match` is an expression in v0, not a statement, so the
/// `Option` has to be collapsed to a value before the caller can branch on
/// it with side effects.
///
/// # Example
///
/// ```tuo
/// let plaintext = std::tls::opened_or_empty(key, iv, 0, header, body);
/// ```
pub fn opened_or_empty(
    in key: Array[Int],
    in iv: Array[Int],
    take sequence: Int,
    in header: Array[Int],
    in body: Array[Int],
) -> Array[Int] {
    match open_record(key, iv, sequence, header, body) {
        Some { value } => value,
        None => std::array::empty(),
    }
}

/// EFFECT: read and decrypt the next record into the connection's buffer.
///
/// Returns the inner content type, or -1 when the peer closed, the record
/// failed to authenticate, or it was malformed. A `change_cipher_spec` record
/// is skipped rather than surfaced: TLS 1.3 does not use it, but clients send
/// one purely to look like TLS 1.2 to middleboxes, and a server that treats it
/// as data or as an error rejects perfectly ordinary clients.
///
/// Effectful, so no spec (`R0007`); pinned natively by
/// `tls_serves_a_real_https_request` in `crates/tuo-cli/tests/stdlib.rs`.
pub fn fill(mut connection: Connection, take timeout_ms: Int) -> Int {
    if !connection.live {
        return 0 - 1;
    }
    var kind = 0 - 1;
    var scanning = true;
    while scanning {
        var header = std::array::empty();
        var i = 0;
        var header_ok = true;
        while i < 5 && header_ok {
            let b = std::rt::read_byte_timeout(connection.socket, timeout_ms);
            if b < 0 {
                header_ok = false;
            } else {
                std::array::push(header, b);
                i = i + 1;
            }
        }
        if !header_ok {
            connection.live = false;
            return 0 - 1;
        }
        let length = u16_at(header, 3);
        if length < 0 || length > max_ciphertext() {
            connection.live = false;
            return 0 - 1;
        }
        var body = std::array::empty();
        var j = 0;
        var body_ok = true;
        while j < length && body_ok {
            let b = std::rt::read_byte_timeout(connection.socket, timeout_ms);
            if b < 0 {
                body_ok = false;
            } else {
                std::array::push(body, b);
                j = j + 1;
            }
        }
        if !body_ok {
            connection.live = false;
            return 0 - 1;
        }
        let outer = byte_at(header, 0);
        if outer == content_change_cipher_spec() {
            // Middlebox compatibility: skip it and read the next record.
            scanning = true;
        } else {
            // `match` is an expression here, not a statement, so the
            // decrypted plaintext is bound first and the empty case stands
            // for failure. `open_record` never yields an empty plaintext on
            // success — every record carries at least its inner content
            // type byte — so the two are distinguishable.
            let plaintext = opened_or_empty(
                connection.client_key,
                connection.client_iv,
                connection.read_sequence,
                header,
                body,
            );
            if std::array::len(plaintext) == 0 {
                // A record that fails to authenticate is fatal: TLS 1.3 has
                // no way to resynchronize a stream, and continuing would
                // mean trusting bytes an attacker chose.
                connection.live = false;
                return 0 - 1;
            }
            connection.read_sequence = connection.read_sequence + 1;
            kind = inner_content_type(plaintext);
            connection.pending = inner_payload(plaintext);
            connection.pending_offset = 0;
            scanning = false;
            if connection.client_epoch_is_handshake && kind == content_handshake() {
                // That was the client's Finished. Everything after it comes
                // under the application key, with the record sequence
                // RESTARTING at zero — each epoch counts separately, and
                // carrying the count across would derive the wrong nonce for
                // every subsequent record.
                connection.client_key = copy_bytes(connection.client_application_key);
                connection.client_iv = copy_bytes(connection.client_application_iv);
                connection.client_epoch_is_handshake = false;
                connection.read_sequence = 0;
                // The Finished carries no application data, so keep reading.
                scanning = true;
            }
        }
    }
    kind
}

/// EFFECT: read one plaintext byte from the connection, decrypting a new
/// record when the buffer is empty.
///
/// Returns the byte, or -1 at end of stream. This is the shape a
/// byte-oriented protocol (HTTP, say) already expects, which is what lets an
/// existing server move onto TLS without restructuring its parser.
///
/// Effectful, so no spec (`R0007`); pinned natively by
/// `tls_serves_a_real_https_request` in `crates/tuo-cli/tests/stdlib.rs`.
pub fn read_byte(mut connection: Connection, take timeout_ms: Int) -> Int {
    var value = 0 - 1;
    var looking = true;
    while looking {
        if connection.pending_offset < std::array::len(connection.pending) {
            value = std::array::get(connection.pending, connection.pending_offset) & 255;
            connection.pending_offset = connection.pending_offset + 1;
            looking = false;
        } else {
            let kind = fill(connection, timeout_ms);
            if kind < 0 {
                looking = false;
            } else {
                if kind == content_alert() {
                    // An alert ends the stream. `close_notify` is the
                    // ordinary one; any other is a peer giving up.
                    connection.live = false;
                    looking = false;
                }
                // A handshake record after the handshake (a session ticket,
                // say) carries no application data: loop for the next record.
            }
        }
    }
    value
}

/// EFFECT: encrypt and write `plaintext` as one application-data record.
///
/// Returns the number of plaintext bytes written, or -1 on failure. Records
/// longer than `max_plaintext()` are refused rather than silently truncated —
/// `write_all` below splits them.
///
/// Effectful, so no spec (`R0007`); pinned natively by
/// `tls_serves_a_real_https_request` in `crates/tuo-cli/tests/stdlib.rs`.
pub fn write_record(mut connection: Connection, in plaintext: Array[Int]) -> Int {
    if !connection.live {
        return 0 - 1;
    }
    if std::array::len(plaintext) > max_plaintext() {
        return 0 - 1;
    }
    let record = seal_record(
        connection.server_key,
        connection.server_iv,
        connection.write_sequence,
        content_application_data(),
        plaintext,
    );
    connection.write_sequence = connection.write_sequence + 1;
    let written = std::rt::write(
        connection.socket,
        std::string::as_str(std::crypto::str_of_bytes(record)),
    );
    if written < 0 {
        connection.live = false;
        return 0 - 1;
    }
    std::array::len(plaintext)
}

/// EFFECT: write `text` as application data, splitting it across records when
/// it exceeds the per-record limit.
///
/// # Example
///
/// ```tuo
/// std::tls::write_all(connection, "HTTP/1.1 200 OK\r\n");
/// ```
///
/// Effectful, so no spec (`R0007`); pinned natively by
/// `tls_serves_a_real_https_request` in `crates/tuo-cli/tests/stdlib.rs`.
pub fn write_all(mut connection: Connection, in text: Str) -> Int {
    let total = std::str::len(text);
    var sent = 0;
    while sent < total {
        var chunk = std::array::empty();
        var i = 0;
        while i < max_plaintext() && sent + i < total {
            std::array::push(chunk, std::str::byte_at(text, sent + i));
            i = i + 1;
        }
        let wrote = write_record(connection, chunk);
        if wrote < 0 {
            return 0 - 1;
        }
        sent = sent + i;
    }
    sent
}

/// EFFECT: send a `close_notify` alert, the orderly way to end a TLS
/// connection (RFC 8446 §6.1).
///
/// Closing the socket without it is a truncation attack from the peer's point
/// of view — it cannot tell a finished stream from one an attacker cut short.
///
/// Effectful, so no spec (`R0007`); pinned natively by
/// `tls_serves_a_real_https_request` in `crates/tuo-cli/tests/stdlib.rs`.
pub fn close_notify(mut connection: Connection) -> Int {
    if !connection.live {
        return 0;
    }
    var alert = std::array::empty();
    // warning(1), close_notify(0).
    std::array::push(alert, 1);
    std::array::push(alert, 0);
    let record = seal_record(
        connection.server_key,
        connection.server_iv,
        connection.write_sequence,
        content_alert(),
        alert,
    );
    connection.write_sequence = connection.write_sequence + 1;
    std::rt::write(
        connection.socket,
        std::string::as_str(std::crypto::str_of_bytes(record)),
    );
    connection.live = false;
    0
}

spec copy_bytes {
    then std::array::len(copy_bytes(zeros32())) == 32;
    then std::array::len(copy_bytes(std::array::empty())) == 0;
    // A copy, not an alias: the source is unchanged by construction, and the
    // bytes match.
    then std::array::get(copy_bytes(one_then(7)), 1) == 7;
}

spec opened_or_empty {
    // A record that fails to authenticate collapses to empty, which is the
    // failure signal `fill` branches on. A genuine success is never empty —
    // every record carries at least its inner content type byte.
    then std::array::len(
        opened_or_empty(zeros32(), zeros12(), 0, std::array::empty(), std::array::empty()),
    ) == 0;
    then std::array::len(sealed_then_opened()) > 0;
}

/// A record sealed and immediately opened, for the spec above.
fn sealed_then_opened() -> Array[Int] {
    var payload = std::array::empty();
    std::array::push(payload, 65);
    let record = seal_record(zeros32(), zeros12(), 0, content_handshake(), payload);
    opened_or_empty(
        zeros32(),
        zeros12(),
        0,
        slice(record, 0, 5),
        slice(record, 5, std::array::len(record) - 5),
    )
}

spec connect {
    // A failed handshake yields a dead connection — a caller cannot
    // accidentally read or write on one.
    then !connect(0, failed_handshake()).live;
    // Reading starts in the HANDSHAKE epoch: the client's Finished arrives
    // under its handshake key, not the application key. Starting in the
    // wrong epoch made a real OpenSSL client's Finished fail to
    // authenticate, which is why this is asserted rather than assumed.
    then connect(0, failed_handshake()).client_epoch_is_handshake;
    then connect(0, failed_handshake()).read_sequence == 0;
    then connect(0, failed_handshake()).write_sequence == 0;
}
