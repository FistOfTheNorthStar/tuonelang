// std::tls — the TLS 1.3 handshake and record layer (RFC 8446).
//
// This is the module that turns the verified primitives into a protocol.
// `std::chacha`, `std::x25519`, `std::hkdf`, `std::sha512`, `std::ed25519`
// and `std::der` each match their RFC's published vectors; none of that
// matters on the wire unless the bytes around them are framed exactly as
// RFC 8446 says. This module is those bytes.
//
// THE PARSING HALF RUNS ON HOSTILE INPUT. A ClientHello arrives before any
// authentication has happened, from anyone who can open a socket. tuonelang
// traps on integer overflow and on out-of-bounds indexing, and a trap aborts
// the *process* — so every reader here is **total**, returning a failure
// value rather than trapping, exactly as `std::der` is. This is not a
// theoretical concern: a one-line unchecked length in this repository's HTTP
// router was a remote pre-authentication process kill.
//
// WHAT IS IMPLEMENTED. The server side of a full (non-resumption) handshake
// with X25519 key exchange, ChaCha20-Poly1305 records, and Ed25519
// certificates — the exact combination the primitives support:
//
//   * record framing (`TLSPlaintext` / `TLSCiphertext`) and its length limits
//   * ClientHello parsing: cipher suites, and the `key_share` /
//     `supported_versions` extensions
//   * ServerHello construction with the server's key share
//   * `EncryptedExtensions`, `Certificate`, `CertificateVerify`, `Finished`
//   * the transcript hash, and the `CertificateVerify` signature content
//   * record protection: per-record nonces, the inner content type, and the
//     AEAD seal/open
//
// WHAT IS DELIBERATELY NOT. No session resumption or PSK, no 0-RTT, no client
// certificates, no HelloRetryRequest, no key update, no RSA or P-256, and no
// X.509 chain validation (`std::der` decodes; it does not validate). Each is
// absent rather than stubbed, so nothing here claims a capability the code
// does not have.
//
// NOT CONSTANT TIME, WHICH IS THE LIMITATION THAT MATTERS MOST. This stack
// completes a real handshake with a real client, which makes it easy to
// mistake for something deployable. It is not, and the reason is timing
// rather than any missing feature.
//
// `std::bignum` is variable-time by design — correct for public values,
// unsafe for secrets — and both the key exchange and signing are built on it.
// So `std::x25519::scalar_mult` on the server's ephemeral private key, and
// `std::ed25519::sign` on the long-term key, take value-dependent time. An
// attacker able to measure that may be able to recover the key. The *shapes*
// are right where they can be — the Montgomery ladder's conditional swap is
// branchless, and tag comparison goes through `std::ct::bytes_eq` — but shape
// is not the guarantee; the arithmetic underneath is.
//
// Ed25519 **verification** is unaffected, since all of its inputs are public,
// so certificate checking is sound. It is the two secret-key operations that
// leak.
//
// Closing this means fixed-width field arithmetic that does not route through
// `std::bignum`, a substantial separate piece of work. Until then, treat this
// as a demonstration that the protocol is expressible in tuonelang, not as
// transport security for anything real.

module std::tls;

// --- Record layer (RFC 8446 §5) ---------------------------------------------

/// The `handshake` record content type (22).
///
/// # Example
///
/// ```tuo
/// let t = std::tls::content_handshake(); // 22
/// ```
pub fn content_handshake() -> Int {
    22
}

/// The `application_data` record content type (23) — also the outer type of
/// every encrypted record, whatever it actually contains.
pub fn content_application_data() -> Int {
    23
}

/// The `alert` record content type (21).
pub fn content_alert() -> Int {
    21
}

/// The `change_cipher_spec` content type (20), which TLS 1.3 does not use but
/// must tolerate: clients send it purely to look like TLS 1.2 to middleboxes.
pub fn content_change_cipher_spec() -> Int {
    20
}

/// The largest plaintext a single record may carry (RFC 8446 §5.1): 2^14.
///
/// A bound, not a preference. A record header declares its own length, so a
/// peer can claim any size it likes; reading that many bytes on trust is how
/// a parser becomes a memory-exhaustion vector.
pub fn max_plaintext() -> Int {
    16384
}

/// The largest ciphertext record body: the plaintext limit plus room for the
/// content type and the AEAD tag (RFC 8446 §5.2).
pub fn max_ciphertext() -> Int {
    16640
}

/// The byte at `index`, or -1 when the index is outside `bytes`.
///
/// Every read in this module goes through here, for the reason the module
/// header gives: indexing out of bounds traps, and this code parses
/// unauthenticated network input.
///
/// # Example
///
/// ```tuo
/// let b = std::tls::byte_at(record, 0); // 22 for a handshake record
/// ```
pub fn byte_at(in bytes: Array[Int], take index: Int) -> Int {
    if index < 0 || index >= std::array::len(bytes) {
        0 - 1
    } else {
        std::array::get(bytes, index) & 255
    }
}

/// A 16-bit big-endian value at `offset`, or -1 when it does not fit.
///
/// # Example
///
/// ```tuo
/// let length = std::tls::u16_at(record, 3);
/// ```
pub fn u16_at(in bytes: Array[Int], take offset: Int) -> Int {
    let high = byte_at(bytes, offset);
    let low = byte_at(bytes, offset + 1);
    if high < 0 || low < 0 {
        return 0 - 1;
    }
    (high << 8) | low
}

/// A 24-bit big-endian value at `offset` — the handshake message length
/// field's width — or -1 when it does not fit.
///
/// # Example
///
/// ```tuo
/// let length = std::tls::u24_at(message, 1);
/// ```
pub fn u24_at(in bytes: Array[Int], take offset: Int) -> Int {
    let a = byte_at(bytes, offset);
    let b = byte_at(bytes, offset + 1);
    let c = byte_at(bytes, offset + 2);
    if a < 0 || b < 0 || c < 0 {
        return 0 - 1;
    }
    (a << 16) | (b << 8) | c
}

/// Append a 16-bit big-endian value.
///
/// # Example
///
/// ```tuo
/// std::tls::push_u16(out, 771);
/// ```
pub fn push_u16(mut out: Array[Int], take value: Int) -> Int {
    std::array::push(out, (value >> 8) & 255);
    std::array::push(out, value & 255);
    0
}

/// Append a 24-bit big-endian value.
///
/// # Example
///
/// ```tuo
/// std::tls::push_u24(out, 128);
/// ```
pub fn push_u24(mut out: Array[Int], take value: Int) -> Int {
    std::array::push(out, (value >> 16) & 255);
    std::array::push(out, (value >> 8) & 255);
    std::array::push(out, value & 255);
    0
}

/// Append every byte of `bytes`.
///
/// # Example
///
/// ```tuo
/// std::tls::push_bytes(out, payload);
/// ```
pub fn push_bytes(mut out: Array[Int], in bytes: Array[Int]) -> Int {
    var i = 0;
    while i < std::array::len(bytes) {
        std::array::push(out, std::array::get(bytes, i) & 255);
        i = i + 1;
    }
    0
}

/// Copy `length` bytes from `offset`, or an empty array when the range is not
/// entirely present.
///
/// Returning empty for a bad range rather than a short read is deliberate: a
/// truncated field that silently becomes a shorter one is how a parser ends
/// up authenticating something other than what arrived.
///
/// # Example
///
/// ```tuo
/// let random = std::tls::slice(hello, 6, 32);
/// ```
pub fn slice(in bytes: Array[Int], take offset: Int, take length: Int) -> Array[Int] {
    var out = std::array::empty();
    if offset < 0 || length < 0 {
        return out;
    }
    if length > std::array::len(bytes) - offset {
        return out;
    }
    var i = 0;
    while i < length {
        let b = byte_at(bytes, offset + i);
        if b < 0 {
            return std::array::empty();
        }
        std::array::push(out, b);
        i = i + 1;
    }
    out
}

/// A parsed record header: its content type, body length, and where the body
/// begins. `body_start` is -1 when the header is malformed or the body is not
/// fully present.
struct Record {
    content_type: Int,
    body_start: Int,
    length: Int,
}

/// A record header that failed to parse.
///
/// # Example
///
/// ```tuo
/// let bad = std::tls::bad_record();
/// ```
pub fn bad_record() -> Record {
    Record { content_type: 0 - 1, body_start: 0 - 1, length: 0 - 1 }
}

/// Whether a record header parsed.
///
/// # Example
///
/// ```tuo
/// if std::tls::record_ok(r) { /* … */ }
/// ```
pub fn record_ok(in record: Record) -> Bool {
    record.body_start >= 0
}

/// Parse the five-byte record header at `offset` (RFC 8446 §5.1).
///
/// Refuses a length above `max_ciphertext()` and a body that is not entirely
/// present — the two checks that keep a lying length field from becoming
/// either a huge allocation or a read past the buffer.
///
/// # Example
///
/// ```tuo
/// let r = std::tls::read_record(buffer, 0);
/// ```
pub fn read_record(in bytes: Array[Int], take offset: Int) -> Record {
    let content_type = byte_at(bytes, offset);
    if content_type < 0 {
        return bad_record();
    }
    // The legacy version field is not checked: RFC 8446 requires it be
    // ignored, and middleboxes put various values there.
    let length = u16_at(bytes, offset + 3);
    if length < 0 || length > max_ciphertext() {
        return bad_record();
    }
    let start = offset + 5;
    if length > std::array::len(bytes) - start {
        return bad_record();
    }
    Record { content_type: content_type, body_start: start, length: length }
}

/// Frame `body` as a record of `content_type` (RFC 8446 §5.1).
///
/// The version field is always 0x0303 ("TLS 1.2") on the wire — TLS 1.3
/// negotiates its real version in an extension, because middleboxes drop
/// records that say anything newer.
///
/// # Example
///
/// ```tuo
/// let record = std::tls::frame_record(std::tls::content_handshake(), hello);
/// ```
pub fn frame_record(take content_type: Int, in body: Array[Int]) -> Array[Int] {
    var out = std::array::empty();
    std::array::push(out, content_type & 255);
    std::array::push(out, 3);
    std::array::push(out, 3);
    push_u16(out, std::array::len(body));
    push_bytes(out, body);
    out
}

// --- Handshake messages (RFC 8446 §4) ---------------------------------------

/// The `client_hello` handshake type (1).
pub fn handshake_client_hello() -> Int {
    1
}

/// The `server_hello` handshake type (2).
pub fn handshake_server_hello() -> Int {
    2
}

/// The `encrypted_extensions` handshake type (8).
pub fn handshake_encrypted_extensions() -> Int {
    8
}

/// The `certificate` handshake type (11).
pub fn handshake_certificate() -> Int {
    11
}

/// The `certificate_verify` handshake type (15).
pub fn handshake_certificate_verify() -> Int {
    15
}

/// The `finished` handshake type (20).
pub fn handshake_finished() -> Int {
    20
}

/// The `TLS_CHACHA20_POLY1305_SHA256` cipher suite (0x1303) — the only suite
/// this module supports, and the one its primitives implement.
///
/// # Example
///
/// ```tuo
/// let suite = std::tls::cipher_suite(); // 4867
/// ```
pub fn cipher_suite() -> Int {
    4867
}

/// The `supported_versions` extension type (43).
pub fn extension_supported_versions() -> Int {
    43
}

/// The `key_share` extension type (51).
pub fn extension_key_share() -> Int {
    51
}

/// The `server_name` extension type (0).
pub fn extension_server_name() -> Int {
    0
}

/// The X25519 named group (0x001d).
///
/// # Example
///
/// ```tuo
/// let group = std::tls::group_x25519(); // 29
/// ```
pub fn group_x25519() -> Int {
    29
}

/// The `ed25519` signature scheme (0x0807).
pub fn signature_ed25519() -> Int {
    2055
}

/// The TLS 1.3 version value (0x0304), carried in `supported_versions`.
pub fn version_tls13() -> Int {
    772
}

/// Where a ClientHello's extension block begins, or -1 when the message is
/// malformed.
///
/// Walking to it means stepping over five variable-length fields, each of
/// which a hostile client controls. Every step is bounds-checked, and any
/// failure returns -1 rather than an offset that happens to land somewhere.
///
/// # Example
///
/// ```tuo
/// let start = std::tls::hello_extensions_start(body);
/// ```
pub fn hello_extensions_start(in body: Array[Int]) -> Int {
    // handshake header (4) + legacy_version (2) + random (32)
    var p = 38;
    let session_len = byte_at(body, p);
    if session_len < 0 {
        return 0 - 1;
    }
    p = p + 1 + session_len;
    let suites_len = u16_at(body, p);
    if suites_len < 0 {
        return 0 - 1;
    }
    p = p + 2 + suites_len;
    let compression_len = byte_at(body, p);
    if compression_len < 0 {
        return 0 - 1;
    }
    p = p + 1 + compression_len;
    let extensions_len = u16_at(body, p);
    if extensions_len < 0 {
        return 0 - 1;
    }
    // The extension block must be entirely present.
    if extensions_len > std::array::len(body) - (p + 2) {
        return 0 - 1;
    }
    p + 2
}

/// The total length of a ClientHello's extension block, or -1.
///
/// # Example
///
/// ```tuo
/// let length = std::tls::hello_extensions_length(body);
/// ```
pub fn hello_extensions_length(in body: Array[Int]) -> Int {
    let start = hello_extensions_start(body);
    if start < 0 {
        return 0 - 1;
    }
    u16_at(body, start - 2)
}

/// The body of extension `wanted` in a ClientHello, or an empty array when it
/// is absent or the message is malformed.
///
/// # Example
///
/// ```tuo
/// let share = std::tls::hello_extension(body, std::tls::extension_key_share());
/// ```
pub fn hello_extension(in body: Array[Int], take wanted: Int) -> Array[Int] {
    let start = hello_extensions_start(body);
    if start < 0 {
        return std::array::empty();
    }
    let total = hello_extensions_length(body);
    if total < 0 {
        return std::array::empty();
    }
    let limit = start + total;
    var p = start;
    while p < limit {
        let kind = u16_at(body, p);
        let length = u16_at(body, p + 2);
        if kind < 0 || length < 0 {
            return std::array::empty();
        }
        // The declared extension must fit inside the block.
        if length > limit - (p + 4) {
            return std::array::empty();
        }
        if kind == wanted {
            return slice(body, p + 4, length);
        }
        let next = p + 4 + length;
        if next <= p {
            // A zero-width step would loop forever on hostile input.
            return std::array::empty();
        }
        p = next;
    }
    std::array::empty()
}

/// Whether a ClientHello offers the one cipher suite this module supports.
///
/// # Example
///
/// ```tuo
/// if std::tls::hello_offers_suite(body) { /* … */ }
/// ```
pub fn hello_offers_suite(in body: Array[Int]) -> Bool {
    var p = 38;
    let session_len = byte_at(body, p);
    if session_len < 0 {
        return false;
    }
    p = p + 1 + session_len;
    let suites_len = u16_at(body, p);
    if suites_len < 0 || suites_len % 2 != 0 {
        return false;
    }
    if suites_len > std::array::len(body) - (p + 2) {
        return false;
    }
    var i = 0;
    var found = false;
    while i < suites_len {
        if u16_at(body, p + 2 + i) == cipher_suite() {
            found = true;
        }
        i = i + 2;
    }
    found
}

/// Whether a ClientHello's `supported_versions` offers TLS 1.3.
///
/// This is how TLS 1.3 is really negotiated — the record and message version
/// fields both say "TLS 1.2" for middlebox compatibility, so a server that
/// trusted them would never speak 1.3 at all.
///
/// # Example
///
/// ```tuo
/// if std::tls::hello_offers_tls13(body) { /* … */ }
/// ```
pub fn hello_offers_tls13(in body: Array[Int]) -> Bool {
    let extension = hello_extension(body, extension_supported_versions());
    let count = byte_at(extension, 0);
    if count < 0 || count % 2 != 0 {
        return false;
    }
    var i = 0;
    var found = false;
    while i < count {
        if u16_at(extension, 1 + i) == version_tls13() {
            found = true;
        }
        i = i + 2;
    }
    found
}

/// The client's X25519 public key from its `key_share` extension, or an empty
/// array when absent.
///
/// A client may offer several groups; this returns the X25519 one, since that
/// is the only group these primitives implement. Returning empty for "no
/// X25519 share" lets the caller send a HelloRetryRequest or alert rather than
/// proceeding with a key it does not have.
///
/// # Example
///
/// ```tuo
/// let peer = std::tls::hello_key_share(body); // 32 bytes
/// ```
pub fn hello_key_share(in body: Array[Int]) -> Array[Int] {
    let extension = hello_extension(body, extension_key_share());
    let total = u16_at(extension, 0);
    if total < 0 {
        return std::array::empty();
    }
    if total > std::array::len(extension) - 2 {
        return std::array::empty();
    }
    let limit = 2 + total;
    var p = 2;
    while p < limit {
        let group = u16_at(extension, p);
        let length = u16_at(extension, p + 2);
        if group < 0 || length < 0 {
            return std::array::empty();
        }
        if length > limit - (p + 4) {
            return std::array::empty();
        }
        if group == group_x25519() && length == 32 {
            return slice(extension, p + 4, 32);
        }
        let next = p + 4 + length;
        if next <= p {
            return std::array::empty();
        }
        p = next;
    }
    std::array::empty()
}

/// The 32-byte `random` field of a ClientHello.
///
/// # Example
///
/// ```tuo
/// let random = std::tls::hello_random(body);
/// ```
pub fn hello_random(in body: Array[Int]) -> Array[Int] {
    slice(body, 6, 32)
}

/// The legacy `session_id`, which a TLS 1.3 server must echo verbatim in its
/// ServerHello (RFC 8446 §4.1.3) for middlebox compatibility.
///
/// # Example
///
/// ```tuo
/// let id = std::tls::hello_session_id(body);
/// ```
pub fn hello_session_id(in body: Array[Int]) -> Array[Int] {
    let length = byte_at(body, 38);
    if length < 0 || length > 32 {
        return std::array::empty();
    }
    slice(body, 39, length)
}

/// Whether a handshake message is a well-formed ClientHello this module can
/// answer: right type, right length, offering TLS 1.3, the supported suite,
/// and an X25519 key share.
///
/// # Example
///
/// ```tuo
/// if std::tls::hello_acceptable(body) { /* … */ }
/// ```
pub fn hello_acceptable(in body: Array[Int]) -> Bool {
    if byte_at(body, 0) != handshake_client_hello() {
        return false;
    }
    let declared = u24_at(body, 1);
    if declared < 0 || declared != std::array::len(body) - 4 {
        return false;
    }
    // Bound each check to a local first: a heap temporary inside a
    // short-circuit operand is a shape this compiler only recently lowered
    // correctly, and sequencing is clearer regardless.
    let versions = hello_offers_tls13(body);
    let suites = hello_offers_suite(body);
    let share = std::array::len(hello_key_share(body)) == 32;
    versions && suites && share
}

// --- ServerHello and the server's flight (RFC 8446 §4.1.3, §4.4) ------------

/// Build a ServerHello answering `client_hello`, carrying `server_share` as
/// the server's X25519 public key (RFC 8446 §4.1.3).
///
/// The `legacy_session_id_echo` is copied from the client verbatim, and the
/// version field says "TLS 1.2" while `supported_versions` says 1.3 — both
/// are middlebox compatibility requirements, not choices. A server that
/// omits the echo or advertises 1.3 in the legacy field gets its records
/// dropped by network equipment that has not been updated since 2018.
///
/// # Example
///
/// ```tuo
/// let hello = std::tls::server_hello(client_body, server_public, server_random);
/// ```
pub fn server_hello(
    in client_hello: Array[Int],
    in server_share: Array[Int],
    in server_random: Array[Int],
) -> Array[Int] {
    var body = std::array::empty();
    // legacy_version: 0x0303.
    push_u16(body, 771);
    push_bytes(body, server_random);
    let session_id = hello_session_id(client_hello);
    std::array::push(body, std::array::len(session_id));
    push_bytes(body, session_id);
    push_u16(body, cipher_suite());
    // legacy_compression_method: null.
    std::array::push(body, 0);

    // Extensions: supported_versions, then key_share.
    var extensions = std::array::empty();
    push_u16(extensions, extension_supported_versions());
    push_u16(extensions, 2);
    push_u16(extensions, version_tls13());
    push_u16(extensions, extension_key_share());
    push_u16(extensions, 4 + std::array::len(server_share));
    push_u16(extensions, group_x25519());
    push_u16(extensions, std::array::len(server_share));
    push_bytes(extensions, server_share);

    push_u16(body, std::array::len(extensions));
    push_bytes(body, extensions);
    wrap_handshake(handshake_server_hello(), body)
}

/// Wrap a message body in its four-byte handshake header.
///
/// # Example
///
/// ```tuo
/// let message = std::tls::wrap_handshake(std::tls::handshake_finished(), mac);
/// ```
pub fn wrap_handshake(take message_type: Int, in body: Array[Int]) -> Array[Int] {
    var out = std::array::empty();
    std::array::push(out, message_type & 255);
    push_u24(out, std::array::len(body));
    push_bytes(out, body);
    out
}

/// An empty `EncryptedExtensions` message — the first encrypted message of
/// the server's flight (RFC 8446 §4.3.1).
///
/// It is empty because this module negotiates nothing that belongs there. The
/// message is still mandatory: a client that does not receive it aborts.
///
/// # Example
///
/// ```tuo
/// let message = std::tls::encrypted_extensions();
/// ```
pub fn encrypted_extensions() -> Array[Int] {
    var body = std::array::empty();
    push_u16(body, 0);
    wrap_handshake(handshake_encrypted_extensions(), body)
}

/// A `Certificate` message carrying one DER certificate (RFC 8446 §4.4.2).
///
/// # Example
///
/// ```tuo
/// let message = std::tls::certificate_message(der);
/// ```
pub fn certificate_message(in der: Array[Int]) -> Array[Int] {
    var body = std::array::empty();
    // certificate_request_context: empty for a server certificate.
    std::array::push(body, 0);
    var list = std::array::empty();
    push_u24(list, std::array::len(der));
    push_bytes(list, der);
    // No certificate extensions.
    push_u16(list, 0);
    push_u24(body, std::array::len(list));
    push_bytes(body, list);
    wrap_handshake(handshake_certificate(), body)
}

/// The exact bytes a `CertificateVerify` signature is computed over
/// (RFC 8446 §4.4.3): 64 spaces, a context string, a zero byte, then the
/// transcript hash.
///
/// The 64 spaces and the context string are not decoration. They ensure a
/// signature made for TLS can never be mistaken for a signature over some
/// other protocol's data — and, because the client and server context strings
/// differ, that a server's signature cannot be replayed as a client's.
///
/// # Example
///
/// ```tuo
/// let content = std::tls::certificate_verify_content(transcript_hash);
/// ```
pub fn certificate_verify_content(in transcript_hash: Array[Int]) -> Array[Int] {
    var out = std::array::empty();
    var i = 0;
    while i < 64 {
        std::array::push(out, 32);
        i = i + 1;
    }
    let context = "TLS 1.3, server CertificateVerify";
    var c = 0;
    while c < std::str::len(context) {
        std::array::push(out, std::str::byte_at(context, c));
        c = c + 1;
    }
    std::array::push(out, 0);
    push_bytes(out, transcript_hash);
    out
}

/// A `CertificateVerify` message carrying an Ed25519 signature
/// (RFC 8446 §4.4.3).
///
/// # Example
///
/// ```tuo
/// let message = std::tls::certificate_verify_message(signature);
/// ```
pub fn certificate_verify_message(in signature: Array[Int]) -> Array[Int] {
    var body = std::array::empty();
    push_u16(body, signature_ed25519());
    push_u16(body, std::array::len(signature));
    push_bytes(body, signature);
    wrap_handshake(handshake_certificate_verify(), body)
}

/// The `Finished` message's verify data: HMAC over the transcript hash under
/// a key derived from the traffic secret (RFC 8446 §4.4.4).
///
/// This is what proves both sides derived the *same* keys. Without it a
/// handshake can complete with mismatched keys and fail mysteriously on the
/// first application record instead.
///
/// # Example
///
/// ```tuo
/// let mac = std::tls::finished_data(traffic_secret, transcript_hash);
/// ```
pub fn finished_data(in traffic_secret: Array[Int], in transcript_hash: Array[Int]) -> Array[Int] {
    let key = std::hkdf::expand_label(
        traffic_secret,
        "finished",
        std::array::empty(),
        std::hkdf::hash_len(),
    );
    std::crypto::hmac_sha256(key, transcript_hash)
}

/// A `Finished` message (RFC 8446 §4.4.4).
///
/// # Example
///
/// ```tuo
/// let message = std::tls::finished_message(traffic_secret, transcript_hash);
/// ```
pub fn finished_message(
    in traffic_secret: Array[Int],
    in transcript_hash: Array[Int],
) -> Array[Int] {
    wrap_handshake(
        handshake_finished(),
        finished_data(traffic_secret, transcript_hash),
    )
}

// --- Record protection (RFC 8446 §5.2) --------------------------------------

/// Encrypt a record: append the real content type to the plaintext, seal it
/// with ChaCha20-Poly1305, and frame the result as `application_data`.
///
/// The inner content type is the reason a TLS 1.3 record's outer type is
/// always 23: the real type travels *inside* the encryption, so an observer
/// cannot tell a handshake record from application data.
///
/// The additional data is the record header itself, which binds the declared
/// length to the ciphertext — without it a peer could truncate a record and
/// the tag would still check out.
///
/// # Example
///
/// ```tuo
/// let record = std::tls::seal_record(key, iv, 0, content_type, plaintext);
/// ```
pub fn seal_record(
    in key: Array[Int],
    in iv: Array[Int],
    take sequence: Int,
    take content_type: Int,
    in plaintext: Array[Int],
) -> Array[Int] {
    var inner = std::array::empty();
    push_bytes(inner, plaintext);
    std::array::push(inner, content_type & 255);

    // The header must be built before sealing, since it is the AEAD's
    // additional data: 5 bytes of header, the body, and the 16-byte tag.
    var header = std::array::empty();
    std::array::push(header, content_application_data());
    std::array::push(header, 3);
    std::array::push(header, 3);
    push_u16(header, std::array::len(inner) + 16);

    let nonce = std::hkdf::record_nonce(iv, sequence);
    let sealed = std::chacha::aead_seal(key, nonce, header, inner);

    var out = std::array::empty();
    push_bytes(out, header);
    push_bytes(out, sealed);
    out
}

/// Decrypt a record body, returning the plaintext **with its inner content
/// type still appended**, or `None` when the tag does not verify.
///
/// `None` must be treated as fatal: in TLS 1.3 a failed record is not a
/// recoverable error, it means the stream is forged or corrupt, and the
/// connection must be torn down rather than resynchronized.
///
/// # Example
///
/// ```tuo
/// match std::tls::open_record(key, iv, 0, header, body) { /* … */ }
/// ```
pub fn open_record(
    in key: Array[Int],
    in iv: Array[Int],
    take sequence: Int,
    in header: Array[Int],
    in body: Array[Int],
) -> Option[Array[Int]] {
    let nonce = std::hkdf::record_nonce(iv, sequence);
    std::chacha::aead_open(key, nonce, header, body)
}

/// The real content type of a decrypted record — its last non-zero byte
/// (RFC 8446 §5.4 allows trailing zero padding).
///
/// # Example
///
/// ```tuo
/// let kind = std::tls::inner_content_type(plaintext);
/// ```
pub fn inner_content_type(in plaintext: Array[Int]) -> Int {
    var i = std::array::len(plaintext) - 1;
    while i >= 0 {
        let b = std::array::get(plaintext, i) & 255;
        if b != 0 {
            return b;
        }
        i = i - 1;
    }
    0 - 1
}

/// A decrypted record's payload, with the inner content type and any padding
/// removed.
///
/// # Example
///
/// ```tuo
/// let payload = std::tls::inner_payload(plaintext);
/// ```
pub fn inner_payload(in plaintext: Array[Int]) -> Array[Int] {
    var i = std::array::len(plaintext) - 1;
    while i >= 0 {
        if (std::array::get(plaintext, i) & 255) != 0 {
            return slice(plaintext, 0, i);
        }
        i = i - 1;
    }
    std::array::empty()
}

// --- The handshake key schedule (RFC 8446 §7.1) -----------------------------
//
// TLS 1.3 derives keys from a chain of secrets, each bound to the transcript
// *at the point it is derived*. That binding is what makes the handshake
// tamper-evident: change any earlier byte and every later key changes, so a
// modified ClientHello produces a Finished the peer cannot reproduce.

/// The SHA-256 hash of a transcript.
///
/// # Example
///
/// ```tuo
/// let hash = std::tls::transcript_hash(messages);
/// ```
pub fn transcript_hash(in messages: Array[Int]) -> Array[Int] {
    // `std::crypto`'s hashes take a `Str`, so the byte array crosses through
    // `str_of_bytes`. That is a lossless round trip — the conversion is
    // byte-for-byte, not a text decoding — but it is the one place this
    // module depends on that being true.
    std::crypto::sha256_bytes(std::string::as_str(std::crypto::str_of_bytes(messages)))
}

/// The client's handshake traffic secret (RFC 8446 §7.1).
///
/// # Example
///
/// ```tuo
/// let secret = std::tls::client_handshake_secret(shared, hello_hash);
/// ```
pub fn client_handshake_secret(
    in shared: Array[Int],
    in hello_hash: Array[Int],
) -> Array[Int] {
    std::hkdf::derive_secret(
        std::hkdf::handshake_secret(shared),
        "c hs traffic",
        hello_hash,
    )
}

/// The server's handshake traffic secret (RFC 8446 §7.1).
///
/// # Example
///
/// ```tuo
/// let secret = std::tls::server_handshake_secret(shared, hello_hash);
/// ```
pub fn server_handshake_secret(
    in shared: Array[Int],
    in hello_hash: Array[Int],
) -> Array[Int] {
    std::hkdf::derive_secret(
        std::hkdf::handshake_secret(shared),
        "s hs traffic",
        hello_hash,
    )
}

/// The client's application traffic secret (RFC 8446 §7.1).
///
/// Derived from the master secret over the transcript through the server's
/// Finished — so application keys depend on the whole handshake having been
/// agreed, not merely on the key exchange.
///
/// # Example
///
/// ```tuo
/// let secret = std::tls::client_application_secret(shared, finished_hash);
/// ```
pub fn client_application_secret(
    in shared: Array[Int],
    in finished_hash: Array[Int],
) -> Array[Int] {
    std::hkdf::derive_secret(
        std::hkdf::master_secret(std::hkdf::handshake_secret(shared)),
        "c ap traffic",
        finished_hash,
    )
}

/// The server's application traffic secret (RFC 8446 §7.1).
///
/// # Example
///
/// ```tuo
/// let secret = std::tls::server_application_secret(shared, finished_hash);
/// ```
pub fn server_application_secret(
    in shared: Array[Int],
    in finished_hash: Array[Int],
) -> Array[Int] {
    std::hkdf::derive_secret(
        std::hkdf::master_secret(std::hkdf::handshake_secret(shared)),
        "s ap traffic",
        finished_hash,
    )
}

// --- The server handshake (RFC 8446 §4) -------------------------------------
//
// The pieces above are data; this is the sequence. A server's flight is:
//
//   ServerHello                    (plaintext)
//   [EncryptedExtensions]          (under the handshake keys)
//   [Certificate]
//   [CertificateVerify]            signs the transcript so far
//   [Finished]                     MACs the transcript so far
//
// Each message is appended to the transcript *before* the next one's keys or
// signature are computed, which is what binds the whole exchange together.

/// Everything a completed server handshake produces: the flight to send, and
/// the four application-traffic values the connection then uses.
///
/// `ok` is false when the ClientHello was unacceptable — the caller must
/// check it and send an alert rather than transmitting the (empty) flight.
struct Handshake {
    ok: Bool,
    flight: Array[Int],
    client_key: Array[Int],
    client_iv: Array[Int],
    server_key: Array[Int],
    server_iv: Array[Int],
    /// The client's **handshake** traffic key. The client's Finished arrives
    /// under this, not under the application key — TLS 1.3 changes keys
    /// mid-flight, and each epoch restarts its record sequence at zero. A
    /// server that reads the client's first record with application keys
    /// fails to authenticate a perfectly valid Finished.
    client_handshake_key: Array[Int],
    /// The client's handshake traffic IV, paired with the key above.
    client_handshake_iv: Array[Int],
}

/// A handshake that could not be completed.
///
/// # Example
///
/// ```tuo
/// let failed = std::tls::failed_handshake();
/// ```
pub fn failed_handshake() -> Handshake {
    Handshake {
        ok: false,
        flight: std::array::empty(),
        client_key: std::array::empty(),
        client_iv: std::array::empty(),
        server_key: std::array::empty(),
        server_iv: std::array::empty(),
        client_handshake_key: std::array::empty(),
        client_handshake_iv: std::array::empty(),
    }
}

/// Run the server side of a full TLS 1.3 handshake.
///
/// Takes the client's ClientHello body, the server's X25519 private key, its
/// certificate, a signature callback's output over the CertificateVerify
/// content, and randomness for the ServerHello. Returns the complete flight
/// to write and the application keys to use afterwards.
///
/// The signature is passed *in* rather than computed here: signing needs the
/// certificate's private key, and `std::ed25519` deliberately ships no
/// `sign` (its arithmetic is variable-time, so signing would leak the key).
/// A server that has a safe signer supplies the signature; one that does not
/// cannot complete a handshake, which is the honest outcome.
///
/// # Example
///
/// ```tuo
/// let result = std::tls::server_handshake(hello, private, cert, signature, random);
/// ```
pub fn server_handshake(
    in client_hello: Array[Int],
    in server_private: Array[Int],
    in certificate: Array[Int],
    in signature: Array[Int],
    in server_random: Array[Int],
) -> Handshake {
    if !hello_acceptable(client_hello) {
        return failed_handshake();
    }
    let peer_share = hello_key_share(client_hello);
    if std::array::len(peer_share) != 32 {
        return failed_handshake();
    }
    let shared = std::x25519::scalar_mult(server_private, peer_share);
    let server_share = std::x25519::public_key(server_private);
    let hello = server_hello(client_hello, server_share, server_random);

    // Transcript: ClientHello, then ServerHello.
    var transcript = std::array::empty();
    push_bytes(transcript, client_hello);
    push_bytes(transcript, hello);
    let hello_hash = transcript_hash(transcript);

    let server_secret = server_handshake_secret(shared, hello_hash);
    let client_secret = client_handshake_secret(shared, hello_hash);
    let hs_key = std::hkdf::traffic_key(server_secret);
    let hs_iv = std::hkdf::traffic_iv(server_secret);

    // The encrypted flight, each message appended to the transcript as it is
    // produced.
    let extensions = encrypted_extensions();
    push_bytes(transcript, extensions);
    let cert_message = certificate_message(certificate);
    push_bytes(transcript, cert_message);
    let verify_message = certificate_verify_message(signature);
    push_bytes(transcript, verify_message);
    let verify_hash = transcript_hash(transcript);
    let finished = finished_message(server_secret, verify_hash);
    push_bytes(transcript, finished);
    let finished_hash = transcript_hash(transcript);

    // Everything after ServerHello travels encrypted, as one record.
    var inner = std::array::empty();
    push_bytes(inner, extensions);
    push_bytes(inner, cert_message);
    push_bytes(inner, verify_message);
    push_bytes(inner, finished);
    let protected = seal_record(hs_key, hs_iv, 0, content_handshake(), inner);

    var flight = std::array::empty();
    push_bytes(flight, frame_record(content_handshake(), hello));
    push_bytes(flight, protected);

    let client_app = client_application_secret(shared, finished_hash);
    let server_app = server_application_secret(shared, finished_hash);
    Handshake {
        ok: true,
        flight: flight,
        client_key: std::hkdf::traffic_key(client_app),
        client_iv: std::hkdf::traffic_iv(client_app),
        server_key: std::hkdf::traffic_key(server_app),
        server_iv: std::hkdf::traffic_iv(server_app),
        client_handshake_key: std::hkdf::traffic_key(client_secret),
        client_handshake_iv: std::hkdf::traffic_iv(client_secret),
    }
}

/// The transcript hash a server must sign, given a ClientHello and the
/// ServerHello it will answer with.
///
/// Exposed separately because the signature has to exist *before*
/// `server_handshake` runs, and it covers exactly this transcript: the two
/// hellos plus EncryptedExtensions and Certificate.
///
/// # Example
///
/// ```tuo
/// let content = std::tls::signing_content(hello, server_share, random, cert);
/// ```
pub fn signing_content(
    in client_hello: Array[Int],
    in server_share: Array[Int],
    in server_random: Array[Int],
    in certificate: Array[Int],
) -> Array[Int] {
    var transcript = std::array::empty();
    push_bytes(transcript, client_hello);
    push_bytes(transcript, server_hello(client_hello, server_share, server_random));
    push_bytes(transcript, encrypted_extensions());
    push_bytes(transcript, certificate_message(certificate));
    certificate_verify_content(transcript_hash(transcript))
}

// --- Specs ------------------------------------------------------------------
