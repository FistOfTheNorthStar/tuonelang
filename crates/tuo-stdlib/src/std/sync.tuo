// std::sync — synchronization and structured concurrency.
//
// Synchronization is inherently about *effects* — threads observing and
// changing shared state. Since ADR-0007 landed, v0 has exactly **one**
// concurrency primitive: the structured fork-join `std::rt::par_map`, wrapped
// here as `par_map`. It is deliberately the *only* way to start a thread —
// every worker joins before the call returns, and the only values that cross
// a thread boundary are a non-capturing function value, `Copy` `Int` tasks
// read from a shared read-only buffer, and each thread's own disjoint result
// slot, so no data race is expressible through it (the ADR's "no data races,
// checked" constraint, enforced by the primitive's shape rather than a
// bolted-on marker system).
//
//   Executable tier — the pure *state models*: whether a one-shot latch has
//   fired, whether a lock is held. Reasoning about the state is computation
//   and runs; performing the synchronization is not and does not.
//
//   Effect tier — `par_map`. Spawning is a typed effect (ADR-0007), so it
//   carries no spec; the native CLI test named in its doc pins it on both
//   backends.
//
//   Contract tier — `lock`, `unlock`. Shared-state locking needs a mutable
//   place shared across threads, which the structured primitive deliberately
//   does not admit; these stay exact signatures with documented contracts and
//   no executable spec, marked `CONTRACT:`, until an ADR admits shared state.
//
// One lock model, one one-shot latch model, one way to go parallel — no
// competing primitives.

module std::sync;

// ----------------------------------------------------------------------------
// Once — a one-shot latch's state. Executable tier.
//
// A `Once` records whether its single action has run. The *state transition* is
// pure and runs; the real `Once` also provides mutual exclusion across threads,
// which is the contract part.
// ----------------------------------------------------------------------------

/// The state of a one-shot latch: has its action already run?
pub struct Once {
    fired: Bool,
}

/// A fresh, unfired latch.
///
/// # Example
/// ```tuo
/// let o = std::sync::once_new();
/// ```
pub fn once_new() -> Once {
    Once { fired: false }
}

/// Has this latch already fired?
///
/// # Example
/// ```tuo
/// let b = std::sync::has_fired(std::sync::once_new()); // false
/// ```
pub fn has_fired(in o: Once) -> Bool {
    o.fired
}

/// The latch after firing (its action has now run).
///
/// Pure state transition: firing an already-fired latch leaves it fired.
///
/// # Example
/// ```tuo
/// let o = std::sync::fire(std::sync::once_new());
/// ```
pub fn fire(in o: Once) -> Once {
    Once { fired: true }
}

// ----------------------------------------------------------------------------
// Mutex state — the pure held/free model. Executable tier.
// ----------------------------------------------------------------------------

/// The state of a lock: held or free.
pub struct LockState {
    held: Bool,
}

/// A free lock.
///
/// # Example
/// ```tuo
/// let s = std::sync::unlocked();
/// ```
pub fn unlocked() -> LockState {
    LockState { held: false }
}

/// Is this lock currently held?
///
/// # Example
/// ```tuo
/// let b = std::sync::is_held(std::sync::unlocked()); // false
/// ```
pub fn is_held(in s: LockState) -> Bool {
    s.held
}

// ----------------------------------------------------------------------------
// Synchronization operations — the CONTRACT tier.
// ----------------------------------------------------------------------------

/// CONTRACT (not executable in v0): acquire the lock, returning the held state.
///
/// The real operation blocks until the lock is available; v0 has no threads
/// and `std::rt` exposes no lock primitive, so this is a contract and does not
/// run.
///
/// # Example
/// ```tuo
/// // let held = std::sync::lock(state);
/// ```
pub fn lock(in state: LockState) -> LockState {
    // Contract placeholder: the real implementation blocks until acquired.
    LockState { held: true }
}

/// CONTRACT (not executable in v0): release the lock, returning the free state.
///
/// # Example
/// ```tuo
/// // let free = std::sync::unlock(state);
/// ```
pub fn unlock(in state: LockState) -> LockState {
    // Contract placeholder.
    LockState { held: false }
}

/// EFFECT (runs natively; no spec — spawning is a typed effect, so a spec
/// would be `R0007`): apply the non-capturing function value `f` to every
/// task, distributing tasks round-robin over `workers` OS threads (task `i`
/// runs on worker `i % workers`, the partition `examples/concurrent-worker`'s
/// scheduling model predicts; `workers` below 1 behaves as 1), and return
/// the results **in task order**. Every thread is joined before the call
/// returns — structured fork-join, nothing detaches — and the result is
/// deterministic whenever `f` is pure. Pinned natively on both backends by
/// `crates/tuo-cli/tests/stdlib.rs` (`par_map_runs_natively`).
///
/// # Example
/// ```tuo
/// // fn square(take x: Int) -> Int { x * x }
/// // let squares = std::sync::par_map(square, tasks, 4);
/// ```
pub fn par_map(take f: fn(take Int) -> Int, in tasks: Array[Int], take workers: Int) -> Array[Int] {
    std::rt::par_map(f, tasks, workers)
}

// ----------------------------------------------------------------------------
// Specs — executable tier only (the pure state models).
// ----------------------------------------------------------------------------

spec "once latch fires exactly once" {
    then !has_fired(once_new());
    then has_fired(fire(once_new()));
    then has_fired(fire(fire(once_new())));
}

spec "a fresh lock is free" {
    then !is_held(unlocked());
}
