// std::sync — synchronization and structured concurrency.
//
// Synchronization is inherently about *effects* — threads observing and
// coordinating with each other. Since ADR-0007 landed, the *only* way to
// start a thread is the structured fork-join `std::rt::par_map`, wrapped
// here as `par_map`: every worker joins before the call returns, and no
// tuonelang memory is ever shared between threads. Since ADR-0015 landed,
// threads can also *communicate*: `channel`/`send`/`recv`/`close` move
// non-negative `Int`s by value through a runtime-synchronized FIFO, and
// `mutex`/`lock`/`unlock` guard critical sections over *external* resources
// (files, sockets). Neither introduces shared mutable memory, so ADR-0007's
// no-data-race property is preserved by the primitives' shape.
//
//   Executable tier — the pure *state models*: whether a one-shot latch has
//   fired, whether a lock is held. Reasoning about the state is computation
//   and runs; performing the synchronization is not and does not.
//
//   Effect tier — `par_map`, the channel operations, and the mutex
//   operations. Each is a typed effect, so it carries no spec (`R0007`);
//   the native CLI tests named in their docs pin them on both backends.
//
// There is no contract tier left: ADR-0015 discharged the old
// `lock`/`unlock` contracts (their pure-model signatures were placeholders;
// the real API is handle-based, and the pure `LockState` model stays here
// as the documented state model). One lock, one latch model, one channel,
// one way to go parallel — no competing primitives.

module std::sync;

// ----------------------------------------------------------------------------
// Once — a one-shot latch's state. Executable tier.
//
// A `Once` records whether its single action has run. The *state transition* is
// pure and runs; the real `Once` also provides mutual exclusion across threads,
// which is the contract part.
// ----------------------------------------------------------------------------

/// The state of a one-shot latch: has its action already run?
pub struct Once {
    fired: Bool,
}

/// A fresh, unfired latch.
///
/// # Example
/// ```tuo
/// let o = std::sync::once_new();
/// ```
pub fn once_new() -> Once {
    Once { fired: false }
}

/// Has this latch already fired?
///
/// # Example
/// ```tuo
/// let b = std::sync::has_fired(std::sync::once_new()); // false
/// ```
pub fn has_fired(in o: Once) -> Bool {
    o.fired
}

/// The latch after firing (its action has now run).
///
/// Pure state transition: firing an already-fired latch leaves it fired.
///
/// # Example
/// ```tuo
/// let o = std::sync::fire(std::sync::once_new());
/// ```
pub fn fire(in o: Once) -> Once {
    Once { fired: true }
}

// ----------------------------------------------------------------------------
// Mutex state — the pure held/free model. Executable tier.
// ----------------------------------------------------------------------------

/// The state of a lock: held or free.
pub struct LockState {
    held: Bool,
}

/// A free lock.
///
/// # Example
/// ```tuo
/// let s = std::sync::unlocked();
/// ```
pub fn unlocked() -> LockState {
    LockState { held: false }
}

/// Is this lock currently held?
///
/// # Example
/// ```tuo
/// let b = std::sync::is_held(std::sync::unlocked()); // false
/// ```
pub fn is_held(in s: LockState) -> Bool {
    s.held
}

// ----------------------------------------------------------------------------
// Channels — communication between par_map workers. EFFECT tier (ADR-0015).
//
// A channel is an unbounded FIFO of **non-negative** Ints behind an opaque
// handle. Values cross threads by copy — never by shared memory — so the
// no-data-race property survives. `recv` returns -1 once the channel is
// closed and drained; `send` refuses a negative value so that signal stays
// unambiguous.
// ----------------------------------------------------------------------------

/// EFFECT (executable and effectful): create a channel; returns its handle
/// (`>= 0`) or a negative value when the registry is exhausted. Handles
/// live for the process — there is deliberately no free. Effectful, so no
/// spec (`R0007`); pinned by the native CLI tests in
/// `crates/tuo-cli/tests/stdlib.rs`.
///
/// # Example
/// ```tuo
/// // let ch = std::sync::channel();
/// ```
pub fn channel() -> Int {
    std::rt::chan_new()
}

/// EFFECT (executable and effectful): enqueue the non-negative `v`; `0` on
/// success, negative on an invalid handle, a closed channel, or a negative
/// `v`. Effectful, so no spec (`R0007`); pinned by the native CLI tests in
/// `crates/tuo-cli/tests/stdlib.rs`.
///
/// # Example
/// ```tuo
/// // let ok = std::sync::send(ch, 7);
/// ```
pub fn send(take ch: Int, take v: Int) -> Int {
    std::rt::chan_send(ch, v)
}

/// EFFECT (executable and effectful): dequeue the oldest value, blocking
/// until one is available; returns the value, or `-1` once the channel is
/// closed and drained. Blocks forever if nothing will ever send — a
/// liveness bug the compiler does not catch. Effectful, so no spec
/// (`R0007`); pinned by the native CLI tests in
/// `crates/tuo-cli/tests/stdlib.rs`.
///
/// # Example
/// ```tuo
/// // let v = std::sync::recv(ch);
/// ```
pub fn recv(take ch: Int) -> Int {
    std::rt::chan_recv(ch)
}

/// EFFECT (executable and effectful): close the channel — sends are refused
/// and every blocked or future `recv` returns `-1` after the queue drains.
/// Idempotent. Effectful, so no spec (`R0007`); pinned by the native CLI
/// tests in `crates/tuo-cli/tests/stdlib.rs`.
///
/// # Example
/// ```tuo
/// // let _ = std::sync::close(ch);
/// ```
pub fn close(take ch: Int) -> Int {
    std::rt::chan_close(ch)
}

// ----------------------------------------------------------------------------
// Mutexes — critical sections over external resources. EFFECT tier
// (ADR-0015). The old CONTRACT stubs, now real: handle-based, since there is
// no shared tuonelang memory for a lock to guard — a mutex serializes
// workers' access to what the OS effects reach (a file, a socket).
// ----------------------------------------------------------------------------

/// EFFECT (executable and effectful): create a mutex; returns its handle
/// (`>= 0`) or a negative value when the registry is exhausted. Handles
/// live for the process. Effectful, so no spec (`R0007`); pinned by the
/// native CLI tests in `crates/tuo-cli/tests/stdlib.rs`.
///
/// # Example
/// ```tuo
/// // let m = std::sync::mutex();
/// ```
pub fn mutex() -> Int {
    std::rt::mutex_new()
}

/// EFFECT (executable and effectful): acquire the mutex, blocking until it
/// is available; `0` on success, negative on an invalid handle or a relock
/// by the holding thread (error-checked — a mistake is a code, never
/// undefined behavior). Effectful, so no spec (`R0007`); pinned by the
/// native CLI tests in `crates/tuo-cli/tests/stdlib.rs`.
///
/// # Example
/// ```tuo
/// // let ok = std::sync::lock(m);
/// ```
pub fn lock(take m: Int) -> Int {
    std::rt::mutex_lock(m)
}

/// EFFECT (executable and effectful): release the mutex; `0` on success,
/// negative on an invalid handle or when the calling thread does not hold
/// it. Effectful, so no spec (`R0007`); pinned by the native CLI tests in
/// `crates/tuo-cli/tests/stdlib.rs`.
///
/// # Example
/// ```tuo
/// // let ok = std::sync::unlock(m);
/// ```
pub fn unlock(take m: Int) -> Int {
    std::rt::mutex_unlock(m)
}

/// EFFECT (runs natively; no spec — spawning is a typed effect, so a spec
/// would be `R0007`): apply the non-capturing function value `f` to every
/// task, distributing tasks round-robin over `workers` OS threads (task `i`
/// runs on worker `i % workers`, the partition `examples/concurrent-worker`'s
/// scheduling model predicts; `workers` below 1 behaves as 1), and return
/// the results **in task order**. Every thread is joined before the call
/// returns — structured fork-join, nothing detaches — and the result is
/// deterministic whenever `f` is pure. Pinned natively on both backends by
/// `crates/tuo-cli/tests/stdlib.rs` (`par_map_runs_natively`).
///
/// # Example
/// ```tuo
/// // fn square(take x: Int) -> Int { x * x }
/// // let squares = std::sync::par_map(square, tasks, 4);
/// ```
pub fn par_map(take f: fn(take Int) -> Int, in tasks: Array[Int], take workers: Int) -> Array[Int] {
    std::rt::par_map(f, tasks, workers)
}

// ----------------------------------------------------------------------------
// Specs — executable tier only (the pure state models).
// ----------------------------------------------------------------------------

spec "once latch fires exactly once" {
    then !has_fired(once_new());
    then has_fired(fire(once_new()));
    then has_fired(fire(fire(once_new())));
}

spec "a fresh lock is free" {
    then !is_held(unlocked());
}
