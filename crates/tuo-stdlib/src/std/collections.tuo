// std::collections — value collections and growable-array algorithms.
//
// This module is entirely executable.
//
//   `Pair[A, B]` and the counted-range helpers — flat value types and pure
//   functions over the scalar core.
//
//   `Array[Int]` algorithms — pure folds and searches over the language's
//   growable indexed sequence. ADR-0009 landed the allocator core, so an
//   `Array[Int]` can now be *built* (`std::array::empty`/`push`) and *read*
//   (`std::array::len`/`get`); these algorithms are the obvious higher-level
//   operations a caller reaches for on top of those builtins. Every one runs,
//   and every spec below executes through the reference interpreter — the ops
//   are pure, so a spec may build the array it folds. The array builtins
//   (`std::array::{empty,push,pop,len,get}`) are the primitive layer; this
//   module never re-spells them, only composes them into algorithms that add
//   value.
//
//   Higher-order combinators — one generic `fold`/`map_into`/`filter_into`/
//   `any`/`all` over a first-class function value (ADR-0008 Tier 1), plus the
//   `String`-element instantiations ADR-0012's widened element set makes
//   expressible (`fold_strings`/`map_into_strings`/`filter_into_strings`).

module std::collections;

// ----------------------------------------------------------------------------
// Pair[A, B] — the canonical two-element product.
//
// One product type, used everywhere a function must return two values (there
// are no tuples-as-return in the executable subset). Construct with `pair`,
// read with `first`/`second`, transform with `swap`.
// ----------------------------------------------------------------------------

/// A pair of a `first: A` and a `second: B`.
pub struct Pair[A, B] {
    first: A,
    second: B,
}

/// Build a pair from its two components.
///
/// # Example
/// ```tuo
/// let p = std::collections::pair(3, 8);
/// ```
pub fn pair(take a: Int, take b: Int) -> Pair[Int, Int] {
    Pair { first: a, second: b }
}

/// The first component of a pair.
///
/// # Example
/// ```tuo
/// let n = std::collections::first(std::collections::pair(3, 8)); // 3
/// ```
pub fn first(in p: Pair[Int, Int]) -> Int {
    p.first
}

/// The second component of a pair.
///
/// # Example
/// ```tuo
/// let n = std::collections::second(std::collections::pair(3, 8)); // 8
/// ```
pub fn second(in p: Pair[Int, Int]) -> Int {
    p.second
}

/// A pair with its components exchanged.
///
/// # Example
/// ```tuo
/// let p = std::collections::swap(std::collections::pair(3, 8)); // (8, 3)
/// ```
pub fn swap(in p: Pair[Int, Int]) -> Pair[Int, Int] {
    Pair { first: p.second, second: p.first }
}

// ----------------------------------------------------------------------------
// Counted ranges — the executable stand-in for iteration until iterators land.
//
// A half-open range `[start, end)` of integers, summarised without ever
// materialising a sequence. These are the obvious folds a caller reaches for.
// ----------------------------------------------------------------------------

/// The number of integers in the half-open range `[start, end)`.
///
/// Empty when `end <= start`.
///
/// # Example
/// ```tuo
/// let n = std::collections::range_len(2, 7); // 5
/// ```
pub fn range_len(take start: Int, take end: Int) -> Int {
    if end <= start {
        0
    } else {
        end - start
    }
}

/// The sum of every integer in the half-open range `[start, end)`.
///
/// # Example
/// ```tuo
/// let n = std::collections::range_sum(1, 5); // 1 + 2 + 3 + 4 = 10
/// ```
pub fn range_sum(take start: Int, take end: Int) -> Int {
    var total = 0;
    var i = start;
    while i < end {
        total = total + i;
        i = i + 1;
    }
    total
}

/// Does the half-open range `[start, end)` contain `value`?
///
/// # Example
/// ```tuo
/// let b = std::collections::range_contains(2, 7, 5); // true
/// ```
pub fn range_contains(take start: Int, take end: Int, take value: Int) -> Bool {
    value >= start && value < end
}

// ----------------------------------------------------------------------------
// Array[Int] algorithms — pure folds and searches.
//
// Each function borrows the array (`in xs`) and derives its length from
// `std::array::len`, so there is no redundant `count` argument to keep in sync:
// the array knows its own length now that it is a real growable value. These
// are the single, stable higher-level array API; they run, and their specs
// below build real arrays to exercise them.
//
// A small `singleton`/`of2`/`of3` set of constructors keeps the specs (and a
// caller's tests) readable without re-spelling `std::array::push`.
// ----------------------------------------------------------------------------

/// A one-element array holding `a`.
///
/// # Example
/// ```tuo
/// let xs = std::collections::singleton(7); // [7]
/// ```
pub fn singleton(take a: Int) -> Array[Int] {
    var xs = std::array::empty();
    std::array::push(xs, a);
    xs
}

/// A two-element array `[a, b]`.
///
/// # Example
/// ```tuo
/// let xs = std::collections::of2(3, 8); // [3, 8]
/// ```
pub fn of2(take a: Int, take b: Int) -> Array[Int] {
    var xs = std::array::empty();
    std::array::push(xs, a);
    std::array::push(xs, b);
    xs
}

/// A three-element array `[a, b, c]`.
///
/// # Example
/// ```tuo
/// let xs = std::collections::of3(1, 2, 3); // [1, 2, 3]
/// ```
pub fn of3(take a: Int, take b: Int, take c: Int) -> Array[Int] {
    var xs = std::array::empty();
    std::array::push(xs, a);
    std::array::push(xs, b);
    std::array::push(xs, c);
    xs
}

/// The sum of every element in `xs`. Zero for the empty array.
///
/// # Example
/// ```tuo
/// let total = std::collections::sum(std::collections::of3(1, 2, 3)); // 6
/// ```
pub fn sum(in xs: Array[Int]) -> Int {
    var total = 0;
    var i = 0;
    while i < std::array::len(xs) {
        total = total + std::array::get(xs, i);
        i = i + 1;
    }
    total
}

/// The largest element of `xs`, or `None` when `xs` is empty.
///
/// # Example
/// ```tuo
/// let m = std::collections::max_of(std::collections::of3(3, 9, 4)); // Some { value: 9 }
/// ```
pub fn max_of(in xs: Array[Int]) -> Option[Int] {
    if std::array::len(xs) == 0 {
        return None;
    }
    var best = std::array::get(xs, 0);
    var i = 1;
    while i < std::array::len(xs) {
        let x = std::array::get(xs, i);
        if x > best {
            best = x;
        }
        i = i + 1;
    }
    Some { value: best }
}

/// Does any element of `xs` equal `needle`?
///
/// # Example
/// ```tuo
/// let found = std::collections::contains(std::collections::of3(1, 2, 3), 2); // true
/// ```
pub fn contains(in xs: Array[Int], take needle: Int) -> Bool {
    var i = 0;
    while i < std::array::len(xs) {
        if std::array::get(xs, i) == needle {
            return true;
        }
        i = i + 1;
    }
    false
}

/// The index of the first element equal to `needle`, or `None` when absent.
///
/// # Example
/// ```tuo
/// let at = std::collections::index_of(std::collections::of3(7, 8, 9), 8); // Some { value: 1 }
/// ```
pub fn index_of(in xs: Array[Int], take needle: Int) -> Option[Int] {
    var i = 0;
    while i < std::array::len(xs) {
        if std::array::get(xs, i) == needle {
            return Some { value: i };
        }
        i = i + 1;
    }
    None
}

/// A **new** array holding `xs`'s elements in reverse order. `xs` is left
/// untouched (it is only borrowed); the result is freshly allocated.
///
/// # Example
/// ```tuo
/// let ys = std::collections::reversed(std::collections::of3(1, 2, 3)); // [3, 2, 1]
/// ```
pub fn reversed(in xs: Array[Int]) -> Array[Int] {
    var out = std::array::empty();
    var i = std::array::len(xs) - 1;
    while i >= 0 {
        std::array::push(out, std::array::get(xs, i));
        i = i - 1;
    }
    out
}

/// The smallest element of `xs`, or `None` when `xs` is empty. The `min`
/// counterpart to `max_of`.
///
/// # Example
/// ```tuo
/// let m = std::collections::min_of(std::collections::of3(3, 1, 4)); // Some { value: 1 }
/// ```
pub fn min_of(in xs: Array[Int]) -> Option[Int] {
    if std::array::len(xs) == 0 {
        return None;
    }
    var best = std::array::get(xs, 0);
    var i = 1;
    while i < std::array::len(xs) {
        let x = std::array::get(xs, i);
        if x < best {
            best = x;
        }
        i = i + 1;
    }
    Some { value: best }
}

/// A **new** array holding every element of `xs` followed by every element of
/// `ys`, in order. Both inputs are only borrowed; the result is freshly
/// allocated. The array analogue of `std::string::concat`.
///
/// # Example
/// ```tuo
/// let zs = std::collections::concat(std::collections::of2(1, 2), std::collections::of2(3, 4)); // [1, 2, 3, 4]
/// ```
pub fn concat(in xs: Array[Int], in ys: Array[Int]) -> Array[Int] {
    var out = std::array::empty();
    var i = 0;
    while i < std::array::len(xs) {
        std::array::push(out, std::array::get(xs, i));
        i = i + 1;
    }
    var j = 0;
    while j < std::array::len(ys) {
        std::array::push(out, std::array::get(ys, j));
        j = j + 1;
    }
    out
}

// ----------------------------------------------------------------------------
// Sorting and ordered-array queries.
//
// `sorted_ascending`/`sorted_descending` return a **new** sorted array (the
// input is only borrowed, so the caller's array is never disturbed — the same
// non-mutating contract as `reversed`). The sort is an insertion sort: O(n²),
// but stable, in-place on the freshly-copied buffer, and the obvious correct
// algorithm for the small arrays the runnable core builds. `is_sorted` and
// `binary_search` are the queries that pair with a sorted array; `deduped`
// collapses runs of equal elements in an already-sorted array.
// ----------------------------------------------------------------------------

/// A **new** array holding `xs`'s elements in non-decreasing order. `xs` is
/// only borrowed; the result is freshly allocated (insertion sort).
///
/// # Example
/// ```tuo
/// let ys = std::collections::sorted_ascending(std::collections::of3(3, 1, 2)); // [1, 2, 3]
/// ```
pub fn sorted_ascending(in xs: Array[Int]) -> Array[Int] {
    var out = std::array::empty();
    var i = 0;
    while i < std::array::len(xs) {
        out = insert_ascending(out, std::array::get(xs, i));
        i = i + 1;
    }
    out
}

/// A **new** array holding `xs`'s elements in non-increasing order. `xs` is
/// only borrowed; the result is freshly allocated.
///
/// # Example
/// ```tuo
/// let ys = std::collections::sorted_descending(std::collections::of3(1, 3, 2)); // [3, 2, 1]
/// ```
pub fn sorted_descending(in xs: Array[Int]) -> Array[Int] {
    reversed(sorted_ascending(xs))
}

/// Insert `value` into the already-ascending array `sorted`, returning a new
/// array that stays ascending. The per-element step of the insertion sort,
/// exposed because it is independently useful (maintaining a sorted array).
///
/// # Example
/// ```tuo
/// let ys = std::collections::insert_ascending(std::collections::of2(1, 3), 2); // [1, 2, 3]
/// ```
pub fn insert_ascending(in sorted: Array[Int], take value: Int) -> Array[Int] {
    var out = std::array::empty();
    var i = 0;
    var placed = false;
    while i < std::array::len(sorted) {
        let x = std::array::get(sorted, i);
        if !placed && value <= x {
            std::array::push(out, value);
            placed = true;
        }
        std::array::push(out, x);
        i = i + 1;
    }
    if !placed {
        std::array::push(out, value);
    }
    out
}

/// Is `xs` in non-decreasing order? Vacuously true for the empty and
/// single-element arrays.
///
/// # Example
/// ```tuo
/// let b = std::collections::is_sorted(std::collections::of3(1, 2, 2)); // true
/// ```
pub fn is_sorted(in xs: Array[Int]) -> Bool {
    var i = 1;
    while i < std::array::len(xs) {
        if std::array::get(xs, i - 1) > std::array::get(xs, i) {
            return false;
        }
        i = i + 1;
    }
    true
}

/// The index of `needle` in the **ascending** array `xs` by binary search, or
/// `None` when absent. `xs` must be sorted (the caller's responsibility — the
/// search does not verify it); on an unsorted array the result is unspecified
/// but never traps. When `needle` occurs more than once, *an* index of it is
/// returned (not necessarily the first).
///
/// # Example
/// ```tuo
/// let at = std::collections::binary_search(std::collections::of3(1, 3, 5), 3); // Some { value: 1 }
/// ```
pub fn binary_search(in xs: Array[Int], take needle: Int) -> Option[Int] {
    var lo = 0;
    var hi = std::array::len(xs);
    while lo < hi {
        let mid = lo + (hi - lo) / 2;
        let x = std::array::get(xs, mid);
        if x == needle {
            return Some { value: mid };
        } else if x < needle {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    None
}

/// A **new** array holding the elements of the **ascending** array `xs` with
/// each run of equal elements collapsed to one. `xs` must be sorted for this to
/// remove *all* duplicates (it only compares adjacent elements); on an unsorted
/// array it removes adjacent duplicates only, and never traps.
///
/// # Example
/// ```tuo
/// let ys = std::collections::deduped(std::collections::of3(1, 1, 2)); // [1, 2]
/// ```
pub fn deduped(in xs: Array[Int]) -> Array[Int] {
    var out = std::array::empty();
    var i = 0;
    while i < std::array::len(xs) {
        let x = std::array::get(xs, i);
        if i == 0 || std::array::get(xs, i - 1) != x {
            std::array::push(out, x);
        }
        i = i + 1;
    }
    out
}

// ----------------------------------------------------------------------------
// Higher-order combinators — one generic fold/map/filter over a function value
// (ADR-0008 Tier 1).
//
// ADR-0008 landed non-capturing first-class function values: a bare top-level
// `fn` name is a value of type `fn(mode T, …) -> R` — a `Copy` code pointer —
// and calling it is an indirect call with the identical direct-call ABI. That
// is exactly what these combinators need: instead of shipping N specialized
// folds (one per operation), the library ships *one* `fold` and lets the caller
// pass the step as a value. `map_into`/`filter_into`/`any`/`all` follow the same
// shape. This is the abstraction ADR-0008's D-8 finding named as missing.
//
// The step/predicate modes are part of the function *type*, so they are fixed
// here and documented: because `Int` and `Bool` are `Copy` scalars, every
// element is passed `take` (moved by copy — no borrow to thread), which is the
// cheapest and most natural contract for the `Int` forms.
//
// The combinators are monomorphic per element type: v0 has no user type
// parameters (Q-0010 is a future ADR), so each element instantiation is its
// own concrete function. The `Int` forms below are the original ADR-0008
// shapes; ADR-0012 widened the array element set to owned heap-backed
// elements, so the `String` instantiations follow in their own section (with
// the non-`Copy` modes that element demands). When the type system gains
// generics over the element type, these signatures generalize with no change
// to their meaning.
// ----------------------------------------------------------------------------

/// Left-fold `xs` with `step`, starting from `init`: the accumulator becomes
/// `step(acc, xs[i])` for each element in order. Zero-element arrays return
/// `init` unchanged.
///
/// `step` is a function *value* — pass a bare top-level `fn(take Int, take Int)
/// -> Int` name (ADR-0008 Tier 1). This one generic fold replaces a family of
/// specialized folds: `sum(xs)` is `fold(xs, 0, add)`, a product is
/// `fold(xs, 1, mul)`, and so on.
///
/// # Example
/// ```tuo
/// fn add(take a: Int, take b: Int) -> Int { a + b }
/// let total = std::collections::fold(std::collections::of3(1, 2, 3), 0, add); // 6
/// ```
pub fn fold(in xs: Array[Int], take init: Int, take step: fn(take Int, take Int) -> Int) -> Int {
    var acc = init;
    var i = 0;
    while i < std::array::len(xs) {
        acc = step(acc, std::array::get(xs, i));
        i = i + 1;
    }
    acc
}

/// A **new** array holding `f(x)` for every element `x` of `xs`, in order. `xs`
/// is only borrowed; the result is freshly allocated. This is the `map` the
/// ADR names, monomorphic `Int → Int` in v0.
///
/// `f` is a function *value* — pass a bare top-level `fn(take Int) -> Int` name.
///
/// # Example
/// ```tuo
/// fn double(take x: Int) -> Int { x * 2 }
/// let ys = std::collections::map_into(std::collections::of3(1, 2, 3), double); // [2, 4, 6]
/// ```
pub fn map_into(in xs: Array[Int], take f: fn(take Int) -> Int) -> Array[Int] {
    var out = std::array::empty();
    var i = 0;
    while i < std::array::len(xs) {
        std::array::push(out, f(std::array::get(xs, i)));
        i = i + 1;
    }
    out
}

/// A **new** array holding exactly the elements of `xs` for which `pred` is
/// true, in order. `xs` is only borrowed; the result's length is
/// data-dependent (freshly allocated).
///
/// `pred` is a function *value* — pass a bare top-level `fn(take Int) -> Bool`
/// name.
///
/// # Example
/// ```tuo
/// fn is_even(take x: Int) -> Bool { x % 2 == 0 }
/// let ys = std::collections::filter_into(std::collections::of3(1, 2, 4), is_even); // [2, 4]
/// ```
pub fn filter_into(in xs: Array[Int], take pred: fn(take Int) -> Bool) -> Array[Int] {
    var out = std::array::empty();
    var i = 0;
    while i < std::array::len(xs) {
        let x = std::array::get(xs, i);
        if pred(x) {
            std::array::push(out, x);
        }
        i = i + 1;
    }
    out
}

/// Does `pred` hold for **any** element of `xs`? `false` for the empty array.
/// Short-circuits on the first match.
///
/// `pred` is a function *value* — pass a bare top-level `fn(take Int) -> Bool`
/// name.
///
/// # Example
/// ```tuo
/// fn is_even(take x: Int) -> Bool { x % 2 == 0 }
/// let b = std::collections::any(std::collections::of3(1, 3, 4), is_even); // true
/// ```
pub fn any(in xs: Array[Int], take pred: fn(take Int) -> Bool) -> Bool {
    var i = 0;
    while i < std::array::len(xs) {
        if pred(std::array::get(xs, i)) {
            return true;
        }
        i = i + 1;
    }
    false
}

/// Does `pred` hold for **every** element of `xs`? `true` for the empty array
/// (vacuously). Short-circuits on the first counterexample.
///
/// `pred` is a function *value* — pass a bare top-level `fn(take Int) -> Bool`
/// name.
///
/// # Example
/// ```tuo
/// fn is_even(take x: Int) -> Bool { x % 2 == 0 }
/// let b = std::collections::all(std::collections::of3(2, 4, 6), is_even); // true
/// ```
pub fn all(in xs: Array[Int], take pred: fn(take Int) -> Bool) -> Bool {
    var i = 0;
    while i < std::array::len(xs) {
        if !pred(std::array::get(xs, i)) {
            return false;
        }
        i = i + 1;
    }
    true
}

// ----------------------------------------------------------------------------
// Named transforms for the combinator specs. These are ordinary top-level
// functions used as *values* — the only way to obtain a function value in
// Tier 1 (ADR-0008). Each combinator spec below passes one of these by name.
// ----------------------------------------------------------------------------

/// Add two integers. Used as a `fold` step value in the specs.
pub fn add(take a: Int, take b: Int) -> Int {
    a + b
}

/// Multiply two integers. Used as a `fold` step value in the specs.
pub fn mul(take a: Int, take b: Int) -> Int {
    a * b
}

/// Double an integer. Used as a `map_into` transform value in the specs.
pub fn double(take x: Int) -> Int {
    x * 2
}

/// Is an integer even? Used as a `filter_into`/`any`/`all` predicate value.
pub fn is_even(take x: Int) -> Bool {
    x % 2 == 0
}

// ----------------------------------------------------------------------------
// Combinators over owned `String` elements (ADR-0012).
//
// ADR-0012 widened the array element set to owned, heap-backed elements, so
// the three combinators it names — `fold`, `map_into`, `filter_into` — gain
// their `String` instantiations here: the same shapes, spelled per element
// type because the stdlib is monomorphic until user generics land (Q-0010).
// Because `String` is not `Copy`, the modes differ deliberately from the `Int`
// forms: a read-only role (a fold step, a filter predicate) *borrows* the
// element (`in String`), while a transform takes ownership (`take String`) and
// returns the new element. `std::array::get` hands each visited element to the
// function as a fresh deep copy (ADR-0012's owned-element `get`), so the
// source array is never disturbed.
// ----------------------------------------------------------------------------

/// Left-fold the elements of a `String` array with `step`, starting from
/// `init`: the accumulator becomes `step(acc, xs[i])` for each element in
/// order. The `String` instantiation of `fold` — the accumulator stays `Int`,
/// and `step` borrows each element (`in String`, the non-`Copy` mode). A
/// zero-element array returns `init` unchanged.
///
/// # Example
/// ```tuo
/// fn add_len(take acc: Int, in s: String) -> Int { acc + std::string::len(s) }
/// // over ["ab", "cde"]: total length 5
/// let n = std::collections::fold_strings(xs, 0, add_len);
/// ```
pub fn fold_strings(in xs: Array[String], take init: Int, take step: fn(take Int, in String) -> Int) -> Int {
    var acc = init;
    var i = 0;
    while i < std::array::len(xs) {
        let x = std::array::get(xs, i);
        acc = step(acc, x);
        i = i + 1;
    }
    acc
}

/// A **new** array holding `f(x)` for every element `x` of `xs`, in order —
/// the `String` instantiation of `map_into`. `xs` is only borrowed: each
/// element reaches `f` as a fresh deep copy (`take String`, the transform
/// consumes its input and returns the new element), and the result is freshly
/// allocated.
///
/// # Example
/// ```tuo
/// fn exclaim(take s: String) -> String {
///     var out = s;
///     std::string::append(out, "!");
///     out
/// }
/// // over ["hi"]: ["hi!"]
/// let ys = std::collections::map_into_strings(xs, exclaim);
/// ```
pub fn map_into_strings(in xs: Array[String], take f: fn(take String) -> String) -> Array[String] {
    var out = std::array::empty();
    var i = 0;
    while i < std::array::len(xs) {
        std::array::push(out, f(std::array::get(xs, i)));
        i = i + 1;
    }
    out
}

/// A **new** array holding exactly the elements of `xs` for which `pred` is
/// true, in order — the `String` instantiation of `filter_into`. `xs` is only
/// borrowed; `pred` borrows each element (`in String`); the result's length is
/// data-dependent (freshly allocated).
///
/// # Example
/// ```tuo
/// fn is_nonempty(in s: String) -> Bool { std::string::len(s) > 0 }
/// // over ["a", "", "bc"]: ["a", "bc"]
/// let kept = std::collections::filter_into_strings(xs, is_nonempty);
/// ```
pub fn filter_into_strings(in xs: Array[String], take pred: fn(in String) -> Bool) -> Array[String] {
    var out = std::array::empty();
    var i = 0;
    while i < std::array::len(xs) {
        let x = std::array::get(xs, i);
        if pred(x) {
            // `x` cannot be pushed here — that would be a conditional move
            // (O0008, no hidden drop flags) — so the kept element is a fresh
            // deep copy of the same slot; `x` drops unconditionally.
            std::array::push(out, std::array::get(xs, i));
        }
        i = i + 1;
    }
    out
}

// ----------------------------------------------------------------------------
// Keyed aggregation over the hash map (ADR-0011).
//
// The dictionary-shaped algorithms the map unblocks. `counts` is the
// canonical one — the frequency table every dedup/histogram/group-by reduces
// to with an `Int` value — and it composes with the map builtins
// (`std::map::{get,len,keys}`) for everything richer. Richer `group_by`
// shapes (a map holding an `Array` per key) await non-`Int` map values, a
// later additive increment the ADR names.
// ----------------------------------------------------------------------------

/// The frequency table of `xs`: a map from each distinct element to how many
/// times it occurs. The keys carry `xs`'s distinct elements in first-seen
/// order (`std::map::keys`' insertion order).
///
/// # Example
/// ```tuo
/// let freq = std::collections::counts(std::collections::of3(2, 7, 2));
/// // std::map::get(freq, 2) == Some { value: 2 }
/// ```
pub fn counts(in xs: Array[Int]) -> Map[Int, Int] {
    var freq = std::map::empty();
    var i = 0;
    while i < std::array::len(xs) {
        let x = std::array::get(xs, i);
        let seen = match std::map::get(freq, x) {
            Some { value } => value,
            None => 0,
        };
        let _ = std::map::insert(freq, x, seen + 1);
        i = i + 1;
    }
    freq
}

// ----------------------------------------------------------------------------
// Named transforms and observation helpers for the String-combinator specs.
// The transforms are private: they exist to be passed as *values* (the only
// way to obtain a function value in Tier 1); the public API is the
// combinators. `nth_is` is the heap-spec observation idiom (`Array == Array`
// over non-scalar elements is deferred): read the i-th owned element and
// compare its text through the ADR-0010 `as_str` view.
// ----------------------------------------------------------------------------

// Add a string's length to the accumulator. Used as a `fold_strings` step.
fn add_len(take acc: Int, in s: String) -> Int {
    acc + std::string::len(s)
}

// Append "!" to an owned string. Used as a `map_into_strings` transform.
fn exclaim(take s: String) -> String {
    var out = s;
    std::string::append(out, "!");
    out
}

// Is the string non-empty? Used as a `filter_into_strings` predicate.
fn is_nonempty(in s: String) -> Bool {
    std::string::len(s) > 0
}

// The i-th element's text equals `want` (bound locally so the view stays
// inside its borrow).
fn nth_is(in xs: Array[String], take i: Int, in want: Str) -> Bool {
    let piece = std::array::get(xs, i);
    std::string::as_str(piece) == want
}

// Build the two-element `String` array the specs exercise.
fn strings_ab_cde() -> Array[String] {
    var out = std::array::empty();
    std::array::push(out, std::string::from_str("ab"));
    std::array::push(out, std::string::from_str("cde"));
    out
}

// ----------------------------------------------------------------------------
// Specs — every function above runs. The array algorithms build their input
// with the constructors, then assert the fold/search result.
// ----------------------------------------------------------------------------

spec first {
    then first(pair(3, 8)) == 3;
    then second(pair(3, 8)) == 8;
}

spec swap {
    then first(swap(pair(3, 8))) == 8;
    then second(swap(pair(3, 8))) == 3;
}

spec range_len {
    then range_len(2, 7) == 5;
    then range_len(7, 2) == 0;
    then range_len(4, 4) == 0;
}

spec range_sum {
    then range_sum(1, 5) == 10;
    then range_sum(0, 0) == 0;
    then range_sum(3, 4) == 3;
}

spec range_contains {
    then range_contains(2, 7, 5);
    then range_contains(2, 7, 2);
    then !range_contains(2, 7, 7);
    then !range_contains(2, 7, 1);
}

spec "array constructors build the expected arrays" {
    then std::array::len(singleton(7)) == 1;
    then std::array::get(singleton(7), 0) == 7;
    then std::array::len(of2(3, 8)) == 2;
    then std::array::get(of2(3, 8), 1) == 8;
    then std::array::len(of3(1, 2, 3)) == 3;
    then std::array::get(of3(1, 2, 3), 2) == 3;
}

spec sum {
    then sum(of3(1, 2, 3)) == 6;
    then sum(of2(10, 20)) == 30;
    then sum(singleton(5)) == 5;
    then sum(std::array::empty()) == 0;
}

spec max_of {
    // Unwrap the Option inline (a sentinel for None), the module-local idiom
    // for leaving the Option world without depending on std::core.
    then match max_of(of3(3, 9, 4)) {
        Some { value } => value,
        None => -1,
    } == 9;
    then match max_of(of2(8, 2)) {
        Some { value } => value,
        None => -1,
    } == 8;
    then match max_of(singleton(5)) {
        Some { value } => value,
        None => -1,
    } == 5;
    then match max_of(std::array::empty()) {
        Some { value } => value,
        None => -1,
    } == -1;
}

spec contains {
    then contains(of3(1, 2, 3), 2);
    then !contains(of3(1, 2, 3), 4);
    then !contains(std::array::empty(), 0);
}

spec index_of {
    then match index_of(of3(7, 8, 9), 8) {
        Some { value } => value,
        None => -1,
    } == 1;
    then match index_of(of3(7, 8, 9), 7) {
        Some { value } => value,
        None => -1,
    } == 0;
    then match index_of(of3(7, 8, 9), 5) {
        Some { value } => value,
        None => -1,
    } == -1;
    then match index_of(std::array::empty(), 0) {
        Some { value } => value,
        None => -1,
    } == -1;
}

spec reversed {
    then std::array::get(reversed(of3(1, 2, 3)), 0) == 3;
    then std::array::get(reversed(of3(1, 2, 3)), 2) == 1;
    then std::array::len(reversed(of3(1, 2, 3))) == 3;
    then sum(reversed(of2(4, 5))) == 9;
    then std::array::len(reversed(std::array::empty())) == 0;
}

spec min_of {
    then match min_of(of3(3, 1, 4)) {
        Some { value } => value,
        None => -1,
    } == 1;
    then match min_of(of2(8, 2)) {
        Some { value } => value,
        None => -1,
    } == 2;
    then match min_of(singleton(5)) {
        Some { value } => value,
        None => -1,
    } == 5;
    then match min_of(std::array::empty()) {
        Some { value } => value,
        None => -1,
    } == -1;
}

spec concat {
    then std::array::len(concat(of2(1, 2), of2(3, 4))) == 4;
    then std::array::get(concat(of2(1, 2), of2(3, 4)), 0) == 1;
    then std::array::get(concat(of2(1, 2), of2(3, 4)), 3) == 4;
    then sum(concat(of3(1, 2, 3), singleton(4))) == 10;
    then std::array::len(concat(std::array::empty(), of2(3, 4))) == 2;
    then std::array::len(concat(of2(1, 2), std::array::empty())) == 2;
}

spec insert_ascending {
    then std::array::get(insert_ascending(of2(1, 3), 2), 1) == 2;
    then std::array::len(insert_ascending(of2(1, 3), 2)) == 3;
    then std::array::get(insert_ascending(of2(2, 4), 1), 0) == 1; // before all
    then std::array::get(insert_ascending(of2(2, 4), 9), 2) == 9; // after all
    then std::array::get(insert_ascending(std::array::empty(), 5), 0) == 5;
}

spec sorted_ascending {
    then is_sorted(sorted_ascending(of3(3, 1, 2)));
    then std::array::get(sorted_ascending(of3(3, 1, 2)), 0) == 1;
    then std::array::get(sorted_ascending(of3(3, 1, 2)), 2) == 3;
    then std::array::len(sorted_ascending(of3(3, 1, 2))) == 3;
    // A sort permutes: the sum is preserved.
    then sum(sorted_ascending(of3(5, 9, 1))) == sum(of3(5, 9, 1));
    then std::array::len(sorted_ascending(std::array::empty())) == 0;
}

spec sorted_descending {
    then std::array::get(sorted_descending(of3(1, 3, 2)), 0) == 3;
    then std::array::get(sorted_descending(of3(1, 3, 2)), 2) == 1;
    then sum(sorted_descending(of3(1, 3, 2))) == 6;
}

spec is_sorted {
    then is_sorted(of3(1, 2, 3));
    then is_sorted(of3(1, 2, 2)); // non-strict
    then !is_sorted(of3(3, 1, 2));
    then is_sorted(singleton(5));
    then is_sorted(std::array::empty());
}

spec binary_search {
    then match binary_search(of3(1, 3, 5), 3) {
        Some { value } => value,
        None => -1,
    } == 1;
    then match binary_search(of3(1, 3, 5), 1) {
        Some { value } => value,
        None => -1,
    } == 0;
    then match binary_search(of3(1, 3, 5), 5) {
        Some { value } => value,
        None => -1,
    } == 2;
    then match binary_search(of3(1, 3, 5), 4) {
        Some { value } => value,
        None => -1,
    } == -1;
    then match binary_search(std::array::empty(), 0) {
        Some { value } => value,
        None => -1,
    } == -1;
    // Agrees with linear index_of on a sorted array.
    then match binary_search(of3(2, 4, 6), 4) {
        Some { value } => value,
        None => -1,
    } == match index_of(of3(2, 4, 6), 4) {
        Some { value } => value,
        None => -1,
    };
}

spec deduped {
    then std::array::len(deduped(of3(1, 1, 2))) == 2;
    then std::array::get(deduped(of3(1, 1, 2)), 0) == 1;
    then std::array::get(deduped(of3(1, 1, 2)), 1) == 2;
    then std::array::len(deduped(of3(1, 2, 3))) == 3; // no dups
    then std::array::len(deduped(std::array::empty())) == 0;
    // deduping a sorted array leaves it sorted.
    then is_sorted(deduped(sorted_ascending(of3(3, 1, 1))));
}

// The combinator specs each pass a NAMED top-level fn as a value (ADR-0008
// Tier 1) — `add`/`mul`/`double`/`is_even` above. Passing the function by name
// is the only way to make a function value in Tier 1.

spec fold {
    // The one generic fold subsumes the specialized ones: `sum` is fold with
    // `add` and init 0; a product is fold with `mul` and init 1.
    then fold(of3(1, 2, 3), 0, add) == 6;
    then fold(of3(1, 2, 3), 1, mul) == 6;
    then fold(of2(10, 20), 0, add) == 30;
    then fold(singleton(5), 100, add) == 105;
    then fold(std::array::empty(), 42, add) == 42;
    // fold-with-add agrees with the specialized `sum` for every array.
    then fold(of3(4, 5, 6), 0, add) == sum(of3(4, 5, 6));
}

spec map_into {
    then std::array::get(map_into(of3(1, 2, 3), double), 0) == 2;
    then std::array::get(map_into(of3(1, 2, 3), double), 2) == 6;
    then std::array::len(map_into(of3(1, 2, 3), double)) == 3;
    then sum(map_into(of3(1, 2, 3), double)) == 12;
    then std::array::len(map_into(std::array::empty(), double)) == 0;
}

spec filter_into {
    // even elements of [1, 2, 3] are [2]; of [2, 4, 6] are all three.
    then std::array::len(filter_into(of3(1, 2, 3), is_even)) == 1;
    then std::array::get(filter_into(of3(1, 2, 3), is_even), 0) == 2;
    then std::array::len(filter_into(of3(2, 4, 6), is_even)) == 3;
    then sum(filter_into(of3(2, 3, 4), is_even)) == 6;
    then std::array::len(filter_into(std::array::empty(), is_even)) == 0;
}

spec any {
    then any(of3(1, 3, 4), is_even);
    then !any(of3(1, 3, 5), is_even);
    then !any(std::array::empty(), is_even);
}

spec all {
    then all(of3(2, 4, 6), is_even);
    then !all(of3(2, 4, 5), is_even);
    then all(std::array::empty(), is_even);
}

// The `String` instantiations (ADR-0012): each spec builds a real owned-element
// array, passes a named private transform as a function value, and asserts
// observations (`len`, `nth_is` through the `as_str` view) — the heap-spec
// idiom, since `Array == Array` over non-scalar elements is deferred.

spec fold_strings {
    let xs = strings_ab_cde();
    then fold_strings(xs, 0, add_len) == 5;
    then fold_strings(xs, 100, add_len) == 105;
    let none: Array[String] = std::array::empty();
    then fold_strings(none, 42, add_len) == 42;
}

spec map_into_strings {
    var xs = std::array::empty();
    std::array::push(xs, std::string::from_str("hi"));
    std::array::push(xs, std::string::from_str(""));
    let ys = map_into_strings(xs, exclaim);
    then std::array::len(ys) == 2;
    then nth_is(ys, 0, "hi!");
    then nth_is(ys, 1, "!");
    // The source array is only borrowed — its elements are unchanged.
    then nth_is(xs, 0, "hi");
    then std::array::len(map_into_strings(std::array::empty(), exclaim)) == 0;
}

spec filter_into_strings {
    var xs = std::array::empty();
    std::array::push(xs, std::string::from_str("a"));
    std::array::push(xs, std::string::from_str(""));
    std::array::push(xs, std::string::from_str("bc"));
    let kept = filter_into_strings(xs, is_nonempty);
    then std::array::len(kept) == 2;
    then nth_is(kept, 0, "a");
    then nth_is(kept, 1, "bc");
    // Filtering agrees with folding: the kept text lengths sum to 3.
    then fold_strings(kept, 0, add_len) == 3;
    then std::array::len(filter_into_strings(std::array::empty(), is_nonempty)) == 0;
}

spec counts {
    // [2, 7, 2] → {2: 2, 7: 1}, keys in first-seen order.
    let freq = counts(of3(2, 7, 2));
    then std::map::len(freq) == 2;
    then match std::map::get(freq, 2) {
        Some { value } => value,
        None => 0 - 1,
    } == 2;
    then match std::map::get(freq, 7) {
        Some { value } => value,
        None => 0 - 1,
    } == 1;
    then match std::map::get(freq, 9) {
        Some { value } => value,
        None => 0 - 1,
    } == 0 - 1;
    then std::array::get(std::map::keys(freq), 0) == 2;
    then std::array::get(std::map::keys(freq), 1) == 7;
    then std::map::len(counts(std::array::empty())) == 0;
    // The counts sum back to the input length.
    then fold(std::map::keys(counts(of3(5, 5, 5))), 0, add) == 5;
    then match std::map::get(counts(of3(5, 5, 5)), 5) {
        Some { value } => value,
        None => 0,
    } == 3;
}

spec add {
    then add(2, 3) == 5;
}

spec mul {
    then mul(4, 5) == 20;
}

spec double {
    then double(6) == 12;
}

spec is_even {
    then is_even(4);
    then !is_even(5);
}
