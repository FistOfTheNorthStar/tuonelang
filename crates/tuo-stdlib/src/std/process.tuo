// std::process — the running process and its children.
//
//   Executable tier — `ExitStatus`, the meaning of a process exit code, and the
//   pure reasoning over it (success, failure, the code itself).
//
//   Effect tier — `exit`, implemented in tuonelang over the `std::rt::exit`
//   effect primitive (ADR-0006). It compiles and runs natively, but an
//   effectful function can never appear in a spec (`R0007`), so it is pinned
//   by a native CLI test instead and marked `EFFECT:`.
//
//   Contract tier — inspecting the OS process (`arg_count`): `std::rt` exposes
//   no argv primitive, so this stays an exact signature with a documented
//   contract and no executable spec, marked `CONTRACT:`.
//
// One exit-status model — a wrapped integer code — used everywhere.

module std::process;

// ----------------------------------------------------------------------------
// ExitStatus — the result of a finished process. Executable tier.
//
// A process exits with an integer code; 0 means success, anything else is a
// failure code. This is the single obvious model.
// ----------------------------------------------------------------------------

/// The exit status of a process: its integer code.
pub struct ExitStatus {
    code: Int,
}

/// The success status (code 0).
///
/// # Example
/// ```tuo
/// let s = std::process::success();
/// ```
pub fn success() -> ExitStatus {
    ExitStatus { code: 0 }
}

/// A failure status with the given non-zero code.
///
/// # Example
/// ```tuo
/// let s = std::process::failure(2);
/// ```
pub fn failure(take code: Int) -> ExitStatus {
    ExitStatus { code }
}

/// The integer exit code of a status.
///
/// # Example
/// ```tuo
/// let c = std::process::code(std::process::failure(2)); // 2
/// ```
pub fn code(in status: ExitStatus) -> Int {
    status.code
}

/// Did the process succeed (exit code 0)?
///
/// # Example
/// ```tuo
/// let b = std::process::is_success(std::process::success()); // true
/// ```
pub fn is_success(in status: ExitStatus) -> Bool {
    status.code == 0
}

// ----------------------------------------------------------------------------
// Process control — the EFFECT tier (`exit`) and the CONTRACT tier
// (`arg_count`).
// ----------------------------------------------------------------------------

/// EFFECT (executable and effectful): terminate the current process with
/// `status`.
///
/// Implemented over the `std::rt::exit` effect primitive: the process ends
/// immediately with `code(status) & 0xff` as its exit status. This never
/// returns — the declared `ExitStatus` return type exists only so the
/// signature composes, and the trailing expression is never reached.
/// Effectful, so no spec (`R0007`); pinned by the native CLI tests in
/// `crates/tuo-cli/tests/stdlib.rs`.
///
/// # Example
/// ```tuo
/// // std::process::exit(std::process::failure(1)); // process ends, status 1
/// ```
pub fn exit(in status: ExitStatus) -> ExitStatus {
    std::rt::exit(code(status));
    status
}

/// CONTRACT (not executable in v0): the number of command-line arguments.
///
/// `std::rt` exposes no argv effect primitive (ADR-0006 landed descriptor
/// I/O and process exit only), so this stays a contract until one exists.
///
/// # Example
/// ```tuo
/// // let n = std::process::arg_count();
/// ```
pub fn arg_count() -> Int {
    // Contract placeholder.
    0
}

// ----------------------------------------------------------------------------
// Specs — executable tier only.
// ----------------------------------------------------------------------------

spec success {
    then code(success()) == 0;
    then is_success(success());
}

spec failure {
    then code(failure(2)) == 2;
    then !is_success(failure(2));
}

spec is_success {
    then is_success(success());
    then !is_success(failure(1));
}
