/// A byte of the sealed record, for the specs below.
fn aead_sealed_byte(take i: Int) -> Int {
    std::array::get(
        aead_seal(
            aead_vector_key(),
            aead_vector_nonce(),
            aead_vector_aad(),
            aead_vector_plaintext(),
        ),
        i,
    )
}

/// The opened plaintext's byte at `i`, or -1 when opening failed — the
/// spelling the round-trip specs need, since `Option` cannot be compared
/// directly in a `then`.
fn aead_opened_byte(take i: Int) -> Int {
    let sealed = aead_seal(
        aead_vector_key(),
        aead_vector_nonce(),
        aead_vector_aad(),
        aead_vector_plaintext(),
    );
    match aead_open(aead_vector_key(), aead_vector_nonce(), aead_vector_aad(), sealed) {
        Some { value } => std::array::get(value, i),
        None => 0 - 1,
    }
}

/// Whether opening a record whose ciphertext was tampered with fails — the
/// property that makes this an AEAD rather than a cipher.
fn aead_rejects_tampering() -> Bool {
    var sealed = aead_seal(
        aead_vector_key(),
        aead_vector_nonce(),
        aead_vector_aad(),
        aead_vector_plaintext(),
    );
    // Flip one bit in the ciphertext.
    std::array::set(sealed, 0, std::array::get(sealed, 0) ^ 1);
    match aead_open(aead_vector_key(), aead_vector_nonce(), aead_vector_aad(), sealed) {
        Some { value } => false,
        None => true,
    }
}

/// Whether opening with the wrong additional data fails. AAD is
/// authenticated but not encrypted, so this is the check that it is
/// authenticated at all.
fn aead_rejects_wrong_aad() -> Bool {
    let sealed = aead_seal(
        aead_vector_key(),
        aead_vector_nonce(),
        aead_vector_aad(),
        aead_vector_plaintext(),
    );
    var other = std::array::empty();
    std::array::push(other, 99);
    match aead_open(aead_vector_key(), aead_vector_nonce(), other, sealed) {
        Some { value } => false,
        None => true,
    }
}

spec aead_seal {
    // RFC 8439 2.8.2's PUBLISHED ciphertext, first eight bytes:
    // d3 1a 8d 34 64 8e 60 db.
    then aead_sealed_byte(0) == 211;
    then aead_sealed_byte(1) == 26;
    then aead_sealed_byte(2) == 141;
    then aead_sealed_byte(3) == 52;
    then aead_sealed_byte(4) == 100;
    then aead_sealed_byte(5) == 142;
    then aead_sealed_byte(6) == 96;
    then aead_sealed_byte(7) == 219;
    // The record is the ciphertext plus a 16-byte tag.
    then std::array::len(
        aead_seal(
            aead_vector_key(),
            aead_vector_nonce(),
            aead_vector_aad(),
            aead_vector_plaintext(),
        ),
    ) == 114 + 16;
    // RFC 8439 2.8.2's PUBLISHED tag, appended after the 114 ciphertext bytes.
    then aead_sealed_byte(114 + 0) == 26;
    then aead_sealed_byte(114 + 1) == 225;
    then aead_sealed_byte(114 + 2) == 11;
    then aead_sealed_byte(114 + 3) == 89;
    then aead_sealed_byte(114 + 4) == 79;
    then aead_sealed_byte(114 + 5) == 9;
    then aead_sealed_byte(114 + 6) == 226;
    then aead_sealed_byte(114 + 7) == 106;
    then aead_sealed_byte(114 + 8) == 126;
    then aead_sealed_byte(114 + 9) == 144;
    then aead_sealed_byte(114 + 10) == 46;
    then aead_sealed_byte(114 + 11) == 203;
    then aead_sealed_byte(114 + 12) == 208;
    then aead_sealed_byte(114 + 13) == 96;
    then aead_sealed_byte(114 + 14) == 6;
    then aead_sealed_byte(114 + 15) == 145;
}

spec aead_open {
    // Round trip: what was sealed opens back to the same plaintext.
    then aead_opened_byte(0) == 76;
    then aead_opened_byte(1) == 97;
    then aead_opened_byte(113) == 46;
    // Integrity, which is the whole point: a single flipped ciphertext bit
    // must make the record fail to open rather than decrypt to garbage.
    then aead_rejects_tampering();
    // The additional data is authenticated even though it is not encrypted.
    then aead_rejects_wrong_aad();
}

spec poly_key_gen {
    // The one-time key is block ZERO, while the ciphertext starts at block
    // one — the separation that keeps the authenticator key clear of the
    // keystream.
    then std::array::len(poly_key_gen(aead_vector_key(), aead_vector_nonce())) == 32;
    then std::array::get(poly_key_gen(aead_vector_key(), aead_vector_nonce()), 0)
        == std::array::get(block(aead_vector_key(), 0, aead_vector_nonce()), 0);
}

/// Append a little-endian 64-bit length to a fresh buffer and read one of
/// its bytes back — `push_le64` writes into a `mut` place, which a spec
/// cannot bind directly.
fn le64_byte(take value: Int, take index: Int) -> Int {
    var buffer = std::array::empty();
    push_le64(buffer, value);
    std::array::get(buffer, index)
}

/// `push_le64`'s own return value, so the spec can call it by name.
fn le64_result(take value: Int) -> Int {
    var buffer = std::array::empty();
    push_le64(buffer, value)
}

spec push_le64 {
    then le64_result(1) == 0;
    // Little-endian: 1 is 01 00 00 00 00 00 00 00.
    then le64_byte(1, 0) == 1;
    then le64_byte(1, 7) == 0;
    // 256 puts its 1 in the SECOND byte, which is what little-endian means.
    then le64_byte(256, 0) == 0;
    then le64_byte(256, 1) == 1;
    // A length is always exactly eight bytes wide.
    then le64_byte(0, 7) == 0;
}

/// The length of a buffer of `size` bytes after padding — `pad16` writes
/// into a `mut` place, which a spec cannot bind directly.
fn padded_len(take size: Int) -> Int {
    var buffer = std::array::empty();
    var i = 0;
    while i < size {
        std::array::push(buffer, 0);
        i = i + 1;
    }
    pad16(buffer);
    std::array::len(buffer)
}

spec pad16 {
    // Already aligned: padding adds nothing. This is the case a naive
    // implementation gets wrong by always appending 16.
    then padded_len(0) == 0;
    then padded_len(16) == 16;
    then padded_len(32) == 32;
    // Unaligned: round up to the next multiple of 16.
    then padded_len(1) == 16;
    then padded_len(12) == 16;
    then padded_len(17) == 32;
    // 12 bytes of AAD pad to 16; 12 of ciphertext pad to 16; plus two
    // 8-byte lengths = 48.
    then std::array::len(aead_mac_data(aead_vector_aad(), aead_vector_aad())) % 16 == 0;
}

spec aead_mac_data {
    // Empty inputs still carry the two length fields.
    then std::array::len(aead_mac_data(std::array::empty(), std::array::empty())) == 16;
}

spec aead_tag {
    // The tag `aead_seal` appends is the one `aead_tag` recomputes.
    then std::array::len(
        aead_tag(
            aead_vector_key(),
            aead_vector_nonce(),
            aead_vector_aad(),
            aead_vector_plaintext(),
        ),
    ) == 16;
}
