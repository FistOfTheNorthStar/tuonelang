// std::chacha — the ChaCha20 stream cipher and Poly1305 authenticator
// (RFC 8439), the AEAD half of a TLS 1.3 record layer.
//
// This module is entirely executable: every function is pure computation over
// `Int` and `Array[Int]`, runs through the reference interpreter, and the
// specs below prove it against the RFC's **published test vectors** rather
// than against the module's own reasoning. That distinction is the whole
// point for a cipher: an implementation that is merely self-consistent is
// worthless, because it agrees with itself while disagreeing with every
// other implementation on the wire.
//
// WHY CHACHA20-POLY1305 AND NOT AES-GCM. Both are TLS 1.3 cipher suites, and
// AES is the more common one — but AES is *defined* over table lookups or a
// hardware instruction, and a table-driven AES written in a high-level
// language is the textbook cache-timing vulnerability. ChaCha20 is defined
// over exactly the operations ADR-0019 gave the language — 32-bit add, XOR,
// and rotate — so it is expressible here *without* a data-dependent memory
// access, which is why Bernstein designed it that way. It is the honest
// choice for a language with no AES instruction.
//
// Design rules (shared across the whole standard library):
//   * One obvious way to do each fundamental thing — no competing APIs.
//   * Free functions only. Method syntax is not lowered in v0.
//   * Every public function carries its exact signature, a doc comment, at
//     least one worked example, and an executable spec.
//
// BYTES ARE `Array[Int]`, each element in `0 ..= 255`. v0 has no `U8`, so a
// "byte string" is that convention, enforced by masking at every boundary —
// the same convention `std::crypto` already uses, so the two compose without
// a conversion layer.
//
// WHAT IS CONSTANT TIME, AND HOW FAR THAT GOES. ChaCha20's control flow is
// data-independent by construction (no branch and no index depends on the
// key or the plaintext), but its functions are NOT marked
// `#[constant_time]`: they loop and index by nature, which the ADR-0020
// checker refuses, and there is no `#[allow]` escape hatch — a function that
// cannot satisfy the checker simply goes unmarked. Poly1305's arithmetic is
// marked: `poly_step` and `poly_finish` are fixed-limb straight-line code
// (ADR-0022), compiler-checked and disassembly-pinned, with only the
// length-driven loops around them unmarked. As everywhere in the library,
// this is verified-branchless source, not a guarantee about wall time.

module std::chacha;

/// The number of 32-bit words in a ChaCha20 state: 4 constants, 8 key words,
/// 1 counter, 3 nonce words.
///
/// # Example
///
/// ```tuo
/// let n = std::chacha::state_words(); // 16
/// ```
pub fn state_words() -> Int {
    16
}

/// The ChaCha20 block size in bytes — 16 words of 4 bytes.
///
/// # Example
///
/// ```tuo
/// let n = std::chacha::block_bytes(); // 64
/// ```
pub fn block_bytes() -> Int {
    64
}

/// The four ChaCha20 constants: the ASCII of "expand 32-byte k", as
/// little-endian 32-bit words (RFC 8439 §2.3).
///
/// # Example
///
/// ```tuo
/// let c = std::chacha::constant(0); // 1634760805 (0x61707865)
/// ```
pub fn constant(take index: Int) -> Int {
    if index == 0 {
        1634760805
    } else if index == 1 {
        857760878
    } else if index == 2 {
        2036477234
    } else {
        1797285236
    }
}

/// One quarter-round applied to four state words, returning the word named by
/// `which` (0 = a, 1 = b, 2 = c, 3 = d).
///
/// The quarter round is ChaCha20's only primitive (RFC 8439 §2.1): add, XOR,
/// rotate, four times. v0 has no tuples and no out-parameters for four
/// values at once, so the round is computed in full and one word selected —
/// the caller runs it four times. That is redundant arithmetic, not redundant
/// *logic*: there is still exactly one expression of the round.
///
/// # Example
///
/// ```tuo
/// // RFC 8439 §2.1.1's vector, whose `a` output is 0xea2a92f4.
/// let a = std::chacha::quarter_round(286331153, 16909060, 2609737539, 19088743, 0);
/// ```
pub fn quarter_round(
    take a: Int,
    take b: Int,
    take c: Int,
    take d: Int,
    take which: Int,
) -> Int {
    var wa = a;
    var wb = b;
    var wc = c;
    var wd = d;
    wa = std::bits::add32(wa, wb);
    wd = std::bits::rotl32(wd ^ wa, 16);
    wc = std::bits::add32(wc, wd);
    wb = std::bits::rotl32(wb ^ wc, 12);
    wa = std::bits::add32(wa, wb);
    wd = std::bits::rotl32(wd ^ wa, 8);
    wc = std::bits::add32(wc, wd);
    wb = std::bits::rotl32(wb ^ wc, 7);
    if which == 0 {
        wa
    } else if which == 1 {
        wb
    } else if which == 2 {
        wc
    } else {
        wd
    }
}

/// Apply one quarter round in place to `state` at the four given indices.
///
/// # Example
///
/// ```tuo
/// var s = std::chacha::initial_state(key, counter, nonce);
/// std::chacha::quarter_round_at(s, 0, 4, 8, 12);
/// ```
pub fn quarter_round_at(
    mut state: Array[Int],
    take ai: Int,
    take bi: Int,
    take ci: Int,
    take di: Int,
) -> Int {
    let a = std::array::get(state, ai);
    let b = std::array::get(state, bi);
    let c = std::array::get(state, ci);
    let d = std::array::get(state, di);
    std::array::set(state, ai, quarter_round(a, b, c, d, 0));
    std::array::set(state, bi, quarter_round(a, b, c, d, 1));
    std::array::set(state, ci, quarter_round(a, b, c, d, 2));
    std::array::set(state, di, quarter_round(a, b, c, d, 3));
    0
}

/// Build the initial ChaCha20 state from a 32-byte key, a block counter, and
/// a 12-byte nonce (RFC 8439 §2.3).
///
/// The key and nonce are byte arrays; they are read as little-endian 32-bit
/// words, which is ChaCha20's byte order throughout (and the reason this
/// module does not reuse `std::bits::be32`).
///
/// # Example
///
/// ```tuo
/// let s = std::chacha::initial_state(key, 1, nonce); // 16 words
/// ```
pub fn initial_state(in key: Array[Int], take counter: Int, in nonce: Array[Int]) -> Array[Int] {
    var state = std::array::empty();
    var i = 0;
    while i < 4 {
        std::array::push(state, constant(i));
        i = i + 1;
    }
    var k = 0;
    while k < 8 {
        std::array::push(state, le32_at(key, k * 4));
        k = k + 1;
    }
    std::array::push(state, std::bits::low32(counter));
    var n = 0;
    while n < 3 {
        std::array::push(state, le32_at(nonce, n * 4));
        n = n + 1;
    }
    state
}

/// Read a little-endian 32-bit word out of a byte array at `offset`.
///
/// Bytes beyond the array's end read as zero, so a short final block needs no
/// separate padding step.
///
/// # Example
///
/// ```tuo
/// let w = std::chacha::le32_at(bytes, 0);
/// ```
pub fn le32_at(in bytes: Array[Int], take offset: Int) -> Int {
    let b0 = byte_or_zero(bytes, offset);
    let b1 = byte_or_zero(bytes, offset + 1);
    let b2 = byte_or_zero(bytes, offset + 2);
    let b3 = byte_or_zero(bytes, offset + 3);
    std::bits::low32(b0 | (b1 << 8) | (b2 << 16) | (b3 << 24))
}

/// The byte at `index`, or 0 when the index is past the end.
///
/// # Example
///
/// ```tuo
/// let b = std::chacha::byte_or_zero(bytes, 99); // 0 if shorter
/// ```
pub fn byte_or_zero(in bytes: Array[Int], take index: Int) -> Int {
    if index < 0 || index >= std::array::len(bytes) {
        0
    } else {
        std::array::get(bytes, index) & 255
    }
}

/// The ChaCha20 block function: 20 rounds over the initial state, added
/// word-wise to it (RFC 8439 §2.3), returning the 64 keystream bytes.
///
/// # Example
///
/// ```tuo
/// let ks = std::chacha::block(key, 1, nonce); // 64 bytes
/// ```
pub fn block(in key: Array[Int], take counter: Int, in nonce: Array[Int]) -> Array[Int] {
    let start = initial_state(key, counter, nonce);
    var work = std::array::empty();
    var c = 0;
    while c < state_words() {
        std::array::push(work, std::array::get(start, c));
        c = c + 1;
    }
    // 10 double-rounds = 20 rounds. Each double round is four column rounds
    // followed by four diagonal rounds.
    var round = 0;
    while round < 10 {
        quarter_round_at(work, 0, 4, 8, 12);
        quarter_round_at(work, 1, 5, 9, 13);
        quarter_round_at(work, 2, 6, 10, 14);
        quarter_round_at(work, 3, 7, 11, 15);
        quarter_round_at(work, 0, 5, 10, 15);
        quarter_round_at(work, 1, 6, 11, 12);
        quarter_round_at(work, 2, 7, 8, 13);
        quarter_round_at(work, 3, 4, 9, 14);
        round = round + 1;
    }
    var out = std::array::empty();
    var w = 0;
    while w < state_words() {
        let sum = std::bits::add32(std::array::get(work, w), std::array::get(start, w));
        // Little-endian serialization, ChaCha20's byte order.
        std::array::push(out, sum & 255);
        std::array::push(out, (sum >> 8) & 255);
        std::array::push(out, (sum >> 16) & 255);
        std::array::push(out, (sum >> 24) & 255);
        w = w + 1;
    }
    out
}

/// Encrypt or decrypt `data` with ChaCha20 (RFC 8439 §2.4).
///
/// The cipher is its own inverse — it XORs a keystream — so one function
/// serves both directions, which is why there is no separate `decrypt`.
///
/// # Example
///
/// ```tuo
/// let ct = std::chacha::apply(key, 1, nonce, plaintext);
/// let pt = std::chacha::apply(key, 1, nonce, ct); // back again
/// ```
pub fn apply(
    in key: Array[Int],
    take counter: Int,
    in nonce: Array[Int],
    in data: Array[Int],
) -> Array[Int] {
    var out = std::array::empty();
    let n = std::array::len(data);
    var offset = 0;
    var block_index = counter;
    while offset < n {
        let keystream = block(key, block_index, nonce);
        var i = 0;
        while i < block_bytes() && offset + i < n {
            let plain = std::array::get(data, offset + i);
            std::array::push(out, (plain & 255) ^ std::array::get(keystream, i));
            i = i + 1;
        }
        offset = offset + block_bytes();
        block_index = block_index + 1;
    }
    out
}

// --- Specs: RFC 8439's PUBLISHED vectors ------------------------------------
//
// These assert the RFC's numbers, not this module's reasoning. That is the
// difference between an implementation that is correct and one that is merely
// self-consistent — and for a cipher, only the former is worth anything,
// because the peer on the other end of the wire implemented the RFC.

/// The RFC 8439 §2.3.2 test key: the bytes 0x00 through 0x1f in order.
fn vector_key() -> Array[Int] {
    var k = std::array::empty();
    var i = 0;
    while i < 32 {
        std::array::push(k, i);
        i = i + 1;
    }
    k
}

/// The RFC 8439 §2.3.2 test nonce: 00:00:00:09:00:00:00:4a:00:00:00:00.
fn vector_nonce() -> Array[Int] {
    var n = std::array::empty();
    std::array::push(n, 0);
    std::array::push(n, 0);
    std::array::push(n, 0);
    std::array::push(n, 9);
    std::array::push(n, 0);
    std::array::push(n, 0);
    std::array::push(n, 0);
    std::array::push(n, 74);
    std::array::push(n, 0);
    std::array::push(n, 0);
    std::array::push(n, 0);
    std::array::push(n, 0);
    n
}

/// One keystream byte of the §2.3.2 block, for the spec below.
fn vector_keystream_byte(take i: Int) -> Int {
    let ks = block(vector_key(), 1, vector_nonce());
    std::array::get(ks, i)
}

spec quarter_round {
    // RFC 8439 §2.1.1: the published (a, b, c, d) outputs for the published
    // inputs. 0xea2a92f4, 0xcb1cf8ce, 0x4581472e, 0x5881c4bb.
    then quarter_round(286331153, 16909060, 2609737539, 19088743, 0) == 3928658676;
    then quarter_round(286331153, 16909060, 2609737539, 19088743, 1) == 3407673550;
    then quarter_round(286331153, 16909060, 2609737539, 19088743, 2) == 1166100270;
    then quarter_round(286331153, 16909060, 2609737539, 19088743, 3) == 1484899515;
}

spec constant {
    // "expand 32-byte k" as little-endian words.
    then constant(0) == 1634760805;
    then constant(1) == 857760878;
    then constant(2) == 2036477234;
    then constant(3) == 1797285236;
}

spec byte_or_zero {
    then byte_or_zero(vector_nonce(), 3) == 9;
    then byte_or_zero(vector_nonce(), 7) == 74;
    // Past the end reads as zero, so a short final block needs no padding.
    then byte_or_zero(vector_nonce(), 99) == 0;
    then byte_or_zero(vector_nonce(), 0 - 1) == 0;
}

spec le32_at {
    // Little-endian: the nonce's bytes 0..3 are 00 00 00 09, so the word is
    // 0x09000000 = 150994944.
    then le32_at(vector_nonce(), 0) == 150994944;
    // Reading past the end pads with zeros rather than trapping.
    then le32_at(vector_nonce(), 96) == 0;
}

spec block {
    // RFC 8439 §2.3.2's published keystream. First word 0xe4e7f110
    // serializes little-endian as 10 f1 e7 e4.
    then vector_keystream_byte(0) == 16;
    then vector_keystream_byte(1) == 241;
    then vector_keystream_byte(2) == 231;
    then vector_keystream_byte(3) == 228;
    // Last word 0x4e3c50a2 serializes as a2 50 3c 4e.
    then vector_keystream_byte(60) == 162;
    then vector_keystream_byte(61) == 80;
    then vector_keystream_byte(62) == 60;
    then vector_keystream_byte(63) == 78;
    // A block is exactly 64 bytes.
    then std::array::len(block(vector_key(), 1, vector_nonce())) == 64;
}

spec apply {
    // The cipher is its own inverse: encrypting twice returns the plaintext.
    // This is the property that makes one function serve both directions.
    then std::array::get(
        apply(vector_key(), 1, vector_nonce(), apply(vector_key(), 1, vector_nonce(), vector_key())),
        0,
    ) == 0;
    then std::array::get(
        apply(vector_key(), 1, vector_nonce(), apply(vector_key(), 1, vector_nonce(), vector_key())),
        31,
    ) == 31;
    // Ciphertext is the same length as plaintext — a stream cipher adds no
    // padding.
    then std::array::len(apply(vector_key(), 1, vector_nonce(), vector_key())) == 32;
    // And it actually encrypts: the first byte XORs with keystream byte 0.
    then std::array::get(apply(vector_key(), 1, vector_nonce(), vector_key()), 0) == 16;
}

spec state_words {
    // 4 constants + 8 key words + 1 counter + 3 nonce words.
    then state_words() == 16;
}

spec block_bytes {
    // 16 words of 4 bytes each.
    then block_bytes() == 64;
    then block_bytes() == state_words() * 4;
}

spec initial_state {
    // The four constants come first, then the key, counter, and nonce.
    then std::array::len(initial_state(vector_key(), 1, vector_nonce())) == state_words();
    then std::array::get(initial_state(vector_key(), 1, vector_nonce()), 0) == constant(0);
    then std::array::get(initial_state(vector_key(), 1, vector_nonce()), 3) == constant(3);
    // The counter sits at word 12, between the key and the nonce.
    then std::array::get(initial_state(vector_key(), 7, vector_nonce()), 12) == 7;
    // Word 13 is the nonce's first little-endian word, 0x09000000.
    then std::array::get(initial_state(vector_key(), 1, vector_nonce()), 13) == 150994944;
}

/// Apply one column round to a fresh state, returning `quarter_round_at`'s
/// own result — the spelling the spec needs, since a `mut` argument must be a
/// place and a call result is a temporary.
fn round_in_place() -> Int {
    var s = initial_state(vector_key(), 1, vector_nonce());
    quarter_round_at(s, 0, 4, 8, 12)
}

/// The state word at `index` after one column round is applied to a fresh
/// initial state — the observable `quarter_round_at`'s spec needs, since v0
/// has no way to assert on a mutation from inside a `then`.
fn state_after_one_round(take index: Int) -> Int {
    var s = initial_state(vector_key(), 1, vector_nonce());
    quarter_round_at(s, 0, 4, 8, 12);
    std::array::get(s, index)
}

spec quarter_round_at {
    // `quarter_round_at` needs a `mut` *place*, which a spec cannot bind
    // (`given` is immutable) and a call result is not (`O0004`). So the call
    // lives in `round_in_place`, and the round's effect is asserted through
    // `state_after_one_round` below.
    then round_in_place() == 0;
    // Applying the round in place must equal computing it directly on the
    // same four words — the property that makes the in-place form a mere
    // convenience over `quarter_round` rather than a second implementation.
    then state_after_one_round(0)
        == quarter_round(constant(0), le32_at(vector_key(), 0), le32_at(vector_key(), 16), 1, 0);
    then state_after_one_round(4)
        == quarter_round(constant(0), le32_at(vector_key(), 0), le32_at(vector_key(), 16), 1, 1);
    then state_after_one_round(8)
        == quarter_round(constant(0), le32_at(vector_key(), 0), le32_at(vector_key(), 16), 1, 2);
    then state_after_one_round(12)
        == quarter_round(constant(0), le32_at(vector_key(), 0), le32_at(vector_key(), 16), 1, 3);
    // Words the round does not touch are unchanged.
    then state_after_one_round(1) == constant(1);
}

// --- Poly1305 (RFC 8439 §2.5) -----------------------------------------------
//
// The one-time authenticator that turns ChaCha20's confidentiality into an
// AEAD. It evaluates a polynomial over the prime field 2^130 - 5.
//
// ONE-TIME is the load-bearing word, and it is a *security* property, not a
// performance note. The key must never be reused across two messages: two
// tags under one key let an attacker solve for `r` and forge arbitrary
// messages. In the AEAD below the key is derived per-record from the nonce,
// which is what makes that safe.
//
// FIXED LIMBS, CONSTANT TIME (ADR-0022). The accumulator, the key halves `r`
// and `s`, and each message block are `Poly` values: five 26-bit limbs, the
// layout of poly1305-donna. A block step is twenty-five limb products and a
// fixed carry chain, written with `std::int`'s wrapping operations and
// marked `#[constant_time]`, as is the final reduction, which chooses
// between h and h - p by mask rather than by comparison. The bound that
// replaces the trap: limbs enter a step below 2^27 and the clamped `r`
// below 2^26 (2^28.4 times five), so every product sum stays below 2^58.
// The loops — over blocks, and over bytes in the loaders — depend only on
// the message *length*, which the record layer sends in the clear anyway.
//
// This replaced a `std::bignum` implementation that normalized, skipped zero
// limbs, and reduced by repeated subtraction — timing that depended on the
// one-time key and the plaintext.

/// An element of GF(2^130 - 5) — the accumulator, a key half, or one message
/// block — in five 26-bit limbs, least significant first.
///
/// # Example
///
/// ```tuo
/// let r = std::chacha::poly_limbs(std::chacha::poly_clamp_r(key));
/// ```
pub struct Poly {
    l0: Int,
    l1: Int,
    l2: Int,
    l3: Int,
    l4: Int,
}

/// Clamp the `r` half of a Poly1305 key (RFC 8439 §2.5): certain bits are
/// forced to zero so the multiplication cannot overflow the field.
///
/// The clamp is part of the algorithm, not an optimization — an unclamped `r`
/// produces tags no other implementation agrees with. The two `if`s branch on
/// the byte position, never on the key.
///
/// # Example
///
/// ```tuo
/// let r = std::chacha::poly_clamp_r(key); // the first 16 bytes, clamped
/// ```
pub fn poly_clamp_r(in key: Array[Int]) -> Array[Int] {
    var out = std::array::empty();
    var i = 0;
    while i < 16 {
        var b = byte_or_zero(key, i);
        // Bytes 3, 7, 11, 15 keep only their low 4 bits; bytes 4, 8, 12 have
        // their low 2 bits cleared.
        if i == 3 || i == 7 || i == 11 || i == 15 {
            b = b & 15;
        }
        if i == 4 || i == 8 || i == 12 {
            b = b & 252;
        }
        std::array::push(out, b);
        i = i + 1;
    }
    out
}

/// The 26 bits of a little-endian byte string starting at bit `low`, with
/// bytes past the end read as zero.
fn bits_26(in bytes: Array[Int], take low: Int) -> Int {
    let first = low >> 3;
    var acc = 0;
    var k = 0;
    while k < 5 {
        acc = acc | (byte_or_zero(bytes, first + k) << (k * 8));
        k = k + 1;
    }
    (acc >> (low & 7)) & 67108863
}

/// A little-endian byte string of up to 17 bytes as five 26-bit limbs (bits
/// 0 to 129; missing bytes are zero).
///
/// # Example
///
/// ```tuo
/// let s = std::chacha::poly_limbs(pad_bytes);
/// ```
pub fn poly_limbs(in bytes: Array[Int]) -> Poly {
    Poly {
        l0: bits_26(bytes, 0),
        l1: bits_26(bytes, 26),
        l2: bits_26(bytes, 52),
        l3: bits_26(bytes, 78),
        l4: bits_26(bytes, 104),
    }
}

/// The 16 bytes of a reduced value's low 128 bits, little-endian — the tag.
///
/// # Example
///
/// ```tuo
/// let tag = std::chacha::poly_bytes(std::chacha::poly_finish(h, s));
/// ```
pub fn poly_bytes(take f: Poly) -> Array[Int] {
    let limbs = [f.l0, f.l1, f.l2, f.l3, f.l4];
    var out = std::array::empty();
    var acc = 0;
    var bits = 0;
    var limb = 0;
    while limb < 5 {
        acc = acc | (limbs[limb as Usize] << bits);
        bits = bits + 26;
        while bits >= 8 && std::array::len(out) < 16 {
            std::array::push(out, acc & 255);
            acc = acc >> 8;
            bits = bits - 8;
        }
        limb = limb + 1;
    }
    out
}

/// Zero, the accumulator's starting value.
///
/// # Example
///
/// ```tuo
/// var h = std::chacha::poly_zero();
/// ```
#[constant_time]
pub fn poly_zero() -> Poly {
    Poly { l0: 0, l1: 0, l2: 0, l3: 0, l4: 0 }
}

/// One Poly1305 block: `(h + m) * r mod 2^130 - 5`, partially carried.
///
/// `m` is the block with its padding bit already set (`poly_limbs` of the
/// padded block). Since 2^130 = 5 in this field, a product's limbs past
/// 2^130 fold back multiplied by 5, which is why `r`'s upper limbs appear
/// pre-multiplied (`s1` to `s4`).
///
/// # Example
///
/// ```tuo
/// h = std::chacha::poly_step(h, r, std::chacha::poly_limbs(block));
/// ```
#[constant_time]
pub fn poly_step(take h: Poly, take r: Poly, take m: Poly) -> Poly {
    let h0 = std::int::wrapping_add(h.l0, m.l0);
    let h1 = std::int::wrapping_add(h.l1, m.l1);
    let h2 = std::int::wrapping_add(h.l2, m.l2);
    let h3 = std::int::wrapping_add(h.l3, m.l3);
    let h4 = std::int::wrapping_add(h.l4, m.l4);
    let s1 = std::int::wrapping_mul(r.l1, 5);
    let s2 = std::int::wrapping_mul(r.l2, 5);
    let s3 = std::int::wrapping_mul(r.l3, 5);
    let s4 = std::int::wrapping_mul(r.l4, 5);
    var d0 = std::int::wrapping_mul(h0, r.l0);
    d0 = std::int::wrapping_add(d0, std::int::wrapping_mul(h1, s4));
    d0 = std::int::wrapping_add(d0, std::int::wrapping_mul(h2, s3));
    d0 = std::int::wrapping_add(d0, std::int::wrapping_mul(h3, s2));
    d0 = std::int::wrapping_add(d0, std::int::wrapping_mul(h4, s1));
    var d1 = std::int::wrapping_mul(h0, r.l1);
    d1 = std::int::wrapping_add(d1, std::int::wrapping_mul(h1, r.l0));
    d1 = std::int::wrapping_add(d1, std::int::wrapping_mul(h2, s4));
    d1 = std::int::wrapping_add(d1, std::int::wrapping_mul(h3, s3));
    d1 = std::int::wrapping_add(d1, std::int::wrapping_mul(h4, s2));
    var d2 = std::int::wrapping_mul(h0, r.l2);
    d2 = std::int::wrapping_add(d2, std::int::wrapping_mul(h1, r.l1));
    d2 = std::int::wrapping_add(d2, std::int::wrapping_mul(h2, r.l0));
    d2 = std::int::wrapping_add(d2, std::int::wrapping_mul(h3, s4));
    d2 = std::int::wrapping_add(d2, std::int::wrapping_mul(h4, s3));
    var d3 = std::int::wrapping_mul(h0, r.l3);
    d3 = std::int::wrapping_add(d3, std::int::wrapping_mul(h1, r.l2));
    d3 = std::int::wrapping_add(d3, std::int::wrapping_mul(h2, r.l1));
    d3 = std::int::wrapping_add(d3, std::int::wrapping_mul(h3, r.l0));
    d3 = std::int::wrapping_add(d3, std::int::wrapping_mul(h4, s4));
    var d4 = std::int::wrapping_mul(h0, r.l4);
    d4 = std::int::wrapping_add(d4, std::int::wrapping_mul(h1, r.l3));
    d4 = std::int::wrapping_add(d4, std::int::wrapping_mul(h2, r.l2));
    d4 = std::int::wrapping_add(d4, std::int::wrapping_mul(h3, r.l1));
    d4 = std::int::wrapping_add(d4, std::int::wrapping_mul(h4, r.l0));
    var c = d0 >> 26;
    var l0 = d0 & 67108863;
    d1 = std::int::wrapping_add(d1, c);
    c = d1 >> 26;
    let l1 = d1 & 67108863;
    d2 = std::int::wrapping_add(d2, c);
    c = d2 >> 26;
    let l2 = d2 & 67108863;
    d3 = std::int::wrapping_add(d3, c);
    c = d3 >> 26;
    let l3 = d3 & 67108863;
    d4 = std::int::wrapping_add(d4, c);
    c = d4 >> 26;
    let l4 = d4 & 67108863;
    l0 = std::int::wrapping_add(l0, std::int::wrapping_mul(c, 5));
    c = l0 >> 26;
    l0 = l0 & 67108863;
    Poly {
        l0: l0,
        l1: std::int::wrapping_add(l1, c),
        l2: l2,
        l3: l3,
        l4: l4,
    }
}

/// The tag from the final accumulator: carry `h` fully, reduce it below
/// 2^130 - 5, add the pad `s`, and keep the low 128 bits.
///
/// The reduction computes g = h + 5 - 2^130 and keeps it exactly when it is
/// non-negative (h >= p), choosing by the sign of g's top limb and
/// `std::ct::select` rather than by comparing.
///
/// # Example
///
/// ```tuo
/// let tag = std::chacha::poly_bytes(std::chacha::poly_finish(h, s));
/// ```
#[constant_time]
pub fn poly_finish(take h: Poly, take s: Poly) -> Poly {
    var h0 = h.l0;
    var h1 = h.l1;
    var h2 = h.l2;
    var h3 = h.l3;
    var h4 = h.l4;
    var c = h1 >> 26;
    h1 = h1 & 67108863;
    h2 = std::int::wrapping_add(h2, c);
    c = h2 >> 26;
    h2 = h2 & 67108863;
    h3 = std::int::wrapping_add(h3, c);
    c = h3 >> 26;
    h3 = h3 & 67108863;
    h4 = std::int::wrapping_add(h4, c);
    c = h4 >> 26;
    h4 = h4 & 67108863;
    h0 = std::int::wrapping_add(h0, std::int::wrapping_mul(c, 5));
    c = h0 >> 26;
    h0 = h0 & 67108863;
    h1 = std::int::wrapping_add(h1, c);
    // g = h + 5 - 2^130.
    var g0 = std::int::wrapping_add(h0, 5);
    c = g0 >> 26;
    g0 = g0 & 67108863;
    var g1 = std::int::wrapping_add(h1, c);
    c = g1 >> 26;
    g1 = g1 & 67108863;
    var g2 = std::int::wrapping_add(h2, c);
    c = g2 >> 26;
    g2 = g2 & 67108863;
    var g3 = std::int::wrapping_add(h3, c);
    c = g3 >> 26;
    g3 = g3 & 67108863;
    let g4 = std::int::wrapping_sub(std::int::wrapping_add(h4, c), 67108864);
    // 1 when g4 >= 0 (h >= p, so g = h - p is the reduced value), else 0.
    let reduce = std::int::wrapping_add(g4 >> 63, 1);
    let f0 = std::ct::select(reduce, g0, h0);
    let f1 = std::ct::select(reduce, g1, h1);
    let f2 = std::ct::select(reduce, g2, h2);
    let f3 = std::ct::select(reduce, g3, h3);
    let f4 = std::ct::select(reduce, g4 & 67108863, h4);
    // Add s and keep 128 bits: the top limb holds bits 104 to 127.
    var t = std::int::wrapping_add(f0, s.l0);
    let o0 = t & 67108863;
    t = std::int::wrapping_add(std::int::wrapping_add(f1, s.l1), t >> 26);
    let o1 = t & 67108863;
    t = std::int::wrapping_add(std::int::wrapping_add(f2, s.l2), t >> 26);
    let o2 = t & 67108863;
    t = std::int::wrapping_add(std::int::wrapping_add(f3, s.l3), t >> 26);
    let o3 = t & 67108863;
    t = std::int::wrapping_add(std::int::wrapping_add(f4, s.l4), t >> 26);
    Poly { l0: o0, l1: o1, l2: o2, l3: o3, l4: t & 16777215 }
}

/// The 17-byte block at `offset`: up to 16 message bytes, then the 1 byte
/// that makes the polynomial injective over variable-length input, then
/// zeros. For a full block the 1 lands at bit 128.
fn poly_block(in message: Array[Int], take offset: Int) -> Array[Int] {
    var out = std::array::empty();
    let n = std::array::len(message);
    var i = 0;
    while i < 16 && offset + i < n {
        std::array::push(out, std::array::get(message, offset + i) & 255);
        i = i + 1;
    }
    std::array::push(out, 1);
    out
}

/// The Poly1305 one-time authenticator (RFC 8439 §2.5): a 16-byte tag over
/// `message` under the 32-byte one-time `key`.
///
/// The key MUST NOT be reused across messages — see the section header.
///
/// # Example
///
/// ```tuo
/// let tag = std::chacha::poly1305(one_time_key, message); // 16 bytes
/// ```
pub fn poly1305(in key: Array[Int], in message: Array[Int]) -> Array[Int] {
    let r = poly_limbs(poly_clamp_r(key));
    var s_bytes = std::array::empty();
    var k = 16;
    while k < 32 {
        std::array::push(s_bytes, byte_or_zero(key, k));
        k = k + 1;
    }
    let s = poly_limbs(s_bytes);
    var h = poly_zero();
    let n = std::array::len(message);
    var offset = 0;
    while offset < n {
        h = poly_step(h, r, poly_limbs(poly_block(message, offset)));
        offset = offset + 16;
    }
    poly_bytes(poly_finish(h, s))
}

// --- Poly1305 specs: RFC 8439 2.5.2's PUBLISHED vector ----------------------

/// The RFC 8439 2.5.2 one-time key.
fn poly_vector_key() -> Array[Int] {
    var a = std::array::empty();
    std::array::push(a, 133);
    std::array::push(a, 214);
    std::array::push(a, 190);
    std::array::push(a, 120);
    std::array::push(a, 87);
    std::array::push(a, 85);
    std::array::push(a, 109);
    std::array::push(a, 51);
    std::array::push(a, 127);
    std::array::push(a, 68);
    std::array::push(a, 82);
    std::array::push(a, 254);
    std::array::push(a, 66);
    std::array::push(a, 213);
    std::array::push(a, 6);
    std::array::push(a, 168);
    std::array::push(a, 1);
    std::array::push(a, 3);
    std::array::push(a, 128);
    std::array::push(a, 138);
    std::array::push(a, 251);
    std::array::push(a, 13);
    std::array::push(a, 178);
    std::array::push(a, 253);
    std::array::push(a, 74);
    std::array::push(a, 191);
    std::array::push(a, 246);
    std::array::push(a, 175);
    std::array::push(a, 65);
    std::array::push(a, 73);
    std::array::push(a, 245);
    std::array::push(a, 27);
    a
}

/// The RFC 8439 2.5.2 message: "Cryptographic Forum Research Group".
fn poly_vector_message() -> Array[Int] {
    var a = std::array::empty();
    std::array::push(a, 67);
    std::array::push(a, 114);
    std::array::push(a, 121);
    std::array::push(a, 112);
    std::array::push(a, 116);
    std::array::push(a, 111);
    std::array::push(a, 103);
    std::array::push(a, 114);
    std::array::push(a, 97);
    std::array::push(a, 112);
    std::array::push(a, 104);
    std::array::push(a, 105);
    std::array::push(a, 99);
    std::array::push(a, 32);
    std::array::push(a, 70);
    std::array::push(a, 111);
    std::array::push(a, 114);
    std::array::push(a, 117);
    std::array::push(a, 109);
    std::array::push(a, 32);
    std::array::push(a, 82);
    std::array::push(a, 101);
    std::array::push(a, 115);
    std::array::push(a, 101);
    std::array::push(a, 97);
    std::array::push(a, 114);
    std::array::push(a, 99);
    std::array::push(a, 104);
    std::array::push(a, 32);
    std::array::push(a, 71);
    std::array::push(a, 114);
    std::array::push(a, 111);
    std::array::push(a, 117);
    std::array::push(a, 112);
    a
}

/// The RFC 8439 2.5.2 published tag, a8061dc1305136c6c22b8baf0c0127a9.
fn poly_vector_tag() -> Array[Int] {
    var a = std::array::empty();
    std::array::push(a, 168);
    std::array::push(a, 6);
    std::array::push(a, 29);
    std::array::push(a, 193);
    std::array::push(a, 48);
    std::array::push(a, 81);
    std::array::push(a, 54);
    std::array::push(a, 198);
    std::array::push(a, 194);
    std::array::push(a, 43);
    std::array::push(a, 139);
    std::array::push(a, 175);
    std::array::push(a, 12);
    std::array::push(a, 1);
    std::array::push(a, 39);
    std::array::push(a, 169);
    a
}

/// The computed tag byte at `i`, for the spec below.
fn poly_tag_byte(take i: Int) -> Int {
    std::array::get(poly1305(poly_vector_key(), poly_vector_message()), i)
}

spec poly1305 {
    // Every byte of RFC 8439 2.5.2's PUBLISHED tag. This is the assertion
    // that matters: it pins the implementation against the RFC rather than
    // against its own reasoning, which is the only thing that makes an
    // authenticator interoperable.
    then poly_tag_byte(0) == 168;
    then poly_tag_byte(1) == 6;
    then poly_tag_byte(2) == 29;
    then poly_tag_byte(3) == 193;
    then poly_tag_byte(4) == 48;
    then poly_tag_byte(5) == 81;
    then poly_tag_byte(6) == 54;
    then poly_tag_byte(7) == 198;
    then poly_tag_byte(8) == 194;
    then poly_tag_byte(9) == 43;
    then poly_tag_byte(10) == 139;
    then poly_tag_byte(11) == 175;
    then poly_tag_byte(12) == 12;
    then poly_tag_byte(13) == 1;
    then poly_tag_byte(14) == 39;
    then poly_tag_byte(15) == 169;
    // A tag is exactly 16 bytes.
    then std::array::len(poly1305(poly_vector_key(), poly_vector_message())) == 16;
}

spec poly_clamp_r {
    // The clamp is part of the algorithm: bytes 3/7/11/15 keep 4 bits,
    // bytes 4/8/12 have their low 2 bits cleared.
    then std::array::get(poly_clamp_r(poly_vector_key()), 3) == 120 & 15;
    then std::array::get(poly_clamp_r(poly_vector_key()), 4) == 87 & 252;
    then std::array::len(poly_clamp_r(poly_vector_key())) == 16;
    // An unclamped byte passes through unchanged.
    then std::array::get(poly_clamp_r(poly_vector_key()), 0) == 133;
}

/// A `Poly` from five limbs, for the specs below.
fn poly_of(take l0: Int, take l1: Int, take l2: Int, take l3: Int, take l4: Int) -> Poly {
    Poly { l0: l0, l1: l1, l2: l2, l3: l3, l4: l4 }
}

/// Whether two `Poly` values have the same limbs.
fn poly_same(take a: Poly, take b: Poly) -> Bool {
    a.l0 == b.l0 && a.l1 == b.l1 && a.l2 == b.l2 && a.l3 == b.l3 && a.l4 == b.l4
}

/// `count` bytes of 0xff.
fn ones(take count: Int) -> Array[Int] {
    var out = std::array::empty();
    var i = 0;
    while i < count {
        std::array::push(out, 255);
        i = i + 1;
    }
    out
}

spec poly_limbs {
    // Little-endian, 26 bits a limb: byte 0 is limb 0's low bits, and a 17th
    // byte of 1 is bit 128, bit 24 of the top limb.
    then poly_limbs(poly_vector_tag()).l0 == 168 + 6 * 256 + 29 * 65536 + (193 & 3) * 16777216;
    then poly_same(poly_limbs(ones(17)), poly_of(67108863, 67108863, 67108863, 67108863, 67108863));
    then poly_same(poly_limbs(ones(16)), poly_of(67108863, 67108863, 67108863, 67108863, 16777215));
    then poly_same(poly_limbs(std::array::empty()), poly_zero());
}

spec poly_bytes {
    // The inverse of `poly_limbs` on 16 bytes.
    then std::array::len(poly_bytes(poly_limbs(poly_vector_tag()))) == 16;
    then std::array::get(poly_bytes(poly_limbs(poly_vector_tag())), 0) == 168;
    then std::array::get(poly_bytes(poly_limbs(poly_vector_tag())), 15) == 169;
    then std::array::get(poly_bytes(poly_limbs(poly_vector_tag())), 7) == 198;
}

spec poly_zero {
    then poly_same(poly_zero(), poly_of(0, 0, 0, 0, 0));
}

spec poly_step {
    // (0 + 2) * 3 = 6, and (1 + 0) * 2^26 = 2^26 (a carry into limb 1).
    then poly_same(poly_step(poly_zero(), poly_of(3, 0, 0, 0, 0), poly_of(2, 0, 0, 0, 0)), poly_of(6, 0, 0, 0, 0));
    then poly_same(poly_step(poly_of(1, 0, 0, 0, 0), poly_of(0, 1, 0, 0, 0), poly_zero()), poly_of(0, 1, 0, 0, 0));
    // 2^104 * 2^26 = 2^130 = 5: the fold.
    then poly_same(poly_finish(poly_step(poly_of(0, 0, 0, 0, 1), poly_of(0, 1, 0, 0, 0), poly_zero()), poly_zero()), poly_of(5, 0, 0, 0, 0));
}

spec poly_finish {
    // p = 2^130 - 5 reduces to 0, p + 1 to 1, and p - 1 stays.
    then poly_same(poly_finish(poly_of(67108859, 67108863, 67108863, 67108863, 67108863), poly_zero()), poly_zero());
    then poly_same(poly_finish(poly_of(67108860, 67108863, 67108863, 67108863, 67108863), poly_zero()), poly_of(1, 0, 0, 0, 0));
    then poly_same(
        poly_finish(poly_of(67108858, 67108863, 67108863, 67108863, 67108863), poly_zero()),
        poly_of(67108858, 67108863, 67108863, 67108863, 16777215),
    );
    // The pad is added modulo 2^128: (2^128 - 1) + 1 wraps to 0.
    then poly_same(poly_finish(poly_limbs(ones(16)), poly_of(1, 0, 0, 0, 0)), poly_zero());
}

// --- AEAD_CHACHA20_POLY1305 (RFC 8439 §2.8) ---------------------------------
//
// The composition that TLS 1.3 actually uses: ChaCha20 for confidentiality,
// Poly1305 for integrity, and a specific framing that binds them together.
//
// The framing is not decoration. The one-time Poly1305 key is derived from
// ChaCha20 block **zero** while the ciphertext starts at block **one**, so
// the authenticator key can never collide with keystream — that is what makes
// the one-time requirement satisfiable. The length fields at the end prevent
// an attacker from shifting bytes between the additional data and the
// ciphertext, which would otherwise authenticate to the same tag.

/// Derive the Poly1305 one-time key for a record: ChaCha20 block zero under
/// the same key and nonce (RFC 8439 §2.6).
///
/// # Example
///
/// ```tuo
/// let otk = std::chacha::poly_key_gen(key, nonce); // 32 bytes
/// ```
pub fn poly_key_gen(in key: Array[Int], in nonce: Array[Int]) -> Array[Int] {
    let ks = block(key, 0, nonce);
    var out = std::array::empty();
    var i = 0;
    while i < 32 {
        std::array::push(out, std::array::get(ks, i));
        i = i + 1;
    }
    out
}

/// Append `value` as an 8-byte little-endian length, the framing AEAD uses
/// for its additional-data and ciphertext lengths.
///
/// # Example
///
/// ```tuo
/// std::chacha::push_le64(buffer, 12);
/// ```
pub fn push_le64(mut out: Array[Int], take value: Int) -> Int {
    var v = value;
    var i = 0;
    while i < 8 {
        std::array::push(out, v & 255);
        v = v >> 8;
        i = i + 1;
    }
    0
}

/// Append zero bytes until `out`'s length is a multiple of 16 — the padding
/// AEAD inserts after the additional data and after the ciphertext.
///
/// # Example
///
/// ```tuo
/// std::chacha::pad16(buffer);
/// ```
pub fn pad16(mut out: Array[Int]) -> Int {
    var remainder = std::array::len(out) % 16;
    if remainder > 0 {
        var i = remainder;
        while i < 16 {
            std::array::push(out, 0);
            i = i + 1;
        }
    }
    0
}

/// Build the exact byte string Poly1305 authenticates over a record
/// (RFC 8439 §2.8): the additional data, padded to 16; the ciphertext, padded
/// to 16; then both lengths as 8-byte little-endian values.
///
/// # Example
///
/// ```tuo
/// let mac_input = std::chacha::aead_mac_data(aad, ciphertext);
/// ```
pub fn aead_mac_data(in aad: Array[Int], in ciphertext: Array[Int]) -> Array[Int] {
    var out = std::array::empty();
    var i = 0;
    while i < std::array::len(aad) {
        std::array::push(out, std::array::get(aad, i) & 255);
        i = i + 1;
    }
    pad16(out);
    var j = 0;
    while j < std::array::len(ciphertext) {
        std::array::push(out, std::array::get(ciphertext, j) & 255);
        j = j + 1;
    }
    pad16(out);
    // The lengths bind the two fields together: without them an attacker
    // could move bytes from the ciphertext into the additional data and
    // produce the same tag.
    push_le64(out, std::array::len(aad));
    push_le64(out, std::array::len(ciphertext));
    out
}

/// Seal a message: encrypt `plaintext` and authenticate it together with
/// `aad`, returning the ciphertext with its 16-byte tag appended
/// (RFC 8439 §2.8).
///
/// # Example
///
/// ```tuo
/// let sealed = std::chacha::aead_seal(key, nonce, aad, plaintext);
/// ```
pub fn aead_seal(
    in key: Array[Int],
    in nonce: Array[Int],
    in aad: Array[Int],
    in plaintext: Array[Int],
) -> Array[Int] {
    let otk = poly_key_gen(key, nonce);
    // Counter 1: block 0 is spent on the one-time key, which is exactly what
    // keeps the authenticator key clear of the keystream.
    let ciphertext = apply(key, 1, nonce, plaintext);
    let tag = poly1305(otk, aead_mac_data(aad, ciphertext));
    var out = std::array::empty();
    var i = 0;
    while i < std::array::len(ciphertext) {
        std::array::push(out, std::array::get(ciphertext, i));
        i = i + 1;
    }
    var t = 0;
    while t < 16 {
        std::array::push(out, std::array::get(tag, t));
        t = t + 1;
    }
    out
}

/// The tag a sealed record should carry, recomputed from its ciphertext —
/// the value `aead_open` compares against.
///
/// # Example
///
/// ```tuo
/// let expected = std::chacha::aead_tag(key, nonce, aad, ciphertext);
/// ```
pub fn aead_tag(
    in key: Array[Int],
    in nonce: Array[Int],
    in aad: Array[Int],
    in ciphertext: Array[Int],
) -> Array[Int] {
    poly1305(poly_key_gen(key, nonce), aead_mac_data(aad, ciphertext))
}

/// Open a sealed record: verify its tag and, only then, decrypt it.
///
/// Returns the plaintext, or `None` when the tag does not match. **The
/// `None` case must be treated as fatal by the caller** — a failed tag means
/// the record was forged or corrupted, and there is no partial result worth
/// looking at. Returning `Option` rather than the plaintext-and-a-flag is
/// deliberate: it makes ignoring the failure require writing a `match` that
/// visibly discards it.
///
/// The comparison is constant time (`std::crypto::verify`), because a
/// byte-at-a-time tag compare that returns early is a forgery oracle: an
/// attacker learns how many leading bytes were right and can search the tag
/// one byte at a time.
///
/// # Example
///
/// ```tuo
/// match std::chacha::aead_open(key, nonce, aad, sealed) {
///     Some { value } => value,   // authentic
///     None => handle_forgery(),
/// }
/// ```
pub fn aead_open(
    in key: Array[Int],
    in nonce: Array[Int],
    in aad: Array[Int],
    in sealed: Array[Int],
) -> Option[Array[Int]] {
    let n = std::array::len(sealed);
    if n < 16 {
        // Too short to even carry a tag.
        return Option::None;
    }
    var ciphertext = std::array::empty();
    var i = 0;
    while i < n - 16 {
        std::array::push(ciphertext, std::array::get(sealed, i));
        i = i + 1;
    }
    var received = std::array::empty();
    var t = n - 16;
    while t < n {
        std::array::push(received, std::array::get(sealed, t));
        t = t + 1;
    }
    let expected = aead_tag(key, nonce, aad, ciphertext);
    if !std::crypto::verify(expected, received) {
        return Option::None;
    }
    Option::Some { value: apply(key, 1, nonce, ciphertext) }
}

// --- AEAD specs: RFC 8439 2.8.2's PUBLISHED vector --------------------------

/// The RFC 8439 2.8.2 key: bytes 0x80..0x9f.
fn aead_vector_key() -> Array[Int] {
    var a = std::array::empty();
    std::array::push(a, 128);
    std::array::push(a, 129);
    std::array::push(a, 130);
    std::array::push(a, 131);
    std::array::push(a, 132);
    std::array::push(a, 133);
    std::array::push(a, 134);
    std::array::push(a, 135);
    std::array::push(a, 136);
    std::array::push(a, 137);
    std::array::push(a, 138);
    std::array::push(a, 139);
    std::array::push(a, 140);
    std::array::push(a, 141);
    std::array::push(a, 142);
    std::array::push(a, 143);
    std::array::push(a, 144);
    std::array::push(a, 145);
    std::array::push(a, 146);
    std::array::push(a, 147);
    std::array::push(a, 148);
    std::array::push(a, 149);
    std::array::push(a, 150);
    std::array::push(a, 151);
    std::array::push(a, 152);
    std::array::push(a, 153);
    std::array::push(a, 154);
    std::array::push(a, 155);
    std::array::push(a, 156);
    std::array::push(a, 157);
    std::array::push(a, 158);
    std::array::push(a, 159);
    a
}

/// The RFC 8439 2.8.2 nonce.
fn aead_vector_nonce() -> Array[Int] {
    var a = std::array::empty();
    std::array::push(a, 7);
    std::array::push(a, 0);
    std::array::push(a, 0);
    std::array::push(a, 0);
    std::array::push(a, 64);
    std::array::push(a, 65);
    std::array::push(a, 66);
    std::array::push(a, 67);
    std::array::push(a, 68);
    std::array::push(a, 69);
    std::array::push(a, 70);
    std::array::push(a, 71);
    a
}

/// The RFC 8439 2.8.2 additional data.
fn aead_vector_aad() -> Array[Int] {
    var a = std::array::empty();
    std::array::push(a, 80);
    std::array::push(a, 81);
    std::array::push(a, 82);
    std::array::push(a, 83);
    std::array::push(a, 192);
    std::array::push(a, 193);
    std::array::push(a, 194);
    std::array::push(a, 195);
    std::array::push(a, 196);
    std::array::push(a, 197);
    std::array::push(a, 198);
    std::array::push(a, 199);
    a
}

