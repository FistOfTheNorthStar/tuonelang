/// The RFC 8439 2.5.2 published tag, a8061dc1305136c6c22b8baf0c0127a9.
fn poly_vector_tag() -> Array[Int] {
    var a = std::array::empty();
    std::array::push(a, 168);
    std::array::push(a, 6);
    std::array::push(a, 29);
    std::array::push(a, 193);
    std::array::push(a, 48);
    std::array::push(a, 81);
    std::array::push(a, 54);
    std::array::push(a, 198);
    std::array::push(a, 194);
    std::array::push(a, 43);
    std::array::push(a, 139);
    std::array::push(a, 175);
    std::array::push(a, 12);
    std::array::push(a, 1);
    std::array::push(a, 39);
    std::array::push(a, 169);
    a
}

/// The computed tag byte at `i`, for the spec below.
fn poly_tag_byte(take i: Int) -> Int {
    std::array::get(poly1305(poly_vector_key(), poly_vector_message()), i)
}

spec poly1305 {
    // Every byte of RFC 8439 2.5.2's PUBLISHED tag. This is the assertion
    // that matters: it pins the implementation against the RFC rather than
    // against its own reasoning, which is the only thing that makes an
    // authenticator interoperable.
    then poly_tag_byte(0) == 168;
    then poly_tag_byte(1) == 6;
    then poly_tag_byte(2) == 29;
    then poly_tag_byte(3) == 193;
    then poly_tag_byte(4) == 48;
    then poly_tag_byte(5) == 81;
    then poly_tag_byte(6) == 54;
    then poly_tag_byte(7) == 198;
    then poly_tag_byte(8) == 194;
    then poly_tag_byte(9) == 43;
    then poly_tag_byte(10) == 139;
    then poly_tag_byte(11) == 175;
    then poly_tag_byte(12) == 12;
    then poly_tag_byte(13) == 1;
    then poly_tag_byte(14) == 39;
    then poly_tag_byte(15) == 169;
    // A tag is exactly 16 bytes.
    then std::array::len(poly1305(poly_vector_key(), poly_vector_message())) == 16;
}

spec poly_clamp_r {
    // The clamp is part of the algorithm: bytes 3/7/11/15 keep 4 bits,
    // bytes 4/8/12 have their low 2 bits cleared.
    then std::array::get(poly_clamp_r(poly_vector_key()), 3) == 120 & 15;
    then std::array::get(poly_clamp_r(poly_vector_key()), 4) == 87 & 252;
    then std::array::len(poly_clamp_r(poly_vector_key())) == 16;
    // An unclamped byte passes through unchanged.
    then std::array::get(poly_clamp_r(poly_vector_key()), 0) == 133;
}

spec poly_prime {
    // 2^130 - 5 = 1361129467683753853853498429727072845819:
    // exactly 130 bits wide, ending in 9.
    then std::bignum::bit_length(poly_prime()) == 130;
    then std::bignum::rem_small(poly_prime(), 10) == 9;
}

spec le_bytes_to_num {
    // Little-endian: [1, 0, 0, 0] is 1, not 2^24.
    // The tag is 128 bits, too wide for an `Int`, so `to_int` declines it —
    // which is itself the check that the little-endian read produced a full
    // 16-byte number rather than silently truncating.
    then std::bignum::int_or(std::bignum::to_int(le_bytes_to_num(poly_vector_tag())), 0 - 1) == 0 - 1;
    then std::bignum::bit_length(le_bytes_to_num(poly_vector_key())) > 0;
}

spec num_to_le_bytes {
    // Round-trip: a tag serialized and read back is the same number.
    then std::array::len(num_to_le_bytes(le_bytes_to_num(poly_vector_tag()), 16)) == 16;
    then std::array::get(num_to_le_bytes(le_bytes_to_num(poly_vector_tag()), 16), 0) == 168;
    then std::array::get(num_to_le_bytes(le_bytes_to_num(poly_vector_tag()), 16), 15) == 169;
}

spec poly_mod {
    // Reducing a value already below the prime leaves it unchanged.
    then std::bignum::int_or(std::bignum::to_int(poly_mod(std::bignum::from_int(7), poly_prime())), 0 - 1) == 7;
    // Reducing the prime itself yields zero.
    then std::bignum::is_zero(poly_mod(poly_prime(), poly_prime()));
}

// --- AEAD_CHACHA20_POLY1305 (RFC 8439 §2.8) ---------------------------------
//
// The composition that TLS 1.3 actually uses: ChaCha20 for confidentiality,
// Poly1305 for integrity, and a specific framing that binds them together.
//
// The framing is not decoration. The one-time Poly1305 key is derived from
// ChaCha20 block **zero** while the ciphertext starts at block **one**, so
// the authenticator key can never collide with keystream — that is what makes
// the one-time requirement satisfiable. The length fields at the end prevent
// an attacker from shifting bytes between the additional data and the
// ciphertext, which would otherwise authenticate to the same tag.

/// Derive the Poly1305 one-time key for a record: ChaCha20 block zero under
/// the same key and nonce (RFC 8439 §2.6).
///
/// # Example
///
/// ```tuo
/// let otk = std::chacha::poly_key_gen(key, nonce); // 32 bytes
/// ```
pub fn poly_key_gen(in key: Array[Int], in nonce: Array[Int]) -> Array[Int] {
    let ks = block(key, 0, nonce);
    var out = std::array::empty();
    var i = 0;
    while i < 32 {
        std::array::push(out, std::array::get(ks, i));
        i = i + 1;
    }
    out
}

/// Append `value` as an 8-byte little-endian length, the framing AEAD uses
/// for its additional-data and ciphertext lengths.
///
/// # Example
///
/// ```tuo
/// std::chacha::push_le64(buffer, 12);
/// ```
pub fn push_le64(mut out: Array[Int], take value: Int) -> Int {
    var v = value;
    var i = 0;
    while i < 8 {
        std::array::push(out, v & 255);
        v = v >> 8;
        i = i + 1;
    }
    0
}

/// Append zero bytes until `out`'s length is a multiple of 16 — the padding
/// AEAD inserts after the additional data and after the ciphertext.
///
/// # Example
///
/// ```tuo
/// std::chacha::pad16(buffer);
/// ```
pub fn pad16(mut out: Array[Int]) -> Int {
    var remainder = std::array::len(out) % 16;
    if remainder > 0 {
        var i = remainder;
        while i < 16 {
            std::array::push(out, 0);
            i = i + 1;
        }
    }
    0
}

/// Build the exact byte string Poly1305 authenticates over a record
/// (RFC 8439 §2.8): the additional data, padded to 16; the ciphertext, padded
/// to 16; then both lengths as 8-byte little-endian values.
///
/// # Example
///
/// ```tuo
/// let mac_input = std::chacha::aead_mac_data(aad, ciphertext);
/// ```
pub fn aead_mac_data(in aad: Array[Int], in ciphertext: Array[Int]) -> Array[Int] {
    var out = std::array::empty();
    var i = 0;
    while i < std::array::len(aad) {
        std::array::push(out, std::array::get(aad, i) & 255);
        i = i + 1;
    }
    pad16(out);
    var j = 0;
    while j < std::array::len(ciphertext) {
        std::array::push(out, std::array::get(ciphertext, j) & 255);
        j = j + 1;
    }
    pad16(out);
    // The lengths bind the two fields together: without them an attacker
    // could move bytes from the ciphertext into the additional data and
    // produce the same tag.
    push_le64(out, std::array::len(aad));
    push_le64(out, std::array::len(ciphertext));
    out
}

/// Seal a message: encrypt `plaintext` and authenticate it together with
/// `aad`, returning the ciphertext with its 16-byte tag appended
/// (RFC 8439 §2.8).
///
/// # Example
///
/// ```tuo
/// let sealed = std::chacha::aead_seal(key, nonce, aad, plaintext);
/// ```
pub fn aead_seal(
    in key: Array[Int],
    in nonce: Array[Int],
    in aad: Array[Int],
    in plaintext: Array[Int],
) -> Array[Int] {
    let otk = poly_key_gen(key, nonce);
    // Counter 1: block 0 is spent on the one-time key, which is exactly what
    // keeps the authenticator key clear of the keystream.
    let ciphertext = apply(key, 1, nonce, plaintext);
    let tag = poly1305(otk, aead_mac_data(aad, ciphertext));
    var out = std::array::empty();
    var i = 0;
    while i < std::array::len(ciphertext) {
        std::array::push(out, std::array::get(ciphertext, i));
        i = i + 1;
    }
    var t = 0;
    while t < 16 {
        std::array::push(out, std::array::get(tag, t));
        t = t + 1;
    }
    out
}

/// The tag a sealed record should carry, recomputed from its ciphertext —
/// the value `aead_open` compares against.
///
/// # Example
///
/// ```tuo
/// let expected = std::chacha::aead_tag(key, nonce, aad, ciphertext);
/// ```
pub fn aead_tag(
    in key: Array[Int],
    in nonce: Array[Int],
    in aad: Array[Int],
    in ciphertext: Array[Int],
) -> Array[Int] {
    poly1305(poly_key_gen(key, nonce), aead_mac_data(aad, ciphertext))
}

/// Open a sealed record: verify its tag and, only then, decrypt it.
///
/// Returns the plaintext, or `None` when the tag does not match. **The
/// `None` case must be treated as fatal by the caller** — a failed tag means
/// the record was forged or corrupted, and there is no partial result worth
/// looking at. Returning `Option` rather than the plaintext-and-a-flag is
/// deliberate: it makes ignoring the failure require writing a `match` that
/// visibly discards it.
///
/// The comparison is constant time (`std::crypto::verify`), because a
/// byte-at-a-time tag compare that returns early is a forgery oracle: an
/// attacker learns how many leading bytes were right and can search the tag
/// one byte at a time.
///
/// # Example
///
/// ```tuo
/// match std::chacha::aead_open(key, nonce, aad, sealed) {
///     Some { value } => value,   // authentic
///     None => handle_forgery(),
/// }
/// ```
pub fn aead_open(
    in key: Array[Int],
    in nonce: Array[Int],
    in aad: Array[Int],
    in sealed: Array[Int],
) -> Option[Array[Int]] {
    let n = std::array::len(sealed);
    if n < 16 {
        // Too short to even carry a tag.
        return Option::None;
    }
    var ciphertext = std::array::empty();
    var i = 0;
    while i < n - 16 {
        std::array::push(ciphertext, std::array::get(sealed, i));
        i = i + 1;
    }
    var received = std::array::empty();
    var t = n - 16;
    while t < n {
        std::array::push(received, std::array::get(sealed, t));
        t = t + 1;
    }
    let expected = aead_tag(key, nonce, aad, ciphertext);
    if !std::crypto::verify(expected, received) {
        return Option::None;
    }
    Option::Some { value: apply(key, 1, nonce, ciphertext) }
}

