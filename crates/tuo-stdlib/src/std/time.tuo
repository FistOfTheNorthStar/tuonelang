// std::time — durations and instants.
//
// Two honestly separated tiers, like the rest of the effectful standard
// library:
//
//   Executable tier — `Duration`, a plain span of nanoseconds, its pure
//   arithmetic, its rendering (`render`), and — since ADR-0013 — `elapsed`
//   (pure subtraction over two instants). Ordinary computation: it runs, and
//   its specs run.
//
//   Effect tier — reading the clock (`now`), implemented over the
//   `std::rt::now_nanos` effect primitive ADR-0013 landed. It compiles and
//   runs natively, but an effectful function can never appear in a spec
//   (`R0007`), so it is pinned by a native CLI test instead and marked
//   `EFFECT:`.

module std::time;

// ----------------------------------------------------------------------------
// Duration — a span of time in nanoseconds. Executable tier.
//
// One representation (nanoseconds as an `Int`), one set of constructors, one
// set of combinators. No competing "millis vs micros" duration types.
// ----------------------------------------------------------------------------

/// A span of time, stored as a whole number of nanoseconds.
pub struct Duration {
    nanos: Int,
}

/// A duration of `n` nanoseconds.
///
/// # Example
/// ```tuo
/// let d = std::time::from_nanos(500);
/// ```
pub fn from_nanos(take n: Int) -> Duration {
    Duration { nanos: n }
}

/// A duration of `n` milliseconds.
///
/// # Example
/// ```tuo
/// let d = std::time::from_millis(2); // 2_000_000 ns
/// ```
pub fn from_millis(take n: Int) -> Duration {
    Duration { nanos: n * 1000000 }
}

/// A duration of `n` seconds.
///
/// # Example
/// ```tuo
/// let d = std::time::from_secs(1); // 1_000_000_000 ns
/// ```
pub fn from_secs(take n: Int) -> Duration {
    Duration { nanos: n * 1000000000 }
}

/// The zero duration.
///
/// # Example
/// ```tuo
/// let d = std::time::zero();
/// ```
pub fn zero() -> Duration {
    Duration { nanos: 0 }
}

/// This duration expressed in whole nanoseconds.
///
/// # Example
/// ```tuo
/// let n = std::time::as_nanos(std::time::from_millis(2)); // 2_000_000
/// ```
pub fn as_nanos(in d: Duration) -> Int {
    d.nanos
}

/// This duration expressed in whole milliseconds (truncating).
///
/// # Example
/// ```tuo
/// let n = std::time::as_millis(std::time::from_secs(1)); // 1000
/// ```
pub fn as_millis(in d: Duration) -> Int {
    d.nanos / 1000000
}

/// The sum of two durations.
///
/// # Example
/// ```tuo
/// let d = std::time::add(std::time::from_millis(1), std::time::from_millis(2));
/// ```
pub fn add(in a: Duration, in b: Duration) -> Duration {
    Duration { nanos: a.nanos + b.nanos }
}

/// Is duration `a` shorter than duration `b`?
///
/// # Example
/// ```tuo
/// let b = std::time::lt(std::time::from_millis(1), std::time::from_secs(1));
/// ```
pub fn lt(in a: Duration, in b: Duration) -> Bool {
    a.nanos < b.nanos
}

// ----------------------------------------------------------------------------
// Rendering — the one human-readable spelling of a duration. Executable tier.
// ----------------------------------------------------------------------------

/// This duration as text in the **coarsest exact unit**: `"2s"`, `"1500ms"`,
/// `"250us"`, `"37ns"` — whole seconds render as seconds, else whole
/// milliseconds, else whole microseconds, else nanoseconds; zero is `"0s"`
/// and a negative duration carries a leading `-`. One rendering, never a
/// choice of formats. (The single unrepresentable input is the minimum `Int`
/// duration, whose negation overflows and traps — the language's ordinary
/// overflow contract.)
///
/// # Example
/// ```tuo
/// let s = std::time::render(std::time::from_millis(1500)); // "1500ms"
/// ```
pub fn render(in d: Duration) -> String {
    if d.nanos == 0 {
        return std::string::from_str("0s");
    }
    var out = std::string::empty();
    var m = d.nanos;
    if m < 0 {
        std::string::append(out, "-");
        m = 0 - m;
    }
    if m % 1000000000 == 0 {
        append_digits(out, m / 1000000000);
        std::string::append(out, "s");
    } else if m % 1000000 == 0 {
        append_digits(out, m / 1000000);
        std::string::append(out, "ms");
    } else if m % 1000 == 0 {
        append_digits(out, m / 1000);
        std::string::append(out, "us");
    } else {
        append_digits(out, m);
        std::string::append(out, "ns");
    }
    out
}

// Append the decimal digits of the non-negative `n` to `s`. Private helper:
// the module must stand alone, so it cannot reuse `std::str::to_string`.
fn append_digits(mut s: String, take n: Int) {
    if n == 0 {
        std::string::push_byte(s, 48);
        return;
    }
    var digits = std::array::empty();
    var m = n;
    while m > 0 {
        std::array::push(digits, m % 10);
        m = m / 10;
    }
    var i = std::array::len(digits) - 1;
    while i >= 0 {
        std::string::push_byte(s, 48 + std::array::get(digits, i));
        i = i - 1;
    }
}

// ----------------------------------------------------------------------------
// Instant — a monotonic timestamp. `now` is the effect tier; `elapsed` is
// pure arithmetic over two instants (ADR-0013 made both real).
// ----------------------------------------------------------------------------

/// A point on the monotonic clock, as nanoseconds since an unspecified epoch.
pub struct Instant {
    nanos: Int,
}

/// An instant at `n` nanoseconds on the monotonic clock's arbitrary scale.
/// The pure constructor the specs (and any simulation) use; real time comes
/// from `now`.
///
/// # Example
/// ```tuo
/// let t = std::time::instant_at(100);
/// ```
pub fn instant_at(take n: Int) -> Instant {
    Instant { nanos: n }
}

/// EFFECT (executable and effectful): the current monotonic instant.
///
/// Implemented over the `std::rt::now_nanos` effect primitive (ADR-0013):
/// nanoseconds on a monotonic clock whose epoch is arbitrary, so only
/// differences — `elapsed(earlier, later)` — are meaningful. Effectful, so
/// no spec (`R0007`); pinned by the native CLI tests in
/// `crates/tuo-cli/tests/stdlib.rs`.
///
/// # Example
/// ```tuo
/// // let start = std::time::now();
/// ```
pub fn now() -> Instant {
    Instant { nanos: std::rt::now_nanos() }
}

/// The duration from `earlier` to `later` — pure subtraction over two
/// instants (negative when `later` precedes `earlier`).
///
/// # Example
/// ```tuo
/// let span = std::time::elapsed(std::time::instant_at(100), std::time::instant_at(350));
/// ```
pub fn elapsed(in earlier: Instant, in later: Instant) -> Duration {
    Duration { nanos: later.nanos - earlier.nanos }
}

// ----------------------------------------------------------------------------
// Specs — executable tier only. The clock effect stays unspecced (R0007).
// ----------------------------------------------------------------------------

spec from_nanos {
    then as_nanos(from_nanos(500)) == 500;
    then as_nanos(zero()) == 0;
}

spec from_millis {
    then as_nanos(from_millis(2)) == 2000000;
    then as_millis(from_millis(2)) == 2;
}

spec from_secs {
    then as_nanos(from_secs(1)) == 1000000000;
    then as_millis(from_secs(1)) == 1000;
}

spec add {
    then as_millis(add(from_millis(1), from_millis(2))) == 3;
}

spec lt {
    then lt(from_millis(1), from_secs(1));
    then !lt(from_secs(1), from_millis(1));
}

spec render {
    then render(zero()) == std::string::from_str("0s");
    then render(from_secs(2)) == std::string::from_str("2s");
    then render(from_millis(1500)) == std::string::from_str("1500ms");
    then render(from_nanos(250000)) == std::string::from_str("250us");
    then render(from_nanos(37)) == std::string::from_str("37ns");
    then render(from_millis(0 - 1500)) == std::string::from_str("-1500ms");
    then render(from_millis(1000)) == std::string::from_str("1s");
}

spec instant_at {
    then as_nanos(elapsed(instant_at(0), instant_at(75))) == 75;
}

spec elapsed {
    then as_nanos(elapsed(instant_at(100), instant_at(350))) == 250;
    then as_nanos(elapsed(instant_at(350), instant_at(100))) == 0 - 250;
    then as_millis(elapsed(instant_at(0), instant_at(2000000))) == 2;
}
