/// The public key OpenSSL reports for `sample_certificate`.
fn sample_public_key() -> Array[Int] {
    var a = std::array::empty();
    std::array::push(a, 15);
    std::array::push(a, 213);
    std::array::push(a, 65);
    std::array::push(a, 171);
    std::array::push(a, 25);
    std::array::push(a, 24);
    std::array::push(a, 82);
    std::array::push(a, 85);
    std::array::push(a, 197);
    std::array::push(a, 221);
    std::array::push(a, 199);
    std::array::push(a, 43);
    std::array::push(a, 46);
    std::array::push(a, 171);
    std::array::push(a, 85);
    std::array::push(a, 4);
    std::array::push(a, 97);
    std::array::push(a, 150);
    std::array::push(a, 244);
    std::array::push(a, 80);
    std::array::push(a, 117);
    std::array::push(a, 205);
    std::array::push(a, 135);
    std::array::push(a, 54);
    std::array::push(a, 165);
    std::array::push(a, 246);
    std::array::push(a, 145);
    std::array::push(a, 214);
    std::array::push(a, 146);
    std::array::push(a, 92);
    std::array::push(a, 6);
    std::array::push(a, 103);
    a
}

/// A byte of the parsed public key, for the spec below.
fn parsed_key_byte(take i: Int) -> Int {
    std::array::get(certificate_public_key(sample_certificate()), i)
}

/// The certificate truncated to `n` bytes — the most basic hostile input.
fn truncated(take n: Int) -> Array[Int] {
    var out = std::array::empty();
    var i = 0;
    while i < n {
        std::array::push(out, std::array::get(sample_certificate(), i));
        i = i + 1;
    }
    out
}

spec read_header {
    // The certificate opens with a SEQUENCE whose length is long-form.
    then header_ok(read_header(sample_certificate(), 0));
    then read_header(sample_certificate(), 0).tag == tag_sequence();
    then read_header(sample_certificate(), 0).length == 316;
    // Past the end is a clean failure, not a trap.
    then !header_ok(read_header(sample_certificate(), 9999));
    then !header_ok(read_header(std::array::empty(), 0));
    // A header whose length runs past the data is refused — the single most
    // obvious attack on a parser.
    then !header_ok(read_header(truncated(10), 0));
}

spec fits {
    then fits(sample_certificate(), 0, 320);
    then !fits(sample_certificate(), 0, 321);
    then !fits(sample_certificate(), 300, 100);
    // Negative and absurd values answer rather than trapping.
    then !fits(sample_certificate(), 0 - 1, 1);
    then !fits(sample_certificate(), 0, 0 - 1);
    then !fits(sample_certificate(), 0, max_length() + 1);
}

spec byte_at {
    then byte_at(sample_certificate(), 0) == 48;
    // Out of bounds is -1, never a trap — every read in this module goes
    // through here precisely for that reason.
    then byte_at(sample_certificate(), 0 - 1) == 0 - 1;
    then byte_at(sample_certificate(), 320) == 0 - 1;
    then byte_at(std::array::empty(), 0) == 0 - 1;
}

spec max_length {
    then max_length() == 16777216;
}

spec bad_header {
    then !header_ok(bad_header());
    then bad_header().content_start == 0 - 1;
}

spec header_ok {
    then header_ok(read_header(sample_certificate(), 0));
    then !header_ok(bad_header());
}

spec end_of {
    // The outer SEQUENCE ends at the end of the certificate: 4 header bytes
    // plus 316 content bytes.
    then end_of(read_header(sample_certificate(), 0)) == 320;
    then end_of(bad_header()) == 0 - 1;
}

spec value_of {
    then std::array::len(value_of(sample_certificate(), read_header(sample_certificate(), 0)))
        == 316;
    then std::array::len(value_of(sample_certificate(), bad_header())) == 0;
}

spec child_at {
    // The first child of the certificate is the TBS SEQUENCE.
    then header_ok(child_at(sample_certificate(), read_header(sample_certificate(), 0), 0));
    then child_at(sample_certificate(), read_header(sample_certificate(), 0), 0).tag
        == tag_sequence();
    // The third is the signature BIT STRING.
    then child_at(sample_certificate(), read_header(sample_certificate(), 0), 2).tag
        == tag_bit_string();
    // Past the end, and a negative index, both fail cleanly.
    then !header_ok(child_at(sample_certificate(), read_header(sample_certificate(), 0), 99));
    then !header_ok(child_at(sample_certificate(), read_header(sample_certificate(), 0), 0 - 1));
    then !header_ok(child_at(sample_certificate(), bad_header(), 0));
}

spec child_count {
    // A Certificate is exactly three elements.
    then child_count(sample_certificate(), read_header(sample_certificate(), 0)) == 3;
    then child_count(sample_certificate(), bad_header()) == 0;
}

spec tag_sequence {
    then tag_sequence() == 48;
}

spec tag_integer {
    then tag_integer() == 2;
}

spec tag_bit_string {
    then tag_bit_string() == 3;
}

spec tag_octet_string {
    then tag_octet_string() == 4;
}

spec tag_oid {
    then tag_oid() == 6;
}

spec oid_ed25519 {
    // 1.3.101.112 encodes as 2b 65 70.
    then std::array::len(oid_ed25519()) == 3;
    then std::array::get(oid_ed25519(), 0) == 43;
    then std::array::get(oid_ed25519(), 1) == 101;
    then std::array::get(oid_ed25519(), 2) == 112;
}

spec value_equals {
    then !value_equals(sample_certificate(), bad_header(), oid_ed25519());
    then !value_equals(sample_certificate(), read_header(sample_certificate(), 0), oid_ed25519());
}

spec bit_string_bytes {
    // The signature BIT STRING unwraps to 64 bytes — an Ed25519 signature —
    // with its "unused bits" prefix dropped.
    then std::array::len(
        bit_string_bytes(
            sample_certificate(),
            child_at(sample_certificate(), read_header(sample_certificate(), 0), 2),
        ),
    ) == 64;
    then std::array::len(bit_string_bytes(sample_certificate(), bad_header())) == 0;
    // A non-BIT-STRING header yields nothing rather than raw bytes.
    then std::array::len(
        bit_string_bytes(sample_certificate(), read_header(sample_certificate(), 0)),
    ) == 0;
}

spec spki_index {
    // This is a v3 certificate, so its TBS opens with a [0] version tag and
    // the SPKI is field 6. Reading field 5 here would silently return the
    // SUBJECT rather than the key.
    then spki_index(
        sample_certificate(),
        child_at(sample_certificate(), read_header(sample_certificate(), 0), 0),
    ) == 6;
    then spki_index(sample_certificate(), bad_header()) == 0 - 1;
}

spec certificate_spki {
    then header_ok(certificate_spki(sample_certificate()));
    then certificate_spki(sample_certificate()).tag == tag_sequence();
    then !header_ok(certificate_spki(std::array::empty()));
}

spec certificate_is_ed25519 {
    then certificate_is_ed25519(sample_certificate());
    then !certificate_is_ed25519(std::array::empty());
    then !certificate_is_ed25519(truncated(50));
}

spec certificate_public_key {
    // Every byte of the key OpenSSL itself reports for this certificate.
    then parsed_key_byte(0) == 15;
    then parsed_key_byte(1) == 213;
    then parsed_key_byte(2) == 65;
    then parsed_key_byte(3) == 171;
    then parsed_key_byte(4) == 25;
    then parsed_key_byte(5) == 24;
    then parsed_key_byte(6) == 82;
    then parsed_key_byte(7) == 85;
    then parsed_key_byte(8) == 197;
    then parsed_key_byte(9) == 221;
    then parsed_key_byte(10) == 199;
    then parsed_key_byte(11) == 43;
    then parsed_key_byte(12) == 46;
    then parsed_key_byte(13) == 171;
    then parsed_key_byte(14) == 85;
    then parsed_key_byte(15) == 4;
    then parsed_key_byte(16) == 97;
    then parsed_key_byte(17) == 150;
    then parsed_key_byte(18) == 244;
    then parsed_key_byte(19) == 80;
    then parsed_key_byte(20) == 117;
    then parsed_key_byte(21) == 205;
    then parsed_key_byte(22) == 135;
    then parsed_key_byte(23) == 54;
    then parsed_key_byte(24) == 165;
    then parsed_key_byte(25) == 246;
    then parsed_key_byte(26) == 145;
    then parsed_key_byte(27) == 214;
    then parsed_key_byte(28) == 146;
    then parsed_key_byte(29) == 92;
    then parsed_key_byte(30) == 6;
    then parsed_key_byte(31) == 103;
    then std::array::len(certificate_public_key(sample_certificate())) == 32;
    // Hostile input yields nothing rather than trapping.
    then std::array::len(certificate_public_key(std::array::empty())) == 0;
    then std::array::len(certificate_public_key(truncated(1))) == 0;
    then std::array::len(certificate_public_key(truncated(100))) == 0;
    then std::array::len(certificate_public_key(truncated(319))) == 0;
}

spec certificate_signature {
    // Ed25519 signatures are 64 bytes.
    then std::array::len(certificate_signature(sample_certificate())) == 64;
    then std::array::len(certificate_signature(std::array::empty())) == 0;
    then std::array::len(certificate_signature(truncated(200))) == 0;
}

spec certificate_tbs {
    // The signed region is a real subset of the certificate, and includes
    // its own header (the signature covers the complete DER element).
    // 3 header bytes (tag, 0x81, 239) plus 239 content bytes.
    then std::array::len(certificate_tbs(sample_certificate())) == 242;
    then std::array::get(certificate_tbs(sample_certificate()), 0) == tag_sequence();
    then std::array::len(certificate_tbs(std::array::empty())) == 0;
}

spec tbs_start {
    then tbs_start(sample_certificate(), read_header(sample_certificate(), 0)) == 4;
    then tbs_start(sample_certificate(), bad_header()) == 0 - 1;
}
