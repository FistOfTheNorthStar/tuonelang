    s12 = std::int::wrapping_add(s12, std::int::wrapping_mul(a.s9, b.s3));
    s12 = std::int::wrapping_add(s12, std::int::wrapping_mul(a.s10, b.s2));
    s12 = std::int::wrapping_add(s12, std::int::wrapping_mul(a.s11, b.s1));
    var s13 = std::int::wrapping_mul(a.s2, b.s11);
    s13 = std::int::wrapping_add(s13, std::int::wrapping_mul(a.s3, b.s10));
    s13 = std::int::wrapping_add(s13, std::int::wrapping_mul(a.s4, b.s9));
    s13 = std::int::wrapping_add(s13, std::int::wrapping_mul(a.s5, b.s8));
    s13 = std::int::wrapping_add(s13, std::int::wrapping_mul(a.s6, b.s7));
    s13 = std::int::wrapping_add(s13, std::int::wrapping_mul(a.s7, b.s6));
    s13 = std::int::wrapping_add(s13, std::int::wrapping_mul(a.s8, b.s5));
    s13 = std::int::wrapping_add(s13, std::int::wrapping_mul(a.s9, b.s4));
    s13 = std::int::wrapping_add(s13, std::int::wrapping_mul(a.s10, b.s3));
    s13 = std::int::wrapping_add(s13, std::int::wrapping_mul(a.s11, b.s2));
    var s14 = std::int::wrapping_mul(a.s3, b.s11);
    s14 = std::int::wrapping_add(s14, std::int::wrapping_mul(a.s4, b.s10));
    s14 = std::int::wrapping_add(s14, std::int::wrapping_mul(a.s5, b.s9));
    s14 = std::int::wrapping_add(s14, std::int::wrapping_mul(a.s6, b.s8));
    s14 = std::int::wrapping_add(s14, std::int::wrapping_mul(a.s7, b.s7));
    s14 = std::int::wrapping_add(s14, std::int::wrapping_mul(a.s8, b.s6));
    s14 = std::int::wrapping_add(s14, std::int::wrapping_mul(a.s9, b.s5));
    s14 = std::int::wrapping_add(s14, std::int::wrapping_mul(a.s10, b.s4));
    s14 = std::int::wrapping_add(s14, std::int::wrapping_mul(a.s11, b.s3));
    var s15 = std::int::wrapping_mul(a.s4, b.s11);
    s15 = std::int::wrapping_add(s15, std::int::wrapping_mul(a.s5, b.s10));
    s15 = std::int::wrapping_add(s15, std::int::wrapping_mul(a.s6, b.s9));
    s15 = std::int::wrapping_add(s15, std::int::wrapping_mul(a.s7, b.s8));
    s15 = std::int::wrapping_add(s15, std::int::wrapping_mul(a.s8, b.s7));
    s15 = std::int::wrapping_add(s15, std::int::wrapping_mul(a.s9, b.s6));
    s15 = std::int::wrapping_add(s15, std::int::wrapping_mul(a.s10, b.s5));
    s15 = std::int::wrapping_add(s15, std::int::wrapping_mul(a.s11, b.s4));
    var s16 = std::int::wrapping_mul(a.s5, b.s11);
    s16 = std::int::wrapping_add(s16, std::int::wrapping_mul(a.s6, b.s10));
    s16 = std::int::wrapping_add(s16, std::int::wrapping_mul(a.s7, b.s9));
    s16 = std::int::wrapping_add(s16, std::int::wrapping_mul(a.s8, b.s8));
    s16 = std::int::wrapping_add(s16, std::int::wrapping_mul(a.s9, b.s7));
    s16 = std::int::wrapping_add(s16, std::int::wrapping_mul(a.s10, b.s6));
    s16 = std::int::wrapping_add(s16, std::int::wrapping_mul(a.s11, b.s5));
    var s17 = std::int::wrapping_mul(a.s6, b.s11);
    s17 = std::int::wrapping_add(s17, std::int::wrapping_mul(a.s7, b.s10));
    s17 = std::int::wrapping_add(s17, std::int::wrapping_mul(a.s8, b.s9));
    s17 = std::int::wrapping_add(s17, std::int::wrapping_mul(a.s9, b.s8));
    s17 = std::int::wrapping_add(s17, std::int::wrapping_mul(a.s10, b.s7));
    s17 = std::int::wrapping_add(s17, std::int::wrapping_mul(a.s11, b.s6));
    var s18 = std::int::wrapping_mul(a.s7, b.s11);
    s18 = std::int::wrapping_add(s18, std::int::wrapping_mul(a.s8, b.s10));
    s18 = std::int::wrapping_add(s18, std::int::wrapping_mul(a.s9, b.s9));
    s18 = std::int::wrapping_add(s18, std::int::wrapping_mul(a.s10, b.s8));
    s18 = std::int::wrapping_add(s18, std::int::wrapping_mul(a.s11, b.s7));
    var s19 = std::int::wrapping_mul(a.s8, b.s11);
    s19 = std::int::wrapping_add(s19, std::int::wrapping_mul(a.s9, b.s10));
    s19 = std::int::wrapping_add(s19, std::int::wrapping_mul(a.s10, b.s9));
    s19 = std::int::wrapping_add(s19, std::int::wrapping_mul(a.s11, b.s8));
    var s20 = std::int::wrapping_mul(a.s9, b.s11);
    s20 = std::int::wrapping_add(s20, std::int::wrapping_mul(a.s10, b.s10));
    s20 = std::int::wrapping_add(s20, std::int::wrapping_mul(a.s11, b.s9));
    var s21 = std::int::wrapping_mul(a.s10, b.s11);
    s21 = std::int::wrapping_add(s21, std::int::wrapping_mul(a.s11, b.s10));
    var s22 = std::int::wrapping_mul(a.s11, b.s11);
    var s23 = 0;
    var carry = 0;
    carry = std::int::wrapping_add(s0, 1048576) >> 21;
    s1 = std::int::wrapping_add(s1, carry);
    s0 = std::int::wrapping_sub(s0, carry << 21);
    carry = std::int::wrapping_add(s2, 1048576) >> 21;
    s3 = std::int::wrapping_add(s3, carry);
    s2 = std::int::wrapping_sub(s2, carry << 21);
    carry = std::int::wrapping_add(s4, 1048576) >> 21;
    s5 = std::int::wrapping_add(s5, carry);
    s4 = std::int::wrapping_sub(s4, carry << 21);
    carry = std::int::wrapping_add(s6, 1048576) >> 21;
    s7 = std::int::wrapping_add(s7, carry);
    s6 = std::int::wrapping_sub(s6, carry << 21);
    carry = std::int::wrapping_add(s8, 1048576) >> 21;
    s9 = std::int::wrapping_add(s9, carry);
    s8 = std::int::wrapping_sub(s8, carry << 21);
    carry = std::int::wrapping_add(s10, 1048576) >> 21;
    s11 = std::int::wrapping_add(s11, carry);
    s10 = std::int::wrapping_sub(s10, carry << 21);
    carry = std::int::wrapping_add(s12, 1048576) >> 21;
    s13 = std::int::wrapping_add(s13, carry);
    s12 = std::int::wrapping_sub(s12, carry << 21);
    carry = std::int::wrapping_add(s14, 1048576) >> 21;
    s15 = std::int::wrapping_add(s15, carry);
    s14 = std::int::wrapping_sub(s14, carry << 21);
    carry = std::int::wrapping_add(s16, 1048576) >> 21;
    s17 = std::int::wrapping_add(s17, carry);
    s16 = std::int::wrapping_sub(s16, carry << 21);
    carry = std::int::wrapping_add(s18, 1048576) >> 21;
    s19 = std::int::wrapping_add(s19, carry);
    s18 = std::int::wrapping_sub(s18, carry << 21);
    carry = std::int::wrapping_add(s20, 1048576) >> 21;
    s21 = std::int::wrapping_add(s21, carry);
    s20 = std::int::wrapping_sub(s20, carry << 21);
    carry = std::int::wrapping_add(s22, 1048576) >> 21;
    s23 = std::int::wrapping_add(s23, carry);
    s22 = std::int::wrapping_sub(s22, carry << 21);
    carry = std::int::wrapping_add(s1, 1048576) >> 21;
    s2 = std::int::wrapping_add(s2, carry);
    s1 = std::int::wrapping_sub(s1, carry << 21);
    carry = std::int::wrapping_add(s3, 1048576) >> 21;
    s4 = std::int::wrapping_add(s4, carry);
    s3 = std::int::wrapping_sub(s3, carry << 21);
    carry = std::int::wrapping_add(s5, 1048576) >> 21;
    s6 = std::int::wrapping_add(s6, carry);
    s5 = std::int::wrapping_sub(s5, carry << 21);
    carry = std::int::wrapping_add(s7, 1048576) >> 21;
    s8 = std::int::wrapping_add(s8, carry);
    s7 = std::int::wrapping_sub(s7, carry << 21);
    carry = std::int::wrapping_add(s9, 1048576) >> 21;
    s10 = std::int::wrapping_add(s10, carry);
    s9 = std::int::wrapping_sub(s9, carry << 21);
    carry = std::int::wrapping_add(s11, 1048576) >> 21;
    s12 = std::int::wrapping_add(s12, carry);
    s11 = std::int::wrapping_sub(s11, carry << 21);
    carry = std::int::wrapping_add(s13, 1048576) >> 21;
    s14 = std::int::wrapping_add(s14, carry);
    s13 = std::int::wrapping_sub(s13, carry << 21);
    carry = std::int::wrapping_add(s15, 1048576) >> 21;
    s16 = std::int::wrapping_add(s16, carry);
    s15 = std::int::wrapping_sub(s15, carry << 21);
    carry = std::int::wrapping_add(s17, 1048576) >> 21;
    s18 = std::int::wrapping_add(s18, carry);
    s17 = std::int::wrapping_sub(s17, carry << 21);
    carry = std::int::wrapping_add(s19, 1048576) >> 21;
    s20 = std::int::wrapping_add(s20, carry);
    s19 = std::int::wrapping_sub(s19, carry << 21);
    carry = std::int::wrapping_add(s21, 1048576) >> 21;
    s22 = std::int::wrapping_add(s22, carry);
    s21 = std::int::wrapping_sub(s21, carry << 21);
    reduce_wide(WideScalar {
        s0: s0,
        s1: s1,
        s2: s2,
        s3: s3,
        s4: s4,
        s5: s5,
        s6: s6,
        s7: s7,
        s8: s8,
        s9: s9,
        s10: s10,
        s11: s11,
        s12: s12,
        s13: s13,
        s14: s14,
        s15: s15,
        s16: s16,
        s17: s17,
        s18: s18,
        s19: s19,
        s20: s20,
        s21: s21,
        s22: s22,
        s23: s23,
    })
}

/// Limb `index` (21 bits from bit 21 * index) of a little-endian byte
/// string, or every bit from there up when `top` is true. Reads at most
/// four bytes, chosen by position.
fn limb_at(in bytes: Array[Int], take index: Int, take top: Bool) -> Int {
    let bit = index * 21;
    let first = bit >> 3;
    var acc = 0;
    var k = 0;
    while k < 4 && first + k < std::array::len(bytes) {
        acc = acc | ((std::array::get(bytes, first + k) & 255) << (k * 8));
        k = k + 1;
    }
    let shifted = acc >> (bit & 7);
    if top {
        return shifted;
    }
    shifted & 2097151
}

/// A 32-byte little-endian scalar as limbs; the top limb takes every bit
/// from 231 up, so a clamped secret scalar (below 2^255) fits unreduced.
///
/// # Example
/// ```tuo
/// let s = std::ed25519::scalar_limbs(bytes);
/// ```
pub fn scalar_limbs(in bytes: Array[Int]) -> Scalar {
    Scalar {
        s0: limb_at(bytes, 0, false),
        s1: limb_at(bytes, 1, false),
        s2: limb_at(bytes, 2, false),
        s3: limb_at(bytes, 3, false),
        s4: limb_at(bytes, 4, false),
        s5: limb_at(bytes, 5, false),
        s6: limb_at(bytes, 6, false),
        s7: limb_at(bytes, 7, false),
        s8: limb_at(bytes, 8, false),
        s9: limb_at(bytes, 9, false),
        s10: limb_at(bytes, 10, false),
        s11: limb_at(bytes, 11, true),
    }
}

/// A 64-byte little-endian value (a SHA-512 digest) as wide limbs.
///
/// # Example
/// ```tuo
/// let w = std::ed25519::wide_limbs(digest);
/// ```
pub fn wide_limbs(in bytes: Array[Int]) -> WideScalar {
    WideScalar {
        s0: limb_at(bytes, 0, false),
        s1: limb_at(bytes, 1, false),
        s2: limb_at(bytes, 2, false),
        s3: limb_at(bytes, 3, false),
        s4: limb_at(bytes, 4, false),
        s5: limb_at(bytes, 5, false),
        s6: limb_at(bytes, 6, false),
        s7: limb_at(bytes, 7, false),
        s8: limb_at(bytes, 8, false),
        s9: limb_at(bytes, 9, false),
        s10: limb_at(bytes, 10, false),
        s11: limb_at(bytes, 11, false),
        s12: limb_at(bytes, 12, false),
        s13: limb_at(bytes, 13, false),
        s14: limb_at(bytes, 14, false),
        s15: limb_at(bytes, 15, false),
        s16: limb_at(bytes, 16, false),
        s17: limb_at(bytes, 17, false),
        s18: limb_at(bytes, 18, false),
        s19: limb_at(bytes, 19, false),
        s20: limb_at(bytes, 20, false),
        s21: limb_at(bytes, 21, false),
        s22: limb_at(bytes, 22, false),
        s23: limb_at(bytes, 23, true),
    }
}

/// The 32-byte little-endian encoding of canonical limbs.
///
/// # Example
/// ```tuo
/// let bytes = std::ed25519::scalar_bytes(s);
/// ```
pub fn scalar_bytes(take s: Scalar) -> Array[Int] {
    let limbs = [s.s0, s.s1, s.s2, s.s3, s.s4, s.s5, s.s6, s.s7, s.s8, s.s9, s.s10, s.s11];
    var out = std::array::empty();
    var acc = 0;
    var bits = 0;
    var limb = 0;
    while limb < 12 {
        acc = acc | (limbs[limb as Usize] << bits);
        bits = bits + 21;
        while bits >= 8 {
            std::array::push(out, acc & 255);
            acc = acc >> 8;
            bits = bits - 8;
        }
        limb = limb + 1;
    }
    // 252 bits fill 31 bytes and leave 4 for the last.
    std::array::push(out, acc);
    out
}

/// A 64-byte little-endian value reduced modulo L, as 32 bytes — how RFC
/// 8032 turns a SHA-512 digest into a scalar.
///
/// # Example
/// ```tuo
/// let r = std::ed25519::scalar_reduce(std::sha512::hash(input));
/// ```
pub fn scalar_reduce(in bytes: Array[Int]) -> Array[Int] {
    scalar_bytes(reduce_wide(wide_limbs(bytes)))
}

/// The public key for a 32-byte Ed25519 seed: the encoding of `[a]B` for
/// the seed's clamped scalar `a`. Constant time in the seed (see the section
/// header).
///
/// # Example
///
/// ```tuo
/// let public = std::ed25519::public_key(seed);
/// ```
pub fn public_key(in seed: Array[Int]) -> Array[Int] {
    ct_encode(ct_base_mult(expand_seed(seed, 0)))
}

/// Sign `message` with a 32-byte Ed25519 seed (RFC 8032 §5.1.6), returning
/// the 64-byte signature R || S, or an empty array for a seed of the wrong
/// length.
///
/// Constant time in the seed and the derived nonce (see the section header).
/// The nonce is derived deterministically from the key and message, exactly
/// as RFC 8032 specifies, so signing the same message twice yields the same
/// signature and no randomness source is needed (which also removes a whole
/// class of catastrophic nonce-reuse bug).
///
/// # Example
///
/// ```tuo
/// let signature = std::ed25519::sign(seed, message); // 64 bytes
/// ```
pub fn sign(in seed: Array[Int], in message: Array[Int]) -> Array[Int] {
    if std::array::len(seed) != 32 {
        return std::array::empty();
    }
    let scalar = expand_seed(seed, 0);
    let prefix = expand_seed(seed, 1);
    let public = ct_encode(ct_base_mult(scalar));

    // r = SHA-512(prefix || message), reduced mod L.
    var r_input = std::array::empty();
    var i = 0;
    while i < std::array::len(prefix) {
        std::array::push(r_input, std::array::get(prefix, i));
        i = i + 1;
    }
    var m = 0;
    while m < std::array::len(message) {
        std::array::push(r_input, std::array::get(message, m) & 255);
        m = m + 1;
    }
    let r = scalar_reduce(std::sha512::hash(r_input));
    let r_point = ct_encode(ct_base_mult(r));

    // h = SHA-512(R || A || message), reduced mod L.
    var h_input = std::array::empty();
    var p = 0;
    while p < 32 {
        std::array::push(h_input, std::array::get(r_point, p));
        p = p + 1;
    }
    var q = 0;
    while q < 32 {
        std::array::push(h_input, std::array::get(public, q));
        q = q + 1;
    }
    var n = 0;
    while n < std::array::len(message) {
        std::array::push(h_input, std::array::get(message, n) & 255);
        n = n + 1;
    }
    let h = scalar_reduce(std::sha512::hash(h_input));

    // S = (r + h * a) mod L.
    let s = scalar_bytes(mul_add(scalar_limbs(h), scalar_limbs(scalar), scalar_limbs(r)));
    var signature = std::array::empty();
    var a = 0;
    while a < 32 {
        std::array::push(signature, std::array::get(r_point, a));
        a = a + 1;
    }
    var b = 0;
    while b < 32 {
        std::array::push(signature, std::array::get(s, b));
        b = b + 1;
    }
    signature
}

/// 32 bytes from 64 lowercase hex digits, for the specs below.
fn hex32(in text: Str) -> Array[Int] {
    var out = std::array::empty();
    var i = 0;
    while i < 64 {
        let hi = hex_digit(std::str::byte_at(text, i));
        let lo = hex_digit(std::str::byte_at(text, i + 1));
        std::array::push(out, hi * 16 + lo);
        i = i + 2;
    }
    out
}

/// The value of one lowercase hex digit.
fn hex_digit(take c: Int) -> Int {
    if c >= 97 {
        return c - 87;
    }
    c - 48
}

/// Whether two byte arrays are equal, for the specs below.
fn same_bytes(in a: Array[Int], in b: Array[Int]) -> Bool {
    if std::array::len(a) != std::array::len(b) {
        return false;
    }
    var i = 0;
    while i < std::array::len(a) {
        if std::array::get(a, i) != std::array::get(b, i) {
            return false;
        }
        i = i + 1;
    }
    true
}

/// A little-endian byte string of `count` bytes holding `value`.
fn int_bytes(take value: Int, take count: Int) -> Array[Int] {
    var out = std::array::empty();
    var v = value;
    var i = 0;
    while i < count {
        std::array::push(out, v & 255);
        v = v >> 8;
        i = i + 1;
    }
    out
}

/// L, the group order, as 32 little-endian bytes.
fn order_bytes() -> Array[Int] {
    hex32("edd3f55c1a631258d69cf7a2def9de1400000000000000000000000000000010")
}

/// L - 1.
fn order_minus_one() -> Array[Int] {
    hex32("ecd3f55c1a631258d69cf7a2def9de1400000000000000000000000000000010")
}

/// `bytes` followed by `count` zero bytes.
fn padded(in bytes: Array[Int], take count: Int) -> Array[Int] {
    var out = std::array::empty();
    var i = 0;
    while i < std::array::len(bytes) {
        std::array::push(out, std::array::get(bytes, i));
        i = i + 1;
    }
    var j = 0;
    while j < count {
        std::array::push(out, 0);
        j = j + 1;
    }
    out
}

/// 64 bytes of 0xff: 2^512 - 1, the largest digest.
fn all_ones_64() -> Array[Int] {
    var out = std::array::empty();
    var i = 0;
    while i < 64 {
        std::array::push(out, 255);
        i = i + 1;
    }
    out
}

/// The encoding of a point, through the constant-time path.
fn encoded(take p: CtPoint) -> Array[Int] {
    ct_encode(p)
}

spec encode_point {
    // Encoding is 32 bytes, and the identity (0, 1) encodes as 01 00 … 00:
    // y = 1 little-endian, with x even so the sign bit stays clear.
    then std::array::len(encode_point(identity())) == 32;
    then std::array::get(encode_point(identity()), 0) == 1;
    then std::array::get(encode_point(identity()), 31) == 0;
}

spec expand_seed {
    // Both halves are 32 bytes.
    then std::array::len(expand_seed(zero_bytes(32), 0)) == 32;
    then std::array::len(expand_seed(zero_bytes(32), 1)) == 32;
    // The scalar half is CLAMPED: low three bits clear, bit 254 set, bit 255
    // clear. An unclamped scalar produces signatures nothing accepts.
    then (std::array::get(expand_seed(zero_bytes(32), 0), 0) & 7) == 0;
    then (std::array::get(expand_seed(zero_bytes(32), 0), 31) & 64) == 64;
    then (std::array::get(expand_seed(zero_bytes(32), 0), 31) & 128) == 0;
    // The two halves differ — they are different parts of one SHA-512.
    then std::array::get(expand_seed(zero_bytes(32), 0), 1)
        != std::array::get(expand_seed(zero_bytes(32), 1), 1)
        || std::array::get(expand_seed(zero_bytes(32), 0), 2)
            != std::array::get(expand_seed(zero_bytes(32), 1), 2);
}

spec ct_identity {
    // The identity encodes as y = 1 with x even.
    then same_bytes(encoded(ct_identity()), padded(int_bytes(1, 1), 31));
}

spec ct_base_point {
    // B's published encoding (RFC 8032 §5.1): y = 4/5, x even.
    then same_bytes(
        encoded(ct_base_point()),
        hex32("5866666666666666666666666666666666666666666666666666666666666666"),
    );
}

spec ct_add {
    // The identity is neutral, on either side.
    then same_bytes(encoded(ct_add(ct_base_point(), ct_identity())), encoded(ct_base_point()));
    then same_bytes(encoded(ct_add(ct_identity(), ct_base_point())), encoded(ct_base_point()));
    // The unified formula doubles too: B + B = 2B.
    then same_bytes(
        encoded(ct_add(ct_base_point(), ct_base_point())),
        hex32("c9a3f86aae465f0e56513864510f3997561fa2c9e85ea21dc2292309f3cd6022"),
    );
}

spec ct_double {
    // 2B, against its published encoding, and against the addition formula.
    then same_bytes(
        encoded(ct_double(ct_base_point())),
        hex32("c9a3f86aae465f0e56513864510f3997561fa2c9e85ea21dc2292309f3cd6022"),
    );
    then same_bytes(encoded(ct_double(ct_identity())), encoded(ct_identity()));
}

spec ct_select {
    then same_bytes(encoded(ct_select(1, ct_identity(), ct_base_point())), encoded(ct_identity()));
    then same_bytes(encoded(ct_select(0, ct_identity(), ct_base_point())), encoded(ct_base_point()));
}

spec ct_step {
    // From the identity, a 1 bit gives B and a 0 bit stays put.
    then same_bytes(encoded(ct_step(ct_identity(), 1)), encoded(ct_base_point()));
    then same_bytes(encoded(ct_step(ct_identity(), 0)), encoded(ct_identity()));
    // From B, a 1 bit gives 2B + B = 3B.
    then same_bytes(
        encoded(ct_step(ct_base_point(), 1)),
        hex32("d4b4f5784868c3020403246717ec169ff79e26608ea126a1ab69ee77d1b16712"),
    );
}

spec ct_base_mult {
    // [0]B is the identity, [1]B is B, [3]B as above.
    then same_bytes(encoded(ct_base_mult(zero_bytes(32))), encoded(ct_identity()));
    then same_bytes(encoded(ct_base_mult(padded(int_bytes(1, 1), 31))), encoded(ct_base_point()));
    then same_bytes(
        encoded(ct_base_mult(padded(int_bytes(3, 1), 31))),
        hex32("d4b4f5784868c3020403246717ec169ff79e26608ea126a1ab69ee77d1b16712"),
    );
    // [L]B is the identity: B has order L.
    then same_bytes(encoded(ct_base_mult(order_bytes())), encoded(ct_identity()));
}

spec ct_encode {
    then std::array::len(ct_encode(ct_base_point())) == 32;
    // x's parity lands in the top bit: -B has B's y and the odd x.
    then same_bytes(encoded(ct_base_mult(order_minus_one())), hex32("58666666666666666666666666666666666666666666666666666666666666e6"));
}

spec reduce_wide {
    // Small values pass through; L and 2L reduce to zero.
    then same_bytes(scalar_bytes(reduce_wide(wide_limbs(padded(int_bytes(42, 1), 63)))), padded(int_bytes(42, 1), 31));
    then same_bytes(scalar_bytes(reduce_wide(wide_limbs(padded(order_bytes(), 32)))), zero_bytes(32));
    then same_bytes(scalar_bytes(reduce_wide(wide_limbs(padded(order_minus_one(), 32)))), order_minus_one());
    // The largest digest, against Python's big-integer `(2^512 - 1) % L`.
    then same_bytes(scalar_bytes(reduce_wide(wide_limbs(all_ones_64()))), hex32("000f9c44e31106a447938568a71b0ed065bef517d273ecce3d9a307c1b419903"));
}

spec mul_add {
    // 6 * 7 + 5 = 47.
    then same_bytes(
        scalar_bytes(mul_add(scalar_limbs(padded(int_bytes(6, 1), 31)), scalar_limbs(padded(int_bytes(7, 1), 31)), scalar_limbs(padded(int_bytes(5, 1), 31)))),
        padded(int_bytes(47, 1), 31),
    );
    // (L - 1)^2 + 0 = 1 (mod L), and (L - 1) * 1 + 1 = 0.
    then same_bytes(
        scalar_bytes(mul_add(scalar_limbs(order_minus_one()), scalar_limbs(order_minus_one()), scalar_limbs(zero_bytes(32)))),
        padded(int_bytes(1, 1), 31),
    );
    then same_bytes(
        scalar_bytes(mul_add(scalar_limbs(order_minus_one()), scalar_limbs(padded(int_bytes(1, 1), 31)), scalar_limbs(padded(int_bytes(1, 1), 31)))),
        zero_bytes(32),
    );
}

spec scalar_limbs {
    // Limb 0 is the low 21 bits; the top limb keeps bits 231 and up.
    then scalar_limbs(padded(int_bytes(2097153, 3), 29)).s0 == 1;
    then scalar_limbs(padded(int_bytes(2097153, 3), 29)).s1 == 1;
    then scalar_limbs(all_ones_32()).s11 == 33554431;
}

spec wide_limbs {
    then wide_limbs(all_ones_64()).s0 == 2097151;
    // The top limb holds bits 483 to 511: 29 bits.
    then wide_limbs(all_ones_64()).s23 == 536870911;
}

spec scalar_bytes {
    then same_bytes(scalar_bytes(scalar_limbs(order_minus_one())), order_minus_one());
}

spec scalar_reduce {
    then same_bytes(scalar_reduce(padded(order_bytes(), 32)), zero_bytes(32));
    then same_bytes(scalar_reduce(all_ones_64()), hex32("000f9c44e31106a447938568a71b0ed065bef517d273ecce3d9a307c1b419903"));
}

spec public_key {
    // RFC 8032 §7.1, test 1.
    then same_bytes(
        public_key(hex32("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")),
        hex32("d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"),
    );
}

spec sign {
    // A wrong-length seed is refused rather than trapping or producing a
    // signature that cannot be verified.
    then std::array::len(sign(std::array::empty(), std::array::empty())) == 0;
    then std::array::len(sign(zero_bytes(31), std::array::empty())) == 0;
    // RFC 8032's published signatures are pinned natively
    // (`ed25519_signs_rfc_8032_vectors`), and against OpenSSL.
}

/// 32 bytes of 0xff.
fn all_ones_32() -> Array[Int] {
    var out = std::array::empty();
    var i = 0;
    while i < 32 {
        std::array::push(out, 255);
        i = i + 1;
    }
    out
}
