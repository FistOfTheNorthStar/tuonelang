    s11 = std::int::wrapping_add(s11, std::int::wrapping_mul(a.s4, b.s7));
    s11 = std::int::wrapping_add(s11, std::int::wrapping_mul(a.s5, b.s6));
    s11 = std::int::wrapping_add(s11, std::int::wrapping_mul(a.s6, b.s5));
    s11 = std::int::wrapping_add(s11, std::int::wrapping_mul(a.s7, b.s4));
    s11 = std::int::wrapping_add(s11, std::int::wrapping_mul(a.s8, b.s3));
    s11 = std::int::wrapping_add(s11, std::int::wrapping_mul(a.s9, b.s2));
