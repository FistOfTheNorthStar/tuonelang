    s12 = std::int::wrapping_add(s12, std::int::wrapping_mul(a.s2, b.s10));
    s12 = std::int::wrapping_add(s12, std::int::wrapping_mul(a.s3, b.s9));
    s12 = std::int::wrapping_add(s12, std::int::wrapping_mul(a.s4, b.s8));
