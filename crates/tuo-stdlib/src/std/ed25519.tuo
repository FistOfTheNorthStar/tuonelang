/// `(a * b + c) mod L` (ref10's `sc_muladd`): a schoolbook product into
/// twenty-three limbs, a carry pass, and `reduce_wide`. Operands are any
/// 32-byte values, so the top limb may hold 25 bits; every intermediate
/// stays below 2^51.
///
/// # Example
/// ```tuo
/// let s = std::ed25519::mul_add(h, a, r);
/// ```
#[constant_time]
pub fn mul_add(take a: Scalar, take b: Scalar, take c: Scalar) -> Scalar {
    var s0 = c.s0;
    s0 = std::int::wrapping_add(s0, std::int::wrapping_mul(a.s0, b.s0));
    var s1 = c.s1;
    s1 = std::int::wrapping_add(s1, std::int::wrapping_mul(a.s0, b.s1));
    s1 = std::int::wrapping_add(s1, std::int::wrapping_mul(a.s1, b.s0));
    var s2 = c.s2;
    s2 = std::int::wrapping_add(s2, std::int::wrapping_mul(a.s0, b.s2));
    s2 = std::int::wrapping_add(s2, std::int::wrapping_mul(a.s1, b.s1));
    s2 = std::int::wrapping_add(s2, std::int::wrapping_mul(a.s2, b.s0));
    var s3 = c.s3;
    s3 = std::int::wrapping_add(s3, std::int::wrapping_mul(a.s0, b.s3));
    s3 = std::int::wrapping_add(s3, std::int::wrapping_mul(a.s1, b.s2));
    s3 = std::int::wrapping_add(s3, std::int::wrapping_mul(a.s2, b.s1));
    s3 = std::int::wrapping_add(s3, std::int::wrapping_mul(a.s3, b.s0));
    var s4 = c.s4;
    s4 = std::int::wrapping_add(s4, std::int::wrapping_mul(a.s0, b.s4));
    s4 = std::int::wrapping_add(s4, std::int::wrapping_mul(a.s1, b.s3));
    s4 = std::int::wrapping_add(s4, std::int::wrapping_mul(a.s2, b.s2));
    s4 = std::int::wrapping_add(s4, std::int::wrapping_mul(a.s3, b.s1));
    s4 = std::int::wrapping_add(s4, std::int::wrapping_mul(a.s4, b.s0));
    var s5 = c.s5;
    s5 = std::int::wrapping_add(s5, std::int::wrapping_mul(a.s0, b.s5));
    s5 = std::int::wrapping_add(s5, std::int::wrapping_mul(a.s1, b.s4));
    s5 = std::int::wrapping_add(s5, std::int::wrapping_mul(a.s2, b.s3));
    s5 = std::int::wrapping_add(s5, std::int::wrapping_mul(a.s3, b.s2));
    s5 = std::int::wrapping_add(s5, std::int::wrapping_mul(a.s4, b.s1));
