/// The `index`-th SHA-512 initial hash value (FIPS 180-4 §5.3.5).
///
/// # Example
///
/// ```tuo
/// let k = std::sha512::initial_hash(0);
/// ```
pub fn initial_hash(take index: Int) -> Int {
    // Split into 32-bit halves: a literal above 2^63 would not fit
    // tuonelang's signed `Int`.
    let hi = initial_hash_hi(index);
    let lo = initial_hash_lo(index);
    (hi << 32) | lo
}

/// The high 32 bits of constant `index`.
///
/// # Example
///
/// ```tuo
/// let h = std::sha512::initial_hash_hi(0);
/// ```
pub fn initial_hash_hi(take index: Int) -> Int {
    var table = std::array::empty();
    std::array::push(table, 1779033703);
    std::array::push(table, 3144134277);
    std::array::push(table, 1013904242);
    std::array::push(table, 2773480762);
    std::array::push(table, 1359893119);
    std::array::push(table, 2600822924);
    std::array::push(table, 528734635);
    std::array::push(table, 1541459225);
    if index < 0 || index >= std::array::len(table) {
        return 0;
    }
    std::array::get(table, index)
}

/// The low 32 bits of constant `index`.
///
/// # Example
///
/// ```tuo
/// let h = std::sha512::initial_hash_lo(0);
/// ```
pub fn initial_hash_lo(take index: Int) -> Int {
    var table = std::array::empty();
    std::array::push(table, 4089235720);
    std::array::push(table, 2227873595);
    std::array::push(table, 4271175723);
