    std::array::push(table, 4215389547);
    std::array::push(table, 327033209);
    if index < 0 || index >= std::array::len(table) {
        return 0;
    }
    std::array::get(table, index)
}

/// Pad a message to a multiple of 128 bytes (FIPS 180-4 §5.1.2): append a
/// `0x80` byte, then zeros, then the message's **bit** length as a 128-bit
/// big-endian integer.
///
/// The length field is 128 bits wide, not 64 — that is SHA-512's difference
/// from SHA-256 and a place a transcription slips easily. Only the low 64
/// bits can be non-zero here, since a tuonelang `Array` cannot hold 2^61
/// bytes, but the sixteen bytes must still be present or every digest is
/// wrong.
///
/// # Example
///
/// ```tuo
/// let padded = std::sha512::pad(message);
/// ```
pub fn pad(in message: Array[Int]) -> Array[Int] {
    var out = std::array::empty();
    let n = std::array::len(message);
    var i = 0;
    while i < n {
        std::array::push(out, std::array::get(message, i) & 255);
        i = i + 1;
    }
    std::array::push(out, 128);
    // Zero-pad until the length is 112 mod 128, leaving room for the
    // sixteen-byte length field.
    while std::array::len(out) % 128 != 112 {
        std::array::push(out, 0);
    }
    // The high 64 bits of the bit length are always zero at these sizes.
    var z = 0;
    while z < 8 {
        std::array::push(out, 0);
        z = z + 1;
    }
    // The low 64 bits, big-endian. `n * 8` cannot overflow for any array
    // tuonelang can allocate.
    let bits = n * 8;
    var shift = 7;
    while shift >= 0 {
        std::array::push(out, shr64(bits, shift * 8) & 255);
        shift = shift - 1;
    }
    out
}

/// Read a big-endian 64-bit word from `bytes` at `offset`.
///
/// # Example
///
/// ```tuo
/// let w = std::sha512::word_at(padded, 0);
/// ```
pub fn word_at(in bytes: Array[Int], take offset: Int) -> Int {
    var value = 0;
    var i = 0;
    while i < 8 {
        var b = 0;
        if offset + i < std::array::len(bytes) {
            b = std::array::get(bytes, offset + i) & 255;
        }
        // Shift-and-or rather than multiply-and-add, so nothing can trap.
        value = (value << 8) | b;
        i = i + 1;
    }
    value
}

/// The SHA-512 digest of a byte array — 64 bytes (FIPS 180-4).
///
/// # Example
///
/// ```tuo
/// let digest = std::sha512::hash(message); // 64 bytes
/// ```
pub fn hash(in message: Array[Int]) -> Array[Int] {
    let padded = pad(message);
    // The eight working hash values.
    var h0 = initial_hash(0);
    var h1 = initial_hash(1);
    var h2 = initial_hash(2);
    var h3 = initial_hash(3);
    var h4 = initial_hash(4);
    var h5 = initial_hash(5);
    var h6 = initial_hash(6);
    var h7 = initial_hash(7);

    var block = 0;
    let blocks = std::array::len(padded) / 128;
    while block < blocks {
        let base = block * 128;
        // The message schedule: sixteen words from the block, then sixty-four
        // derived from them.
        var w = std::array::empty();
        var t = 0;
        while t < 16 {
            std::array::push(w, word_at(padded, base + t * 8));
            t = t + 1;
        }
        while t < 80 {
            let s1 = small_sigma1(std::array::get(w, t - 2));
            let w7 = std::array::get(w, t - 7);
            let s0 = small_sigma0(std::array::get(w, t - 15));
            let w16 = std::array::get(w, t - 16);
            std::array::push(w, add64(add64(s1, w7), add64(s0, w16)));
            t = t + 1;
        }

        var a = h0;
        var b = h1;
        var c = h2;
        var d = h3;
        var e = h4;
        var f = h5;
        var g = h6;
        var h = h7;

        var round = 0;
        while round < 80 {
            let t1 = add64(
                add64(add64(h, big_sigma1(e)), ch(e, f, g)),
                add64(round_constant(round), std::array::get(w, round)),
            );
            let t2 = add64(big_sigma0(a), maj(a, b, c));
            h = g;
            g = f;
            f = e;
            e = add64(d, t1);
            d = c;
            c = b;
            b = a;
            a = add64(t1, t2);
            round = round + 1;
        }

        h0 = add64(h0, a);
        h1 = add64(h1, b);
        h2 = add64(h2, c);
        h3 = add64(h3, d);
        h4 = add64(h4, e);
        h5 = add64(h5, f);
        h6 = add64(h6, g);
        h7 = add64(h7, h);
        block = block + 1;
    }

    var out = std::array::empty();
    push_word(out, h0);
    push_word(out, h1);
    push_word(out, h2);
    push_word(out, h3);
    push_word(out, h4);
    push_word(out, h5);
    push_word(out, h6);
    push_word(out, h7);
    out
}

/// Append a 64-bit word to `out` as eight big-endian bytes.
///
/// # Example
///
/// ```tuo
/// std::sha512::push_word(buffer, word);
/// ```
pub fn push_word(mut out: Array[Int], take value: Int) -> Int {
    var shift = 7;
    while shift >= 0 {
        std::array::push(out, shr64(value, shift * 8) & 255);
        shift = shift - 1;
    }
    0
}

// --- Specs: FIPS 180-4's PUBLISHED digests ----------------------------------

/// The message "abc", FIPS 180-4's worked example.
fn abc_message() -> Array[Int] {
    var a = std::array::empty();
    std::array::push(a, 97);
    std::array::push(a, 98);
    std::array::push(a, 99);
    a
}

/// A byte of SHA-512("abc"), for the spec below.
fn abc_digest_byte(take i: Int) -> Int {
    std::array::get(hash(abc_message()), i)
}

/// A byte of SHA-512(""), for the spec below.
fn empty_digest_byte(take i: Int) -> Int {
    std::array::get(hash(std::array::empty()), i)
}

spec add64 {
    then add64(5, 7) == 12;
    then add64(0, 0) == 0;
    // The cases plain `+` TRAPS on: two words with high bits set. This is
    // the whole reason `add64` exists, so it is the load-bearing assertion.
    then add64(1 << 62, 1 << 62) == (1 << 63);
    // Wrapping: 2^64 - 1 plus 1 is 0. (-1 is all ones as a bit pattern.)
    then add64(0 - 1, 1) == 0;
    then add64(0 - 1, 2) == 1;
}

spec shr64 {
    then shr64(256, 8) == 1;
    then shr64(1, 0) == 1;
    then shr64(1, 64) == 0;
    // LOGICAL, not arithmetic: a word with its high bit set must not smear
    // ones downward. tuonelang's `>>` is arithmetic on a signed type, so a
    // naive shift gets this wrong.
    then shr64(1 << 63, 63) == 1;
    then shr64(0 - 1, 60) == 15;
}

spec rotr64 {
    then rotr64(1, 0) == 1;
    // Rotating 1 right by one puts it in the top bit.
    then rotr64(1, 1) == (1 << 63);
    // A full turn is the identity.
    then rotr64(12345, 64) == 12345;
}

spec mask32 {
    then mask32() == 4294967295;
}

spec ch {
    // Ch picks y where x is 1 and z where x is 0.
    then ch(0, 5, 9) == 9;
    then ch(0 - 1, 5, 9) == 5;
}

spec maj {
    // Maj is the bitwise majority.
    then maj(0, 0, 0) == 0;
    then maj(0 - 1, 0 - 1, 0) == 0 - 1;
    then maj(1, 1, 0) == 1;
}

spec big_sigma0 {
    then big_sigma0(0) == 0;
}

spec big_sigma1 {
    then big_sigma1(0) == 0;
}

spec small_sigma0 {
    then small_sigma0(0) == 0;
}

spec small_sigma1 {
    then small_sigma1(0) == 0;
}

spec round_constant {
    // FIPS 180-4 §4.2.3's first and last constants.
    then round_constant(0) == 0x428a2f98d728ae22;
    then round_constant(79) == 0x6c44198c4a475817;
    // Out of range answers 0 rather than trapping.
    then round_constant(0 - 1) == 0;
    then round_constant(80) == 0;
}

spec round_constant_hi {
    then round_constant_hi(0) == 0x428a2f98;
}

spec round_constant_lo {
    then round_constant_lo(0) == 0xd728ae22;
}

spec initial_hash {
    // FIPS 180-4 §5.3.5.
    then initial_hash(0) == 0x6a09e667f3bcc908;
    then initial_hash(7) == 0x5be0cd19137e2179;
    then initial_hash(8) == 0;
}

spec initial_hash_hi {
    then initial_hash_hi(0) == 0x6a09e667;
}

spec initial_hash_lo {
    then initial_hash_lo(0) == 0xf3bcc908;
}

spec pad {
    // "abc" is 3 bytes, so one block of 128.
    then std::array::len(pad(abc_message())) == 128;
    // The 0x80 terminator sits right after the message.
    then std::array::get(pad(abc_message()), 3) == 128;
    // The bit length, 24, lands in the FINAL byte — the 128-bit length field
    // is SHA-512's difference from SHA-256, and a 64-bit field here would
    // put it eight bytes early and break every digest.
    then std::array::get(pad(abc_message()), 127) == 24;
    then std::array::get(pad(abc_message()), 126) == 0;
    // An empty message still pads to a full block.
    then std::array::len(pad(std::array::empty())) == 128;
    then std::array::get(pad(std::array::empty()), 0) == 128;
    // A message that just crosses the boundary needs two blocks.
    then std::array::len(pad(hash(abc_message()))) == 128;
}

spec word_at {
    // Big-endian assembly.
    then word_at(pad(abc_message()), 0) == 0x6162638000000000;
    // Past the end reads as zero rather than trapping.
    then word_at(std::array::empty(), 0) == 0;
}

spec push_word {
    then std::array::len(hash(abc_message())) == 64;
}

spec hash {
    // FIPS 180-4's PUBLISHED digest of "abc", every byte.
    then abc_digest_byte(0) == 221;
    then abc_digest_byte(1) == 175;
    then abc_digest_byte(2) == 53;
    then abc_digest_byte(3) == 161;
    then abc_digest_byte(4) == 147;
    then abc_digest_byte(5) == 97;
