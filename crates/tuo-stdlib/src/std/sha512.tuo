    then abc_digest_byte(18) == 250;
    then abc_digest_byte(19) == 78;
    then abc_digest_byte(20) == 137;
    then abc_digest_byte(21) == 169;
    then abc_digest_byte(22) == 126;
    then abc_digest_byte(23) == 162;
    then abc_digest_byte(24) == 10;
    then abc_digest_byte(25) == 158;
    then abc_digest_byte(26) == 238;
    then abc_digest_byte(27) == 230;
    then abc_digest_byte(28) == 75;
    then abc_digest_byte(29) == 85;
    then abc_digest_byte(30) == 211;
    then abc_digest_byte(31) == 154;
    then abc_digest_byte(32) == 33;
    then abc_digest_byte(33) == 146;
    then abc_digest_byte(34) == 153;
    then abc_digest_byte(35) == 42;
    then abc_digest_byte(36) == 39;
    then abc_digest_byte(37) == 79;
    then abc_digest_byte(38) == 193;
    then abc_digest_byte(39) == 168;
    then abc_digest_byte(40) == 54;
    then abc_digest_byte(41) == 186;
    then abc_digest_byte(42) == 60;
    then abc_digest_byte(43) == 35;
    then abc_digest_byte(44) == 163;
    then abc_digest_byte(45) == 254;
    then abc_digest_byte(46) == 235;
    then abc_digest_byte(47) == 189;
    then abc_digest_byte(48) == 69;
    then abc_digest_byte(49) == 77;
    then abc_digest_byte(50) == 68;
    then abc_digest_byte(51) == 35;
    then abc_digest_byte(52) == 100;
    then abc_digest_byte(53) == 60;
    then abc_digest_byte(54) == 232;
    then abc_digest_byte(55) == 14;
    then abc_digest_byte(56) == 42;
    then abc_digest_byte(57) == 154;
    then abc_digest_byte(58) == 201;
    then abc_digest_byte(59) == 79;
    then abc_digest_byte(60) == 165;
    then abc_digest_byte(61) == 76;
    then abc_digest_byte(62) == 164;
    then abc_digest_byte(63) == 159;
    // And the empty string's, whose first bytes cf 83 e1 35 are among the
    // most-recognized in cryptography.
    then empty_digest_byte(0) == 207;
    then empty_digest_byte(1) == 131;
    then empty_digest_byte(2) == 225;
    then empty_digest_byte(3) == 53;
    then empty_digest_byte(4) == 126;
    then empty_digest_byte(5) == 239;
    then empty_digest_byte(6) == 184;
    then empty_digest_byte(7) == 189;
    then std::array::len(hash(std::array::empty())) == 64;
}
