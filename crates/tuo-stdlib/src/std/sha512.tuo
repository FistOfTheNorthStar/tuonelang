// std::sha512 — SHA-512 (FIPS 180-4), the hash Ed25519 is defined over.
//
// This module is entirely executable, and its specs assert FIPS 180-4's
// **published** digests rather than the module's own reasoning — the same
// rule `std::crypto` follows, and for the same reason: a hash that agrees
// only with itself produces signatures no other implementation accepts.
//
// WHY A SEPARATE MODULE FROM `std::crypto`'s SHA-256. They are different
// algorithms, not one parameterized by width. SHA-512 works on 64-bit words
// with different constants, different rotation amounts, a 128-bit length
// field, and eighty rounds rather than sixty-four. Sharing code between them
// would mean a parameterized skeleton that is harder to check against the
// standard than two direct transcriptions.
//
// THE 64-BIT PROBLEM, which shapes every line below. tuonelang's `Int` is a
// **signed** i64, and `+` **traps** on overflow rather than wrapping. SHA-512
// is defined over addition mod 2^64, so `a + b` is exactly the wrong
// primitive: for two words with their high bits set it aborts the process.
// `add64` below does the add through 32-bit halves so no intermediate ever
// exceeds the positive range, and every other operation masks to 64 bits the
// same way. This is the same reasoning `std::bits`'s `add32` documents, one
// width up, where it matters more because the sign bit is now in play.

module std::sha512;

/// A mask selecting the low 32 bits.
///
/// # Example
///
/// ```tuo
/// let m = std::sha512::mask32(); // 4294967295
/// ```
pub fn mask32() -> Int {
    4294967295
}

/// Addition modulo 2^64, the operation SHA-512 is defined over.
///
/// Done through 32-bit halves because tuonelang's `+` **traps** on signed
/// overflow: two words with their high bits set would abort the process, and
/// SHA-512 produces such words constantly. The halves keep every
/// intermediate inside the positive range.
///
/// # Example
///
/// ```tuo
/// let s = std::sha512::add64(a, b);
/// ```
pub fn add64(take a: Int, take b: Int) -> Int {
    let lo = (a & mask32()) + (b & mask32());
    let hi = ((a >> 32) & mask32()) + ((b >> 32) & mask32()) + ((lo >> 32) & mask32());
    ((hi & mask32()) << 32) | (lo & mask32())
}

/// Logical right shift by `n`, without sign extension.
///
/// tuonelang's `>>` is arithmetic on a signed type, so shifting a word whose
/// high bit is set would smear ones down from the top. SHA-512's `SHR` is
/// logical, so the result is masked.
///
/// # Example
///
/// ```tuo
/// let r = std::sha512::shr64(value, 7);
/// ```
pub fn shr64(take value: Int, take n: Int) -> Int {
    if n <= 0 {
        return value;
    }
    if n >= 64 {
        return 0;
    }
    // Shift one bit at a time past the sign bit, then the rest: masking after
    // a single shift clears whatever the sign extension brought in.
    ((value >> 1) & 0x7FFFFFFFFFFFFFFF) >> (n - 1)
}

/// Rotate right by `n` within 64 bits.
///
/// # Example
///
/// ```tuo
/// let r = std::sha512::rotr64(value, 28);
/// ```
pub fn rotr64(take value: Int, take n: Int) -> Int {
    let r = n % 64;
    if r == 0 {
        return value;
    }
    shr64(value, r) | (value << (64 - r))
}

/// SHA-512's `Ch` function (FIPS 180-4 §4.1.3).
///
/// # Example
///
/// ```tuo
/// let c = std::sha512::ch(e, f, g);
/// ```
pub fn ch(take x: Int, take y: Int, take z: Int) -> Int {
    (x & y) ^ ((~x) & z)
}

/// SHA-512's `Maj` function (FIPS 180-4 §4.1.3).
///
/// # Example
///
/// ```tuo
/// let m = std::sha512::maj(a, b, c);
/// ```
pub fn maj(take x: Int, take y: Int, take z: Int) -> Int {
    (x & y) ^ (x & z) ^ (y & z)
}

/// SHA-512's big sigma 0 (FIPS 180-4 §4.1.3).
///
/// # Example
///
/// ```tuo
/// let s = std::sha512::big_sigma0(a);
/// ```
pub fn big_sigma0(take x: Int) -> Int {
    rotr64(x, 28) ^ rotr64(x, 34) ^ rotr64(x, 39)
}

/// SHA-512's big sigma 1 (FIPS 180-4 §4.1.3).
///
/// # Example
///
/// ```tuo
/// let s = std::sha512::big_sigma1(e);
/// ```
pub fn big_sigma1(take x: Int) -> Int {
    rotr64(x, 14) ^ rotr64(x, 18) ^ rotr64(x, 41)
}

/// SHA-512's small sigma 0 (FIPS 180-4 §4.1.3).
///
/// # Example
///
/// ```tuo
/// let s = std::sha512::small_sigma0(w);
/// ```
pub fn small_sigma0(take x: Int) -> Int {
    rotr64(x, 1) ^ rotr64(x, 8) ^ shr64(x, 7)
}

/// SHA-512's small sigma 1 (FIPS 180-4 §4.1.3).
///
/// # Example
///
/// ```tuo
/// let s = std::sha512::small_sigma1(w);
/// ```
pub fn small_sigma1(take x: Int) -> Int {
    rotr64(x, 19) ^ rotr64(x, 61) ^ shr64(x, 6)
}

/// The `index`-th SHA-512 round constant (FIPS 180-4 §4.2.3): the first 64 bits of the fractional part of the cube root of the `index`-th prime.
///
/// # Example
///
/// ```tuo
/// let k = std::sha512::round_constant(0);
/// ```
pub fn round_constant(take index: Int) -> Int {
    // Split into 32-bit halves: a literal above 2^63 would not fit
    // tuonelang's signed `Int`.
    let hi = round_constant_hi(index);
    let lo = round_constant_lo(index);
    (hi << 32) | lo
}

