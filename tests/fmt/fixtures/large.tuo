module   large::generated ;

/// Struct number 0.
pub struct S0[T:Ord]where T:Clone{ pub a0:T ,b0:Box[T],}
enum E0{A0{v:F64},B0,}
fn f0(in x:Int,mut y:F64,take z:Box[Int])->Int{
let q=0+x*2;    // trailing 0
var r=q..x;
let s=match q{0=>"z",1|2=>"s",n if n>9=>"b",_=>"o",};
for e in items(){touch(e);}
if q>0{q}else{x}
}
spec "spec 0"{given g:Int=0;when let w=f0(g,1.0,boxed());then w==f0(g,1.0,boxed());assert w!=1;}

