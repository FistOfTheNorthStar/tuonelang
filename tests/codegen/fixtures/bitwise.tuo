// ADR-0019: the bitwise operators, exercised so the exit byte depends on
// every one of them. `wire` is the big-endian framing that motivated the
// ADR (a length-prefixed protocol header), which the multiply-add form
// cannot express once a high bit is set.
fn wire(take b0: Int, take b1: Int, take b2: Int, take b3: Int) -> Int {
    (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
}

fn main() -> Int {
    let framed = wire(1, 2, 3, 4);
    let low = framed & 255;              // 4
    let high = (framed >> 24) & 255;     // 1
    let mixed = (low ^ high) | 8;        // (4^1)|8 = 13
    let masked = ~mixed & 15;            // ~13 & 15 = 2
    low + high + mixed + masked          // 4 + 1 + 13 + 2 = 20
}
