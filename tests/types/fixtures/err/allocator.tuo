// ADR-0009 error rules: mistyped/misarity allocator-builtin calls are ordinary
// type errors (T0001/T0002), the monomorphic `Array[Int]` surface rejects a
// mismatched element type as a plain type error, and a spec whose closure
// reaches the effectful `std::rt::write_string` is `R0007`.

fn wrong_arity(in s: String) -> Int {
    std::string::byte_at(s)
}

fn wrong_types() -> String {
    std::string::concat(1, 2)
}

// ADR-0010: `as_str` takes `in String`, not `Str`; passing a `Str` (here a
// literal) is a plain type error, and its result is a `Str`, not a `String`.
fn as_str_wants_string() -> Int {
    std::str::len(std::string::as_str("already a Str"))
}

fn as_str_result_is_str() -> String {
    std::string::as_str(std::string::from_str("x"))
}

fn wrong_element() -> Int {
    // `std::array::push` is `Array[Int]`-monomorphic: pushing a `Str` onto an
    // `Array[Int]` is an ordinary type error.
    var xs = std::array::empty();
    std::array::push(xs, 5);
    std::array::push(xs, "nope");
    std::array::len(xs)
}

fn emit(take fd: Int, in s: String) -> Int {
    std::rt::write_string(fd, s)
}

spec "via write_string" {
    then emit(1, std::string::empty()) == 0;
}
