// ADR-0032 Stage A: tuonelang has free functions only, so a method call is
// an error (`T0024`, with the free call offered when exactly one function
// fits). Before Stage A it checked silently and failed later at `run`/`spec`
// with unrelated messages. Since Stage B the declarations and the qualified
// interface-member call `Reset::reset(c)` check cleanly, and an impl member is
// never offered as a method call's rewrite.

struct Counter {
    count: Int,
}

interface Reset {
    fn reset(in self) -> Int;
}

impl Reset for Counter {
    fn reset(in self) -> Int {
        self.count
    }
}

const START: Int = 10;

fn fresh() -> Counter {
    Counter { count: START }
}

fn total(in c: Counter, in xs: Array[Int]) -> Int {
    c.count + xs.len()
}

fn unknown(in c: Counter) -> Int {
    c.no_such_method(1, 2)
}

fn via_interface(in c: Counter) -> Int {
    Reset::reset(c)
}
