fn sum_to(in limit: Int) -> Int {
    var total = 0;
    for n in 0 .. limit {
        total = total + n;
    }
    while total > 100 {
        total = total - 1;
    }
    total
}

fn spin() -> Int {
    var n = 0;
    loop {
        n = n + 1;
        if n > 3 {
            break n;
        }
    }
}

fn classify(in b: Bool) -> Int {
    match b {
        true => 1,
        false => 0,
    }
}
