fn histogram(in scores: Array[Int]) -> Array[Int] {
    var buckets = std::array::filled(10, 0);
    var i = 0;
    while i < std::array::len(scores) {
        let score = std::array::get(scores, i);
        if score >= 0 && score <= 100 {
            let b = std::core::min(score / 10, 9);
            buckets[b as Usize] = buckets[b as Usize] + 1;
        }
        i = i + 1;
    }
    buckets
}

spec histogram {
    when var scores = std::array::empty();
    when std::array::push(scores, 95);
    when std::array::push(scores, 100);
    when std::array::push(scores, 42);
    when std::array::push(scores, 0);
    then std::array::get(histogram(scores), 9) == 2;
    then std::array::get(histogram(scores), 4) == 1;
    then std::array::get(histogram(scores), 0) == 1;
    then std::array::len(histogram(scores)) == 10;
}

spec "histogram ignores out-of-range scores" {
    when var scores = std::array::empty();
    when std::array::push(scores, 0 - 5);
    when std::array::push(scores, 101);
    then std::array::get(histogram(scores), 0) == 0;
    then std::array::get(histogram(scores), 9) == 0;
    then std::array::len(histogram(std::array::empty())) == 10;
}
