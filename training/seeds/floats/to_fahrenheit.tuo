fn to_fahrenheit(take celsius: Float) -> Float {
    celsius * 9.0 / 5.0 + 32.0
}

spec to_fahrenheit {
    then to_fahrenheit(100.0) == 212.0;
    then to_fahrenheit(0.0) == 32.0;
}

spec "to_fahrenheit meets celsius at minus forty" {
    then to_fahrenheit(0.0 - 40.0) == 0.0 - 40.0;
    then to_fahrenheit(37.5) == 99.5;
}
