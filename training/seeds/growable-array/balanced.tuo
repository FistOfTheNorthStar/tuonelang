const OPEN_PAREN: Int = 40;
const CLOSE_PAREN: Int = 41;
const OPEN_SQUARE: Int = 91;
const CLOSE_SQUARE: Int = 93;
const OPEN_CURLY: Int = 123;
const CLOSE_CURLY: Int = 125;

fn opener_for(take close: Int) -> Int {
    if close == CLOSE_PAREN {
        OPEN_PAREN
    } else if close == CLOSE_SQUARE {
        OPEN_SQUARE
    } else {
        OPEN_CURLY
    }
}

fn balanced(in text: Str) -> Bool {
    var stack = std::array::empty();
    var i = 0;
    while i < std::str::len(text) {
        let b = std::str::byte_at(text, i);
        if b == OPEN_PAREN || b == OPEN_SQUARE || b == OPEN_CURLY {
            std::array::push(stack, b);
        } else if b == CLOSE_PAREN || b == CLOSE_SQUARE || b == CLOSE_CURLY {
            match std::array::pop(stack) {
                Some { value } => {
                    if value != opener_for(b) {
                        return false;
                    }
                },
                None => return false,
            }
        }
        i = i + 1;
    }
    std::array::len(stack) == 0
}

spec balanced {
    then balanced("f(a[1], {b})");
    then balanced("");
    then balanced("no brackets");
    then !balanced("(]");
    then !balanced("((");
    then !balanced("())");
    then !balanced("([)]");
}
