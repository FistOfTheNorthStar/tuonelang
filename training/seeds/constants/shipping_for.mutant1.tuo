const FREE_SHIPPING_CENTS: Int = 5000;
const FLAT_RATE_CENTS: Int = 499;

fn shipping_for(take order_cents: Int) -> Int {
    if order_cents > FREE_SHIPPING_CENTS {
        0
    } else {
        FLAT_RATE_CENTS
    }
}

fn order_total(take order_cents: Int) -> Int {
    order_cents + shipping_for(order_cents)
}

spec shipping_for {
    then shipping_for(1200) == FLAT_RATE_CENTS;
    then shipping_for(FREE_SHIPPING_CENTS) == 0;
    then shipping_for(FREE_SHIPPING_CENTS - 1) == FLAT_RATE_CENTS;
}

spec order_total {
    then order_total(1200) == 1699;
    then order_total(7350) == 7350;
}
