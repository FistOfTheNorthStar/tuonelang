fn first_even(take a: Int, take b: Int) -> Option[Int] {
    if a % 2 == 0 {
        Some { value: a }
    } else if b % 2 == 0 {
        Some { value: b }
    } else {
        None
    }
}

fn or_zero(in o: Option[Int]) -> Int {
    match o {
        Some { value } => value,
        None => 0,
    }
}

spec first_even {
    then or_zero(first_even(3, 4)) == 4;
    then or_zero(first_even(2, 7)) == 2;
    then or_zero(first_even(1, 3)) == 0;
}
