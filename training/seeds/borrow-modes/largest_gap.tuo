fn largest_gap(in times: Array[Int]) -> Int {
    var best = 0;
    var i = 1;
    while i < std::array::len(times) {
        let gap = std::array::get(times, i) - std::array::get(times, i - 1);
        if gap > best {
            best = gap;
        }
        i = i + 1;
    }
    best
}

spec largest_gap {
    when var times = std::array::empty();
    when std::array::push(times, 5);
    when std::array::push(times, 12);
    when std::array::push(times, 15);
    when std::array::push(times, 40);
    then largest_gap(times) == 25;
    then std::array::len(times) == 4;
}

spec "largest_gap with too few buses" {
    when var one = std::array::empty();
    when std::array::push(one, 30);
    then largest_gap(one) == 0;
    then largest_gap(std::array::empty()) == 0;
}

spec "largest_gap finds the first gap" {
    when var times = std::array::empty();
    when std::array::push(times, 0);
    when std::array::push(times, 50);
    when std::array::push(times, 55);
    then largest_gap(times) == 50;
}
