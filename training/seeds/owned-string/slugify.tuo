const LOWER_A: Int = 97;
const LOWER_Z: Int = 122;

fn is_alnum(take b: Int) -> Bool {
    std::str::is_digit(b) || (b >= LOWER_A && b <= LOWER_Z)
}

fn slugify(in title: Str) -> String {
    let lowered = std::str::to_lower(title);
    let text = std::string::as_str(lowered);
    var out = std::string::empty();
    var pending_dash = false;
    var i = 0;
    while i < std::str::len(text) {
        let b = std::str::byte_at(text, i);
        if is_alnum(b) {
            if pending_dash && std::string::len(out) > 0 {
                std::string::append(out, "-");
            }
            pending_dash = false;
            std::string::push_byte(out, b);
        } else {
            pending_dash = true;
        }
        i = i + 1;
    }
    out
}

spec slugify {
    then std::string::as_str(slugify("Hello, World!")) == "hello-world";
    then std::string::as_str(slugify("Rust 2024 Edition")) == "rust-2024-edition";
}

spec "slugify trims and collapses separators" {
    then std::string::as_str(slugify("  --Tips & Tricks--  ")) == "tips-tricks";
    then std::string::as_str(slugify("a...b")) == "a-b";
    then std::string::len(slugify("!!!")) == 0;
    then std::string::len(slugify("")) == 0;
}
