const READ: Int = 1;
const WRITE: Int = 2;
const EXECUTE: Int = 4;

fn grant(take perms: Int, take flag: Int) -> Int {
    perms | flag
}

fn revoke(take perms: Int, take flag: Int) -> Int {
    perms ^ flag
}

fn allows(take perms: Int, take flag: Int) -> Bool {
    (perms & flag) == flag
}

spec grant {
    then grant(0, 1) == 1;
    then grant(1, 2) == 3;
    then grant(3, 1) == 3;
}

spec revoke {
    then revoke(7, 2) == 5;
    then revoke(1, 2) == 1;
    then revoke(0, 4) == 0;
}

spec allows {
    then allows(5, 4);
    then !allows(1, 2);
    then allows(3, 3);
    then !allows(1, 3);
}
