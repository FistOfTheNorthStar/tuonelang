const READ: Int = 1;
const WRITE: Int = 2;
const EXECUTE: Int = 4;

fn grant(take perms: Int, take flag: Int) -> Int {
    perms | flag
}

fn revoke(take perms: Int, take flag: Int) -> Int {
    perms & ~flag
}

fn allows(take perms: Int, take flag: Int) -> Bool {
    (perms & flag) == flag
}

spec grant {
    then grant(0, READ) == READ;
    then grant(READ, WRITE) == READ | WRITE;
    then grant(READ | WRITE, READ) == READ | WRITE;
}

spec revoke {
    then revoke(READ | WRITE | EXECUTE, WRITE) == READ | EXECUTE;
    then revoke(READ, WRITE) == READ;
    then revoke(0, EXECUTE) == 0;
}

spec allows {
    then allows(READ | EXECUTE, EXECUTE);
    then !allows(READ, WRITE);
    then allows(READ | WRITE, READ | WRITE);
    then !allows(READ, READ | WRITE);
}
