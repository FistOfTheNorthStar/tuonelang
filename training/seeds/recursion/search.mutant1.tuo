fn search_between(in ids: [Int; 8], take needle: Int, take lo: Int, take hi: Int) -> Int {
    if lo >= hi {
        return 0 - 1;
    }
    let mid = (lo + hi) / 2;
    let value = ids[mid as Usize];
    if value == needle {
        mid
    } else if value < needle {
        search_between(ids, needle, mid + 1, hi)
    } else {
        search_between(ids, needle, lo, mid)
    }
}

fn search(in ids: [Int; 8], take needle: Int) -> Int {
    search_between(ids, needle, 0, 7)
}

spec search {
    then search([3, 8, 15, 23, 42, 57, 61, 90], 42) == 4;
    then search([3, 8, 15, 23, 42, 57, 61, 90], 3) == 0;
    then search([3, 8, 15, 23, 42, 57, 61, 90], 90) == 7;
    then search([3, 8, 15, 23, 42, 57, 61, 90], 16) == 0 - 1;
    then search([3, 8, 15, 23, 42, 57, 61, 90], 100) == 0 - 1;
    then search([3, 8, 15, 23, 42, 57, 61, 90], 1) == 0 - 1;
}

spec search_between {
    then search_between([3, 8, 15, 23, 42, 57, 61, 90], 57, 5, 8) == 5;
    then search_between([3, 8, 15, 23, 42, 57, 61, 90], 57, 0, 5) == 0 - 1;
    then search_between([3, 8, 15, 23, 42, 57, 61, 90], 8, 2, 2) == 0 - 1;
}
