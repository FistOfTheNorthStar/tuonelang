fn is_vowel(take b: Int) -> Bool {
    b == 97 || b == 101 || b == 105 || b == 111 || b == 117
}

fn count_vowels(in s: Str) -> Int {
    var count = 0;
    var i = 1;
    while i < std::str::len(s) {
        if is_vowel(std::str::byte_at(s, i)) {
            count = count + 1;
        }
        i = i + 1;
    }
    count
}

spec count_vowels {
    then count_vowels("tuonelang") == 4;
    then count_vowels("apple") == 2;
    then count_vowels("") == 0;
}
