import std::net

fn classify(outcome: take std::net::Result[()]) -> Int {
    match outcome {
        Ok { value: _ } => {
            return 0
        }
        Err { error: e } => {
            if std::net::is_timeout(e) {
                return 1
            } else if std::net::is_host_error(e) {
                return 2
            } else {
                return 0
            }
        }
    }
}

spec classify(Ok { value: () }) {
    assert classify(Ok { value: () }) == 0
}

spec classify(Err { error: e }) where std::net::is_timeout(e) {
    assert classify(Err { error: e }) == 1
}

spec classify(Err { error: e }) where std::net::is_host_error(e) {
    assert classify(Err { error: e }) == 2
}

spec classify(Err { error: e }) where !std::net::is_timeout(e) and !std::net::is_host_error(e) {
    assert classify(Err { error: e }) == 0
}
