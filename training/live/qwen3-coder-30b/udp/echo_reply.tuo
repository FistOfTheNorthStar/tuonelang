import std::net::udp_bind
import std::net::udp_send
import std::net::udp_recv
import std::net::udp_peer_port
import std::net::udp_close
import std::time::sleep_ms

reply_matches(take fd: Int, in expected: Str) -> Bool {
    var buffer = [0; 1024]
    var received = udp_recv(fd, take buffer, 50)
    if received < 0 {
        return false
    }
    
    if received != 4 {
        return false
    }
    
    var i = 0
    while i < 4 {
        if buffer[i] != expected[i] {
            return false
        }
        i = i + 1
    }
    
    return true
}

main() -> Int {
    var server_fd = udp_bind("127.0.0.1", 0)
    if server_fd < 0 {
        return 1
    }
    
    var client_fd = udp_bind("127.0.0.1", 0)
    if client_fd < 0 {
        udp_close(server_fd)
        return 2
    }
    
    var ping = "ping"
    var pong = "pong"
    
    var send_result = udp_send(client_fd, take ping, server_fd)
    if send_result != 4 {
        udp_close(client_fd)
        udp_close(server_fd)
        return 3
    }
    
    var peer_port = udp_peer_port(server_fd)
    if peer_port < 0 {
        udp_close(client_fd)
        udp_close(server_fd)
        return 4
    }
    
    var received = reply_matches(server_fd, take pong)
    if not received {
        udp_close(client_fd)
        udp_close(server_fd)
        return 5
    }
    
    udp_close(client_fd)
    udp_close(server_fd)
    return 44
}
