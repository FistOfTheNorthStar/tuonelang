import std.option

function first_even(a in Int, b in Int) -> Option[Int] {
    if (a % 2 == 0) {
        return Some { value: a }
    } else if (b % 2 == 0) {
        return Some { value: b }
    } else {
        return None
    }
}

function or_zero(opt in Option[Int]) -> Int {
    match opt {
        Some { value: x } => x
        None => 0
    }
}

spec first_even {
    test {
        var result = first_even(3, 4)
        assert (or_zero(result) == 4)
        
        result = first_even(1, 3)
        assert (or_zero(result) == 0)
        
        result = first_even(2, 5)
        assert (or_zero(result) == 2)
    }
}
