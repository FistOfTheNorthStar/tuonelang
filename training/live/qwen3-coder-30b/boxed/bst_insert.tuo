import std.option
import std.box

struct Bst {
    key: Int,
    left: Option[Box[Bst]],
    right: Option[Box[Bst]]
}

fn bst_insert(take tree: Option[Box[Bst]], take key: Int) -> Option[Box[Bst]] {
    match tree {
        None => {
            Some { value: Box { Bst { key: key, left: None, right: None } } }
        },
        Some { value: node } => {
            if key < node.key {
                let new_left = bst_insert(node.left, key)
                Some { value: Box { Bst { key: node.key, left: new_left, right: node.right } } }
            } else if key > node.key {
                let new_right = bst_insert(node.right, key)
                Some { value: Box { Bst { key: node.key, left: node.left, right: new_right } } }
            } else {
                tree
            }
        }
    }
}

fn bst_contains(in tree: Option[Box[Bst]], take key: Int) -> Bool {
    match tree {
        None => false,
        Some { value: node } => {
            if key < node.key {
                bst_contains(node.left, key)
            } else if key > node.key {
                bst_contains(node.right, key)
            } else {
                true
            }
        }
    }
}

fn bst_size(in tree: Option[Box[Bst]]) -> Int {
    match tree {
        None => 0,
        Some { value: node } => {
            1 + bst_size(node.left) + bst_size(node.right)
        }
    }
}
