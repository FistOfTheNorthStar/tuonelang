import net.socket
import net.addr
import io.readable
import io.writable

fn main() {
    var sock = socket(SocketFamily::Inet6, SocketType::Stream, 0)
    defer { sock.close() }
    
    var addr = sockaddr_in6 {
        sin6_family: AddressFamily::Inet6,
        sin6_port: 0,
        sin6_addr: in6addr_any,
        sin6_flowinfo: 0,
        sin6_scope_id: 0
    }
    
    sock.bind(addr)
    
    var addr_len = sizeof(sockaddr_in6)
    var bound_addr = sockaddr_in6 { 
        sin6_family: AddressFamily::Inet6, 
        sin6_port: 0, 
        sin6_addr: in6addr_any, 
        sin6_flowinfo: 0, 
        sin6_scope_id: 0 
    }
    
    sock.getsockname(bound_addr, addr_len)
    
    sock.listen(1)
    
    var client_sock = socket(SocketFamily::Inet6, SocketType::Stream, 0)
    defer { client_sock.close() }
    
    var peer_addr = sockaddr_in6 {
        sin6_family: AddressFamily::Inet6,
        sin6_port: bound_addr.sin6_port,
        sin6_addr: in6addr_loopback,
        sin6_flowinfo: 0,
        sin6_scope_id: 0
    }
    
    client_sock.connect(peer_addr)
    
    var accepted_sock = sock.accept()
    defer { accepted_sock.close() }
    
    var peer_addr_len = sizeof(sockaddr_in6)
    var peer_sockaddr = sockaddr_in6 {
        sin6_family: AddressFamily::Inet6,
        sin6_port: 0,
        sin6_addr: in6addr_any,
        sin6_flowinfo: 0,
        sin6_scope_id: 0
    }
    
    accepted_sock.getpeername(peer_sockaddr, peer_addr_len)
    
    var family = peer_sockaddr.sin6_family
    
    if family == AddressFamily::Inet6 {
        print("6")
    } else {
        print("0")
    }
}
