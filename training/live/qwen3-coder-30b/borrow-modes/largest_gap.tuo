import std.array
import std.math

largest_gap(in times: Array[Int]) -> Int {
    if times.len < 2 {
        return 0
    }
    
    var max_gap = 0
    var i = 1
    while i < times.len {
        var gap = times[i] - times[i-1]
        if gap > max_gap {
            max_gap = gap
        }
        i = i + 1
    }
    
    return max_gap
}
