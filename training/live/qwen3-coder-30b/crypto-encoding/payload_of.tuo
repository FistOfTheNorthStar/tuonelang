import base64
import strings

fn payload_of(in token: Str) -> Str {
    var parts = strings.split(token, ".")
    if parts.len() != 3 {
        return ""
    }
    
    var payload_b64 = parts[1]
    var decoded = base64.decode(payload_b64)
    if decoded.is_err() {
        return ""
    }
    
    return decoded.value
}
