module search_ids;

/// Recursively searches for a needle in a sorted array segment.
/// Returns the index of the needle if found, or -1 otherwise.
/// The search is performed in the half-open range [lo, hi).
pub fn search_between(in ids: [Int; 8], take needle: Int, take lo: Int, take hi: Int) -> Int {
    // Base case: If the search range is empty, the element is not found.
    if lo >= hi {
        return -1;
    }

    // Calculate the middle index.
    // Using (lo + hi) / 2 is safe here because lo and hi are indices (Int)
    // and the initial call ensures hi - lo <= 8.
    let mid = lo + (hi - lo) / 2;

    // Check if the middle element is the needle.
    if ids[mid] == needle {
        return mid;
    } 
    // If the needle is smaller than the middle element, search the left half: [lo, mid)
    else if needle < ids[mid] {
        return search_between(ids, needle, lo, mid);
    } 
    // If the needle is larger than the middle element, search the right half: [mid + 1, hi)
    else {
        return search_between(ids, needle, mid + 1, hi);
    }
}

/// Public interface for binary search over the entire array [0, 8).
/// Returns the index of needle if found, or -1 otherwise.
pub fn search(in ids: [Int; 8], take needle: Int) -> Int {
    // The initial call searches the range [0, 8).
    search_between(ids, needle, 0, 8)
}

spec search {
    // Test case 1: Needle in the middle
    then search([1, 2, 3, 4, 5, 6, 7, 8], 4) == 3;

    // Test case 2: Needle at the start
    then search([1, 2, 3, 4, 5, 6, 7, 8], 1) == 0;

    // Test case 3: Needle at the end
    then search([1, 2, 3, 4, 5, 6, 7, 8], 8) == 7;

    // Test case 4: Needle not present (smaller than min)
    then search([1, 2, 3, 4, 5, 6, 7, 8], 0) == -1;

    // Test case 5: Needle not present (larger than max)
    then search([1, 2, 3, 4, 5, 6, 7, 8], 10) == -1;

    // Test case 6: Empty/all same elements (needle present)
    then search([5, 5, 5, 5, 5, 5, 5, 5], 5) == 0; // Should find the first occurrence index

    // Test case 7: Empty/all same elements (needle absent)
    then search([5, 5, 5, 5, 5, 5, 5, 5], 6) == -1;
}

fn main() -> Int {
    // Example usage: Search for 5 in [1, 2, 3, 4, 5, 6, 7, 8]
    let ids: [Int; 8] = [1, 2, 3, 4, 5, 6, 7, 8];
    let result = search(ids, 5);
    
    // Print the result (though main's return value is the exit status)
    // We use a simple return value here.
    if result != -1 {
        result
    } else {
        -1
    }
}
