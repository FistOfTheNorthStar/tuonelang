module prime_counter;

import std::core;
import std::sync;
import std::array;

/// Checks if a number is prime using trial division up to the square root.
fn is_prime(take n: Int) -> Bool {
    if n <= 1 {
        return false;
    }
    if n <= 3 {
        return true;
    }
    if n % 2 == 0 || n % 3 == 0 {
        return false;
    }
    var i = 5;
    while i * i <= n {
        if n % i == 0 || n % (i + 2) == 0 {
            return false;
        }
        i = i + 6;
    }
    true
}

/// Counts the primes in the range [start, end) by trial division.
/// The range size is fixed at 250.
fn count_primes(take chunk: Int) -> Int {
    let start = chunk * 250;
    let end = start + 250;
    var count = 0;
    var i = start;
    while i < end {
        if is_prime(i) {
            count = count + 1;
        }
        i = i + 1;
    }
    count
}

spec count_primes {
    then count_primes(0) == 10; // Primes in [0, 250)
    then count_primes(1) == 10; // Primes in [250, 500)
    then count_primes(2) == 10; // Primes in [500, 750)
    then count_primes(3) == 10; // Primes in [750, 1000)
}

fn main() -> Int {
    // We need to cover the range [0, 1000).
    // Chunk 0 covers [0, 250)
    // Chunk 1 covers [250, 500)
    // Chunk 2 covers [500, 750)
    // Chunk 3 covers [750, 1000)
    let tasks: Array[Int] = std::array::of3(0, 1, 2, 3);

    // Use par_map to process the chunks in parallel, using 2 workers.
    // The result is an Array[Int] containing the prime counts for each chunk.
    let counts: Array[Int] = std::sync::par_map(count_primes, tasks, 2);

    // Sum the results from the array of counts.
    std::collections::sum(counts)
}
