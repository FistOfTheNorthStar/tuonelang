module udp_echo_server;

import std::net;
import std::str;
import std::time;
import std::array;

// Constants for clarity
const PING_MESSAGE: Str = "ping";
const PONG_MESSAGE: Str = "pong";
const TIMEOUT_MS: Int = 50;
const PING_LEN: Int = 4;

/// The main logic for the UDP echo server simulation.
fn main() -> Int {
    // 1. Setup: Create two sockets (one for client, one for server)
    // In a real scenario, we'd use std::net::socket() or similar.
    // Since the prompt implies we are simulating the interaction using provided
    // functions, we will assume we can get two file descriptors (fds) for
    // binding and communication, and we will use placeholder values for them.
    // We must use std::net::listen() or std::net::udp_bind() to get fds.

    // For this simulation, we assume we can bind two sockets to ephemeral ports.
    // We'll use placeholder fds and rely on the provided functions.
    let client_fd: Int = 100; // Placeholder for client socket FD
    let server_fd: Int = 101; // Placeholder for server socket FD

    // 2. Bind sockets (Binding to ephemeral ports is usually implicit or handled by the OS/API)
    // We assume std::net::bind() or similar setup happens here and returns valid fds.
    // Since no explicit bind function is given, we proceed assuming the fds are ready.

    // 3. Start the server listening/receiving loop
    let result = server_receive_and_reply(server_fd, client_fd);

    // 4. Cleanup: Close both sockets
    std::net::close(server_fd);
    std::net::close(client_fd);

    // 5. Return status code
    if result {
        // Success: Client received "pong"
        44
    } else {
        // Failure: Return a distinct code based on the failure step
        // The function returns a Bool, so we map failure to a code.
        // We'll use 1 for general failure, as the specific failure point
        // is determined inside the function logic.
        1
    }
}

/// Attempts to receive a "ping" on the server socket, verifies it, and replies "pong"
/// to the sender's port using the client socket descriptor.
/// Returns true if the reply was successful, false otherwise.
fn server_receive_and_reply(
    take server_fd: Int,
    take client_fd: Int
) -> Bool {
    // Step 1: Wait for the client to send data on the server socket (server_fd)
    // We use the provided 'reply_matches' function which encapsulates the wait/read.
    let received_data_option: Option[Str] = std::net::reply_matches(
        take server_fd,
        PING_MESSAGE
    );

    if std::core::is_none(received_data_option) {
        // Failure 1: Did not receive "ping" within timeout.
        // We cannot return a specific code here, so we rely on the main function's
        // structure to handle the failure path (returning false).
        return false;
    }

    let received_data = std::core::unwrap_or(received_data_option, std::str::empty());

    // Step 2: Check if the received data is exactly "ping" (4 bytes)
    if received_data != PING_MESSAGE {
        // Failure 2: Received data was not "ping".
        return false;
    }

    // Step 3: Get the sender's port from the received datagram (using the client_fd placeholder)
    // The prompt specifies using std::net::udp_peer_port on the *sender's* descriptor.
    let sender_port: Int = std::net::udp_peer_port(take client_fd);

    // Step 4: Construct the reply message
    let reply_message: Str = PONG_MESSAGE;

    // Step 5: Send "pong" back to the sender's port using the client socket descriptor.
    // We use std::net::udp_send(take fd: Int, in host: Str, take port: Int, in bytes: Str)
    let send_result: Int = std::net::udp_send(
        take client_fd,
        "127.0.0.1", // Target host (localhost)
        take sender_port,
        in reply_message
    );

    if send_result != 0 {
        // Failure 3: Failed to send the reply.
        return false;
    }

    // Success
    true
}

