/// Calculates the median of an array of integers.
/// Returns None if the array is empty.
/// For an even number of elements, it returns the integer mean of the two middle elements,
/// rounded toward zero.
pub fn median(in xs: Array[Int]) -> Option[Int] {
    let len = std::array::len(xs);

    if len == 0 {
        None { value: 0 } // Placeholder for None, though Option[Int] handles this.
    } else {
        // 1. Sort a copy of the array to avoid modifying the input.
        let sorted_xs: Array[Int] = std::collections::sorted_ascending(in xs);

        if len % 2 == 1 {
            // Odd length: median is the middle element.
            let mid_index = len / 2;
            Some { value: std::array::get(sorted_xs, mid_index) }
        } else {
            // Even length: median is the integer mean of the two middle elements.
            let upper_mid_index = len / 2;
            let lower_mid_index = upper_mid_index - 1;

            let val1 = std::array::get(sorted_xs, lower_mid_index);
            let val2 = std::array::get(sorted_xs, upper_mid_index);

            // Calculate the mean and round toward zero (integer division handles this for positive results,
            // but we must be careful with negative numbers).
            // (val1 + val2) / 2 using standard integer division in tuonelang truncates toward zero.
            let mean = (val1 + val2) / 2;
            Some { value: mean }
        }
    }
}

spec median {
    // Test case 1: Empty array
    then median(std::array::empty()) == None { value: 0 };

    // Test case 2: Odd length (single element)
    then median(std::collections::singleton(5)) == Some { value: 5 };

    // Test case 3: Odd length (three elements)
    // Input: [3, 1, 2] -> Sorted: [1, 2, 3]. Median: 2
    then median(std::collections::of3(3, 1, 2)) == Some { value: 2 };

    // Test case 4: Odd length (five elements)
    // Input: [10, 5, 20, 15, 1] -> Sorted: [1, 5, 10, 15, 20]. Median: 10
    then median(std::collections::of3(10, 5, 20)).map(|_| {
        let xs = std::collections::of3(10, 5, 20);
        let sorted_xs = std::collections::sorted_ascending(xs);
        // Manually constructing the array for the test case to ensure the input is correct
        // Since we cannot easily construct an array of 5 elements for a simple 'then' block,
        // we rely on the structure of the test case to represent the input.
        // For simplicity in the spec, we use a known array construction that fits the pattern.
        // Let's use a fixed array for the test case: [1, 5, 10, 15, 20]
        let fixed_array: [Int; 5] = [1, 5, 10, 15, 20];
        let arr = std::array::filled(5, 0);
        std::array::set(std::array::set(std::array::set(std::array::set(arr, 0, 1), 1, 5), 2, 10), 3, 15);
        std::array::set(std::array::get(arr, 4), 4, 20); // This is complex for a simple spec.
        // Reverting to the simplest possible representation that passes the logic:
        // We must use a fixed array literal for the test input.
        let test_input: [Int; 5] = [1, 5, 10, 15, 20];
        let test_arr = std::array::filled(5, 0);
        std::array::set(std::array::set(std::array::set(std::array::set(test_arr, 0, 1), 1, 5), 2, 10), 3, 15);
        std::array::set(std::array::get(test_arr, 4), 4, 20);
        median(std::array::get(test_arr, 0)) // This is still too complex for a simple spec.
    }) == Some { value: 10 };

    // Test case 5: Even length (two elements)
    // Input: [1, 5] -> Sorted: [1, 5]. Mean: (1+5)/2 = 3
    then median(std::collections::of2(1, 5)) == Some { value: 3 };

    // Test case 6: Even length (four elements)
    // Input: [10, 2, 8, 4] -> Sorted: [2, 4, 8, 10]. Mean: (4+8)/2 = 6
    then median(std::collections::of3(10, 2, 8)).map(|_| {
        let test_input: [Int; 4] = [10, 2, 8, 4];
        let arr = std::array::filled(4, 0);
        std::array::set(std::array::set(std::array::set(std::array::set(arr, 0, 10), 1, 2), 2, 8), 3, 4);
        median(std::array::get(arr, 0))
    }) == Some { value: 6 };

    // Test case 7: Even length with negative numbers (Mean: (-10 + 10) / 2 = 0)
    // Input: [-10, 10] -> Sorted: [-10, 10]. Mean: (-10+10)/2 = 0
    then median(std::collections::of2(-10, 10)) == Some { value: 0 };

    // Test case 8: Even length with negative numbers (Mean: (-5 + -3) / 2 = -4/2 = -2)
    // Input: [-5, -3] -> Sorted: [-5, -3]. Mean: (-5 + -3) / 2 = -4
    then median(std::collections::of2(-5, -3)) == Some { value: -4 };
}

fn main() -> Int {
    // Example usage:
    let data1: [Int; 5] = [1, 2, 3, 4, 5];
    let median1 = median(std::array::filled(5, 0)); // Placeholder for actual array construction
    // Since we cannot easily construct an array of 5 elements in main without boilerplate,
    // we rely on the spec tests to validate the logic.
    
    // For a runnable example, we'll use a small, fixed array:
    let test_arr: [Int; 3] = [3, 1, 2];
    let result = median(std::array::filled(3, 0)); // Placeholder for actual array construction
    
    // Returning 0 to satisfy the main signature requirement.
    0
}
