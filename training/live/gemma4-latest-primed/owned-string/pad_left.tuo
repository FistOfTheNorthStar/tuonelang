/// Pads a string on the left with a specified byte until it reaches a target width.
/// If the string is already at or over the target width, it is returned unchanged.
pub fn pad_left(in s: Str, take width: Int, take fill: Int) -> String {
    let s_len = std::str::len(in s);

    if s_len >= width {
        return std::string::from_str(in s);
    }

    let padding_needed = width - s_len;
    
    // Create the padding string
    let mut padding_builder = std::string::builder();
    for _ in 0..padding_needed {
        padding_builder.push_byte(fill);
    }
    let padding_str = padding_builder.build();

    // Concatenate padding + original string
    std::string::concat(padding_str.as_str(), in s).to_string()
}

spec pad_left {
    then pad_left("42", 5, 48) == "00042";
    then pad_left("1", 1, 99) == "1"; // Already width 1
    then pad_left("abc", 3, 0) == "abc"; // Already width 3
    then pad_left("abc", 2, 0) == "abc"; // Longer than width, unchanged
    then pad_left("", 4, 1) == "1111";
    then pad_left("A", 1, 0) == "A";
}

fn main() -> Int {
    // Example usage: pad_left("42", 5, 48) -> "00042"
    let result = pad_left("42", 5, 48);
    std::io::println(result).unwrap_or(0);
    0
}
