fn checked_sub(take a: Int, take b: Int) -> Result[Int, Str] {
    if b > a {
        Err { error: "underflow" }
    } else {
        Ok { value: a - b }
    }
}

spec checked_sub {
    then checked_sub(5, 2) == Ok { value: 3 };
    then checked_sub(2, 5) == Err { error: "underflow" };
    then checked_sub(0, 0) == Ok { value: 0 };
}
