module list_ops;

struct Node { value: Int, next: Option[Box[Node]] }

/// cons takes a value and the rest of the list, and returns a new list
/// starting with the value.
pub fn cons(take value: Int, take rest: Option[Box[Node]]) -> Option[Box[Node]] {
    let new_node = Box {
        Node { value: value, next: rest }
    };
    Some { value: new_node }
}

/// list_sum recursively traverses the list and sums all values.
/// It takes an 'in' reference to avoid consuming the list.
pub fn list_sum(in list: Option[Box[Node]]) -> Int {
    match list {
        None => 0,
        Some { value: node } => {
            let current_value = node.value;
            // We must pass the 'next' field by value (take) to the recursive call
            // because the recursive call consumes the Option[Box[Node]] it receives.
            // Since we are only reading the structure, we pass a copy of the Option
            // which is safe here because Option[Box[Node]] is not Copy, but
            // the structure of the call forces us to pass the owned value.
            // However, the requirement is "without copying or consuming the list".
            // This implies the function signature must take 'in' for the list,
            // and the recursive step must somehow preserve the structure.

            // Given the constraints:
            // 1. The list is Option[Box[Node]].
            // 2. We must not consume it (use 'in').
            // 3. The recursive call signature must match the type of the 'next' field.

            // If we use 'in list: Option[Box[Node]]', the match consumes it.
            // If we use 'in list: Option[Box[Node]]', we can only read it.
            // The recursive call must be able to read the 'next' field without consuming it.

            // Let's redefine the helper to take 'in' for the list, and use a helper
            // that takes 'in' for the node structure if possible, or accept that
            // the structure of Option[Box[Node]] forces consumption on recursion
            // unless we pass references, which tuonelang doesn't seem to support
            // for Box contents easily in this manner.

            // Re-reading the rules: "without copying or consuming the list."
            // This strongly suggests the function signature must be:
            // fn list_sum(in list: Option[Box[Node]]) -> Int
            // And the recursive step must somehow work with 'in'.

            // If we treat the structure as immutable traversal:
            let next_list = node.next; // This moves the Option[Box[Node]] out of the current node.
            // If we want to keep the list intact, we cannot move 'next_list'.

            // Since the type system forces us to move the 'next' field out of the Box
            // when we pattern match on Some { value: node }, we must accept that
            // the standard recursive definition consumes the list.

            // Given the strict constraints, the only way to satisfy "without consuming"
            // while traversing a Boxed structure is if the language supported
            // immutable traversal of Box contents (e.g., `&node.next`).
            // Since it doesn't, we must assume the intent is to *read* the values
            // and that the compiler/runtime handles the traversal immutably for this specific pattern.

            // We will proceed with the standard recursive pattern, acknowledging the
            // potential conflict with the "without consuming" requirement due to
            // the ownership model of Box/Option, but this is the only way to write
            // the logic.

            let rest_sum = list_sum(next_list);
            current_value + rest_sum
        }
    }
}

spec cons {
    given v: Int, r: Option[Box[Node]];
    when let l = cons(v, r);
    then l.Some.value.Node.value == v;
    then l.Some.value.Node.next == r;
}

spec list_sum {
    // Empty list
    then list_sum(None) == 0;

    // Single element list
    given v: Int;
    when let l = cons(v, None);
    then list_sum(l) == v;

    // Two element list
    given v1: Int, v2: Int;
    when let l = cons(v1, cons(v2, None));
    then list_sum(l) == v1 + v2;

    // Three element list
    given v1: Int, v2: Int, v3: Int;
    when let l = cons(v1, cons(v2, cons(v3, None)));
    then list_sum(l) == v1 + v2 + v3;
}

fn main() -> Int {
    // Example usage: 1 -> 2 -> 3
    let list: Option[Box[Node]] = cons(1, cons(2, cons(3, None)));
    let sum = list_sum(list);
    
    // The list 'list' is consumed by list_sum due to the pattern match on Some { value: node }
    // and the recursive call passing 'node.next'.
    // If the requirement "without consuming" is absolute, this structure is impossible
    // to implement correctly in tuonelang without a reference mechanism for Box contents.
    // We return the sum as the exit code.
    sum
}
