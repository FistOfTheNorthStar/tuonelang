module main_cleanup;

import std::fs;
import std::str;

const LOCK_FILE_PATH: Str = "tuo_seed_cleanup.lock";

/// Writes a specific string to a file, returns 1 on success.
fn write_lock(take path: Str, take content: Str) -> Int {
    std::fs::write(path, content).ok().map_or(1, |res| res)
}

/// Checks if a file exists, returns 1 if it exists, 0 otherwise.
fn check_exists(take path: Str) -> Int {
    if std::fs::exists(path).unwrap_or(false) {
        1
    } else {
        0
    }
}

/// Removes a file, returns 1 on success, 0 on failure (if it didn't exist).
fn remove_lock(take path: Str) -> Int {
    std::fs::remove(path).ok().map_or(0, |res| 1)
}

/// Checks if a file no longer exists, returns 1 if it doesn't exist, 0 otherwise.
fn check_not_exists(take path: Str) -> Int {
    if !std::fs::exists(path).unwrap_or(false) {
        1
    } else {
        0
    }
}

/// Attempts to read a file, returns 1 if it fails with Not Found, 0 otherwise.
fn check_read_failure(take path: Str) -> Int {
    let result = std::fs::read(path);
    if std::fs::is_not_found(result.err().unwrap_or(std::fs::FsError::other(0))) {
        1
    } else {
        0
    }
}

fn main() -> Int {
    // Step 1: Write the lock file
    let step1_result = write_lock(LOCK_FILE_PATH, "lock");
    if step1_result != 1 {
        return 1;
    }

    // Step 2: Check if the file exists
    let step2_result = check_exists(LOCK_FILE_PATH);
    if step2_result != 1 {
        return 2;
    }

    // Step 3: Remove the file
    let step3_result = remove_lock(LOCK_FILE_PATH);
    if step3_result != 1 {
        return 3;
    }

    // Step 4: Check if the file no longer exists
    let step4_result = check_not_exists(LOCK_FILE_PATH);
    if step4_result != 1 {
        return 4;
    }

    // Step 5: Attempt to read the file and expect Not Found error
    let step5_result = check_read_failure(LOCK_FILE_PATH);
    if step5_result != 1 {
        return 5;
    }

    // Success
    7
}

spec main() {
    then main() == 7;
}
