module prime_counter;

/// Check if a number is prime
fn is_prime(take n: Int) -> Bool {
    if n < 2 {
        false
    } else if n == 2 {
        true
    } else if n % 2 == 0 {
        false
    } else {
        var i = 3;
        while i * i <= n {
            if n % i == 0 {
                false
            }
            i = i + 2;
        }
        true
    }
}

/// Count primes in a chunk of numbers
fn count_primes(take chunk: Int) -> Int {
    let start = chunk * 250;
    let end = start + 250;
    var count = 0;
    var i = start;
    while i < end {
        if is_prime(i) {
            count = count + 1;
        }
        i = i + 1;
    }
    count
}

spec is_prime {
    then is_prime(2) == true;
    then is_prime(3) == true;
    then is_prime(4) == false;
    then is_prime(17) == true;
    then is_prime(25) == false;
}

spec count_primes {
    then count_primes(0) == 48; // Primes in 0..250
    then count_primes(1) == 43; // Primes in 250..500
}

fn main() -> Int {
    let tasks: Array[Int] = [0, 1, 2, 3];
    let results = std::sync::par_map(count_primes, tasks, 2);
    let total = std::collections::sum(results);
    total
}
