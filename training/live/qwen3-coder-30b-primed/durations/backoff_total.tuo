module retry;

/// Calculate the total backoff time for a given number of retries.
/// The first retry waits 100ms, each subsequent retry doubles the previous wait.
pub fn backoff_total(take retries: Int) -> std::time::Duration {
    if retries <= 0 {
        std::time::zero()
    } else {
        var total = std::time::from_millis(100);
        var current = std::time::from_millis(100);
        var i = 1;
        while i < retries {
            current = std::time::add(current, current);
            total = std::time::add(total, current);
            i = i + 1;
        }
        total
    }
}

spec backoff_total {
    then backoff_total(0) == std::time::zero();
    then backoff_total(1) == std::time::from_millis(100);
    then backoff_total(2) == std::time::from_millis(300);
    then backoff_total(3) == std::time::from_millis(700);
}
