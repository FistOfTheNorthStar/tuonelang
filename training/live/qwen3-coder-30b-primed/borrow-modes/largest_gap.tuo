module bus_gaps;

/// Returns the largest gap between consecutive bus arrivals, or 0 if fewer than two buses arrive.
pub fn largest_gap(in times: Array[Int]) -> Int {
    if std::array::len(times) < 2 {
        0
    } else {
        var max_gap = 0;
        var i = 1;
        while i < std::array::len(times) {
            let gap = std::array::get(times, i) - std::array::get(times, i - 1);
            if gap > max_gap {
                max_gap = gap;
            }
            i = i + 1;
        }
        max_gap
    }
}

spec largest_gap {
    then largest_gap(std::collections::singleton(5)) == 0;
    then largest_gap(std::collections::of2(1, 5)) == 4;
    then largest_gap(std::collections::of3(1, 5, 10)) == 5;
    then largest_gap(std::collections::of3(10, 5, 1)) == 5;
    then largest_gap(std::array::empty()) == 0;
}
