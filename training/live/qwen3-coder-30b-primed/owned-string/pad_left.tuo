module padding;

/// Pad a string on the left with a fill byte until it reaches the specified width.
pub fn pad_left(in s: Str, take width: Int, take fill: Int) -> String {
    let len = std::str::len(s);
    if len >= width {
        return std::string::from_str(s);
    }
    
    let mut result = std::string::empty();
    let padding = width - len;
    
    var i = 0;
    while i < padding {
        std::string::push_byte(mut result, fill);
        i = i + 1;
    }
    
    std::string::append(mut result, s);
    result
}

spec pad_left {
    then pad_left("42", 5, 48) == "00042";
    then pad_left("hello", 3, 48) == "hello";
    then pad_left("", 2, 48) == "00";
    then pad_left("test", 6, 32) == "  test";
}
