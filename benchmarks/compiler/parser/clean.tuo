module bench::clean;

import std::collections::{Map as Dict, Set};
import std::fmt;

/// Point number 0 in the clean corpus.
pub struct Point0[T: Ord + Clone] where T: Display {
    /// Horizontal coordinate.
    pub x: T,
    pub y: T,
    tags: Set[Str],
}

pub enum Shape0 {
    Circle { radius: F64 },
    Rect { w: F64, h: F64 },
    Empty,
}

interface Area0 {
    fn area(in self) -> F64;
    fn scaled(in self, in factor: F64) -> F64 {
        self.area() * factor
    }
}

impl Area0 for Shape0 {
    fn area(in self) -> F64 {
        match self {
            Shape0::Circle { radius } => 3.14159 * radius * radius,
            Shape0::Rect { w, h } => w * h,
            _ => 0.0,
        }
    }
}

const LIMIT_0: Int = 0 * 64 + 7;

fn build_0[T: Ord](in items: List[T], mut acc: List[T]) -> List[T] where T: Clone {
    var total = 0;
    for item in items {
        if total > LIMIT_0 {
            break;
        };
        total = total + 1;
    }
    'outer: loop {
        while total > 0 {
            total = total - 1;
        }
        break 'outer acc;
    }
}

spec shape_0_area {
    given radius: F64 = 0.5;
    when let shape = Shape0::Circle;
    then shape.area() >= 0.0;
    assert LIMIT_0 > 0;
}
