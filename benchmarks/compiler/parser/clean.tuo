    /// Horizontal coordinate.
    pub x: T,
    pub y: T,
    tags: Set[Str],
}

pub enum Shape54 {
    Circle { radius: F64 },
    Rect { w: F64, h: F64 },
    Empty,
}

interface Area54 {
    fn area(in self) -> F64;
    fn scaled(in self, in factor: F64) -> F64 {
        self.area() * factor
    }
}

impl Area54 for Shape54 {
    fn area(in self) -> F64 {
        match self {
            Shape54::Circle { radius } => 3.14159 * radius * radius,
            Shape54::Rect { w, h } => w * h,
            _ => 0.0,
        }
    }
}

const LIMIT_54: Int = 54 * 64 + 7;

fn build_54[T: Ord](in items: List[T], mut acc: List[T]) -> List[T] where T: Clone {
    var total = 0;
    for item in items {
        if total > LIMIT_54 {
            break;
        };
        total = total + 1;
    }
    'outer: loop {
        while total > 0 {
            total = total - 1;
        }
        break 'outer acc;
    }
}

spec shape_54_area {
    given radius: F64 = 54.5;
    when let shape = Shape54::Circle;
    then shape.area() >= 0.0;
    assert LIMIT_54 > 0;
}
