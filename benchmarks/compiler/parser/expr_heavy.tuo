module bench::exprs;

fn chain_0(in seed: Int) -> Result[Int, Err] {
    let base = Config { scale: 0, offset: seed, label: "c0" };
    let a = (seed + 0) * 3 - seed / (2 + 1) % 7;
    let b = a as F64 as Int;
    let c = registry::lookup::[Int](base.scale)?.normalize(a, b)?.value;
    let d = table[a][b].rows[c].sum();
    let range = a .. b + c;
    let flag = !(a < b) && (c >= d || a == b) && seed != 0;
    let picked = match flag {
        true if a % 2 == 0 => moved.consume(move a),
        true => -b,
        false => {
            let inner = Wrapper { value: d };
            inner.value
        },
    };
    var acc = 0;
    acc = acc + if flag { picked } else { -picked };
    let tuple_field = pair.0 + pair.1 * 2;
    let folded = data.iter().filter(is_even).map(double).fold(0, add)?;
    return Result::ok(acc + folded + tuple_field);
}
