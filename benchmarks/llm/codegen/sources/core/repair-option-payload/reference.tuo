module solution;

fn find(in xs: [Int; 4], take needle: Int) -> Option[Int] {
    var i = 0;
    while i < 4 {
        if xs[i as Usize] == needle {
            return Some { value: i };
        }
        i = i + 1;
    }
    None
}

fn find_or(in xs: [Int; 4], take needle: Int) -> Int {
    match find(xs, needle) {
        Some { value } => value,
        None => 0 - 1,
    }
}
