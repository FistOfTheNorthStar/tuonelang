module solution;

pub fn to_binary(take n: Int) -> String {
    if n == 0 {
        return std::string::from_str("0");
    }
    var backwards = std::string::empty();
    var x = n;
    while x > 0 {
        std::string::push_byte(backwards, 48 + x % 2);
        x = x / 2;
    }
    var out = std::string::empty();
    var i = std::string::len(backwards) - 1;
    while i >= 0 {
        std::string::push_byte(out, std::string::byte_at(backwards, i));
        i = i - 1;
    }
    out
}
