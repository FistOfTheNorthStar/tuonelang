module solution;

pub fn push_twice(mut xs: Array[Int], take v: Int) -> Int {
    std::array::push(xs, v);
    std::array::push(xs, v);
    std::array::len(xs)
}

pub fn filled_pairs(take n: Int) -> Int {
    var xs = std::array::empty();
    var i = 1;
    while i <= n {
        let _ = push_twice(xs, i);
        i = i + 1;
    }
    var total = 0;
    var j = 0;
    while j < std::array::len(xs) {
        total = total + std::array::get(xs, j);
        j = j + 1;
    }
    total
}
