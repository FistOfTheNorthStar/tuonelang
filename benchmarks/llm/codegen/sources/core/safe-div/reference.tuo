module solution;

pub fn safe_div(take a: Int, take b: Int) -> Option[Int] {
    if b == 0 {
        None
    } else {
        Some { value: a / b }
    }
}

pub fn div_or(take a: Int, take b: Int, take fallback: Int) -> Int {
    match safe_div(a, b) {
        Some { value } => value,
        None => fallback,
    }
}
