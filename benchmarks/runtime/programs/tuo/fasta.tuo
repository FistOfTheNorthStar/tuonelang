// The fasta workload — the Benchmarks Game's fasta: generate three DNA
// sequences — ALU repeated for 2,000,000 bases, then 3,000,000 bases drawn
// from the IUB code table and 5,000,000 from Homo sapiens frequencies, with the
// benchmark's linear congruential generator — wrapped at 60 bases per line.
// Instead of writing to stdout, every generated byte (newlines included) is
// folded into a checksum (sum = (sum * 31 + byte) % 1000003). The C, Rust,
// and Go peers generate the identical stream. Exit byte: 175.

struct Gen {
    sum: Int,
    last: Int,
}

fn alu() -> Str {
    "GGCCGGGCGCGGTGGCTCACGCCTGTAATCCCAGCACTTTGGGAGGCCGAGGCGGGCGGATCACCTGAGGTCAGGAGTTCGAGACCAGCCTGGCCAACATGGTGAAACCCCGTCTCTACTAAAAATACAAAAATTAGCCGGGCGTGGTGGCGCGCGCCTGTAATCCCAGCTACTCGGGAGGCTGAGGCAGGAGAATCGCTTGAACCCGGGAGGCGGAGGTTGCAGTGAGCCGAGATCGCGCCACTGCACTCCAGCCTGGGCGACAGAGCGAGACTCCGTCTCAAAAA"
}

fn emit(mut g: Gen, take byte: Int) {
    g.sum = (g.sum * 31 + byte) % 1000003;
}

fn random_unit(mut g: Gen) -> Float {
    g.last = (g.last * 3877 + 29573) % 139968;
    (g.last as Float) / 139968.0
}

fn repeat(mut g: Gen, take n: Int) {
    let seq = alu();
    let len = std::str::len(seq);
    var at = 0;
    var col = 0;
    var i = 0;
    while i < n {
        emit(g, std::str::byte_at(seq, at));
        at = at + 1;
        if at == len {
            at = 0;
        }
        col = col + 1;
        if col == 60 {
            emit(g, 10);
            col = 0;
        }
        i = i + 1;
    }
    if col > 0 {
        emit(g, 10);
    }
}

fn random_seq(mut g: Gen, in codes: Str, in cumulative: Array[Float], take n: Int) {
    let count = std::array::len(cumulative);
    var col = 0;
    var i = 0;
    while i < n {
        let r = random_unit(g);
        var k = 0;
        while k < count - 1 && r >= std::array::get(cumulative, k) {
            k = k + 1;
        }
        emit(g, std::str::byte_at(codes, k));
        col = col + 1;
        if col == 60 {
            emit(g, 10);
            col = 0;
        }
        i = i + 1;
    }
    if col > 0 {
        emit(g, 10);
    }
}

fn cumulate(in p: Array[Float]) -> Array[Float] {
    var out = std::array::empty();
    var acc = 0.0;
    var i = 0;
    while i < std::array::len(p) {
        acc = acc + std::array::get(p, i);
        std::array::push(out, acc);
        i = i + 1;
    }
    out
}

fn iub() -> Array[Float] {
    var p = std::array::empty();
    std::array::push(p, 0.27);
    std::array::push(p, 0.12);
    std::array::push(p, 0.12);
    std::array::push(p, 0.27);
    var i = 0;
    while i < 11 {
        std::array::push(p, 0.02);
        i = i + 1;
    }
    p
}

fn homo_sapiens() -> Array[Float] {
    var p = std::array::empty();
    std::array::push(p, 0.3029549426680);
    std::array::push(p, 0.1979883004921);
    std::array::push(p, 0.1975473066391);
    std::array::push(p, 0.3015094502008);
    p
}

fn main() -> Int {
    let n = 1000000;
    var g = Gen { sum: 0, last: 42 };
    let iub_c = cumulate(iub());
    let homo_c = cumulate(homo_sapiens());
    repeat(g, 2 * n);
    random_seq(g, "acgtBDHKMNRSVWY", iub_c, 3 * n);
    random_seq(g, "acgt", homo_c, 5 * n);
    g.sum % 256
}
